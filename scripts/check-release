#!/bin/sh

# Dependency-free release-readiness checker. It never creates or publishes tags.

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
VERSION_FILE=$ROOT/VERSION

fail() {
  printf 'release check failure: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  scripts/check-release prepare [--allow-dirty]
  scripts/check-release published

prepare checks the local release candidate without creating a tag. During
implementation, `--allow-dirty` runs consistency checks without claiming a
clean release candidate.
published additionally checks read-only local/remote evidence for the expected tag.
EOF
}

require_text() {
  needle=$1
  file=$2
  grep -F -- "$needle" "$ROOT/$file" >/dev/null 2>&1 || fail "$file is missing: $needle"
}

version=$(awk 'NR == 1 { print; exit }' "$VERSION_FILE")
[ -n "$version" ] || fail "VERSION is empty"
case "$version" in
  *.*) ;;
  *) fail "VERSION is not a release version: $version" ;;
esac
expected_tag=v$version
notes=docs/releases/$expected_tag.md
[ -f "$ROOT/$notes" ] || fail "release notes are missing: $ROOT/$notes"

prepare() {
  allow_dirty=no
  if [ "${1:-}" = --allow-dirty ]; then allow_dirty=yes; fi
  require_text "$version" CHANGELOG.md
  require_text "$version" README.md
  require_text "$version" docs/compatibility.md
  require_text "scripts/swe-forge install" README.md
  require_text "scripts/swe-forge install" docs/installation.md
  require_text "VERSION" scripts/swe-forge
  require_text "v$version" "$notes"
  require_text "Final alpha hardening" "$notes"
  require_text "$version" CHANGELOG.md
  require_text "v$version" README.md
  require_text "$version" docs/compatibility.md
  require_text "$expected_tag" "$notes"
  require_text "main" README.md
  require_text "development-only" README.md
  # A release candidate must not carry staged, unstaged, or untracked content.
  # During implementation, callers may use --allow-dirty only through a
  # future explicit release workflow; this checker remains strict by default.
  if [ "$allow_dirty" = no ]; then
    [ -z "$(git -C "$ROOT" status --porcelain=v1 --untracked-files=all)" ] || \
      fail "release candidate checkout is not clean"
    printf 'PASS: release readiness prepared for %s\n' "$expected_tag"
  else
    printf 'PASS: release consistency prepared for %s (dirty candidate allowed for development)\n' "$expected_tag"
  fi
  printf 'Publication remains manual; no tag or release was created.\n'
}

published() {
  prepare --allow-dirty
  local_tag=$(git -C "$ROOT" rev-parse --verify "refs/tags/$expected_tag" 2>/dev/null || true)
  remote_tag=$(git -C "$ROOT" ls-remote --tags origin "refs/tags/$expected_tag" "refs/tags/$expected_tag^{}" 2>/dev/null || true)
  [ -n "$local_tag" ] || [ -n "$remote_tag" ] || \
    fail "expected tag is not present in local or remote read-only evidence: $expected_tag"
  release_commit=$(git -C "$ROOT" rev-parse HEAD)
  if [ -n "$local_tag" ]; then
    tag_commit=$(git -C "$ROOT" rev-list -n 1 "$expected_tag")
    [ "$tag_commit" = "$release_commit" ] || fail "local tag does not resolve to current release commit"
  fi
  if [ -n "$remote_tag" ]; then
    remote_commit=$(printf '%s\n' "$remote_tag" | awk '$2 ~ /\{\}$/ { print $1; exit }')
    [ -n "$remote_commit" ] || remote_commit=$(printf '%s\n' "$remote_tag" | awk 'NR == 1 { print $1; exit }')
    [ "$remote_commit" = "$release_commit" ] || fail "remote tag evidence does not resolve to current release commit"
  fi
  printf 'PASS: published tag evidence resolves for %s\n' "$expected_tag"
  printf 'Release publication remains a separate manual action.\n'
}

[ "$#" -ge 1 ] || { usage >&2; exit 2; }
case "$1" in
  prepare)
    [ "$#" -le 2 ] || { usage >&2; exit 2; }
    shift
    prepare "${1:-}"
    ;;
  published)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    published
    ;;
  -h|--help) usage ;;
  *) fail "unknown mode: $1" ;;
esac
