#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
GATE=$ROOT/scripts/swe-forge-isolated-gate
FINGERPRINT=$ROOT/scripts/swe-forge-gate
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-isolated-test.XXXXXX")

cleanup() {
  rm -rf "$TMP_ROOT"
}
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'test failure: %s\n' "$*" >&2
  exit 1
}

expect_failure() {
  expected=$1
  shift
  if output=$("$@" 2>&1); then
    fail "expected command to fail: $*"
  fi
  case "$output" in
    *"$expected"*) ;;
    *) fail "failure did not contain '$expected': $output" ;;
  esac
}

make_repo() {
  repo=$TMP_ROOT/repo
  mkdir -p "$repo"
  git -C "$repo" init -q
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name "SWE Forge Isolated Test"
  printf 'base\n' >"$repo/base.txt"
  git -C "$repo" add base.txt
  git -C "$repo" commit -qm 'Base commit'
  git -C "$repo" branch -M main
  printf '%s\n' "$repo"
}

make_bundle() {
  result=$1
  task=$2
  provider=$3
  branch=$4
  worktree=$5
  base=$6
  head=$7
  candidate=$8
  commit=$9
  file=${10}
  check=${11}
  mkdir -p "$result"
  printf 'schema_version\t1\ntask_id\t%s\nstatus\tDONE\nprovider\t%s\nbranch\t%s\nworktree\t%s\nbase_sha\t%s\nhead_sha\t%s\ncandidate_fingerprint\t%s\n' \
    "$task" "$provider" "$branch" "$worktree" "$base" "$head" "$candidate" >"$result/meta.tsv"
  printf '%s\n' "$commit" >"$result/commits.txt"
  printf '%s\n' "$file" >"$result/files.txt"
  printf '%s\tpassed\t%s\t\n' "$check" "$candidate" >"$result/validations.tsv"
  : >"$result/scope-exceptions.txt"
  : >"$result/staged.txt"
  : >"$result/unstaged.txt"
  : >"$result/untracked.txt"
  : >"$result/resources.tsv"
}

repo=$(make_repo)
base=$(git -C "$repo" rev-parse HEAD)
capabilities=$TMP_ROOT/capabilities.tsv
{
  printf 'schema_version\t1\nprovider\tNATIVE\n'
  for capability in concurrent_writable_workers dedicated_worktrees exact_base_sha \
    integration_checkout_protection structured_results wait inspect cancel cleanup \
    central_integration; do
    printf '%s\tproven\tfixture-capability-check\n' "$capability"
  done
} >"$capabilities"

expect_failure 'capability proof must be a regular file' "$GATE" init \
  --state "$TMP_ROOT/missing-capabilities-state" --repo "$repo" --run-id missing-capabilities \
  --provider NATIVE --capabilities-ref missing-capabilities
incomplete_capabilities=$TMP_ROOT/incomplete-capabilities.tsv
{
  printf 'schema_version\t1\nprovider\tNATIVE\n'
  printf 'concurrent_writable_workers\tunknown\tfixture-capability-check\n'
} >"$incomplete_capabilities"
expect_failure 'capability proof must contain every required proven capability' "$GATE" init \
  --state "$TMP_ROOT/incomplete-capabilities-state" --repo "$repo" --run-id incomplete-capabilities \
  --provider NATIVE --capabilities-ref "$incomplete_capabilities"

integration=$TMP_ROOT/integration
worker_a=$TMP_ROOT/worker-a
worker_b=$TMP_ROOT/worker-b
git -C "$repo" worktree add -q -b integration "$integration" "$base"
git -C "$repo" worktree add -q -b worker-a "$worker_a" "$base"
git -C "$repo" worktree add -q -b worker-b "$worker_b" "$base"
state=$TMP_ROOT/state

"$GATE" init --state "$state" --repo "$repo" --run-id fixture \
  --provider NATIVE --capabilities-ref "$capabilities" \
  --requested-mode AUTO --requested-provider HERDR \
  --requested-delivery GUIDED --delivery-mode GUIDED \
  --routing-initial ISOLATED --routing-preferred ISOLATED \
  --routing-selected ISOLATED --routing-current ISOLATED >/dev/null
"$ROOT/scripts/swe-forge-state" validate --state "$state/run-state.yaml" >/dev/null
grep -F 'requested_mode: AUTO' "$state/run-state.yaml" >/dev/null
grep -F 'requested_provider: HERDR' "$state/run-state.yaml" >/dev/null
grep -F 'requested_delivery: GUIDED' "$state/run-state.yaml" >/dev/null
grep -F 'delivery_mode: GUIDED' "$state/run-state.yaml" >/dev/null
grep -F '  current: ISOLATED' "$state/run-state.yaml" >/dev/null
grep -F '  workflow: isolated' "$state/run-state.yaml" >/dev/null
grep -F '    mode: GUIDED' "$state/run-state.yaml" >/dev/null
missing_proven=$TMP_ROOT/missing-proven-capability.yaml
sed 's/^    status: proven$/    status: unknown/' \
  "$state/run-state.yaml" >"$missing_proven"
expect_failure 'ISOLATED state requires proven capability' "$ROOT/scripts/swe-forge-state" \
  validate --state "$missing_proven"
missing_proof_ref=$TMP_ROOT/missing-proof-ref.yaml
sed 's|^    evidence_ref:.*$|    evidence_ref: missing-capability-proof|' \
  "$state/run-state.yaml" >"$missing_proof_ref"
expect_failure 'capability proof must be a regular file' "$ROOT/scripts/swe-forge-state" \
  validate --state "$missing_proof_ref"
integration_invocation_head_before=$(awk '$1 == "head_sha:" && section == "invocation_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$state/run-state.yaml")
integration_reason_before=$(awk '$1 == "reason:" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$state/run-state.yaml")
"$GATE" register-integration --state "$state" --path "$integration" \
  --branch integration --base-sha "$base" --worker-order A,B >/dev/null
integration_path=$(CDPATH= cd "$integration" && pwd -P)
grep -F "  path: $integration_path" "$state/run-state.yaml" >/dev/null
grep -F '  branch: integration' "$state/run-state.yaml" >/dev/null
grep -F '  kind: integration' "$state/run-state.yaml" >/dev/null
grep -F "  base_sha: $base" "$state/run-state.yaml" >/dev/null
grep -F "  head_sha: $base" "$state/run-state.yaml" >/dev/null
grep -F "  checkpoint_sha: $base" "$state/run-state.yaml" >/dev/null
[ "$(awk '$1 == "head_sha:" && section == "invocation_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$state/run-state.yaml")" = "$integration_invocation_head_before" ] || \
  fail 'integration registration changed invocation checkout facts'
[ "$(awk '$1 == "reason:" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$state/run-state.yaml")" = "$integration_reason_before" ] || \
  fail 'integration registration changed unrelated run-state fields'
expect_failure 'central integration checkout is already registered' "$GATE" register-integration \
  --state "$state" --path "$integration" --branch integration --base-sha "$base" \
  --worker-order A,B
"$GATE" register-worker --state "$state" --task-id A --path "$worker_a" \
  --branch worker-a --base-sha "$base" --integration-order 1 \
  --scope a.txt --check worker-smoke >/dev/null
"$GATE" register-worker --state "$state" --task-id B --path "$worker_b" \
  --branch worker-b --base-sha "$base" --integration-order 2 \
  --scope b.txt --check worker-smoke >/dev/null

# B completes first; planned order still requires A.
printf 'B\n' >"$worker_b/b.txt"
git -C "$worker_b" add b.txt
git -C "$worker_b" commit -qm 'Worker B'
b_head=$(git -C "$worker_b" rev-parse HEAD)
b_fp=$("$FINGERPRINT" fingerprint --checkout "$worker_b")
make_bundle "$TMP_ROOT/result-b" B NATIVE worker-b "$worker_b" "$base" "$b_head" "$b_fp" "$b_head" b.txt worker-smoke
"$GATE" validate-result --state "$state" --task-id B --result "$TMP_ROOT/result-b" >/dev/null
expect_failure 'next planned worker is not validated' "$GATE" next --state "$state" --task-id B

# A completes after B but remains the first integration unit.
printf 'A\n' >"$worker_a/a.txt"
git -C "$worker_a" add a.txt
git -C "$worker_a" commit -qm 'Worker A'
a_head=$(git -C "$worker_a" rev-parse HEAD)
a_fp=$("$FINGERPRINT" fingerprint --checkout "$worker_a")
make_bundle "$TMP_ROOT/result-a" A NATIVE worker-a "$worker_a" "$base" "$a_head" "$a_fp" "$a_head" a.txt worker-smoke
"$GATE" validate-result --state "$state" --task-id A --result "$TMP_ROOT/result-a" >/dev/null
"$GATE" next --state "$state" --task-id A >/dev/null
expect_failure 'worker is not next' "$GATE" next --state "$state" --task-id B
"$GATE" transfer --state "$state" --task-id A --apply >/dev/null
git -C "$integration" add a.txt
git -C "$integration" commit -qm 'Integrate worker A'
a_integration=$(git -C "$integration" rev-parse HEAD)
"$GATE" map --state "$state" --task-id A --source-sha "$a_head" \
  --integration-sha "$a_integration" >/dev/null
"$GATE" next --state "$state" --task-id B >/dev/null
"$GATE" transfer --state "$state" --task-id B --apply >/dev/null
git -C "$integration" add b.txt
git -C "$integration" commit -qm 'Integrate worker B'
b_integration=$(git -C "$integration" rev-parse HEAD)
"$GATE" map --state "$state" --task-id B --source-sha "$b_head" \
  --integration-sha "$b_integration" >/dev/null
[ "$(git -C "$integration" show --format=%s --no-patch HEAD~1)" = 'Integrate worker A' ] || fail 'integration order is not A then B'
[ "$(git -C "$integration" show --format=%s --no-patch HEAD)" = 'Integrate worker B' ] || fail 'final integration commit is not B'

# The fixture proves the integration branch is the only branch pushed.
bare=$TMP_ROOT/remote.git
git init --bare -q "$bare"
git -C "$integration" remote add origin "$bare"
git -C "$integration" push -q origin integration
[ "$(git --git-dir="$bare" for-each-ref --format='%(refname:short)' refs/heads)" = integration ] || fail 'worker branches were pushed'

# Failure fixtures exercise the canonical guard rather than duplicating it.
wrong_base=$TMP_ROOT/wrong-base
# A real worktree at a different commit is a wrong-base fixture.
git -C "$repo" worktree add -q -b wrong-base "$wrong_base" "$base"
printf wrong-base >"$wrong_base/wrong.txt"
git -C "$wrong_base" add wrong.txt
git -C "$wrong_base" commit -qm 'Wrong base fixture'
expect_failure 'worker base SHA differs from current integration head' "$GATE" register-worker \
  --state "$state" --task-id wrong-base --path "$wrong_base" \
  --branch wrong-base --base-sha "$base" --integration-order 3 \
  --scope wrong.txt --check worker-smoke
expect_failure 'worker path or branch identity' "$GATE" register-worker \
  --state "$state" --task-id mismatch --path "$worker_a" \
  --branch worker-b --base-sha "$base" --integration-order 3 \
  --scope mismatch.txt --check worker-smoke
expect_failure 'force cleanup is refused' "$GATE" cleanup-eligible \
  --state "$state" --task-id A --force
printf drift >"$integration/drift.txt"
expect_failure 'integration checkout is dirty' "$GATE" verify-integration --state "$state"

printf '%s\n' 'PASS: isolated worktree conformance fixture'
