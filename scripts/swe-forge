#!/bin/sh

set -eu

PROGRAM=${0##*/}
SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
SOURCE_ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd -P)
RUN_TMP=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge.XXXXXX")
CONFLICTS=0
VERIFY_FAILURES=0
MODE=link
SCOPE=project
TARGET=
TRANSACTION_ACTIVE=0
LOCK_DIR=
LOCK_OWNED=0
STAGE_COUNTER=0
CRITICAL_SECTION=0
PENDING_SIGNAL=0
CREATED_FILES=$RUN_TMP/created-files
CREATED_DIRS=$RUN_TMP/created-dirs
ADAPTER_REGISTRY=$SOURCE_ROOT/.swe-forge/adapters/registry.tsv
ADAPTER_ROWS=$RUN_TMP/adapter-rows
: >"$CREATED_FILES"
: >"$CREATED_DIRS"

rollback() {
  while IFS= read -r created_file; do
    rm -f "$created_file"
  done <"$CREATED_FILES"

  sort -r "$CREATED_DIRS" | while IFS= read -r created_dir; do
    rmdir "$created_dir" 2>/dev/null || true
  done
}

on_exit() {
  status=$1
  trap - 0 HUP INT TERM
  set +e
  if [ "$TRANSACTION_ACTIVE" -eq 1 ] && [ "$status" -ne 0 ]; then
    rollback
  fi
  if [ "$LOCK_OWNED" -eq 1 ]; then
    rmdir "$LOCK_DIR" 2>/dev/null || true
  fi
  rm -rf "$RUN_TMP"
  exit "$status"
}

handle_signal() {
  signal_status=$1
  if [ "$CRITICAL_SECTION" -eq 1 ]; then
    PENDING_SIGNAL=$signal_status
  else
    exit "$signal_status"
  fi
}

begin_create() {
  CRITICAL_SECTION=1
}

end_create() {
  CRITICAL_SECTION=0
  if [ "$PENDING_SIGNAL" -ne 0 ]; then
    signal_status=$PENDING_SIGNAL
    PENDING_SIGNAL=0
    exit "$signal_status"
  fi
}

trap 'handle_signal 129' HUP
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM
trap 'on_exit $?' 0

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

invocation_hint() {
  info 'invoke with: see the selected harness adapter README'
}

usage() {
  cat <<'EOF'
Usage:
  scripts/swe-forge install <harness> [options]
  scripts/swe-forge verify <harness> [options]

Options:
  --target PATH       Install into this repository or folder.
  --global            Install into the harness user-level directories.
  --mode link|copy    Link to this checkout (default) or copy a snapshot.

If --target and --global are omitted, install asks for a target when used from
an interactive terminal. Non-interactive callers must provide one explicitly.
EOF
}

conflict() {
  printf 'conflict: %s\n' "$*" >&2
  CONFLICTS=$((CONFLICTS + 1))
}

verify_failure() {
  printf 'FAIL: %s\n' "$*" >&2
  VERIFY_FAILURES=$((VERIFY_FAILURES + 1))
}

path_exists() {
  [ -e "$1" ] || [ -L "$1" ]
}

reject_unsupported_path() {
  checked_path=$1
  newline='
'
  tab=$(printf '\t')
  case "$checked_path" in
    *"$newline"*|*"$tab"*) die "paths containing tabs or newlines are not supported: $checked_path" ;;
  esac
}

assert_real_ancestors() {
  checked_path=$(dirname "$1")
  while [ "$checked_path" != / ] && [ "$checked_path" != . ]; do
    if [ -L "$checked_path" ]; then
      die "destination path contains a symlinked directory: $checked_path"
    fi
    checked_path=$(dirname "$checked_path")
  done
}

record_file() {
  printf '%s\n' "$1" >>"$CREATED_FILES"
}

record_dir() {
  printf '%s\n' "$1" >>"$CREATED_DIRS"
}

ensure_dir() {
  ensure_current=$1
  assert_real_ancestors "$ensure_current"

  if path_exists "$ensure_current"; then
    [ -d "$ensure_current" ] && [ ! -L "$ensure_current" ] || die "$ensure_current must be a real directory"
    return
  fi

  ensure_parent=$(dirname "$ensure_current")
  [ "$ensure_parent" = "$ensure_current" ] || ensure_dir "$ensure_parent"
  ensure_current=$1
  begin_create
  mkdir "$ensure_current"
  record_dir "$ensure_current"
  end_create
}

acquire_lock() {
  if [ "$SCOPE" = global ]; then
    LOCK_DIR=$HOME/.swe-forge-install.lock
  else
    LOCK_DIR=$TARGET/.swe-forge-install.lock
  fi
  assert_real_ancestors "$LOCK_DIR"
  begin_create
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    end_create
    die "another installation may be active; remove stale lock after review: $LOCK_DIR"
  fi
  LOCK_OWNED=1
  end_create
}

resolve_path() {
  current=$1
  count=0

  while [ -L "$current" ]; do
    count=$((count + 1))
    [ "$count" -lt 40 ] || return 1
    link_target=$(readlink "$current") || return 1
    case "$link_target" in
      /*) current=$link_target ;;
      *) current=$(dirname "$current")/$link_target ;;
    esac
  done

  if [ -d "$current" ]; then
    CDPATH= cd "$current" && pwd -P
  else
    parent=$(CDPATH= cd "$(dirname "$current")" && pwd -P) || return 1
    printf '%s/%s\n' "$parent" "$(basename "$current")"
  fi
}

same_path() {
  first=$(resolve_path "$1") || return 1
  second=$(resolve_path "$2") || return 1
  [ "$first" = "$second" ]
}

prepare_manifests() {
  canonical_files=$RUN_TMP/canonical-files
  canonical_dirs=$RUN_TMP/canonical-dirs

  find "$SOURCE_ROOT/.swe-forge" -type f \
    ! -name '.DS_Store' \
    ! -path "$SOURCE_ROOT/.swe-forge/adapters" \
    ! -path "$SOURCE_ROOT/.swe-forge/adapters/*" \
    ! -path "$SOURCE_ROOT/.swe-forge/runs/*" \
    ! -path "$SOURCE_ROOT/.swe-forge/.runs/*" \
    ! -path "$SOURCE_ROOT/.swe-forge/generated/*" \
    -print >"$canonical_files"

  : >"$canonical_dirs"
  for source_entry in "$SOURCE_ROOT/.swe-forge"/*; do
    [ -d "$source_entry" ] || continue
    entry_name=${source_entry##*/}
    case "$entry_name" in
      adapters|runs|.runs|generated) continue ;;
    esac
    printf '%s\n' "$source_entry" >>"$canonical_dirs"
  done

  : >"$ADAPTER_ROWS"
  while IFS='|' read -r adapter_harness adapter_scope adapter_kind adapter_source_rel adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    [ "$adapter_harness" = "$HARNESS" ] || continue
    printf '%s|%s|%s|%s|%s|%s\n' \
      "$adapter_harness" "$adapter_scope" "$adapter_kind" \
      "$adapter_source_rel" "$adapter_destination_rel" "$adapter_support_rel" \
      >>"$ADAPTER_ROWS"
  done <"$ADAPTER_REGISTRY"
  [ -s "$ADAPTER_ROWS" ] || die "no adapter targets registered for harness: $HARNESS"
}

preflight_container() {
  destination=$1
  assert_real_ancestors "$destination"
  if path_exists "$destination" && { [ ! -d "$destination" ] || [ -L "$destination" ]; }; then
    conflict "$destination must be a real directory"
  fi
}

preflight_file() {
  source=$1
  destination=$2
  assert_real_ancestors "$destination"

  if ! path_exists "$destination"; then
    return
  fi

  if [ "$MODE" = link ] && same_path "$source" "$destination"; then
    return
  fi

  if [ -d "$destination" ] && [ ! -L "$destination" ]; then
    conflict "$destination exists as a directory"
    return
  fi

  if [ -L "$destination" ]; then
    if [ "$MODE" = copy ]; then
      conflict "$destination is a symlink; copy mode requires a regular file"
      return
    fi
    if ! same_path "$source" "$destination"; then
      conflict "$destination is a symlink to a different source"
    fi
    return
  fi

  if [ "$MODE" = link ]; then
    conflict "$destination exists as a regular file; remove it after review or use --mode copy"
    return
  fi

  if ! cmp -s "$source" "$destination"; then
    conflict "$destination differs from the SWE Forge source"
  fi
}

preflight_dir_link() {
  source=$1
  destination=$2
  assert_real_ancestors "$destination"

  if ! path_exists "$destination"; then
    return
  fi

  if same_path "$source" "$destination"; then
    return
  fi

  conflict "$destination already exists and is not linked to the SWE Forge source"
}

preflight_tree_copy() {
  source_root=$1
  destination_root=$2
  tree_files=$RUN_TMP/tree-files

  find "$source_root" -type f -print >"$tree_files"
  while IFS= read -r source_file; do
    relative=${source_file#"$source_root/"}
    preflight_file "$source_file" "$destination_root/$relative"
    if ! path_exists "$destination_root/$relative"; then
      conflict "$destination_root is an existing copied tree missing $relative; replace the snapshot after review"
    fi
  done <"$tree_files"

  if [ -d "$destination_root" ] && [ ! -L "$destination_root" ]; then
    destination_entries=$RUN_TMP/preflight-tree-destination-entries
    find "$destination_root" -print >"$destination_entries"
    while IFS= read -r destination_entry; do
      [ "$destination_entry" != "$destination_root" ] || continue
      relative=${destination_entry#"$destination_root/"}
      source_entry=$source_root/$relative
      if [ -L "$destination_entry" ]; then
        conflict "$destination_entry is a symlink; copy mode requires real entries"
      elif [ -d "$destination_entry" ]; then
        [ -d "$source_entry" ] || conflict "$destination_entry is not managed by the current SWE Forge source"
      elif [ -f "$destination_entry" ]; then
        [ -f "$source_entry" ] || conflict "$destination_entry is not managed by the current SWE Forge source"
      else
        conflict "$destination_entry has an unsupported file type"
      fi
    done <"$destination_entries"
  fi
}

preflight_canonical() {
  destination_root=$1
  existing_copy=0
  if [ "$MODE" = copy ] && {
    path_exists "$destination_root/AGENTS.md" ||
    path_exists "$destination_root/SWE-FORGE.md" ||
    path_exists "$destination_root/.swe-forge"
  }; then
    existing_copy=1
  fi

  preflight_file "$SOURCE_ROOT/AGENTS.md" "$destination_root/AGENTS.md"
  preflight_file "$SOURCE_ROOT/SWE-FORGE.md" "$destination_root/SWE-FORGE.md"
  preflight_container "$destination_root/.swe-forge"
  if [ "$existing_copy" -eq 1 ]; then
    path_exists "$destination_root/AGENTS.md" || \
      conflict "$destination_root is an existing copied snapshot missing AGENTS.md; replace it after review"
    path_exists "$destination_root/SWE-FORGE.md" || \
      conflict "$destination_root is an existing copied snapshot missing SWE-FORGE.md; replace it after review"
  fi

  if [ "$MODE" = link ]; then
    while IFS= read -r source_dir; do
      entry_name=${source_dir##*/}
      preflight_dir_link "$source_dir" "$destination_root/.swe-forge/$entry_name"
    done <"$RUN_TMP/canonical-dirs"
  else
    while IFS= read -r source_file; do
      relative=${source_file#"$SOURCE_ROOT/"}
      preflight_file "$source_file" "$destination_root/$relative"
      if [ "$existing_copy" -eq 1 ] && ! path_exists "$destination_root/$relative"; then
        conflict "$destination_root is an existing copied snapshot missing $relative; replace it after review"
      fi
    done <"$RUN_TMP/canonical-files"

    if [ -d "$destination_root/.swe-forge" ] && [ ! -L "$destination_root/.swe-forge" ]; then
      destination_entries=$RUN_TMP/destination-canonical-entries
      find "$destination_root/.swe-forge" -print >"$destination_entries"
      while IFS= read -r destination_entry; do
        [ "$destination_entry" != "$destination_root/.swe-forge" ] || continue
        relative=${destination_entry#"$destination_root/"}
        case "$relative" in
          .swe-forge/runs|.swe-forge/runs/*|.swe-forge/.runs|.swe-forge/.runs/*|.swe-forge/generated|.swe-forge/generated/*) continue ;;
        esac
        source_entry=$SOURCE_ROOT/$relative
        if [ -L "$destination_entry" ]; then
          conflict "$destination_entry is a symlink; copy mode requires real entries"
        elif [ -d "$destination_entry" ]; then
          [ -d "$source_entry" ] || conflict "$destination_entry is not managed by the current SWE Forge source"
        elif [ -f "$destination_entry" ]; then
          [ -f "$source_entry" ] || conflict "$destination_entry is not managed by the current SWE Forge source"
        else
          conflict "$destination_entry has an unsupported file type"
        fi
      done <"$destination_entries"
    fi
  fi
}

preflight_adapter_tree() {
  source_root=$1
  destination_root=$2

  if [ "$MODE" = link ]; then
    preflight_dir_link "$source_root" "$destination_root"
  else
    if path_exists "$destination_root"; then
      if [ ! -d "$destination_root" ] || [ -L "$destination_root" ]; then
        conflict "$destination_root must be a real directory for copy mode"
      else
        preflight_tree_copy "$source_root" "$destination_root"
      fi
    fi
  fi
}

preflight_bridge() {
  destination=$1
  agents_destination=$2

  if ! path_exists "$destination"; then
    return
  fi

  if same_path "$SOURCE_ROOT/CLAUDE.md" "$destination"; then
    return
  fi

  if [ -L "$destination" ]; then
    if ! same_path "$agents_destination" "$destination"; then
      conflict "$destination is not linked to AGENTS.md"
    fi
    return
  fi

  if [ "$MODE" = link ]; then
    conflict "$destination exists as a regular file; remove it after review or use --mode copy"
    return
  fi

  if ! cmp -s "$RUN_TMP/claude-bridge" "$destination"; then
    conflict "$destination must be the minimal @AGENTS.md bridge or be reviewed manually"
  fi
}

adapter_parent_containers() {
  adapter_base=$1
  adapter_relative=$2
  [ "$adapter_relative" != . ] || return 0

  adapter_old_ifs=$IFS
  IFS=/
  set -- $adapter_relative
  IFS=$adapter_old_ifs
  adapter_current=$adapter_base
  for adapter_part do
    [ -n "$adapter_part" ] || continue
    adapter_current=$adapter_current/$adapter_part
    preflight_container "$adapter_current"
  done
}

adapter_destination() {
  if [ "$SCOPE" = global ]; then
    printf '%s/%s\n' "$HOME" "$1"
  else
    printf '%s/%s\n' "$TARGET" "$1"
  fi
}

adapter_source() {
  printf '%s/.swe-forge/adapters/%s\n' "$SOURCE_ROOT" "$1"
}

adapter_is_registered() {
  adapter_requested=$1
  while IFS='|' read -r adapter_harness adapter_scope adapter_kind adapter_source_rel adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    if [ "$adapter_harness" = "$adapter_requested" ]; then
      return 0
    fi
  done <"$ADAPTER_REGISTRY"
  return 1
}

adapter_supports_scope() {
  adapter_requested_scope=$1
  while IFS='|' read -r adapter_harness adapter_scope adapter_kind adapter_source_rel adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    if [ "$adapter_harness" = "$HARNESS" ] && [ "$adapter_scope" = "$adapter_requested_scope" ]; then
      return 0
    fi
  done <"$ADAPTER_REGISTRY"
  return 1
}

preflight_adapter_support() {
  adapter_support=$1
  [ "$adapter_support" != - ] || return 0
  adapter_support_path=$(adapter_destination "$adapter_support")
  adapter_parent_containers \
    "$HOME" \
    "$(dirname "$adapter_support")"
  preflight_canonical "$adapter_support_path"
}

preflight_adapter_artifact() {
  adapter_kind=$1
  adapter_source_path=$2
  adapter_destination_path=$3
  adapter_destination_rel=$4

  if [ "$SCOPE" = global ]; then
    adapter_parent_base=$HOME
  else
    adapter_parent_base=$TARGET
  fi
  adapter_parent_containers \
    "$adapter_parent_base" \
    "$(dirname "$adapter_destination_rel")"

  case "$adapter_kind" in
    file) preflight_file "$adapter_source_path" "$adapter_destination_path" ;;
    tree) preflight_adapter_tree "$adapter_source_path" "$adapter_destination_path" ;;
    bridge) preflight_bridge "$adapter_destination_path" "$TARGET/AGENTS.md" ;;
    *) die "unsupported adapter artifact kind: $adapter_kind" ;;
  esac
}

preflight_install() {
  CONFLICTS=0

  if [ "$SCOPE" != global ]; then
    preflight_canonical "$TARGET"
  fi

  while IFS='|' read -r adapter_harness adapter_scope adapter_kind adapter_source_rel adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    [ "$adapter_scope" = "$SCOPE" ] || continue

    adapter_source_path=$(adapter_source "$adapter_source_rel")
    adapter_destination_path=$(adapter_destination "$adapter_destination_rel")
    if [ "$SCOPE" = global ]; then
      preflight_adapter_support "$adapter_support_rel"
    fi
    preflight_adapter_artifact \
      "$adapter_kind" \
      "$adapter_source_path" \
      "$adapter_destination_path" \
      "$adapter_destination_rel"
  done <"$ADAPTER_ROWS"

  [ "$CONFLICTS" -eq 0 ] || die "installation stopped before writing; review the conflicts above"
}

install_file() {
  source=$1
  destination=$2

  path_exists "$destination" && return
  assert_real_ancestors "$destination"
  ensure_dir "$(dirname "$destination")"
  if [ "$MODE" = link ]; then
    begin_create
    if ! ln -s "$source" "$destination"; then
      end_create
      die "could not install source link: $destination"
    fi
    record_file "$destination"
    end_create
  else
    STAGE_COUNTER=$((STAGE_COUNTER + 1))
    stage_dir=$(dirname "$destination")/.swe-forge-stage.$$.$STAGE_COUNTER
    begin_create
    mkdir "$stage_dir" || die "could not create staging directory: $stage_dir"
    record_dir "$stage_dir"
    end_create
    begin_create
    record_file "$stage_dir/file"
    if ! cp "$source" "$stage_dir/file"; then
      end_create
      die "could not stage copied file: $destination"
    fi
    end_create
    begin_create
    if ! ln "$stage_dir/file" "$destination"; then
      end_create
      die "destination appeared during installation: $destination"
    fi
    record_file "$destination"
    end_create
    rm -f "$stage_dir/file"
    rmdir "$stage_dir"
  fi
}

install_dir_container() {
  destination=$1
  ensure_dir "$destination"
}

install_dir_link() {
  source=$1
  destination=$2

  path_exists "$destination" && return
  assert_real_ancestors "$destination"
  ensure_dir "$(dirname "$destination")"
  begin_create
  if ! ln -s "$source" "$destination"; then
    end_create
    die "could not install source directory link: $destination"
  fi
  record_file "$destination"
  end_create
}

install_tree() {
  source_root=$1
  destination_root=$2
  tree_files=$RUN_TMP/tree-files

  if [ "$MODE" = link ]; then
    install_dir_link "$source_root" "$destination_root"
    return
  fi

  install_dir_container "$destination_root"
  find "$source_root" -type f -print >"$tree_files"
  while IFS= read -r source_file; do
    relative=${source_file#"$source_root/"}
    install_file "$source_file" "$destination_root/$relative"
  done <"$tree_files"
}

install_canonical() {
  destination_root=$1

  install_file "$SOURCE_ROOT/AGENTS.md" "$destination_root/AGENTS.md"
  install_file "$SOURCE_ROOT/SWE-FORGE.md" "$destination_root/SWE-FORGE.md"
  install_dir_container "$destination_root/.swe-forge"

  if [ "$MODE" = link ]; then
    while IFS= read -r source_dir; do
      entry_name=${source_dir##*/}
      install_dir_link "$source_dir" "$destination_root/.swe-forge/$entry_name"
    done <"$RUN_TMP/canonical-dirs"
  else
    while IFS= read -r source_file; do
      relative=${source_file#"$SOURCE_ROOT/"}
      install_file "$source_file" "$destination_root/$relative"
    done <"$RUN_TMP/canonical-files"
  fi
}

install_bridge() {
  destination=$1

  path_exists "$destination" && return
  assert_real_ancestors "$destination"
  ensure_dir "$(dirname "$destination")"
  if [ "$MODE" = link ]; then
    begin_create
    if ! ln -s AGENTS.md "$destination"; then
      end_create
      die "could not install CLAUDE.md bridge: $destination"
    fi
    record_file "$destination"
    end_create
  else
    install_file "$RUN_TMP/claude-bridge" "$destination"
  fi
}

install_adapter_artifact() {
  adapter_kind=$1
  adapter_source_path=$2
  adapter_destination_path=$3

  case "$adapter_kind" in
    file) install_file "$adapter_source_path" "$adapter_destination_path" ;;
    tree) install_tree "$adapter_source_path" "$adapter_destination_path" ;;
    bridge) install_bridge "$adapter_destination_path" ;;
    *) die "unsupported adapter artifact kind: $adapter_kind" ;;
  esac
}

install_requested() {
  if [ "$SCOPE" != global ]; then
    install_canonical "$TARGET"
  fi

  while IFS='|' read -r adapter_harness adapter_scope adapter_kind adapter_source_rel adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    [ "$adapter_scope" = "$SCOPE" ] || continue

    if [ "$SCOPE" = global ] && [ "$adapter_support_rel" != - ]; then
      install_canonical "$(adapter_destination "$adapter_support_rel")"
    fi
    install_adapter_artifact \
      "$adapter_kind" \
      "$(adapter_source "$adapter_source_rel")" \
      "$(adapter_destination "$adapter_destination_rel")"
  done <"$ADAPTER_ROWS"
}

verify_file() {
  source=$1
  destination=$2

  if ! path_exists "$destination"; then
    verify_failure "$destination is missing"
    return
  fi
  if [ "$MODE" = link ]; then
    if [ ! -L "$destination" ]; then
      verify_failure "$destination is not a source link"
    elif ! same_path "$source" "$destination"; then
      verify_failure "$destination does not link to the current SWE Forge source"
    fi
  else
    if [ ! -f "$destination" ] || [ -L "$destination" ]; then
      verify_failure "$destination is not a regular copied file"
    elif ! cmp -s "$source" "$destination"; then
      verify_failure "$destination does not match the current SWE Forge source"
    fi
  fi
}

verify_content_file() {
  source=$1
  destination=$2
  if [ ! -f "$destination" ] || ! cmp -s "$source" "$destination"; then
    verify_failure "$destination does not match the current SWE Forge source"
  fi
}

verify_dir_mapping() {
  source=$1
  destination=$2
  if [ "$MODE" = link ]; then
    if [ ! -L "$destination" ]; then
      verify_failure "$destination is not a source directory link"
    elif ! same_path "$source" "$destination"; then
      verify_failure "$destination does not link to the current SWE Forge source"
    fi
  elif [ ! -d "$destination" ] || [ -L "$destination" ]; then
    verify_failure "$destination is not a real copied directory"
  fi
}

verify_tree() {
  source_root=$1
  destination_root=$2
  tree_files=$RUN_TMP/verify-tree-files

  verify_dir_mapping "$source_root" "$destination_root"
  if [ "$MODE" = link ]; then
    return
  fi

  find "$source_root" -type f -print >"$tree_files"
  while IFS= read -r source_file; do
    relative=${source_file#"$source_root/"}
    verify_file "$source_file" "$destination_root/$relative"
  done <"$tree_files"

  destination_entries=$RUN_TMP/verify-tree-destination-entries
  find "$destination_root" -print >"$destination_entries"
  while IFS= read -r destination_entry; do
    [ "$destination_entry" != "$destination_root" ] || continue
    relative=${destination_entry#"$destination_root/"}
    source_entry=$source_root/$relative
    if [ -L "$destination_entry" ]; then
      verify_failure "$destination_entry is a symlink; copy mode requires real entries"
    elif [ -d "$destination_entry" ]; then
      [ -d "$source_entry" ] || verify_failure "$destination_entry is not managed by the current SWE Forge source"
    elif [ -f "$destination_entry" ]; then
      [ -f "$source_entry" ] || verify_failure "$destination_entry is not managed by the current SWE Forge source"
    else
      verify_failure "$destination_entry has an unsupported file type"
    fi
  done <"$destination_entries"
}

verify_canonical() {
  destination_root=$1

  verify_file "$SOURCE_ROOT/AGENTS.md" "$destination_root/AGENTS.md"
  verify_file "$SOURCE_ROOT/SWE-FORGE.md" "$destination_root/SWE-FORGE.md"

  if ! path_exists "$destination_root/.swe-forge" || [ ! -d "$destination_root/.swe-forge" ]; then
    verify_failure "$destination_root/.swe-forge is missing"
    return
  fi
  if [ -L "$destination_root/.swe-forge" ]; then
    verify_failure "$destination_root/.swe-forge must be a real directory"
    return
  fi

  if [ "$MODE" = link ]; then
    while IFS= read -r source_dir; do
      entry_name=${source_dir##*/}
      verify_dir_mapping "$source_dir" "$destination_root/.swe-forge/$entry_name"
    done <"$RUN_TMP/canonical-dirs"

    while IFS= read -r source_file; do
      relative=${source_file#"$SOURCE_ROOT/"}
      verify_content_file "$source_file" "$destination_root/$relative"
    done <"$RUN_TMP/canonical-files"
  else
    while IFS= read -r source_file; do
      relative=${source_file#"$SOURCE_ROOT/"}
      verify_file "$source_file" "$destination_root/$relative"
    done <"$RUN_TMP/canonical-files"

    destination_entries=$RUN_TMP/verify-destination-canonical-entries
    find "$destination_root/.swe-forge" -print >"$destination_entries"
    while IFS= read -r destination_entry; do
      [ "$destination_entry" != "$destination_root/.swe-forge" ] || continue
      relative=${destination_entry#"$destination_root/"}
      case "$relative" in
        .swe-forge/runs|.swe-forge/runs/*|.swe-forge/.runs|.swe-forge/.runs/*|.swe-forge/generated|.swe-forge/generated/*) continue ;;
      esac
      source_entry=$SOURCE_ROOT/$relative
      if [ -L "$destination_entry" ]; then
        verify_failure "$destination_entry is a symlink; copy mode requires real entries"
      elif [ -d "$destination_entry" ]; then
        [ -d "$source_entry" ] || verify_failure "$destination_entry is not managed by the current SWE Forge source"
      elif [ -f "$destination_entry" ]; then
        [ -f "$source_entry" ] || verify_failure "$destination_entry is not managed by the current SWE Forge source"
      else
        verify_failure "$destination_entry has an unsupported file type"
      fi
    done <"$destination_entries"
  fi
}

verify_bridge() {
  destination=$1
  agents_destination=$2

  if ! path_exists "$destination"; then
    verify_failure "$destination is missing"
    return
  fi

  if [ "$MODE" = link ]; then
    if [ ! -L "$destination" ]; then
      verify_failure "$destination is not linked to AGENTS.md"
    elif ! same_path "$agents_destination" "$destination"; then
      verify_failure "$destination is not linked to AGENTS.md"
    fi
  elif [ ! -f "$destination" ] || [ -L "$destination" ]; then
    verify_failure "$destination is not a regular copied bridge"
  elif ! cmp -s "$RUN_TMP/claude-bridge" "$destination"; then
    verify_failure "$destination is not the minimal @AGENTS.md bridge"
  fi
}

verify_adapter_artifact() {
  adapter_kind=$1
  adapter_source_path=$2
  adapter_destination_path=$3

  case "$adapter_kind" in
    file) verify_file "$adapter_source_path" "$adapter_destination_path" ;;
    tree) verify_tree "$adapter_source_path" "$adapter_destination_path" ;;
    bridge) verify_bridge "$adapter_destination_path" "$TARGET/AGENTS.md" ;;
    *) die "unsupported adapter artifact kind: $adapter_kind" ;;
  esac
}

verify_requested() {
  VERIFY_FAILURES=0

  if [ "$SCOPE" != global ]; then
    verify_canonical "$TARGET"
  fi

  while IFS='|' read -r adapter_harness adapter_scope adapter_kind adapter_source_rel adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    [ "$adapter_scope" = "$SCOPE" ] || continue

    if [ "$SCOPE" = global ] && [ "$adapter_support_rel" != - ]; then
      verify_canonical "$(adapter_destination "$adapter_support_rel")"
    fi
    verify_adapter_artifact \
      "$adapter_kind" \
      "$(adapter_source "$adapter_source_rel")" \
      "$(adapter_destination "$adapter_destination_rel")"
  done <"$ADAPTER_ROWS"

  if [ "$VERIFY_FAILURES" -ne 0 ]; then
    return 1
  fi

  info "PASS: SWE Forge $HARNESS installation is valid"
}

choose_destination() {
  if [ "$SCOPE" = global ]; then
    [ -z "$TARGET" ] || die "--target cannot be combined with --global"
    return
  fi

  if [ -z "$TARGET" ]; then
    if [ ! -t 0 ]; then
      die "no target supplied; use --target PATH or --global"
    fi
    printf 'Install SWE Forge into a repository/folder, or type global: '
    IFS= read -r TARGET || die "no installation target supplied"
    case "$TARGET" in
      global|globally)
        TARGET=
        SCOPE=global
        return
        ;;
      '')
        die "no installation target supplied"
        ;;
    esac
  fi

  [ -d "$TARGET" ] || die "target directory does not exist: $TARGET"
  reject_unsupported_path "$TARGET"
  case "$TARGET" in
    /*) ;;
    *) TARGET=$PWD/$TARGET ;;
  esac
  [ ! -L "$TARGET" ] || die "target directory must not be a symlink: $TARGET"
  assert_real_ancestors "$TARGET/child"
  TARGET=$(CDPATH= cd "$TARGET" && pwd -P)
}

validate_scope() {
  if [ "$SCOPE" != global ]; then
    return
  fi

  [ -n "${HOME:-}" ] || die "HOME must be set for --global"
  case "$HOME" in
    /*) ;;
    *) die "HOME must be an absolute path for --global" ;;
  esac
  reject_unsupported_path "$HOME"
  [ -d "$HOME" ] && [ ! -L "$HOME" ] || die "HOME must be a real directory for --global: $HOME"
  assert_real_ancestors "$HOME/child"
  HOME=$(CDPATH= cd "$HOME" && pwd -P)
  [ "$MODE" = link ] || die "--mode copy is not supported with --global"
}

validate_harness_scope() {
  adapter_supports_scope "$SCOPE" || \
    die "$HARNESS installation does not support $SCOPE scope"
}

parse_args() {
  SEEN_TARGET=0
  SEEN_GLOBAL=0
  SEEN_MODE=0
  if [ "$#" -eq 1 ] && { [ "$1" = -h ] || [ "$1" = --help ]; }; then
    usage
    exit 0
  fi

  [ "$#" -ge 2 ] || {
    usage >&2
    exit 2
  }

  ACTION=$1
  HARNESS=$2
  shift 2

  case "$ACTION" in
    install|verify) ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown action: $ACTION" ;;
  esac

  [ "$HARNESS" != claude-code ] || HARNESS=claude
  adapter_is_registered "$HARNESS" || \
    die "unsupported harness: $HARNESS (see .swe-forge/adapters/registry.tsv)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        [ "$#" -ge 2 ] || die "--target requires a path"
        [ "$SEEN_TARGET" -eq 0 ] || die "target supplied more than once"
        [ -n "$2" ] || die "--target requires a non-empty path"
        SEEN_TARGET=1
        TARGET=$2
        shift 2
        ;;
      --global)
        [ "$SEEN_GLOBAL" -eq 0 ] || die "global scope supplied more than once"
        SEEN_GLOBAL=1
        SCOPE=global
        shift
        ;;
      --mode)
        [ "$#" -ge 2 ] || die "--mode requires link or copy"
        [ "$SEEN_MODE" -eq 0 ] || die "--mode supplied more than once"
        SEEN_MODE=1
        MODE=$2
        case "$MODE" in
          link|copy) ;;
          *) die "unsupported mode: $MODE (use link or copy)" ;;
        esac
        shift 2
        ;;
      global|globally)
        [ "$SEEN_GLOBAL" -eq 0 ] || die "global scope supplied more than once"
        SEEN_GLOBAL=1
        SCOPE=global
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        [ "$SEEN_TARGET" -eq 0 ] || die "target supplied more than once"
        SEEN_TARGET=1
        TARGET=$1
        shift
        ;;
    esac
  done
}

main() {
  parse_args "$@"
  prepare_manifests
  printf '%s\n' '@AGENTS.md' >"$RUN_TMP/claude-bridge"
  choose_destination
  validate_scope
  validate_harness_scope

  if [ "$ACTION" = install ]; then
    acquire_lock
    preflight_install
    TRANSACTION_ACTIVE=1
    install_requested
    if verify_requested; then
      TRANSACTION_ACTIVE=0
      info "source: $SOURCE_ROOT"
      if [ "$SCOPE" = global ]; then
        info "scope: global harness configuration"
      else
        info "target: $TARGET"
      fi
      info "mode: $MODE"
      invocation_hint
    else
      die "installation completed but verification failed"
    fi
  else
    verify_requested || die "verification failed"
  fi
}

main "$@"
