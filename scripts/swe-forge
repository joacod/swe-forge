#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
SOURCE_ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd -P)
RUN_TMP=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge.XXXXXX")
CONFLICTS=0
VERIFY_FAILURES=0
DRY_RUN=0
MANIFEST_BASE=
MANIFEST_DIR=
MANIFEST_PATH=
MANIFEST_ENTRIES=
MANIFEST_BACKUP=
MANIFEST_WAS_EXISTING=0
REMOVED_LINKS=
TRANSACTION_ACTIVE=0
LOCK_DIR=
LOCK_OWNED=0
CRITICAL_SECTION=0
PENDING_SIGNAL=0
CREATED_FILES=$RUN_TMP/created-files
CREATED_DIRS=$RUN_TMP/created-dirs
REMOVED_LINKS=$RUN_TMP/removed-links
: >"$CREATED_FILES"
: >"$CREATED_DIRS"
: >"$REMOVED_LINKS"
ADAPTER_REGISTRY=$SOURCE_ROOT/.swe-forge/adapters/registry.tsv
REGISTRY_VALIDATOR=$SOURCE_ROOT/scripts/lib/registry.sh
ADAPTER_ROWS=$RUN_TMP/adapter-rows

rollback() {
  while IFS= read -r created_file; do
    rm -f "$created_file"
  done <"$CREATED_FILES"

  while IFS="$(printf '\t')" read -r removed_path removed_target; do
    [ -n "${removed_path:-}" ] || continue
    [ -e "$removed_path" ] || ln -s "$removed_target" "$removed_path" 2>/dev/null || true
  done <"$REMOVED_LINKS"

  if [ -n "$MANIFEST_PATH" ]; then
    if [ "$MANIFEST_WAS_EXISTING" -eq 1 ] && [ -f "$MANIFEST_BACKUP" ]; then
      cp -p "$MANIFEST_BACKUP" "$MANIFEST_PATH" 2>/dev/null || true
    elif [ "$MANIFEST_WAS_EXISTING" -eq 0 ]; then
      rm -f "$MANIFEST_PATH"
    fi
  fi

  sort -r "$CREATED_DIRS" | while IFS= read -r created_dir; do
    rmdir "$created_dir" 2>/dev/null || true
  done
}

on_exit() {
  status=$1
  trap - 0 HUP INT TERM
  set +e
  if [ "$TRANSACTION_ACTIVE" -eq 1 ] && [ "$status" -ne 0 ]; then
    rollback
  fi
  if [ "$LOCK_OWNED" -eq 1 ]; then
    rmdir "$LOCK_DIR" 2>/dev/null || true
  fi
  rm -rf "$RUN_TMP"
  exit "$status"
}

handle_signal() {
  signal_status=$1
  if [ "$CRITICAL_SECTION" -eq 1 ]; then
    PENDING_SIGNAL=$signal_status
  else
    exit "$signal_status"
  fi
}

begin_create() {
  CRITICAL_SECTION=1
}

end_create() {
  CRITICAL_SECTION=0
  if [ "$PENDING_SIGNAL" -ne 0 ]; then
    signal_status=$PENDING_SIGNAL
    PENDING_SIGNAL=0
    exit "$signal_status"
  fi
}

trap 'handle_signal 129' HUP
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM
trap 'on_exit $?' 0

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

[ -f "$REGISTRY_VALIDATOR" ] || die "missing adapter registry validator: $REGISTRY_VALIDATOR"
. "$REGISTRY_VALIDATOR"

info() {
  printf '%s\n' "$*"
}

invocation_hint() {
  info 'invoke with: see the selected harness adapter README'
}

source_version() {
  if [ -f "$SOURCE_ROOT/VERSION" ]; then
    IFS= read -r source_version_value <"$SOURCE_ROOT/VERSION" || true
    [ -n "${source_version_value:-}" ] || source_version_value=unknown
    printf '%s\n' "$source_version_value"
  else
    printf '%s\n' unknown
  fi
}

source_commit() {
  git -C "$SOURCE_ROOT" rev-parse --short HEAD 2>/dev/null || printf '%s\n' unknown
}

source_tree_state() {
  if git -C "$SOURCE_ROOT" diff --quiet --ignore-submodules -- 2>/dev/null &&
    [ -z "$(git -C "$SOURCE_ROOT" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ]; then
    printf '%s\n' clean
  else
    printf '%s\n' dirty
  fi
}

manifest_set_paths() {
  MANIFEST_BASE=$HOME
  MANIFEST_DIR=$MANIFEST_BASE/.swe-forge-install-state
  MANIFEST_PATH=$MANIFEST_DIR/$HARNESS.tsv
  assert_real_ancestors "$MANIFEST_DIR/manifest"
  if path_exists "$MANIFEST_DIR" && {
    [ ! -d "$MANIFEST_DIR" ] || [ -L "$MANIFEST_DIR" ];
  }; then
    die "managed installation state must be a real directory: $MANIFEST_DIR"
  fi
}

manifest_relative_path() {
  manifest_absolute_path=$1
  case "$manifest_absolute_path" in
    "$MANIFEST_BASE"/*) printf '%s\n' "${manifest_absolute_path#"$MANIFEST_BASE"/}" ;;
    *) die "managed path escapes user home: $manifest_absolute_path" ;;
  esac
}

manifest_add() {
  manifest_kind=$1
  manifest_destination=$2
  manifest_source=$3
  manifest_link_target=$4
  reject_unsupported_path "$manifest_destination"
  reject_unsupported_path "$manifest_source"
  manifest_relative=$(manifest_relative_path "$manifest_destination")
  printf 'entry\t%s\t%s\t%s\t%s\n' \
    "$manifest_kind" "$manifest_relative" "$manifest_source" \
    "$manifest_link_target" >>"$MANIFEST_ENTRIES"
}

manifest_add_file() {
  manifest_source=$1
  manifest_destination=$2
  manifest_add file "$manifest_destination" "$manifest_source" "$manifest_source"
}

manifest_add_directory_link() {
  manifest_source=$1
  manifest_destination=$2
  manifest_add dir "$manifest_destination" "$manifest_source" "$manifest_source"
}

manifest_support_relative() {
  while IFS='|' read -r manifest_harness manifest_kind \
    manifest_source manifest_destination manifest_support; do
    case "$manifest_harness" in ''|\#*) continue ;; esac
    if [ "$manifest_support" != - ]; then
      printf '%s\n' "$manifest_support"
      return 0
    fi
  done <"$ADAPTER_ROWS"
  return 1
}

build_manifest_inventory() {
  MANIFEST_ENTRIES=$RUN_TMP/manifest-entries
  : >"$MANIFEST_ENTRIES"

  manifest_support=$(manifest_support_relative) || \
    die "adapter is missing a canonical support path"
  canonical_destination_root=$(adapter_destination "$manifest_support")

  manifest_add_file "$SOURCE_ROOT/AGENTS.md" "$canonical_destination_root/AGENTS.md"
  manifest_add_file "$SOURCE_ROOT/SWE-FORGE.md" "$canonical_destination_root/SWE-FORGE.md"
  manifest_add_file "$SOURCE_ROOT/VERSION" "$canonical_destination_root/VERSION"
  while IFS= read -r manifest_source_dir; do
    manifest_entry_name=${manifest_source_dir##*/}
    manifest_add_directory_link "$manifest_source_dir" \
      "$canonical_destination_root/.swe-forge/$manifest_entry_name"
  done <"$RUN_TMP/canonical-dirs"

  while IFS='|' read -r manifest_harness manifest_kind \
    manifest_source manifest_destination manifest_support; do
    case "$manifest_harness" in ''|\#*) continue ;; esac
    manifest_source_path=$(adapter_source "$manifest_source")
    manifest_destination_path=$(adapter_destination "$manifest_destination")
    case "$manifest_kind" in
      file) manifest_add_file "$manifest_source_path" "$manifest_destination_path" ;;
      tree) manifest_add_directory_link "$manifest_source_path" "$manifest_destination_path" ;;
      *) die "unsupported adapter artifact kind: $manifest_kind" ;;
    esac
  done <"$ADAPTER_ROWS"
}

manifest_meta() {
  manifest_meta_key=$1
  manifest_meta_file=$2
  awk -F= -v wanted="$manifest_meta_key" \
    '$1 == wanted { sub(/^[^=]*=/, ""); print; exit }' "$manifest_meta_file"
}

manifest_entry_field() {
  manifest_entry_relative=$1
  manifest_entry_field_number=$2
  awk -F '\t' -v wanted="$manifest_entry_relative" \
    -v field="$manifest_entry_field_number" \
    '$1 == "entry" && $3 == wanted { print $field; exit }' "$MANIFEST_PATH"
}

validate_manifest() {
  [ -f "$MANIFEST_PATH" ] && [ ! -L "$MANIFEST_PATH" ] || \
    die "managed installation manifest is missing or not a regular file: $MANIFEST_PATH"
  [ "$(manifest_meta manifest_version "$MANIFEST_PATH")" = 2 ] || \
    die "unsupported managed installation manifest: $MANIFEST_PATH"
  [ "$(manifest_meta harness "$MANIFEST_PATH")" = "$HARNESS" ] || \
    die "managed installation manifest belongs to another harness"
  [ "$(manifest_meta base "$MANIFEST_PATH")" = "$MANIFEST_BASE" ] || \
    die "managed installation manifest base does not match user home"

  manifest_entries_found=0
  while IFS="$(printf '\t')" read -r manifest_marker manifest_kind \
    manifest_relative manifest_source manifest_link_target; do
    [ "${manifest_marker:-}" = entry ] || continue
    manifest_entries_found=$((manifest_entries_found + 1))
    case "$manifest_kind" in file|dir) ;; *) die "managed manifest has an invalid entry kind" ;; esac
    case "$manifest_relative" in
      ''|/*|..|../*|*/..|*/../*|.|./*|*/./*) die "managed manifest path is unsafe: $manifest_relative" ;;
    esac
    manifest_destination=$MANIFEST_BASE/$manifest_relative
    assert_real_ancestors "$manifest_destination"
    [ -n "${manifest_link_target:-}" ] || \
      die "managed link entry has no target"
  done <"$MANIFEST_PATH"
  [ "$manifest_entries_found" -gt 0 ] || die "managed installation manifest has no entries"
}

load_manifest() {
  manifest_set_paths
  if path_exists "$MANIFEST_PATH"; then
    validate_manifest
  elif [ "$ACTION" = update ] || [ "$ACTION" = uninstall ]; then
    die "no managed installation manifest found; refusing destructive $ACTION"
  fi
}

manifest_write() {
  manifest_set_paths
  if path_exists "$MANIFEST_PATH"; then
    [ -f "$MANIFEST_PATH" ] && [ ! -L "$MANIFEST_PATH" ] || \
      die "managed installation manifest is not a regular file: $MANIFEST_PATH"
    MANIFEST_WAS_EXISTING=1
    MANIFEST_BACKUP=$RUN_TMP/manifest-backup
    cp -p "$MANIFEST_PATH" "$MANIFEST_BACKUP" || \
      die "could not back up managed installation manifest"
  else
    MANIFEST_WAS_EXISTING=0
  fi
  ensure_dir "$MANIFEST_DIR"
  manifest_tmp=$MANIFEST_PATH.tmp.$$
  begin_create
  {
    printf 'manifest_version=2\n'
    printf 'source_root=%s\n' "$SOURCE_ROOT"
    printf 'source_version=%s\n' "$(source_version)"
    printf 'source_commit=%s\n' "$(source_commit)"
    printf 'harness=%s\n' "$HARNESS"
    printf 'base=%s\n' "$MANIFEST_BASE"
    printf 'updated_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    while IFS="$(printf '\t')" read -r manifest_marker manifest_kind \
      manifest_relative manifest_source manifest_link_target; do
      [ "${manifest_marker:-}" = entry ] || continue
      manifest_destination=$MANIFEST_BASE/$manifest_relative
      [ -L "$manifest_destination" ] || \
        die "managed link disappeared before manifest write: $manifest_destination"
      manifest_link_target=$(readlink "$manifest_destination")
      printf 'entry\t%s\t%s\t%s\t%s\n' \
        "$manifest_kind" "$manifest_relative" "$manifest_source" \
        "$manifest_link_target"
    done <"$MANIFEST_ENTRIES"
  } >"$manifest_tmp" || {
    end_create
    rm -f "$manifest_tmp"
    die "could not write managed installation manifest"
  }
  printf '%s\n' "$manifest_tmp" >>"$CREATED_FILES"
  end_create
  begin_create
  if ! mv "$manifest_tmp" "$MANIFEST_PATH"; then
    end_create
    die "could not publish managed installation manifest: $MANIFEST_PATH"
  fi
  end_create
}

record_removed_link() {
  removed_link_path=$1
  removed_link_target=$(readlink "$removed_link_path")
  printf '%s\t%s\n' "$removed_link_path" "$removed_link_target" >>"$REMOVED_LINKS"
}

print_version() {
  info "SWE Forge version: $(source_version)"
  info "source: $SOURCE_ROOT"
  info "commit: $(source_commit)"
  info "worktree: $(source_tree_state)"
}

usage() {
  cat <<'EOF'
Usage:
  scripts/swe-forge version
  scripts/swe-forge install <harness> [options]
  scripts/swe-forge verify <harness>
  scripts/swe-forge status <harness>
  scripts/swe-forge doctor <harness>
  scripts/swe-forge update <harness> [options]
  scripts/swe-forge uninstall <harness>

Options:
  --dry-run           Plan install/update without writing anything.

Installations link the selected harness projection and canonical support tree
back to this SWE Forge checkout under the user's home directory.
EOF
}

conflict() {
  printf 'conflict: %s\n' "$*" >&2
  CONFLICTS=$((CONFLICTS + 1))
}

verify_failure() {
  printf 'FAIL: %s\n' "$*" >&2
  VERIFY_FAILURES=$((VERIFY_FAILURES + 1))
}

path_exists() {
  [ -e "$1" ] || [ -L "$1" ]
}

reject_unsupported_path() {
  checked_path=$1
  newline='
'
  tab=$(printf '\t')
  case "$checked_path" in
    *"$newline"*|*"$tab"*) die "paths containing tabs or newlines are not supported: $checked_path" ;;
  esac
}

assert_real_ancestors() {
  checked_path=$(dirname "$1")
  while [ "$checked_path" != / ] && [ "$checked_path" != . ]; do
    if [ -L "$checked_path" ]; then
      die "destination path contains a symlinked directory: $checked_path"
    fi
    checked_path=$(dirname "$checked_path")
  done
}

record_file() {
  printf '%s\n' "$1" >>"$CREATED_FILES"
}

record_dir() {
  printf '%s\n' "$1" >>"$CREATED_DIRS"
}

ensure_dir() {
  ensure_target=$1
  assert_real_ancestors "$ensure_target"
  case "$ensure_target" in
    "$HOME") return 0 ;;
    "$HOME"/*) ensure_relative=${ensure_target#"$HOME"/} ;;
    *) die "managed directory escapes user home: $ensure_target" ;;
  esac

  ensure_current=$HOME
  ensure_old_ifs=$IFS
  IFS=/
  set -- $ensure_relative
  IFS=$ensure_old_ifs
  for ensure_part do
    [ -n "$ensure_part" ] || continue
    ensure_current=$ensure_current/$ensure_part
    if path_exists "$ensure_current"; then
      [ -d "$ensure_current" ] && [ ! -L "$ensure_current" ] || \
        die "$ensure_current must be a real directory"
      continue
    fi
    begin_create
    mkdir "$ensure_current"
    record_dir "$ensure_current"
    end_create
  done
}

acquire_lock() {
  LOCK_DIR=$HOME/.swe-forge-install.lock
  assert_real_ancestors "$LOCK_DIR"
  begin_create
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    end_create
    die "another installation may be active; remove stale lock after review: $LOCK_DIR"
  fi
  LOCK_OWNED=1
  end_create
}

resolve_path() {
  current=$1
  count=0

  while [ -L "$current" ]; do
    count=$((count + 1))
    [ "$count" -lt 40 ] || return 1
    link_target=$(readlink "$current") || return 1
    case "$link_target" in
      /*) current=$link_target ;;
      *) current=$(dirname "$current")/$link_target ;;
    esac
  done

  if [ -d "$current" ]; then
    CDPATH= cd "$current" && pwd -P
  else
    parent=$(CDPATH= cd "$(dirname "$current")" && pwd -P) || return 1
    printf '%s/%s\n' "$parent" "$(basename "$current")"
  fi
}

same_path() {
  first=$(resolve_path "$1") || return 1
  second=$(resolve_path "$2") || return 1
  [ "$first" = "$second" ]
}

validate_registry_row() {
  registry_line_number=$1
  registry_harness=$2
  registry_kind=$3
  registry_source_rel=$4
  registry_destination_rel=$5
  registry_support_rel=$6

  if ! swe_forge_registry_row_is_valid \
    "$registry_harness" \
    "$registry_kind" \
    "$registry_source_rel" \
    "$registry_destination_rel" \
    "$registry_support_rel"; then
    die "invalid adapter registry row at line $registry_line_number"
  fi

  case "$registry_kind" in
    file|tree)
      registry_source_path=$SOURCE_ROOT/.swe-forge/adapters/$registry_source_rel
      if [ "$registry_kind" = file ]; then
        [ -f "$registry_source_path" ] || \
          die "adapter registry file source is missing at line $registry_line_number: $registry_source_rel"
      else
        [ -d "$registry_source_path" ] || \
          die "adapter registry tree source is missing at line $registry_line_number: $registry_source_rel"
      fi
      ;;
  esac
}

prepare_manifests() {
  canonical_dirs=$RUN_TMP/canonical-dirs
  : >"$canonical_dirs"
  for source_entry in "$SOURCE_ROOT/.swe-forge"/*; do
    [ -d "$source_entry" ] || continue
    entry_name=${source_entry##*/}
    case "$entry_name" in
      adapters|runs|.runs|generated) continue ;;
    esac
    printf '%s\n' "$source_entry" >>"$canonical_dirs"
  done

  : >"$ADAPTER_ROWS"
  registry_line_number=0
  while IFS='|' read -r adapter_harness adapter_kind adapter_source_rel \
    adapter_destination_rel adapter_support_rel; do
    registry_line_number=$((registry_line_number + 1))
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    validate_registry_row \
      "$registry_line_number" \
      "$adapter_harness" \
      "$adapter_kind" \
      "$adapter_source_rel" \
      "$adapter_destination_rel" \
      "$adapter_support_rel"
    [ "$adapter_harness" = "$HARNESS" ] || continue
    printf '%s|%s|%s|%s|%s\n' \
      "$adapter_harness" "$adapter_kind" "$adapter_source_rel" \
      "$adapter_destination_rel" "$adapter_support_rel" >>"$ADAPTER_ROWS"
  done <"$ADAPTER_REGISTRY"
  [ -s "$ADAPTER_ROWS" ] || die "no adapter targets registered for harness: $HARNESS"
}

preflight_container() {
  destination=$1
  assert_real_ancestors "$destination"
  if path_exists "$destination" && { [ ! -d "$destination" ] || [ -L "$destination" ]; }; then
    conflict "$destination must be a real directory"
  fi
}

preflight_file() {
  source=$1
  destination=$2
  assert_real_ancestors "$destination"

  if ! path_exists "$destination"; then
    return
  fi

  if same_path "$source" "$destination"; then
    return
  fi

  if [ -d "$destination" ] && [ ! -L "$destination" ]; then
    conflict "$destination exists as a directory"
    return
  fi

  if [ -L "$destination" ]; then
    conflict "$destination is a symlink to a different source"
    return
  fi

  conflict "$destination exists as a regular file; remove it after review"
}

preflight_dir_link() {
  source=$1
  destination=$2
  assert_real_ancestors "$destination"

  if ! path_exists "$destination"; then
    return
  fi

  if same_path "$source" "$destination"; then
    return
  fi

  conflict "$destination already exists and is not linked to the SWE Forge source"
}

preflight_canonical() {
  destination_root=$1
  preflight_file "$SOURCE_ROOT/AGENTS.md" "$destination_root/AGENTS.md"
  preflight_file "$SOURCE_ROOT/SWE-FORGE.md" "$destination_root/SWE-FORGE.md"
  preflight_file "$SOURCE_ROOT/VERSION" "$destination_root/VERSION"
  preflight_container "$destination_root/.swe-forge"

  while IFS= read -r source_dir; do
    entry_name=${source_dir##*/}
    preflight_dir_link "$source_dir" "$destination_root/.swe-forge/$entry_name"
  done <"$RUN_TMP/canonical-dirs"
}

preflight_adapter_tree() {
  source_root=$1
  destination_root=$2
  preflight_dir_link "$source_root" "$destination_root"
}

adapter_parent_containers() {
  adapter_base=$1
  adapter_relative=$2
  [ "$adapter_relative" != . ] || return 0

  adapter_old_ifs=$IFS
  IFS=/
  set -- $adapter_relative
  IFS=$adapter_old_ifs
  adapter_current=$adapter_base
  for adapter_part do
    [ -n "$adapter_part" ] || continue
    adapter_current=$adapter_current/$adapter_part
    preflight_container "$adapter_current"
  done
}

adapter_destination() {
  printf '%s/%s\n' "$HOME" "$1"
}

adapter_source() {
  printf '%s/.swe-forge/adapters/%s\n' "$SOURCE_ROOT" "$1"
}

adapter_is_registered() {
  adapter_requested=$1
  while IFS='|' read -r adapter_harness adapter_kind adapter_source_rel \
    adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    if [ "$adapter_harness" = "$adapter_requested" ]; then
      return 0
    fi
  done <"$ADAPTER_REGISTRY"
  return 1
}

preflight_adapter_support() {
  adapter_support=$1
  adapter_support_path=$(adapter_destination "$adapter_support")
  adapter_parent_containers "$HOME" "$(dirname "$adapter_support")"
  preflight_canonical "$adapter_support_path"
}

preflight_adapter_artifact() {
  adapter_kind=$1
  adapter_source_path=$2
  adapter_destination_path=$3
  adapter_destination_rel=$4

  adapter_parent_containers "$HOME" "$(dirname "$adapter_destination_rel")"
  case "$adapter_kind" in
    file) preflight_file "$adapter_source_path" "$adapter_destination_path" ;;
    tree) preflight_adapter_tree "$adapter_source_path" "$adapter_destination_path" ;;
    *) die "unsupported adapter artifact kind: $adapter_kind" ;;
  esac
}

preflight_install() {
  CONFLICTS=0
  manifest_support=$(manifest_support_relative) || \
    die "adapter is missing a canonical support path"
  preflight_adapter_support "$manifest_support"

  while IFS='|' read -r adapter_harness adapter_kind adapter_source_rel \
    adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    preflight_adapter_artifact \
      "$adapter_kind" \
      "$(adapter_source "$adapter_source_rel")" \
      "$(adapter_destination "$adapter_destination_rel")" \
      "$adapter_destination_rel"
  done <"$ADAPTER_ROWS"

  [ "$CONFLICTS" -eq 0 ] || die "installation stopped before writing; review the conflicts above"
}

install_file() {
  source=$1
  destination=$2

  path_exists "$destination" && return
  assert_real_ancestors "$destination"
  ensure_dir "$(dirname "$destination")"
  begin_create
  if ! ln -s "$source" "$destination"; then
    end_create
    die "could not install source link: $destination"
  fi
  record_file "$destination"
  end_create
}

install_dir_container() {
  ensure_dir "$1"
}

install_dir_link() {
  source=$1
  destination=$2

  path_exists "$destination" && return
  assert_real_ancestors "$destination"
  ensure_dir "$(dirname "$destination")"
  begin_create
  if ! ln -s "$source" "$destination"; then
    end_create
    die "could not install source directory link: $destination"
  fi
  record_file "$destination"
  end_create
}

install_tree() {
  install_dir_link "$1" "$2"
}

install_canonical() {
  destination_root=$1

  install_file "$SOURCE_ROOT/AGENTS.md" "$destination_root/AGENTS.md"
  install_file "$SOURCE_ROOT/SWE-FORGE.md" "$destination_root/SWE-FORGE.md"
  install_file "$SOURCE_ROOT/VERSION" "$destination_root/VERSION"
  install_dir_container "$destination_root/.swe-forge"

  while IFS= read -r source_dir; do
    entry_name=${source_dir##*/}
    install_dir_link "$source_dir" "$destination_root/.swe-forge/$entry_name"
  done <"$RUN_TMP/canonical-dirs"
}

install_adapter_artifact() {
  adapter_kind=$1
  adapter_source_path=$2
  adapter_destination_path=$3

  case "$adapter_kind" in
    file) install_file "$adapter_source_path" "$adapter_destination_path" ;;
    tree) install_tree "$adapter_source_path" "$adapter_destination_path" ;;
    *) die "unsupported adapter artifact kind: $adapter_kind" ;;
  esac
}

install_requested() {
  manifest_support=$(manifest_support_relative) || \
    die "adapter is missing a canonical support path"
  install_canonical "$(adapter_destination "$manifest_support")"

  while IFS='|' read -r adapter_harness adapter_kind adapter_source_rel \
    adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    install_adapter_artifact \
      "$adapter_kind" \
      "$(adapter_source "$adapter_source_rel")" \
      "$(adapter_destination "$adapter_destination_rel")"
  done <"$ADAPTER_ROWS"
}

verify_file() {
  source=$1
  destination=$2

  if ! path_exists "$destination"; then
    verify_failure "$destination is missing"
    return
  fi
  if [ ! -L "$destination" ]; then
    verify_failure "$destination is not a source link"
  elif ! same_path "$source" "$destination"; then
    verify_failure "$destination does not link to the current SWE Forge source"
  fi
}

verify_dir_mapping() {
  source=$1
  destination=$2
  if [ ! -L "$destination" ]; then
    verify_failure "$destination is not a source directory link"
  elif ! same_path "$source" "$destination"; then
    verify_failure "$destination does not link to the current SWE Forge source"
  fi
}

verify_tree() {
  verify_dir_mapping "$1" "$2"
}

verify_canonical() {
  destination_root=$1

  verify_file "$SOURCE_ROOT/AGENTS.md" "$destination_root/AGENTS.md"
  verify_file "$SOURCE_ROOT/SWE-FORGE.md" "$destination_root/SWE-FORGE.md"
  verify_file "$SOURCE_ROOT/VERSION" "$destination_root/VERSION"

  if ! path_exists "$destination_root/.swe-forge" || \
    [ ! -d "$destination_root/.swe-forge" ] || [ -L "$destination_root/.swe-forge" ]; then
    verify_failure "$destination_root/.swe-forge must be a real directory"
    return
  fi

  while IFS= read -r source_dir; do
    entry_name=${source_dir##*/}
    verify_dir_mapping "$source_dir" "$destination_root/.swe-forge/$entry_name"
  done <"$RUN_TMP/canonical-dirs"
}

verify_adapter_artifact() {
  adapter_kind=$1
  adapter_source_path=$2
  adapter_destination_path=$3

  case "$adapter_kind" in
    file) verify_file "$adapter_source_path" "$adapter_destination_path" ;;
    tree) verify_tree "$adapter_source_path" "$adapter_destination_path" ;;
    *) die "unsupported adapter artifact kind: $adapter_kind" ;;
  esac
}

verify_requested() {
  VERIFY_FAILURES=0
  manifest_support=$(manifest_support_relative) || \
    die "adapter is missing a canonical support path"
  verify_canonical "$(adapter_destination "$manifest_support")"

  while IFS='|' read -r adapter_harness adapter_kind adapter_source_rel \
    adapter_destination_rel adapter_support_rel; do
    case "$adapter_harness" in
      ''|\#*) continue ;;
    esac
    verify_adapter_artifact \
      "$adapter_kind" \
      "$(adapter_source "$adapter_source_rel")" \
      "$(adapter_destination "$adapter_destination_rel")"
  done <"$ADAPTER_ROWS"

  if [ "$VERIFY_FAILURES" -ne 0 ]; then
    return 1
  fi

  info "PASS: SWE Forge $HARNESS installation is valid"
}

status_requested() {
  info "source: $SOURCE_ROOT"
  info "version: $(source_version)"
  info "commit: $(source_commit)"
  info "source state: $(source_tree_state)"
  info "harness: $HARNESS"
  info "home: $HOME"
  if path_exists "$MANIFEST_PATH" && [ -f "$MANIFEST_PATH" ] && [ ! -L "$MANIFEST_PATH" ]; then
    if (validate_manifest) >/dev/null 2>&1; then
      info "manifest: $MANIFEST_PATH"
      info "managed paths: $(awk -F '\t' '$1 == "entry" { count++ } END { print count + 0 }' "$MANIFEST_PATH")"
      while IFS="$(printf '\t')" read -r status_marker status_kind status_relative \
        status_source status_link_target; do
        [ "${status_marker:-}" = entry ] || continue
        info "managed: $MANIFEST_BASE/$status_relative"
      done <"$MANIFEST_PATH"
      info "manifest source version: $(manifest_meta source_version "$MANIFEST_PATH")"
      info "manifest source commit: $(manifest_meta source_commit "$MANIFEST_PATH")"
    else
      info "manifest: INVALID ($MANIFEST_PATH)"
    fi
  else
    info 'manifest: missing (unmanaged installation; destructive lifecycle operations refuse)'
  fi
  if verify_requested; then
    info 'verification: PASS'
    return 0
  fi
  info 'verification: FAIL'
  return 1
}

doctor_requested() {
  doctor_status=0
  status_requested || doctor_status=1
  if [ "$(source_tree_state)" = dirty ]; then
    info 'doctor: source checkout has uncommitted changes; review before updating installations'
  fi
  if ! path_exists "$MANIFEST_PATH"; then
    info 'doctor: no managed manifest; recreate the installation before update or uninstall'
    doctor_status=1
  elif ! (validate_manifest) >/dev/null 2>&1; then
    info 'doctor: managed manifest is invalid or unsafe'
    doctor_status=1
  fi
  if [ "$doctor_status" -eq 0 ]; then
    info 'doctor: PASS'
  else
    info 'doctor: ACTION REQUIRED'
  fi
  return "$doctor_status"
}

inventory_field() {
  inventory_relative=$1
  inventory_field_number=$2
  awk -F '\t' -v wanted="$inventory_relative" \
    -v field="$inventory_field_number" \
    '$1 == "entry" && $3 == wanted { print $field; exit }' "$MANIFEST_ENTRIES"
}

inventory_has_entry() {
  [ -n "$(inventory_field "$1" 2)" ]
}

update_plan() {
  UPDATE_PLAN=$RUN_TMP/update-plan
  : >"$UPDATE_PLAN"
  while IFS="$(printf '\t')" read -r update_marker update_kind update_relative \
    update_source update_link_target; do
    [ "${update_marker:-}" = entry ] || continue
    update_destination=$MANIFEST_BASE/$update_relative
    update_old_target=$(manifest_entry_field "$update_relative" 5)
    if ! path_exists "$update_destination"; then
      update_action=add
    elif [ ! -L "$update_destination" ]; then
      die "managed link was replaced by a non-link: $update_destination"
    elif [ "$(readlink "$update_destination")" != "$update_link_target" ]; then
      [ "$(readlink "$update_destination")" = "$update_old_target" ] || \
        die "managed link was modified: $update_destination"
      update_action=relink
    else
      update_action=noop
    fi
    printf 'action\t%s\t%s\t%s\t%s\t%s\n' "$update_action" "$update_kind" \
      "$update_relative" "$update_source" "$update_link_target" >>"$UPDATE_PLAN"
  done <"$MANIFEST_ENTRIES"

  while IFS="$(printf '\t')" read -r update_marker update_kind update_relative \
    update_source update_link_target; do
    [ "${update_marker:-}" = entry ] || continue
    inventory_has_entry "$update_relative" && continue
    update_destination=$MANIFEST_BASE/$update_relative
    if ! path_exists "$update_destination"; then
      continue
    fi
    [ -L "$update_destination" ] || die "stale managed entry is not a link: $update_destination"
    [ "$(readlink "$update_destination")" = "$update_link_target" ] || \
      die "stale managed link was modified: $update_destination"
    printf 'action\tremove\t%s\t%s\t%s\t%s\n' "$update_kind" "$update_relative" \
      "$update_source" "$update_link_target" >>"$UPDATE_PLAN"
  done <"$MANIFEST_PATH"
}

print_update_plan() {
  update_plan_action_count=0
  while IFS="$(printf '\t')" read -r update_marker update_action update_kind \
    update_relative update_source update_target; do
    [ "${update_marker:-}" = action ] || continue
    case "$update_action" in
      noop) ;;
      *)
        update_plan_action_count=$((update_plan_action_count + 1))
        info "would $update_action: $MANIFEST_BASE/$update_relative"
        ;;
    esac
  done <"$UPDATE_PLAN"
  [ "$update_plan_action_count" -gt 0 ] || info 'would do nothing: installation is current'
}

execute_update_plan() {
  while IFS="$(printf '\t')" read -r update_marker update_action update_kind \
    update_relative update_source update_target; do
    [ "${update_marker:-}" = action ] || continue
    update_destination=$MANIFEST_BASE/$update_relative
    case "$update_action" in
      noop) ;;
      add|relink)
        if [ "$update_action" = relink ]; then
          record_removed_link "$update_destination"
          rm -f "$update_destination"
        fi
        case "$update_kind" in
          dir) install_dir_link "$update_source" "$update_destination" ;;
          file) install_file "$update_source" "$update_destination" ;;
          *) die "unsupported managed update kind: $update_kind" ;;
        esac
        ;;
      remove)
        record_removed_link "$update_destination"
        rm -f "$update_destination"
        ;;
      *) die "unsupported managed update action: $update_action" ;;
    esac
  done <"$UPDATE_PLAN"
}

update_requested() {
  validate_manifest
  build_manifest_inventory
  update_plan
  if [ "$DRY_RUN" -eq 1 ]; then
    info 'dry-run: no files, links, locks, or manifests will be changed'
    print_update_plan
    return 0
  fi
  TRANSACTION_ACTIVE=1
  execute_update_plan
  verify_requested || die 'updated installation failed verification'
  manifest_write
  TRANSACTION_ACTIVE=0
  info "updated: $MANIFEST_PATH"
  info "source version: $(source_version)"
}

manifest_is_shared() {
  shared_relative=$1
  shared_manifest_list=$RUN_TMP/other-manifests
  find "$MANIFEST_DIR" -type f -name '*.tsv' -print 2>/dev/null >"$shared_manifest_list"
  while IFS= read -r other_manifest; do
    [ "$other_manifest" != "$MANIFEST_PATH" ] || continue
    if awk -F '\t' -v wanted="$shared_relative" \
      '$1 == "entry" && $3 == wanted { found=1 } END { exit !found }' "$other_manifest"; then
      return 0
    fi
  done <"$shared_manifest_list"
  return 1
}

uninstall_requested() {
  validate_manifest
  uninstall_count=0
  while IFS="$(printf '\t')" read -r uninstall_marker uninstall_kind \
    uninstall_relative uninstall_source uninstall_link_target; do
    [ "${uninstall_marker:-}" = entry ] || continue
    uninstall_destination=$MANIFEST_BASE/$uninstall_relative
    if ! path_exists "$uninstall_destination"; then
      info "already absent: $uninstall_destination"
      continue
    fi
    [ -L "$uninstall_destination" ] || \
      die "managed link is no longer a link; refusing uninstall: $uninstall_destination"
    [ "$(readlink "$uninstall_destination")" = "$uninstall_link_target" ] || \
      die "managed link was modified; refusing uninstall: $uninstall_destination"
    if manifest_is_shared "$uninstall_relative"; then
      info "keep shared entry: $uninstall_destination"
    else
      uninstall_count=$((uninstall_count + 1))
    fi
  done <"$MANIFEST_PATH"

  MANIFEST_WAS_EXISTING=1
  MANIFEST_BACKUP=$RUN_TMP/uninstall-manifest-backup
  cp -p "$MANIFEST_PATH" "$MANIFEST_BACKUP" || die 'could not back up uninstall manifest'
  TRANSACTION_ACTIVE=1
  while IFS="$(printf '\t')" read -r uninstall_marker uninstall_kind \
    uninstall_relative uninstall_source uninstall_link_target; do
    [ "${uninstall_marker:-}" = entry ] || continue
    uninstall_destination=$MANIFEST_BASE/$uninstall_relative
    path_exists "$uninstall_destination" || continue
    manifest_is_shared "$uninstall_relative" && continue
    record_removed_link "$uninstall_destination"
    rm -f "$uninstall_destination"
  done <"$MANIFEST_PATH"
  rm -f "$MANIFEST_PATH"
  rmdir "$MANIFEST_DIR" 2>/dev/null || true
  TRANSACTION_ACTIVE=0
  info "uninstalled: $HARNESS"
  info "removed managed entries: $uninstall_count"
}

install_dry_run() {
  build_manifest_inventory
  info 'dry-run: no files, links, locks, or manifests will be changed'
  while IFS="$(printf '\t')" read -r dry_marker dry_kind dry_relative \
    dry_source dry_link_target; do
    [ "${dry_marker:-}" = entry ] || continue
    info "would manage: $MANIFEST_BASE/$dry_relative"
  done <"$MANIFEST_ENTRIES"
}

validate_home() {
  [ -n "${HOME:-}" ] || die 'HOME must be set for installation'
  case "$HOME" in
    /*) ;;
    *) die 'HOME must be an absolute path for installation' ;;
  esac
  reject_unsupported_path "$HOME"
  [ -d "$HOME" ] && [ ! -L "$HOME" ] || die "HOME must be a real directory: $HOME"
  assert_real_ancestors "$HOME/child"
  HOME=$(CDPATH= cd "$HOME" && pwd -P)
}

parse_args() {
  if [ "$#" -eq 1 ] && { [ "$1" = -h ] || [ "$1" = --help ]; }; then
    usage
    exit 0
  fi

  [ "$#" -ge 2 ] || {
    usage >&2
    exit 2
  }

  ACTION=$1
  HARNESS=$2
  shift 2

  case "$ACTION" in
    install|verify|status|doctor|update|uninstall) ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown action: $ACTION" ;;
  esac

  [ "$HARNESS" != claude-code ] || HARNESS=claude
  adapter_is_registered "$HARNESS" || \
    die "unsupported harness: $HARNESS (see .swe-forge/adapters/registry.tsv)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        die '--target is no longer supported; SWE Forge installations are user-level'
        ;;
      --global)
        die '--global is no longer supported; user-level installation is implicit'
        ;;
      --mode)
        die '--mode is no longer supported; installations always link to this checkout'
        ;;
      --dry-run)
        [ "$ACTION" = install ] || [ "$ACTION" = update ] || \
          die '--dry-run is supported only for install and update'
        DRY_RUN=1
        shift
        ;;
      global|globally)
        die 'installation scope arguments are no longer supported; installation is user-level'
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        die "unexpected argument: $1 (project installation is no longer supported)"
        ;;
    esac
  done
}

main() {
  if [ "$#" -eq 1 ] && [ "$1" = version ]; then
    print_version
    exit 0
  fi

  parse_args "$@"
  prepare_manifests
  validate_home
  manifest_set_paths

  case "$ACTION" in
    install)
      load_manifest
      if [ "$DRY_RUN" -eq 1 ]; then
        preflight_install
        install_dry_run
        exit 0
      fi
      acquire_lock
      preflight_install
      build_manifest_inventory
      TRANSACTION_ACTIVE=1
      install_requested
      if verify_requested; then
        manifest_write
        TRANSACTION_ACTIVE=0
        info "source: $SOURCE_ROOT"
        info 'installation: user harness configuration'
        info "home: $HOME"
        info "manifest: $MANIFEST_PATH"
        invocation_hint
      else
        die 'installation completed but verification failed'
      fi
      ;;
    verify)
      verify_requested || die 'verification failed'
      ;;
    status)
      status_requested || exit 1
      ;;
    doctor)
      doctor_requested || exit 1
      ;;
    update)
      load_manifest
      if [ "$DRY_RUN" -eq 0 ]; then
        acquire_lock
      fi
      update_requested
      ;;
    uninstall)
      load_manifest
      acquire_lock
      uninstall_requested
      ;;
  esac
}

main "$@"
