#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
TOOL=$ROOT/.swe-forge/tools/swe-forge-worker-brief
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-briefing.XXXXXX")
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'worker briefing test failure: %s\n' "$*" >&2
  exit 1
}

assert_text() {
  needle=$1
  file=$2
  grep -F -- "$needle" "$file" >/dev/null 2>&1 || fail "$file is missing: $needle"
}

expect_failure() {
  label=$1
  shift
  if "$@" >"$TMP_ROOT/failure.out" 2>&1; then
    fail "$label unexpectedly passed"
  fi
}

read_brief() {
  file=$1
  id=$2
  role=$3
  cat >"$file" <<EOF
{
  "worker_briefing": {
    "schema": "worker-brief/v1",
    "task_id": "$id",
    "worker": {
      "role": "$role",
      "mode": "delegated_worker",
      "depth": 1,
      "recursive_delegation": false
    },
    "objective": "Inspect the bounded worker boundary.",
    "acceptance": ["The bounded worker returns only accepted evidence."],
    "repository": {
      "instructions": ["AGENTS.md"],
      "allowed_reads": ["src/parser.ts#parseRecord"],
      "allowed_writes": ["none"]
    },
    "architecture_decisions": ["Use the canonical parser interface."],
    "validation": [
      {
        "command": "scripts/test-parser",
        "requirement": "required",
        "condition": "always",
        "side_effects": "local-only"
      }
    ],
    "permissions": {
      "write_access": "read-only",
      "topology": "SUBAGENTS",
      "allowed_actions": ["read", "validation"],
      "forbidden_actions": ["delivery", "recursive delegation", "peer communication", "scope expansion", "topology decisions"]
    },
    "return": {
      "profile": "READ_ONLY",
      "contract": ".swe-forge/contracts/result.md",
      "expected_output": ["FINDINGS and EVIDENCE"]
    }
  }
}
EOF
}

writable_brief() {
  file=$1
  cat >"$file" <<'EOF'
{
  "worker_briefing": {
    "schema": "worker-brief/v1",
    "task_id": "shared-writer",
    "worker": {
      "role": "implementer",
      "mode": "delegated_worker",
      "depth": 1,
      "recursive_delegation": false
    },
    "objective": "Implement the bounded worker change.",
    "acceptance": ["The implementation remains within its declared scope."],
    "repository": {
      "instructions": ["AGENTS.md"],
      "allowed_reads": ["src/brief.ts"],
      "allowed_writes": ["src/brief.ts"]
    },
    "architecture_decisions": [],
    "validation": [
      {
        "command": "scripts/test-brief",
        "requirement": "required",
        "condition": "always",
        "side_effects": "local-only"
      }
    ],
    "permissions": {
      "write_access": "read-write",
      "topology": "SUBAGENTS",
      "allowed_actions": ["read", "edit", "validation"],
      "forbidden_actions": ["delivery", "recursive delegation", "peer communication", "scope expansion", "topology decisions"]
    },
    "return": {
      "profile": "WRITABLE",
      "contract": ".swe-forge/contracts/result.md",
      "expected_output": ["FILES_CHANGED and VALIDATION"]
    }
  }
}
EOF
}

review_brief() {
  file=$1
  cat >"$file" <<'EOF'
{
  "worker_briefing": {
    "schema": "worker-brief/v1",
    "task_id": "review-worker",
    "worker": {
      "role": "reviewer",
      "mode": "delegated_worker",
      "depth": 1,
      "recursive_delegation": false
    },
    "objective": "Review the bounded worker change.",
    "acceptance": ["The review checks the stated acceptance criteria."],
    "repository": {
      "instructions": [],
      "allowed_reads": ["src/brief.ts"],
      "allowed_writes": ["none"]
    },
    "architecture_decisions": [],
    "validation": [
      {
        "command": "scripts/test-brief",
        "requirement": "required",
        "condition": "always",
        "side_effects": "local-only"
      }
    ],
    "permissions": {
      "write_access": "read-only",
      "topology": "SUBAGENTS",
      "allowed_actions": ["read"],
      "forbidden_actions": ["delivery", "recursive delegation", "peer communication", "scope expansion", "topology decisions"]
    },
    "return": {
      "profile": "REVIEW",
      "contract": ".swe-forge/contracts/review.md",
      "expected_output": ["PASS or CHANGES_REQUIRED"]
    }
  }
}
EOF
}

dependency_brief() {
  file=$1
  cat >"$file" <<'EOF'
{
  "worker_briefing": {
    "schema": "worker-brief/v1",
    "task_id": "dependent-worker",
    "worker": {
      "role": "implementer",
      "mode": "delegated_worker",
      "depth": 1,
      "recursive_delegation": false
    },
    "objective": "Use only the accepted dependency facts relevant to this task.",
    "acceptance": ["The dependent implementation uses the accepted interface."],
    "repository": {
      "instructions": [],
      "allowed_reads": ["src/parser.ts"],
      "allowed_writes": ["src/consumer.ts"]
    },
    "architecture_decisions": [],
    "dependencies": {
      "completed": [
        {
          "task_id": "parser-task",
          "dependency_digest": {
            "accepted_decisions": ["Use parseRecord(input)."],
            "relevant_facts": ["Parser returns normalized records."],
            "changed_interfaces": ["parseRecord(input)"],
            "paths_symbols": ["src/parser.ts#parseRecord"],
            "validation_facts": ["scripts/test-parser passed."],
            "source_refs": ["result/parser.result"]
          }
        }
      ],
      "pending": ["future-task"]
    },
    "validation": [
      {
        "command": "scripts/test-consumer",
        "requirement": "required",
        "condition": "always",
        "side_effects": "local-only"
      }
    ],
    "permissions": {
      "write_access": "read-write",
      "topology": "SUBAGENTS",
      "allowed_actions": ["read", "edit", "validation"],
      "forbidden_actions": ["delivery", "recursive delegation", "peer communication", "scope expansion", "topology decisions"]
    },
    "return": {
      "profile": "WRITABLE",
      "contract": ".swe-forge/contracts/result.md",
      "expected_output": ["FILES_CHANGED"]
    }
  }
}
EOF
}

[ -x "$TOOL" ] || fail 'canonical worker-brief tool is not executable'

read_brief "$TMP_ROOT/read.brief.json" reader-check researcher
"$TOOL" validate --brief "$TMP_ROOT/read.brief.json" >/dev/null
"$TOOL" validate --brief - <"$TMP_ROOT/read.brief.json" >/dev/null
"$TOOL" inspect --brief "$TMP_ROOT/read.brief.json" >"$TMP_ROOT/read.inspect"
for required in '"schema":"worker-brief/v1"' '"valid":true' '"task_id":"reader-check"' '"profile":"READ_ONLY"' '"write_access":"read-only"'; do
  assert_text "$required" "$TMP_ROOT/read.inspect"
done
for required in \
  '"schema": "worker-brief/v1"' '"mode": "delegated_worker"' '"recursive_delegation": false' \
  '"write_access": "read-only"' '"topology": "SUBAGENTS"' \
  '"profile": "READ_ONLY"' '"contract": ".swe-forge/contracts/result.md"' \
  '"allowed_writes": ["none"]'; do
  assert_text "$required" "$TMP_ROOT/read.brief.json"
done
for forbidden in \
  '"delivery"' \
  '"recursive delegation"' \
  '"peer communication"' \
  '"scope expansion"' \
  '"topology decisions"'; do
  assert_text "$forbidden" "$TMP_ROOT/read.brief.json"
done

sed '/"objective":/d' "$TMP_ROOT/read.brief.json" >"$TMP_ROOT/missing-objective.brief.json"
expect_failure 'missing required objective' "$TOOL" validate --brief "$TMP_ROOT/missing-objective.brief.json"
sed 's/"objective": "Inspect the bounded worker boundary\."/"objective": ""/' "$TMP_ROOT/read.brief.json" >"$TMP_ROOT/empty-objective.brief.json"
expect_failure 'empty required objective' "$TOOL" validate --brief "$TMP_ROOT/empty-objective.brief.json"
sed 's/"write_access": "read-only"/"write_access": "read-write"/' "$TMP_ROOT/read.brief.json" >"$TMP_ROOT/illegal-permission.brief.json"
expect_failure 'read-only worker with writable permission' "$TOOL" validate --brief "$TMP_ROOT/illegal-permission.brief.json"
sed 's/"topology": "SUBAGENTS"/"topology": "SOLO"/' "$TMP_ROOT/read.brief.json" >"$TMP_ROOT/bad-topology.brief.json"
expect_failure 'invalid delegated topology' "$TOOL" validate --brief "$TMP_ROOT/bad-topology.brief.json"

writable_brief "$TMP_ROOT/writable.brief.json"
"$TOOL" validate --brief "$TMP_ROOT/writable.brief.json" >/dev/null
"$TOOL" inspect --brief "$TMP_ROOT/writable.brief.json" >"$TMP_ROOT/writable.inspect"
for required in '"task_id":"shared-writer"' '"profile":"WRITABLE"' '"write_access":"read-write"'; do
  assert_text "$required" "$TMP_ROOT/writable.inspect"
done
sed 's/"allowed_writes": \["src\/brief.ts"\]/"allowed_writes": ["none"]/' "$TMP_ROOT/writable.brief.json" >"$TMP_ROOT/illegal-writes.brief.json"
expect_failure 'writable worker with no owned write scope' "$TOOL" validate --brief "$TMP_ROOT/illegal-writes.brief.json"

review_brief "$TMP_ROOT/review.brief.json"
"$TOOL" validate --brief "$TMP_ROOT/review.brief.json" >/dev/null
"$TOOL" inspect --brief "$TMP_ROOT/review.brief.json" >"$TMP_ROOT/review.inspect"
for required in '"task_id":"review-worker"' '"profile":"REVIEW"' '"write_access":"read-only"'; do
  assert_text "$required" "$TMP_ROOT/review.inspect"
done
assert_text '"role": "reviewer"' "$TMP_ROOT/review.brief.json"
assert_text '"profile": "REVIEW"' "$TMP_ROOT/review.brief.json"
assert_text '"contract": ".swe-forge/contracts/review.md"' "$TMP_ROOT/review.brief.json"

# Dependency handoff: only a selected digest is projected into the existing
# brief, and its shape cannot be empty or duplicated.
dependency_brief "$TMP_ROOT/dependency.brief.json"
"$TOOL" validate --brief "$TMP_ROOT/dependency.brief.json" >/dev/null
for required in '"dependencies"' '"completed"' '"pending"' '"dependency_digest"' \
  'Use parseRecord(input).' 'Parser returns normalized records.' \
  'src/parser.ts#parseRecord' 'result/parser.result'; do
  assert_text "$required" "$TMP_ROOT/dependency.brief.json"
done
sed 's/"task_id": "parser-task"/"task_id": "parser-task", "dependency_digest": {"source_refs": ["duplicate"]}/' "$TMP_ROOT/dependency.brief.json" >"$TMP_ROOT/duplicate-digest.brief.json"
expect_failure 'duplicate dependency fields' "$TOOL" validate --brief "$TMP_ROOT/duplicate-digest.brief.json"

printf '%s\n' 'PASS: canonical worker briefing validation and inspection'
