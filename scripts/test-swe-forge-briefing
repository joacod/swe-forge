#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
TOOL=$ROOT/.swe-forge/tools/swe-forge-worker-brief
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-briefing.XXXXXX")
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'worker briefing test failure: %s\n' "$*" >&2
  exit 1
}

assert_text() {
  needle=$1
  file=$2
  grep -F -- "$needle" "$file" >/dev/null 2>&1 || fail "$file is missing: $needle"
}

assert_absent() {
  needle=$1
  file=$2
  if grep -F -- "$needle" "$file" >/dev/null 2>&1; then
    fail "$file unexpectedly contains: $needle"
  fi
}

expect_failure() {
  label=$1
  shift
  if "$@" >"$TMP_ROOT/failure.out" 2>&1; then
    fail "$label unexpectedly passed"
  fi
}

record() { printf '%s\n' "$*"; }
record3() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }
record4() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }
record_validation() { printf 'task\tvalidation\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }

shared_state() {
  record3 state routing.current SUBAGENTS
}

read_input() {
  file=$1
  id=$2
  role=$3
  {
    record worker-brief-input/v1
    record3 task id "$id"
    record3 task owner_role "$role"
    record3 task depth 1
    record3 task objective 'Inspect the bounded worker boundary.'
    record3 task write_access read-only
    record3 task acceptance 'The bounded worker returns only accepted evidence.'
    record3 task instruction AGENTS.md
    record3 task allowed_read 'src/parser.ts#parseRecord'
    record3 task architecture_decision 'Use the canonical parser interface.'
    record3 task expected_output 'FINDINGS and EVIDENCE'
    record_validation scripts/test-parser required always local-only
    shared_state
  } >"$file"
}

shared_input() {
  file=$1
  {
    record worker-brief-input/v1
    record3 task id shared-writer
    record3 task owner_role implementer
    record3 task depth 1
    record3 task objective 'Implement the bounded delivery-checkout change.'
    record3 task write_access read-write
    record3 task acceptance 'The implementation remains within its declared scope.'
    record3 task instruction AGENTS.md
    record3 task allowed_read src/brief.ts
    record3 task allowed_write src/brief.ts
    record3 task expected_output 'FILES_CHANGED and VALIDATION'
    record_validation scripts/test-brief required always local-only
    shared_state
  } >"$file"
}

review_input() {
  file=$1
  {
    record worker-brief-input/v1
    record3 task id review-worker
    record3 task owner_role reviewer
    record3 task depth 1
    record3 task objective 'Review the bounded worker change.'
    record3 task write_access read-only
    record3 task acceptance 'The review checks the stated acceptance criteria.'
    record3 task allowed_read src/brief.ts
    record3 task expected_output 'PASS or CHANGES_REQUIRED'
    record_validation scripts/test-brief required always local-only
    shared_state
  } >"$file"
}

dependency_input() {
  file=$1
  status=$2
  accepted_ref=$3
  {
    record worker-brief-input/v1
    record3 task id dependent-worker
    record3 task owner_role implementer
    record3 task depth 1
    record3 task objective 'Use only the accepted dependency facts relevant to this task.'
    record3 task write_access read-write
    record3 task acceptance 'The dependent implementation uses the accepted interface.'
    record3 task allowed_read src/parser.ts
    record3 task allowed_write src/consumer.ts
    record3 task dependency parser-task
    record3 task expected_output FILES_CHANGED
    record_validation scripts/test-consumer required always local-only
    shared_state
    printf 'state\tdependency\tparser-task\t%s\t%s\n' "$status" "$accepted_ref"
    if [ "$status" = done ]; then
      record4 digest parser-task accepted_decisions 'Use parseRecord(input).'
      record4 digest parser-task relevant_facts 'Parser returns normalized records.'
      record4 digest parser-task changed_interfaces 'parseRecord(input)'
      record4 digest parser-task paths_symbols src/parser.ts#parseRecord
      record4 digest parser-task validation_facts 'scripts/test-parser passed.'
      record4 digest parser-task source_refs "$accepted_ref"
    fi
  } >"$file"
}

[ -x "$TOOL" ] || fail 'canonical worker-brief tool is not executable'
assert_text 'worker_briefing:' "$ROOT/.swe-forge/contracts/worker-brief.md"
assert_text 'worker-brief/v1' "$ROOT/.swe-forge/contracts/worker-brief.md"
assert_text 'render --input' "$TOOL"
assert_text 'validate --brief' "$TOOL"

read_input "$TMP_ROOT/read.input" reader-check researcher
"$TOOL" render --input "$TMP_ROOT/read.input" >"$TMP_ROOT/read.brief"
"$TOOL" validate --brief "$TMP_ROOT/read.brief" --input "$TMP_ROOT/read.input" >/dev/null
for required in \
  'schema: worker-brief/v1' "task_id: 'reader-check'" \
  'mode: delegated_worker' 'recursive_delegation: false' \
  'write_access: read-only' 'topology: SUBAGENTS' \
  'profile: READ_ONLY' 'contract: .swe-forge/contracts/result.md' \
  'allowed_writes:' "- 'none'"; do
  assert_text "$required" "$TMP_ROOT/read.brief"
done
for forbidden in 'CHECKOUT:' 'source_commits:' 'create_pull_request:'; do
  assert_absent "$forbidden" "$TMP_ROOT/read.brief"
done

"$TOOL" render --input "$TMP_ROOT/read.input" >"$TMP_ROOT/read-again.brief"
cmp -s "$TMP_ROOT/read.brief" "$TMP_ROOT/read-again.brief" || fail 'repeated rendering changed the briefing'
sed '/^  objective:/d' "$TMP_ROOT/read.brief" >"$TMP_ROOT/missing-objective.brief"
expect_failure 'missing required objective' "$TOOL" validate --brief "$TMP_ROOT/missing-objective.brief"
sed "s/^  objective: 'Inspect the bounded worker boundary\.'$/  objective: ''/" "$TMP_ROOT/read.brief" >"$TMP_ROOT/empty-objective.brief"
expect_failure 'empty required objective' "$TOOL" validate --brief "$TMP_ROOT/empty-objective.brief"
sed 's/write_access: read-only/write_access: read-write/' "$TMP_ROOT/read.brief" >"$TMP_ROOT/illegal-permission.brief"
expect_failure 'read-only worker with writable permission' "$TOOL" validate --brief "$TMP_ROOT/illegal-permission.brief"
sed 's/state\trouting.current\tSUBAGENTS/state\trouting.current\tSOLO/' "$TMP_ROOT/read.input" >"$TMP_ROOT/bad-state.input"
expect_failure 'invalid delegated topology' "$TOOL" render --input "$TMP_ROOT/bad-state.input"

shared_input "$TMP_ROOT/shared.input"
"$TOOL" render --input "$TMP_ROOT/shared.input" >"$TMP_ROOT/shared.brief"
"$TOOL" validate --brief "$TMP_ROOT/shared.brief" --input "$TMP_ROOT/shared.input" >/dev/null
for required in 'write_access: read-write' 'allowed_writes:' "- 'src/brief.ts'" \
  'allowed_actions:' '      - edit' 'profile: WRITABLE'; do
  assert_text "$required" "$TMP_ROOT/shared.brief"
done
sed "s#- 'src/brief.ts'#- 'src/expanded.ts'#" "$TMP_ROOT/shared.brief" >"$TMP_ROOT/expanded-scope.brief"
expect_failure 'scope expansion beyond canonical task' "$TOOL" validate --brief "$TMP_ROOT/expanded-scope.brief" --input "$TMP_ROOT/shared.input"

review_input "$TMP_ROOT/review.input"
"$TOOL" render --input "$TMP_ROOT/review.input" >"$TMP_ROOT/review.brief"
"$TOOL" validate --brief "$TMP_ROOT/review.brief" --input "$TMP_ROOT/review.input" >/dev/null
assert_text "role: 'reviewer'" "$TMP_ROOT/review.brief"
assert_text 'profile: REVIEW' "$TMP_ROOT/review.brief"
assert_text 'contract: .swe-forge/contracts/review.md' "$TMP_ROOT/review.brief"
assert_absent '      - edit' "$TMP_ROOT/review.brief"

# Dependency handoff: only selected digest categories are projected, and
# completion requires accepted result evidence in canonical state.
dependency_input "$TMP_ROOT/dependency.input" done result/parser.result
"$TOOL" render --input "$TMP_ROOT/dependency.input" >"$TMP_ROOT/dependency.brief"
"$TOOL" validate --brief "$TMP_ROOT/dependency.brief" --input "$TMP_ROOT/dependency.input" >/dev/null
for required in 'dependencies:' 'completed:' 'dependency_digest:' \
  'Use parseRecord(input).' 'Parser returns normalized records.' \
  'src/parser.ts#parseRecord' 'result/parser.result'; do
  assert_text "$required" "$TMP_ROOT/dependency.brief"
done
assert_absent 'RESULT_PROFILE: READ_ONLY' "$TMP_ROOT/dependency.brief"
assert_absent 'full test log' "$TMP_ROOT/dependency.brief"
dependency_input "$TMP_ROOT/unaccepted.input" running none
record4 digest parser-task accepted_decisions 'This digest is not yet accepted.' >>"$TMP_ROOT/unaccepted.input"
expect_failure 'unaccepted dependency digest' "$TOOL" render --input "$TMP_ROOT/unaccepted.input"
dependency_input "$TMP_ROOT/missing-evidence.input" done none
expect_failure 'completed dependency without accepted result evidence' "$TOOL" render --input "$TMP_ROOT/missing-evidence.input"

printf '%s\n' 'PASS: deterministic worker briefing renderer and validator'
