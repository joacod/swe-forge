#!/bin/sh

# Run selected independent validation groups with one final report.
# With no group, preserve the complete repository fixture bundle. Parallel
# execution changes scheduling, not the selected checks.

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)

usage() {
  cat <<'EOF'
Usage:
  scripts/validate-swe-forge [--serial] [GROUP ...]
  scripts/validate-swe-forge [--serial] --group GROUP [--group GROUP ...]
  scripts/validate-swe-forge --plan [GROUP ...]
  scripts/validate-swe-forge --list

With no group, or with `full`, run the complete repository validation bundle.
Use more than one group when a change crosses subsystem boundaries. `release`
is separate because it checks release-readiness consistency; use `full release`
for a release candidate.

Groups:
  core       shell syntax, structural checks, selection fixture, and boundary
  invocation invocation parser fixture
  evidence   executable evidence-gate and run-state fixtures
  installer  installer lifecycle and rollback fixtures
  pi         Pi adapter/runtime fixture
  omp        OMP adapter/runtime fixture
  workers    worker briefing and worker-result contract fixtures
  release    release consistency/readiness check
  full       core, invocation, evidence, installer, pi, omp, and workers

Examples:
  scripts/validate-swe-forge core
  scripts/validate-swe-forge full
  scripts/validate-swe-forge full release

Aliases: structural=core, state=evidence, worker-contracts=workers,
pi-runtime=pi, omp-runtime=omp, and release-readiness=release.

`--plan` reports exactly which checks would run without executing them. The
normal report also identifies groups and checks that were not selected.
EOF
}

fail() {
  printf 'validation batch failure: %s\n' "$*" >&2
  exit 2
}

parallel=yes
list_only=no
plan_only=no
group_requested=no
requested_groups=
full=no
core=no
invocation=no
evidence=no
installer=no
pi=no
omp=no
workers=no
release=no

record_requested_group() {
  group_requested=yes
  if [ -n "$requested_groups" ]; then
    requested_groups="$requested_groups, $1"
  else
    requested_groups=$1
  fi
}

select_group() {
  group=$1
  case "$group" in
    core|structural) core=yes ;;
    invocation) invocation=yes ;;
    evidence|state) evidence=yes ;;
    installer) installer=yes ;;
    pi|pi-runtime) pi=yes ;;
    omp|omp-runtime) omp=yes ;;
    workers|worker|worker-contracts) workers=yes ;;
    release|release-readiness) release=yes ;;
    full) full=yes ;;
    *) fail "unknown validation group: $group" ;;
  esac
  record_requested_group "$group"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --serial)
      parallel=no
      shift
      ;;
    --list)
      list_only=yes
      shift
      ;;
    --plan)
      plan_only=yes
      shift
      ;;
    --group)
      [ "$#" -ge 2 ] || fail '--group requires a group name'
      select_group "$2"
      shift 2
      ;;
    --group=*)
      select_group "${1#--group=}"
      shift
      ;;
    --full)
      select_group full
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      select_group "$1"
      shift
      ;;
  esac
done

if [ "$list_only" = yes ]; then
  [ "$group_requested" = no ] || fail '--list cannot be combined with validation groups'
  [ "$plan_only" = no ] || fail '--list cannot be combined with --plan'
  usage
  exit 0
fi

if [ "$group_requested" = no ]; then
  full=yes
  requested_groups='default (full)'
fi

# `full` intentionally preserves the existing validate-swe-forge fixture
# bundle. Release readiness has a clean-candidate meaning of its own and is
# selected explicitly, normally as `full release`.
if [ "$full" = yes ]; then
  core=yes
  invocation=yes
  evidence=yes
  installer=yes
  pi=yes
  omp=yes
  workers=yes
fi

effective_full=no
if [ "$core" = yes ] && [ "$invocation" = yes ] && \
  [ "$evidence" = yes ] && [ "$installer" = yes ] && \
  [ "$pi" = yes ] && [ "$omp" = yes ] && [ "$workers" = yes ]; then
  effective_full=yes
fi

append_csv() {
  if [ -n "$1" ]; then
    printf '%s, %s' "$1" "$2"
  else
    printf '%s' "$2"
  fi
}

group_selected() {
  case "$1" in
    core) [ "$core" = yes ] ;;
    invocation) [ "$invocation" = yes ] ;;
    evidence) [ "$evidence" = yes ] ;;
    installer) [ "$installer" = yes ] ;;
    pi) [ "$pi" = yes ] ;;
    omp) [ "$omp" = yes ] ;;
    workers) [ "$workers" = yes ] ;;
    release) [ "$release" = yes ] ;;
    *) fail "unknown validation group: $1" ;;
  esac
}

group_names=
for group in core invocation evidence installer pi omp workers release; do
  if group_selected "$group"; then
    group_names=$(append_csv "$group_names" "$group")
  fi
done

not_run_groups=
for group in core invocation evidence installer pi omp workers release; do
  if ! group_selected "$group"; then
    not_run_groups=$(append_csv "$not_run_groups" "$group")
  fi
done

# Check slugs are deliberately static: validation selection is a small,
# inspectable mapping rather than a dependency resolver.
selected_checks=
add_check() {
  check=$1
  case " $selected_checks " in
    *" $check "*) ;;
    *) selected_checks="$selected_checks $check" ;;
  esac
}

group_checks() {
  case "$1" in
    core) printf '%s\n' 'syntax structural selection boundary' ;;
    invocation) printf '%s\n' invocation ;;
    evidence) printf '%s\n' evidence ;;
    installer) printf '%s\n' installer ;;
    pi) printf '%s\n' pi ;;
    omp) printf '%s\n' omp ;;
    workers) printf '%s\n' 'briefing results' ;;
    release) printf '%s\n' release ;;
  esac
}

for group in core invocation evidence installer pi omp workers release; do
  if group_selected "$group"; then
    for check in $(group_checks "$group"); do add_check "$check"; done
  fi
done

check_label() {
  case "$1" in
    syntax) printf '%s\n' 'shell syntax' ;;
    structural) printf '%s\n' 'structural checks' ;;
    selection) printf '%s\n' 'validation selection fixture' ;;
    boundary) printf '%s\n' 'canonical boundary fixture' ;;
    invocation) printf '%s\n' 'invocation parser fixture' ;;
    evidence) printf '%s\n' 'evidence/state fixtures' ;;
    installer) printf '%s\n' 'installer fixture tests' ;;
    pi) printf '%s\n' 'Pi runtime fixture' ;;
    omp) printf '%s\n' 'OMP runtime fixture' ;;
    briefing) printf '%s\n' 'worker briefing fixture' ;;
    results) printf '%s\n' 'worker result fixture' ;;
    release) printf '%s\n' 'release readiness' ;;
    *) fail "unknown validation check: $1" ;;
  esac
}

print_not_run_checks() {
  for group in core invocation evidence installer pi omp workers release; do
    if group_selected "$group"; then continue; fi
    for check in $(group_checks "$group"); do
      printf '  NOT RUN: %s (group %s was not selected)\n' "$(check_label "$check")" "$group"
    done
  done
}

report_selection() {
  printf 'Requested validation groups: %s\n' "$requested_groups"
  printf 'Selected validation groups: %s\n' "$group_names"
  if [ "$effective_full" = yes ]; then
    if [ "$full" = yes ]; then
      printf '%s\n' 'Full validation bundle: selected'
    else
      printf '%s\n' 'Full validation bundle: selected via component groups'
    fi
  else
    printf '%s\n' 'Full validation bundle: not selected'
  fi
  if [ -n "$not_run_groups" ]; then
    printf '%s\n' 'Checks not run (groups not selected):'
    print_not_run_checks
  else
    printf '%s\n' 'Checks not run (groups not selected): none'
  fi
}

report_selection

if [ "$plan_only" = yes ]; then
  printf '%s\n' 'Checks to run:'
  for check in $selected_checks; do
    printf '  RUN: %s\n' "$(check_label "$check")"
  done
  exit 0
fi

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-validation.XXXXXX")
TMP_ROOT=$(CDPATH= cd "$TMP_ROOT" && pwd -P)
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

run_check() {
  label=$1
  slug=$2
  shift 2
  log=$TMP_ROOT/$slug.log
  status_file=$TMP_ROOT/$slug.status
  if "$@" >"$log" 2>&1; then status=0; else status=$?; fi
  printf '%s\n' "$status" >"$status_file"
}

report_check() {
  label=$1
  slug=$2
  status=$(cat "$TMP_ROOT/$slug.status")
  case "$status" in
    0)
      if grep -Eq '^SKIP:' "$TMP_ROOT/$slug.log" 2>/dev/null; then
        printf 'SKIP: %s\n' "$label"
      else
        printf 'PASS: %s\n' "$label"
      fi
      ;;
    ''|*[!0-9]*)
      printf 'FAIL: %s (invalid status: %s)\n' "$label" "$status" >&2
      [ ! -s "$TMP_ROOT/$slug.log" ] || cat "$TMP_ROOT/$slug.log" >&2
      return 1
      ;;
    *)
      printf 'FAIL: %s (exit %s)\n' "$label" "$status" >&2
      [ ! -s "$TMP_ROOT/$slug.log" ] || cat "$TMP_ROOT/$slug.log" >&2
      return 1
      ;;
  esac
  [ ! -s "$TMP_ROOT/$slug.log" ] || cat "$TMP_ROOT/$slug.log"
}

run_named_check() {
  check=$1
  label=$(check_label "$check")
  case "$check" in
    syntax)
      run_check "$label" syntax sh -n \
        "$ROOT/scripts/swe-forge" \
        "$ROOT/scripts/check-swe-forge" \
        "$ROOT/scripts/test-swe-forge" \
        "$ROOT/scripts/validate-swe-forge" \
        "$ROOT/scripts/test-validate-swe-forge" \
        "$ROOT/scripts/swe-forge-gate" \
        "$ROOT/scripts/test-swe-forge-gate" \
        "$ROOT/scripts/test-swe-forge-pi" \
        "$ROOT/scripts/test-swe-forge-omp" \
        "$ROOT/scripts/test-swe-forge-invocation" \
        "$ROOT/scripts/test-swe-forge-briefing" \
        "$ROOT/scripts/test-swe-forge-results" \
        "$ROOT/scripts/check-swe-forge-boundary" \
        "$ROOT/scripts/test-swe-forge-boundary" \
        "$ROOT/scripts/swe-forge-state" \
        "$ROOT/scripts/swe-forge-invocation" \
        "$ROOT/scripts/check-release" \
        "$ROOT/.swe-forge/tools/swe-forge-gate" \
        "$ROOT/.swe-forge/tools/swe-forge-state" \
        "$ROOT/.swe-forge/tools/swe-forge-invocation" \
        "$ROOT/.swe-forge/tools/swe-forge-worker-brief" \
        "$ROOT/.swe-forge/tools/swe-forge-worker-result"
      ;;
    structural) run_check "$label" structural "$ROOT/scripts/check-swe-forge" ;;
    selection) run_check "$label" selection "$ROOT/scripts/test-validate-swe-forge" ;;
    boundary) run_check "$label" boundary "$ROOT/scripts/test-swe-forge-boundary" ;;
    invocation) run_check "$label" invocation "$ROOT/scripts/test-swe-forge-invocation" ;;
    evidence) run_check "$label" evidence "$ROOT/scripts/test-swe-forge-gate" ;;
    installer) run_check "$label" installer "$ROOT/scripts/test-swe-forge" ;;
    pi) run_check "$label" pi "$ROOT/scripts/test-swe-forge-pi" ;;
    omp) run_check "$label" omp "$ROOT/scripts/test-swe-forge-omp" ;;
    briefing) run_check "$label" briefing "$ROOT/scripts/test-swe-forge-briefing" ;;
    results) run_check "$label" results "$ROOT/scripts/test-swe-forge-results" ;;
    release) run_check "$label" release "$ROOT/scripts/check-release" prepare --allow-dirty ;;
    *) fail "unknown validation check: $check" ;;
  esac
}

reported_checks=
run_prechecks() {
  for check in syntax structural; do
    case " $selected_checks " in
      *" $check "*) ;;
      *) continue ;;
    esac
    run_named_check "$check"
    if ! report_check "$(check_label "$check")" "$check"; then
      exit 1
    fi
    reported_checks="$reported_checks $check"
  done
}

run_prechecks

pids=
for check in $selected_checks; do
  case "$check" in
    syntax|structural) continue ;;
  esac
  if [ "$parallel" = yes ]; then
    run_named_check "$check" &
    pids="$pids $!"
  else
    run_named_check "$check"
  fi
done

if [ "$parallel" = yes ]; then
  for pid in $pids; do
    if wait "$pid"; then :; else :; fi
  done
fi

failures=0
for check in $selected_checks; do
  case " $reported_checks " in
    *" $check "*) continue ;;
  esac
  if ! report_check "$(check_label "$check")" "$check"; then
    failures=$((failures + 1))
  fi
done

if [ "$failures" -gt 0 ]; then
  printf 'FAIL: %s validation suite(s) failed\n' "$failures" >&2
  exit 1
fi

printf '%s\n' 'PASS: SWE Forge validation batch'
