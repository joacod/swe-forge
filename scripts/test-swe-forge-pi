#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)

skip_or_fail() {
  message=$1
  if [ "${SWE_FORGE_PI_CI:-}" = 1 ]; then
    printf 'FAIL: %s\n' "$message" >&2
    exit 1
  fi
  printf 'SKIP: %s\n' "$message"
  exit 0
}

command -v node >/dev/null 2>&1 || skip_or_fail 'Pi runtime fixture (Node.js is unavailable)'
NODE_TS_ARGS=
if node --experimental-strip-types --input-type=module -e 'if (!process.features?.typescript) process.exit(1)' >/dev/null 2>&1; then
  NODE_TS_ARGS=--experimental-strip-types
elif ! node --input-type=module -e 'if (!process.features?.typescript) process.exit(1)' >/dev/null 2>&1; then
  skip_or_fail 'Pi runtime fixture (Node.js has no native TypeScript loader)'
fi

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/pi-runtime-fixture.XXXXXX")
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

fixture_cwd=$TMP_ROOT/checkout
mkdir -p "$fixture_cwd"

cd "$ROOT"
node $NODE_TS_ARGS --input-type=module - "$ROOT" "$fixture_cwd" <<'NODE'
import * as fs from "node:fs";
import { execFileSync } from "node:child_process";
import * as path from "node:path";
import { pathToFileURL } from "node:url";

const root = process.argv[2];
const fixtureCwd = process.argv[3];
const modulePath = path.join(root, ".swe-forge", "adapters", "pi", "extensions", "swe-forge-runtime.ts");
const workerBriefTool = path.join(root, ".swe-forge", "tools", "swe-forge-worker-brief");
const stateTool = path.join(root, ".swe-forge", "tools", "swe-forge-state");
const { default: extension } = await import(pathToFileURL(modulePath).href);

function renderWorkerBriefing({ taskId, role, writeAccess, allowedRead, allowedWrite }) {
  const inputPath = path.join(fixtureCwd, "brief-inputs", `${taskId}.input`);
  const records = [
    "worker-brief-input/v1",
    `task\tid\t${taskId}`,
    `task\towner_role\t${role}`,
    "task\tdepth\t1",
    `task\tobjective\tBounded ${taskId} worker objective.`,
    `task\twrite_access\t${writeAccess}`,
    "task\tacceptance\tThe worker stays within the generated briefing scope.",
    "task\tinstruction\tAGENTS.md",
    `task\tallowed_read\t${allowedRead}`,
    ...(allowedWrite ? [`task\tallowed_write\t${allowedWrite}`] : []),
    "task\texpected_output\tstructured result evidence",
    "task\tvalidation\tscripts/test-swe-forge-briefing\trequired\talways\tlocal-only",
    "state\trouting.current\tSUBAGENTS",
  ];
  fs.mkdirSync(path.dirname(inputPath), { recursive: true });
  fs.writeFileSync(inputPath, records.join("\n") + "\n");
  return execFileSync(workerBriefTool, ["render", "--input", inputPath], { encoding: "utf8" });
}

function writeRuntimeState(filePath, options = {}) {
  const cwd = options.cwd ?? fixtureCwd;
  const current = options.current ?? "SOLO";
  const preferred = options.preferred ?? "SOLO";
  const yaml = `workflow: swe-forge
workflow_version: 1
schema_version: 4
run_id: ${options.runId ?? path.basename(path.dirname(filePath))}
status: ${options.status ?? "running"}
requested_mode: AUTO
requested_delivery: PR
delivery_mode: PR
reason: fixture
fallback_used: no
delivery_checkout:
  path: ${cwd}
  branch: feature/fixture
  base_sha: none
  head_sha: none
  checkpoint_sha: none
  status: ready
  branch_setup: reused
  remote_default_evidence: fixture
routing:
  preferred: ${preferred}
  current: ${current}
receipt_ref: none
delivery:
  authorization:
    commit: PR
    push: PR
    create_pull_request: PR
    publish: not-authorized
    deploy: not-authorized
    merge: not-authorized
  commit: pending
  push: pending
  create_pull_request: pending
  sync: not-authorized
  pull_request_ref: none
continuation:
  workflow_active: ${options.workflowActive ?? "true"}
  workflow: ticket
  phase: ${options.phase ?? "implementation"}
  step: 1
  awaiting: ${options.awaiting ?? "none"}
  next_action:
    kind: ${options.nextKind ?? "implement"}
    target: ${options.nextTarget ?? "next step"}
    expected_context_tokens: ${options.expected ?? "unknown"}
  safe_boundary: true
  updated_at: ${options.updatedAt ?? "2040-01-01T00:00:00Z"}
  delivery:
    mode: PR
    pr_number: ${options.prNumber ?? "none"}
    pr_state: ${options.prState ?? "none"}
  recovery:
    host_signal: none
    status: none
context:
  status: ${options.contextStatus ?? "healthy"}
tasks: {}
`;
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, yaml);
}

const oldState = path.join(fixtureCwd, "states", "old", "run-state.yaml");
const newState = path.join(fixtureCwd, "states", "new", "run-state.yaml");
writeRuntimeState(oldState, {
  runId: "old-run",
  current: "SOLO",
  preferred: "SUBAGENTS",
  updatedAt: "2020-01-01T00:00:00Z",
  phase: "awaiting_merge",
  awaiting: "user_merge",
  nextKind: "verify_and_sync_merge",
  nextTarget: "pull request",
  prNumber: 184,
  prState: "OPEN",
  contextStatus: "near-limit",
});
writeRuntimeState(newState, {
  runId: "new-run",
  current: "SOLO",
  preferred: "SOLO",
  updatedAt: "2030-01-01T00:00:00Z",
  phase: "implementation",
  nextTarget: "next step",
  prNumber: 184,
  prState: "OPEN",
});
const terminalState = path.join(fixtureCwd, "states", "terminal", "run-state.yaml");
writeRuntimeState(terminalState, { runId: "terminal-run", status: "accepted", updatedAt: "2060-01-01T00:00:00Z" });
const inactiveState = path.join(fixtureCwd, "states", "inactive", "run-state.yaml");
writeRuntimeState(inactiveState, { runId: "inactive-run", workflowActive: "false", updatedAt: "2070-01-01T00:00:00Z" });
const mismatchState = path.join(fixtureCwd, "states", "mismatch", "run-state.yaml");
writeRuntimeState(mismatchState, { runId: "mismatch-run", cwd: path.join(fixtureCwd, "other"), updatedAt: "2080-01-01T00:00:00Z" });
const resolvedStates = JSON.parse(execFileSync(stateTool, [
  "resolve-active", "--checkout", fixtureCwd, "--candidate", oldState, "--candidate", newState,
  "--candidate", terminalState, "--candidate", inactiveState, "--candidate", mismatchState, "--all",
], { encoding: "utf8" }));
if (resolvedStates.states.length !== 2 || resolvedStates.states[0].run_id !== "new-run") throw new Error("canonical state resolution did not exclude stale states or choose newest");
const terminalInspection = JSON.parse(execFileSync(stateTool, ["inspect", "--state", terminalState, "--checkout", fixtureCwd], { encoding: "utf8" }));
if (terminalInspection.active !== false) throw new Error("terminal state became active");
const mismatchInspection = JSON.parse(execFileSync(stateTool, ["inspect", "--state", mismatchState, "--checkout", fixtureCwd], { encoding: "utf8" }));
if (mismatchInspection.active !== false || mismatchInspection.reason !== "checkout mismatch") throw new Error("mismatching state became active");


process.env.HOME = path.join(fixtureCwd, "home");
fs.mkdirSync(path.join(process.env.HOME, ".pi", "agent"), { recursive: true });
process.env.SWE_FORGE_RUN_STATE = oldState;
const handlers = new Map();
const entries = [];
const pi = {
  on(name, handler) { handlers.set(name, handler); },
  appendEntry(type, data) { entries.push({ type, data }); },
  exec(command, args) {
    try { return { code: 0, stdout: execFileSync(command, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }), stderr: "" }; }
    catch (error) { return { code: error?.status ?? 1, stdout: "", stderr: error?.message ?? String(error) }; }
  },
};
extension(pi);
const ctx = {
  cwd: fixtureCwd,
  isProjectTrusted: () => true,
  hasPendingMessages: () => false,
  getContextUsage: () => ({ tokens: 90_000, contextWindow: 100_000 }),
  compact(options) { this.compaction = options; },
};

const injected = await handlers.get("before_agent_start")({ systemPrompt: "base" }, ctx);
if (!injected?.systemPrompt.includes("SWE-FORGE ACTIVE RUN")) throw new Error("missing continuation injection");
if (!injected.systemPrompt.includes("PR: #184 OPEN")) throw new Error("missing PR continuation state");

const boundedState = path.join(fixtureCwd, "states", "bounded", "run-state.yaml");
const boundedMarker = "bounded-tail-marker";
const oversized = `prefix-${"x".repeat(5000)}-${boundedMarker}`;
writeRuntimeState(boundedState, {
  runId: "bounded-run",
  phase: "implementation",
  nextTarget: oversized,
  updatedAt: "2060-01-01T00:00:00Z",
});
process.env.SWE_FORGE_RUN_STATE = boundedState;
const boundedInjection = await handlers.get("before_agent_start")({ systemPrompt: "base" }, ctx);
if (!boundedInjection?.systemPrompt.includes("SWE-FORGE ACTIVE RUN")) throw new Error("bounded state did not inject");
if (boundedInjection.systemPrompt.includes(boundedMarker)) throw new Error("continuation forwarded an oversized scalar");

process.env.SWE_FORGE_RUN_STATE = oldState;
const transformed = await handlers.get("input")({ text: "merged", source: "interactive" }, ctx);
if (transformed?.text !== "/git-sync merged") throw new Error("active merged shorthand was not routed");
await handlers.get("agent_settled")({}, ctx);
if (!ctx.compaction) throw new Error("safe-boundary proactive compaction was not requested");
if (!entries.some((entry) => entry.data.event === "proactive_compaction_requested")) throw new Error("compaction evidence missing");

process.env.SWE_FORGE_RUN_STATE = newState;
const refreshed = await handlers.get("before_agent_start")({ systemPrompt: "base" }, ctx);
if (!refreshed?.systemPrompt.includes("phase: implementation")) throw new Error("newer state did not win");
const newerTransform = await handlers.get("input")({ text: "merged", source: "interactive" }, ctx);
if (newerTransform) throw new Error("stale state overrode newer continuation");

const staleState = path.join(fixtureCwd, "states", "stale", "run-state.yaml");
fs.mkdirSync(path.dirname(staleState), { recursive: true });
fs.writeFileSync(staleState, `workflow: swe-forge\nschema_version: 3\nstatus: running\n`);
process.env.SWE_FORGE_RUN_STATE = staleState;
const staleInjection = await handlers.get("before_agent_start")({ systemPrompt: "base" }, ctx);
if (staleInjection?.systemPrompt.includes("SWE-FORGE ACTIVE RUN")) throw new Error("stale schema was accepted");
const obsoleteState = path.join(fixtureCwd, "states", "obsolete", "run-state.yaml");
writeRuntimeState(obsoleteState, {
  runId: "obsolete-run",
  current: "SUBAGENTS",
  preferred: "SUBAGENTS",
  updatedAt: "2060-01-01T00:00:00Z",
});
fs.writeFileSync(
  obsoleteState,
  fs.readFileSync(obsoleteState, "utf8").replace("routing:\n", "routing:\n  initial: SUBAGENTS\n"),
);
process.env.SWE_FORGE_RUN_STATE = obsoleteState;
const obsoleteInjection = await handlers.get("before_agent_start")({ systemPrompt: "base" }, ctx);
if (obsoleteInjection?.systemPrompt.includes("SWE-FORGE ACTIVE RUN")) throw new Error("obsolete routing state was accepted");


const subagentState = path.join(fixtureCwd, "states", "subagent", "run-state.yaml");
writeRuntimeState(subagentState, {
  runId: "subagent-run",
  current: "SUBAGENTS",
  preferred: "SUBAGENTS",
  updatedAt: "2050-01-01T00:00:00Z",
});
process.env.SWE_FORGE_RUN_STATE = subagentState;
const subagentHandlers = new Map();
const subagentEntries = [];
const subagentPi = {
  on(name, handler) { subagentHandlers.set(name, handler); },
  getAllTools() { return [{ name: "swe_forge_subagent" }]; },
  getActiveTools() { return ["swe_forge_subagent"]; },
  appendEntry(type, data) { subagentEntries.push({ type, data }); },
  exec(command, args) {
    try { return { code: 0, stdout: execFileSync(command, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }), stderr: "" }; }
    catch (error) { return { code: error?.status ?? 1, stdout: "", stderr: error?.message ?? String(error) }; }
  },
};
extension(subagentPi);
const subagentContext = { cwd: fixtureCwd, isProjectTrusted: () => true, hasPendingMessages: () => false };
const subagentPrompt = await subagentHandlers.get("before_agent_start")({ prompt: "ordinary continuation turn", systemPrompt: "base" }, subagentContext);
if (!subagentPrompt?.systemPrompt.includes("swe_forge_subagent tool observed by the Pi adapter: available")) throw new Error("capability was not advertised");
const capabilitiesInput = { action: "capabilities" };
if (await subagentHandlers.get("tool_call")({ toolName: "swe_forge_subagent", input: capabilitiesInput }, subagentContext)) throw new Error("capability discovery was blocked");
const capabilityDetails = {
  protocolVersion: 1,
  packageVersion: "0.1.0",
  pi: { compatibilityRange: ">=0.84.1 <0.85.0", versionVerification: "before_execution" },
  isolation: { contextIsolation: true, processIsolation: true, filesystemIsolation: false, osSandbox: false },
  trust: { workerPermissions: "user_os_permissions", sandbox: false },
  sweForge: { installed: true, version: "0.1.0-alpha.1" },
  roles: ["reader", "writer"],
  readOnlyParallelSupport: true,
  writableConcurrencySupport: false,
  nestedDelegationSupport: false,
  availableProfiles: ["READ_ONLY", "WRITABLE"],
  profileTools: {
    READ_ONLY: ["read", "grep", "find", "ls"],
    WRITABLE: ["read", "grep", "find", "ls", "edit", "write", "bash"],
  },
  compatibilityErrors: [],
};
await subagentHandlers.get("tool_result")({ toolName: "swe_forge_subagent", input: capabilitiesInput, details: capabilityDetails, isError: false }, subagentContext);
const workerBriefingContract = renderWorkerBriefing({ taskId: "reader-check", role: "reader", writeAccess: "read-only", allowedRead: "src/parser.ts#parseRecord" });
const runInput = { action: "run", role: "reader", workerBriefing: workerBriefingContract, expectedOutputContract: "result", profile: "READ_ONLY" };
if (await subagentHandlers.get("tool_call")({ toolName: "swe_forge_subagent", input: runInput }, subagentContext)) throw new Error("valid delegated run was blocked");
const invalidBriefRun = await subagentHandlers.get("tool_call")({ toolName: "swe_forge_subagent", input: { ...runInput, workerBriefing: workerBriefingContract.replace(/^  objective:.*$/m, "") } }, subagentContext);
if (!invalidBriefRun?.block || !invalidBriefRun.reason.includes("Canonical worker briefing validation failed")) throw new Error("invalid briefing was accepted");

writeRuntimeState(subagentState, { runId: "solo-run", current: "SOLO", preferred: "SOLO", updatedAt: "2051-01-01T00:00:00Z" });
const soloPrompt = await subagentHandlers.get("before_agent_start")({ prompt: "ordinary continuation turn", systemPrompt: "base" }, subagentContext);
if (soloPrompt?.systemPrompt.includes("swe_forge_subagent")) throw new Error("unselected capability was injected into SOLO");
const reroutedAttempt = await subagentHandlers.get("tool_call")({ toolName: "swe_forge_subagent", input: runInput }, subagentContext);
if (!reroutedAttempt?.block || !reroutedAttempt.reason.includes("Canonical routing selected SOLO")) throw new Error("SOLO fallback was not enforced");

const fallbackHandlers = new Map();
const fallbackPi = { on(name, handler) { fallbackHandlers.set(name, handler); }, getAllTools() { return []; }, getActiveTools() { return []; }, appendEntry() {} };
extension(fallbackPi);
const fallbackContext = { cwd: fixtureCwd, hasPendingMessages: () => false, isProjectTrusted: () => true };
await fallbackHandlers.get("before_agent_start")({ prompt: "The user explicitly invoked SWE Forge through Pi.", systemPrompt: "base" }, fallbackContext);
const fallbackAttempt = await fallbackHandlers.get("tool_call")({ toolName: "swe_forge_subagent", input: capabilitiesInput }, fallbackContext);
if (!fallbackAttempt?.block || !fallbackAttempt.reason.includes("fallback")) throw new Error("missing native capability did not preserve fallback");

console.log("PASS: Pi runtime extension fixture");
NODE
