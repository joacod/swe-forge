#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
INSTALL=$ROOT/scripts/swe-forge
HARNESSES='opencode omp claude codex cursor pi'
DELIVERY_COMMANDS='git-commit git-push git-pr git-sync'
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-test.XXXXXX")
TMP_ROOT=$(CDPATH= cd "$TMP_ROOT" && pwd -P)

cleanup() {
  rm -rf "$TMP_ROOT"
}

trap cleanup EXIT HUP INT TERM

fail() {
  printf 'test failure: %s\n' "$*" >&2
  exit 1
}

expect_failure() {
  expected=$1
  shift
  if output=$("$@" 2>&1); then
    fail "expected command to fail: $*"
  fi
  case "$output" in
    *"$expected"*) ;;
    *) fail "failure did not contain '$expected': $output" ;;
  esac
}

forge() {
  forge_home=$1
  shift
  HOME="$forge_home" "$INSTALL" "$@"
}

assert_link() {
  assert_path=$1
  expected_target=$2
  test -L "$assert_path" || fail "expected source link: $assert_path"
  test "$(readlink "$assert_path")" = "$expected_target" || \
    fail "unexpected link target for $assert_path"
}

assert_support_tree() {
  support=$1
  assert_link "$support/AGENTS.md" "$ROOT/AGENTS.md"
  assert_link "$support/SWE-FORGE.md" "$ROOT/SWE-FORGE.md"
  assert_link "$support/VERSION" "$ROOT/VERSION"
  test -d "$support/.swe-forge" || fail "support tree is missing: $support/.swe-forge"
  test ! -L "$support/.swe-forge" || fail "support root must be a real directory: $support/.swe-forge"

  for source_dir in "$ROOT/.swe-forge"/*; do
    [ -d "$source_dir" ] || continue
    entry_name=${source_dir##*/}
    case "$entry_name" in
      adapters|runs|.runs|generated) continue ;;
    esac
    assert_link "$support/.swe-forge/$entry_name" "$source_dir"
  done
  test ! -e "$support/.swe-forge/adapters" || fail "adapter catalog was installed"
  test -x "$support/.swe-forge/tools/swe-forge-invocation" || \
    fail "installed canonical invocation parser is not executable"
}

assert_projection() {
  projection_home=$1
  projection_harness=$2
  case "$projection_harness" in
    opencode)
      projection_support=$projection_home/.config/opencode/swe-forge
      assert_link "$projection_home/.config/opencode/commands/swe-forge.md" \
        "$ROOT/.swe-forge/adapters/opencode/commands/swe-forge.md"
      for command in $DELIVERY_COMMANDS; do
        assert_link "$projection_home/.config/opencode/commands/$command.md" \
          "$ROOT/.swe-forge/adapters/opencode/commands/$command.md"
      done
      ;;
    claude)
      projection_support=$projection_home/.claude/swe-forge
      assert_link "$projection_home/.claude/skills/swe-forge" \
        "$ROOT/.swe-forge/adapters/claude-code/skills/swe-forge"
      ;;
    omp)
      projection_support=$projection_home/.omp/agent/swe-forge
      assert_link "$projection_home/.omp/agent/prompts/swe-forge.md" \
        "$ROOT/.swe-forge/adapters/omp/prompts/swe-forge.md"
      assert_link "$projection_home/.omp/agent/extensions/swe-forge-runtime.ts" \
        "$ROOT/.swe-forge/adapters/omp/extensions/swe-forge-runtime.ts"
      for profile in swe-forge-read-only swe-forge-writable swe-forge-reviewer; do
        assert_link "$projection_home/.omp/agent/agents/$profile.md" \
          "$ROOT/.swe-forge/adapters/omp/agents/$profile.md"
      done
      ;;
    codex|cursor)
      projection_support=$projection_home/.agents/swe-forge
      assert_link "$projection_home/.agents/skills/swe-forge" \
        "$ROOT/.swe-forge/adapters/shared/agent-skill/swe-forge"
      ;;
    pi)
      projection_support=$projection_home/.pi/agent/swe-forge
      assert_link "$projection_home/.pi/agent/prompts/swe-forge.md" \
        "$ROOT/.swe-forge/adapters/pi/prompts/swe-forge.md"
      for command in $DELIVERY_COMMANDS; do
        assert_link "$projection_home/.pi/agent/prompts/$command.md" \
          "$ROOT/.swe-forge/adapters/pi/prompts/$command.md"
      done
      assert_link "$projection_home/.pi/agent/extensions/swe-forge-runtime.ts" \
        "$ROOT/.swe-forge/adapters/pi/extensions/swe-forge-runtime.ts"
      ;;
    *) fail "unknown fixture harness: $projection_harness" ;;
  esac
  assert_support_tree "$projection_support"
}

version_output=$($INSTALL version)
grep -F 'SWE Forge version: ' <<EOF_VERSION >/dev/null
$version_output
EOF_VERSION

# Every harness installs the same way: globally, idempotently, and by link.
homes_root=$TMP_ROOT/homes
mkdir -p "$homes_root"
for harness in $HARNESSES; do
  harness_home=$homes_root/$harness
  mkdir -p "$harness_home"
  forge "$harness_home" install "$harness" >/dev/null
  forge "$harness_home" install "$harness" >/dev/null
  forge "$harness_home" verify "$harness" >/dev/null
  assert_projection "$harness_home" "$harness"
done

# Dry-run install performs preflight only.
dry_home=$TMP_ROOT/dry-home
mkdir -p "$dry_home"
forge "$dry_home" install opencode --dry-run >"$TMP_ROOT/install-dry-run"
grep -F 'dry-run: no files, links, locks, or manifests will be changed' \
  "$TMP_ROOT/install-dry-run" >/dev/null || fail 'install dry-run omitted its no-write notice'
test ! -e "$dry_home/.config" || fail 'install dry-run created harness directories'
test ! -e "$dry_home/.swe-forge-install-state" || fail 'install dry-run wrote a manifest'
test ! -e "$dry_home/.swe-forge-install.lock" || fail 'install dry-run wrote a lock'

# Status, doctor, update, ownership checks, and uninstall use one managed link model.
lifecycle_home=$TMP_ROOT/lifecycle-home
mkdir -p "$lifecycle_home"
forge "$lifecycle_home" install opencode >/dev/null
forge "$lifecycle_home" status opencode >"$TMP_ROOT/status-output"
grep -F 'managed paths:' "$TMP_ROOT/status-output" >/dev/null || fail 'status omitted managed path count'
grep -F 'verification: PASS' "$TMP_ROOT/status-output" >/dev/null || fail 'status omitted verification'
if grep -E '^(scope|mode):' "$TMP_ROOT/status-output" >/dev/null; then
  fail 'status still reports removed installation dimensions'
fi
forge "$lifecycle_home" doctor opencode >"$TMP_ROOT/doctor-output"
grep -F 'doctor: PASS' "$TMP_ROOT/doctor-output" >/dev/null || fail 'doctor omitted PASS'
forge "$lifecycle_home" update opencode --dry-run >"$TMP_ROOT/update-current-dry-run"
grep -F 'would do nothing' "$TMP_ROOT/update-current-dry-run" >/dev/null || \
  fail 'update dry-run did not report a current installation'

manifest="$lifecycle_home/.swe-forge-install-state/opencode.tsv"
test -f "$manifest" || fail 'installation manifest is missing'

managed_link="$lifecycle_home/.config/opencode/commands/git-pr.md"
managed_target="$ROOT/.swe-forge/adapters/opencode/commands/git-pr.md"
rm "$managed_link"
forge "$lifecycle_home" verify opencode >/dev/null 2>&1 && \
  fail 'verify accepted a missing managed link'
forge "$lifecycle_home" update opencode --dry-run >"$TMP_ROOT/update-missing-dry-run"
grep -F 'would add:' "$TMP_ROOT/update-missing-dry-run" >/dev/null || \
  fail 'update dry-run omitted the missing link'
test ! -e "$managed_link" || fail 'update dry-run changed a missing link'
test ! -e "$lifecycle_home/.swe-forge-install.lock" || fail 'update dry-run created a lock'
forge "$lifecycle_home" update opencode >/dev/null
assert_link "$managed_link" "$managed_target"

stale_link="$lifecycle_home/.config/opencode/commands/stale.md"
ln -s "$ROOT/README.md" "$stale_link"
printf 'entry\tfile\t.config/opencode/commands/stale.md\t%s\t%s\n' \
  "$ROOT/README.md" "$ROOT/README.md" >>"$manifest"
forge "$lifecycle_home" update opencode >/dev/null
test ! -e "$stale_link" || fail 'update left a stale managed link'

rm "$managed_link"
ln -s "$ROOT/README.md" "$managed_link"
expect_failure 'managed link was modified' forge "$lifecycle_home" update opencode
expect_failure 'managed link was modified' forge "$lifecycle_home" uninstall opencode
assert_link "$managed_link" "$ROOT/README.md"
rm "$managed_link"
ln -s "$managed_target" "$managed_link"

rm "$managed_link"
printf '%s\n' ambiguous >"$managed_link"
expect_failure 'managed link was replaced by a non-link' forge "$lifecycle_home" update opencode
expect_failure 'managed link is no longer a link' forge "$lifecycle_home" uninstall opencode
rm "$managed_link"
ln -s "$managed_target" "$managed_link"

unmanaged="$lifecycle_home/.config/opencode/commands/unmanaged.md"
printf '%s\n' 'leave this file alone' >"$unmanaged"
forge "$lifecycle_home" uninstall opencode >/dev/null
test -f "$unmanaged" || fail 'uninstall removed an unmanaged file'
test ! -e "$lifecycle_home/.config/opencode/commands/swe-forge.md" || \
  fail 'uninstall left a managed link'
test ! -e "$lifecycle_home/.swe-forge-install-state" || \
  fail 'uninstall left the empty manifest directory'

# Shared canonical support is retained while another harness manifest owns it.
shared_home=$TMP_ROOT/shared-home
mkdir -p "$shared_home"
forge "$shared_home" install codex >/dev/null
forge "$shared_home" install cursor >/dev/null
forge "$shared_home" uninstall codex >/dev/null
assert_link "$shared_home/.agents/skills/swe-forge" \
  "$ROOT/.swe-forge/adapters/shared/agent-skill/swe-forge"
assert_support_tree "$shared_home/.agents/swe-forge"
test -f "$shared_home/.swe-forge-install-state/cursor.tsv" || \
  fail 'shared harness manifest was removed too early'
forge "$shared_home" uninstall cursor >/dev/null
test ! -e "$shared_home/.agents/skills/swe-forge" || \
  fail 'final shared uninstall left an adapter link'
test ! -e "$shared_home/.agents/swe-forge/AGENTS.md" || \
  fail 'final shared uninstall left a managed canonical link'

# Conflicts and locks stop before writing anything.
conflict_home=$TMP_ROOT/conflict-home
mkdir -p "$conflict_home/.config/opencode/commands"
printf '%s\n' 'existing command' >"$conflict_home/.config/opencode/commands/swe-forge.md"
expect_failure 'installation stopped before writing' forge "$conflict_home" install opencode
test ! -e "$conflict_home/.config/opencode/swe-forge" || \
  fail 'conflict partially wrote canonical support'

symlink_home=$TMP_ROOT/symlink-home
symlink_external=$TMP_ROOT/symlink-external
mkdir -p "$symlink_home" "$symlink_external"
ln -s "$symlink_external" "$symlink_home/.config"
expect_failure 'destination path contains a symlinked directory' \
  forge "$symlink_home" install opencode
test ! -e "$symlink_external/opencode" || \
  fail 'symlinked directory received installer output'

locked_home=$TMP_ROOT/locked-home
mkdir -p "$locked_home/.swe-forge-install.lock"
expect_failure 'another installation may be active' forge "$locked_home" install opencode
test -d "$locked_home/.swe-forge-install.lock" || fail 'installer removed another lock'

# Registry validation remains transactional before any installation write.
invalid_source=$TMP_ROOT/invalid-source
invalid_home=$TMP_ROOT/invalid-home
mkdir -p "$invalid_source" "$invalid_home"
cp -R "$ROOT/scripts" "$invalid_source/"
cp -R "$ROOT/.swe-forge" "$invalid_source/"
cp "$ROOT/AGENTS.md" "$ROOT/SWE-FORGE.md" "$ROOT/VERSION" "$invalid_source/"
printf '%s\n' \
  'opencode|file|opencode/commands/swe-forge.md|../outside|.config/opencode/swe-forge' \
  >"$invalid_source/.swe-forge/adapters/registry.tsv"
expect_failure 'invalid adapter registry row' env HOME="$invalid_home" \
  "$invalid_source/scripts/swe-forge" install opencode
test ! -e "$invalid_home/.swe-forge-install-state" || \
  fail 'invalid registry wrote installation state'

# Failed writes and signals roll back links, directories, manifests, and locks.
rollback_home=$TMP_ROOT/rollback-home
fake_bin=$TMP_ROOT/fake-bin
ln_count=$TMP_ROOT/ln-count
mkdir -p "$rollback_home" "$fake_bin"
real_ln=$(command -v ln)
cat >"$fake_bin/ln" <<EOF_LN
#!/bin/sh
count=0
test ! -f "$ln_count" || count=\$(cat "$ln_count")
count=\$((count + 1))
printf '%s\\n' "\$count" >"$ln_count"
test "\$count" -lt 3 || exit 73
exec "$real_ln" "\$@"
EOF_LN
chmod +x "$fake_bin/ln"
expect_failure 'could not install' env PATH="$fake_bin:$PATH" HOME="$rollback_home" \
  "$INSTALL" install opencode
test ! -e "$rollback_home/.config" || fail 'failed install left harness directories'
test ! -e "$rollback_home/.swe-forge-install-state" || fail 'failed install left a manifest'
test ! -e "$rollback_home/.swe-forge-install.lock" || fail 'failed install left a lock'

signal_home=$TMP_ROOT/signal-home
signal_bin=$TMP_ROOT/signal-bin
mkdir -p "$signal_home" "$signal_bin"
cat >"$signal_bin/ln" <<EOF_SIGNAL
#!/bin/sh
"$real_ln" "\$@" || exit
kill -TERM "\$PPID"
exit 0
EOF_SIGNAL
chmod +x "$signal_bin/ln"
if env PATH="$signal_bin:$PATH" HOME="$signal_home" "$INSTALL" install opencode >/dev/null 2>&1; then
  fail 'signal-injected install unexpectedly passed'
else
  signal_status=$?
fi
test "$signal_status" -eq 143 || fail "signal-injected install returned $signal_status instead of 143"
test ! -e "$signal_home/.config" || fail 'signal rollback left harness directories'
test ! -e "$signal_home/.swe-forge-install.lock" || fail 'signal rollback left a lock'

mkdir_signal_home=$TMP_ROOT/mkdir-signal-home
mkdir_signal_bin=$TMP_ROOT/mkdir-signal-bin
mkdir_count=$TMP_ROOT/mkdir-count
mkdir -p "$mkdir_signal_home" "$mkdir_signal_bin"
real_mkdir=$(command -v mkdir)
cat >"$mkdir_signal_bin/mkdir" <<EOF_MKDIR
#!/bin/sh
count=0
test ! -f "$mkdir_count" || count=\$(cat "$mkdir_count")
count=\$((count + 1))
printf '%s\\n' "\$count" >"$mkdir_count"
"$real_mkdir" "\$@" || exit
test "\$count" -ne 2 || kill -TERM "\$PPID"
exit 0
EOF_MKDIR
chmod +x "$mkdir_signal_bin/mkdir"
if env PATH="$mkdir_signal_bin:$PATH" HOME="$mkdir_signal_home" "$INSTALL" install opencode >/dev/null 2>&1; then
  fail 'directory-signal install unexpectedly passed'
else
  mkdir_signal_status=$?
fi
test "$mkdir_signal_status" -eq 143 || \
  fail "directory-signal install returned $mkdir_signal_status instead of 143"
test ! -e "$mkdir_signal_home/.config" || fail 'directory-signal rollback left directories'
test ! -e "$mkdir_signal_home/.swe-forge-install.lock" || \
  fail 'directory-signal rollback left a lock'

# Obsolete scope and copy syntax is rejected instead of silently changing meaning.
expect_failure '--target is no longer supported' "$INSTALL" install opencode --target "$TMP_ROOT/old"
expect_failure '--global is no longer supported' "$INSTALL" install opencode --global
expect_failure '--mode is no longer supported' "$INSTALL" install opencode --mode copy
expect_failure 'project installation is no longer supported' "$INSTALL" install opencode "$TMP_ROOT/old"
expect_failure 'HOME must be an absolute path' env HOME=relative "$INSTALL" install opencode

"$ROOT/scripts/check-swe-forge" >/dev/null

printf '%s\n' 'PASS: installer fixture tests'
