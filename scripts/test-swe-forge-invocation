#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
PARSER=$ROOT/.swe-forge/tools/swe-forge-invocation
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-invocation.XXXXXX")
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'test failure: %s\n' "$*" >&2
  exit 1
}

assert_parse() {
  raw=$1
  expected=$2
  actual=$($PARSER parse --raw-arguments "$raw") || fail "parser rejected: $raw"
  [ "$actual" = "$expected" ] || {
    printf 'expected: %s\nactual:   %s\n' "$expected" "$actual" >&2
    fail "unexpected parse result for: $raw"
  }
}

assert_parse '' \
  '{"raw_arguments":"","parsed_ticket":"","delivery_mode":"PR","input_status":"EMPTY"}'
assert_parse 'implement the parser' \
  '{"raw_arguments":"implement the parser","parsed_ticket":"implement the parser","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'solo implement the parser' \
  '{"raw_arguments":"solo implement the parser","parsed_ticket":"solo implement the parser","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'subagents guided inspect the adapters' \
  '{"raw_arguments":"subagents guided inspect the adapters","parsed_ticket":"subagents guided inspect the adapters","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'pr implement the parser' \
  '{"raw_arguments":"pr implement the parser","parsed_ticket":"implement the parser","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'guided implement the parser' \
  '{"raw_arguments":"guided implement the parser","parsed_ticket":"implement the parser","delivery_mode":"GUIDED","input_status":"COMPLETE"}'
assert_parse 'guided solo inspect the adapters' \
  '{"raw_arguments":"guided solo inspect the adapters","parsed_ticket":"solo inspect the adapters","delivery_mode":"GUIDED","input_status":"COMPLETE"}'
assert_parse 'pr subagents inspect the adapters' \
  '{"raw_arguments":"pr subagents inspect the adapters","parsed_ticket":"subagents inspect the adapters","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'subagents pr' \
  '{"raw_arguments":"subagents pr","parsed_ticket":"subagents pr","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'guided' \
  '{"raw_arguments":"guided","parsed_ticket":"","delivery_mode":"GUIDED","input_status":"INCOMPLETE"}'
assert_parse 'SOLO PR uppercase words remain ticket text' \
  '{"raw_arguments":"SOLO PR uppercase words remain ticket text","parsed_ticket":"SOLO PR uppercase words remain ticket text","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'unknown solo pr words stay ticket text' \
  '{"raw_arguments":"unknown solo pr words stay ticket text","parsed_ticket":"unknown solo pr words stay ticket text","delivery_mode":"PR","input_status":"COMPLETE"}'
assert_parse 'former command token remains ticket text' \
  '{"raw_arguments":"former command token remains ticket text","parsed_ticket":"former command token remains ticket text","delivery_mode":"PR","input_status":"COMPLETE"}'

raw_file=$TMP_ROOT/raw-arguments
printf '  solo\tpr  preserve  "quoted"  \\\\ text\nwith a second line  \n' >"$raw_file"
actual=$($PARSER parse --stdin <"$raw_file")
expected='{"raw_arguments":"  solo\tpr  preserve  \"quoted\"  \\\\ text\nwith a second line  \n","parsed_ticket":"solo\tpr  preserve  \"quoted\"  \\\\ text\nwith a second line","delivery_mode":"PR","input_status":"COMPLETE"}'
[ "$actual" = "$expected" ] || {
  printf 'expected: %s\nactual:   %s\n' "$expected" "$actual" >&2
  fail 'whitespace or exact-content preservation failed'
}

first=$($PARSER parse --raw-arguments 'pr solo deterministic output')
iteration=1
while [ "$iteration" -le 20 ]; do
  current=$($PARSER parse --raw-arguments 'pr solo deterministic output')
  [ "$current" = "$first" ] || fail 'repeated parser output was not deterministic'
  iteration=$((iteration + 1))
done

long_ticket=$(awk 'BEGIN { for (i = 0; i < 9000; i++) printf "x"; print "" }')
long_parse=$($PARSER parse --raw-arguments "pr $long_ticket")
case "$long_parse" in
  *'"input_status":"COMPLETE"'*) ;;
  *) fail 'long invocation was not parsed as a complete ticket' ;;
esac

state_repo=$TMP_ROOT/state-repo
mkdir -p "$state_repo"
git -C "$state_repo" init -q
git -C "$state_repo" config user.email parser-fixture@example.com
git -C "$state_repo" config user.name 'Invocation Parser Fixture'
printf '%s\n' base >"$state_repo/base.txt"
git -C "$state_repo" add base.txt
git -C "$state_repo" commit -qm 'Fixture base'
normalized=$($PARSER parse --raw-arguments 'initialize from parser facts')
json_value() {
  case "$1" in
    delivery_mode) printf '%s\n' "$normalized" | sed -n 's/.*"delivery_mode":"\([^"]*\)".*/\1/p' ;;
    *) fail "unknown parser JSON field: $1" ;;
  esac
}
state_dir=$TMP_ROOT/state
$ROOT/scripts/swe-forge-state init --state "$state_dir" --checkout "$state_repo" \
  --delivery-mode "$(json_value delivery_mode)" >/dev/null
$ROOT/scripts/swe-forge-state validate --state "$state_dir" >/dev/null
grep -F 'schema_version: 4' "$state_dir/run-state.yaml" >/dev/null
grep -F 'delivery_mode: PR' "$state_dir/run-state.yaml" >/dev/null

printf '%s\n' 'PASS: invocation parser fixture tests'
