#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
GATE=$ROOT/scripts/swe-forge-gate
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-gate-test.XXXXXX")

cleanup() {
  rm -rf "$TMP_ROOT"
}

trap cleanup EXIT HUP INT TERM

fail() {
  printf 'test failure: %s\n' "$*" >&2
  exit 1
}

expect_failure() {
  expected=$1
  shift
  if output=$("$@" 2>&1); then
    fail "expected command to fail: $*"
  fi
  case "$output" in
    *"$expected"*) ;;
    *) fail "failure did not contain '$expected': $output" ;;
  esac
}

expect_repo_failure() {
  expected=$1
  repo=$2
  shift 2
  if output=$(cd "$repo" && "$@" 2>&1); then
    fail "expected command to fail: $*"
  fi
  case "$output" in
    *"$expected"*) ;;
    *) fail "failure did not contain '$expected': $output" ;;
  esac
}

make_repo() {
  name=$1
  repo=$TMP_ROOT/$name
  mkdir -p "$repo"
  git -C "$repo" init -q
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name "SWE Forge Test"
  printf 'base\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -qm 'Initial commit'
  git -C "$repo" branch -M main
  printf '%s\n' "$repo"
}

clean_feature_state() {
  repo=$1
  git -C "$repo" checkout -qb feature
  state=$TMP_ROOT/$(basename "$repo").state
  printf '%s\n' "$state"
}

repo=$(make_repo clean)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name smoke --requirement required --final-required false >/dev/null
  printf 'changed\n' >>README.md
  "$GATE" validate --state "$state" --name smoke -- \
    sh -c 'grep -q changed README.md' >/dev/null
  "$GATE" checkpoint --scope README.md --state "$state" >/dev/null
  "$GATE" commit-slice --state "$state" --checkpoint 1 \
    --message 'Record gate evidence' --authorized-by PR >/dev/null
  "$GATE" plan-check --state "$state" --name final-smoke --requirement required >/dev/null
  "$GATE" validate --state "$state" --name final-smoke \
    --final -- sh -c 'grep -q changed README.md' >/dev/null
  "$GATE" review --state "$state" --result PASS --source fresh-context \
    --findings 1 --repaired 1 >/dev/null
  "$GATE" deliver-pr --state "$state" >/dev/null
  "$GATE" receipt --state "$state" --execution SOLO --delivery PR \
    --pr-url https://github.com/example/repo/pull/1 \
    --forge-version 0.1.0-alpha.1 --harness Pi --harness-version 0.84.1 \
    --requested-mode AUTO --selected-mode SOLO --execution-provider NONE \
    --model-provider openai-codex --routing-reason 'tightly coupled test fixture' \
    --model test-model --output "$TMP_ROOT/receipt.md" >/dev/null
)
grep -F 'Final status: ACCEPTED' "$TMP_ROOT/receipt.md" >/dev/null || \
  fail "accepted receipt is missing final status"
grep -F 'Fresh review: PASS — 1 findings, 1 repaired' "$TMP_ROOT/receipt.md" >/dev/null || \
  fail "receipt is missing review summary"
grep -F -- '- Harness: Pi 0.84.1' "$TMP_ROOT/receipt.md" >/dev/null || \
  fail "receipt is missing harness metadata"
grep -F -- '- Routing: AUTO -> SOLO' "$TMP_ROOT/receipt.md" >/dev/null || \
  fail "receipt is missing routing metadata"
grep -F -- '- Execution provider: NONE' "$TMP_ROOT/receipt.md" >/dev/null || \
  fail "receipt is missing execution-provider metadata"
grep -F -- '- Model provider: openai-codex' "$TMP_ROOT/receipt.md" >/dev/null || \
  fail "receipt is missing model-provider metadata"
if grep -F 'Merge performed: no' "$TMP_ROOT/receipt.md" >/dev/null; then
  fail "receipt exposes a merge status that becomes stale after PR creation"
fi
if grep -F 'grep -q' "$TMP_ROOT/receipt.md" >/dev/null; then
  fail "receipt leaked validation command output"
fi

# Regression: PR mode can validate and commit multiple sequential slices in one
# run, including a newly added file whose fingerprint is stable before and after
# staging.
repo=$(make_repo multi-slice)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name first-slice \
    --requirement required --final-required false >/dev/null
  printf 'first slice\n' >>README.md
  "$GATE" validate --state "$state" --name first-slice -- \
    sh -c 'grep -q "first slice" README.md' >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
  "$GATE" commit-slice --state "$state" --checkpoint 1 \
    --message 'Record first slice' --authorized-by PR >/dev/null
  "$GATE" plan-check --state "$state" --name second-slice \
    --requirement required --final-required false >/dev/null
  printf 'second slice\n' >SECOND.md
  "$GATE" validate --state "$state" --name second-slice -- \
    test -f SECOND.md >/dev/null
  "$GATE" checkpoint --state "$state" --scope SECOND.md >/dev/null
  "$GATE" commit-slice --state "$state" --checkpoint 2 \
    --message 'Record second slice' --authorized-by PR >/dev/null
)
test "$(git -C "$repo" rev-list --count main..HEAD)" -eq 2 || \
  fail "multi-slice run did not create one commit per slice"
git -C "$repo" show HEAD:SECOND.md | grep -Fx 'second slice' >/dev/null || \
  fail "second slice was not committed"

# Regression: final-only checks can be planned before a slice without forcing
# the full final suite to run before the slice commit.
repo=$(make_repo deferred-final)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name slice-check \
    --requirement required --final-required false >/dev/null
  "$GATE" plan-check --state "$state" --name final-check \
    --requirement required >/dev/null
  printf 'deferred final\n' >>README.md
  "$GATE" validate --state "$state" --name slice-check -- \
    grep -q 'deferred final' README.md >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
  "$GATE" commit-slice --state "$state" --checkpoint 1 \
    --message 'Commit before final validation' --authorized-by PR >/dev/null
)
expect_repo_failure 'required or applicable final validation' "$repo" "$GATE" \
  deliver-pr --state "$state"

# Regression: an out-of-band commit is still rejected instead of being mixed
# into the next evidence checkpoint.
repo=$(make_repo out-of-band)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name slice \
    --requirement required --final-required false >/dev/null
  printf 'untracked slice\n' >SLICE.md
  "$GATE" validate --state "$state" --name slice -- test -f SLICE.md >/dev/null
  git add SLICE.md
  git commit -qm 'Untracked delivery outside gate'
  printf 'later slice\n' >LATER.md
)
expect_repo_failure 'checkout HEAD changed outside SWE Forge slice delivery' \
  "$repo" "$GATE" checkpoint --state "$state" --scope LATER.md

repo=$(make_repo committed)
git -C "$repo" checkout -qb feature
printf 'committed change\n' >>"$repo/README.md"
git -C "$repo" add README.md
git -C "$repo" commit -qm 'Commit before evidence setup'
state=$TMP_ROOT/committed.state
(
  cd "$repo"
  "$GATE" preflight --state "$state" --base HEAD~1 >/dev/null
  "$GATE" plan-check --state "$state" --name committed-smoke --requirement required >/dev/null
  "$GATE" validate --state "$state" --name committed-smoke \
    --final -- sh -c 'grep -q committed README.md' >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
  "$GATE" review --state "$state" --result PASS --source fresh-context >/dev/null
  "$GATE" deliver-pr --state "$state" >/dev/null
  "$GATE" receipt --state "$state" --execution SOLO --delivery GUIDED \
    --provider NONE --output "$TMP_ROOT/committed-receipt.md" >/dev/null
)
grep -F 'Final status: ACCEPTED' "$TMP_ROOT/committed-receipt.md" >/dev/null || \
  fail "committed-range receipt is missing final status"

repo=$(make_repo dirty)
git -C "$repo" checkout -qb feature
printf 'uncommitted\n' >>"$repo/README.md"
state=$TMP_ROOT/dirty.state
expect_repo_failure 'checkout is not clean' "$repo" "$GATE" preflight --state "$state"
test ! -e "$state/meta.env" || fail "dirty preflight wrote a baseline"

repo=$(make_repo protected)
state=$TMP_ROOT/protected.state
expect_repo_failure 'protected branch is not writable' "$repo" "$GATE" preflight --state "$state"
test ! -e "$state/meta.env" || fail "protected preflight wrote a baseline"

repo=$(make_repo detached)
git -C "$repo" checkout -q --detach HEAD
state=$TMP_ROOT/detached.state
expect_repo_failure 'checkout is detached' "$repo" "$GATE" preflight --state "$state"
test ! -e "$state/meta.env" || fail "detached preflight wrote a baseline"

repo=$(make_repo scope)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name scope-smoke --requirement required >/dev/null
  printf 'allowed\n' >>README.md
  printf 'forbidden\n' >OTHER.md
  "$GATE" validate --state "$state" --name scope-smoke -- \
    sh -c 'test -f OTHER.md' >/dev/null
)
expect_failure 'outside checkpoint scope' "$GATE" checkpoint --state "$state" --scope README.md

repo=$(make_repo authorization)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name smoke --requirement required --final-required false >/dev/null
  printf 'change\n' >>README.md
  "$GATE" validate --state "$state" --name smoke -- \
    sh -c 'grep -q change README.md' >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
)
expect_failure 'requires explicit PR or GO authorization' \
  "$GATE" commit-slice --state "$state" --checkpoint 1 \
  --message 'Record gate evidence' --authorized-by NONE

repo=$(make_repo final-evidence)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name smoke --requirement required --final-required false >/dev/null
  printf 'change\n' >>README.md
  "$GATE" validate --state "$state" --name smoke -- \
    sh -c 'grep -q change README.md' >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
  "$GATE" commit-slice --state "$state" --checkpoint 1 \
    --message 'Record gate evidence' --authorized-by PR >/dev/null
  "$GATE" plan-check --state "$state" --name final-smoke --requirement required >/dev/null
  "$GATE" validate --state "$state" --name final-smoke --final -- \
    sh -c 'grep -q change README.md' >/dev/null
  "$GATE" review --state "$state" --result PASS --source fresh-context >/dev/null
  "$GATE" receipt --state "$state" --execution SOLO --delivery PR \
    --pr-url https://github.com/example/repo/pull/2 \
    --output "$TMP_ROOT/final-evidence-receipt.md" >/dev/null
  printf 'later change\n' >>README.md
  git add README.md
  git commit -qm 'Change after receipt'
)
expect_failure 'receipt is stale' "$GATE" receipt-verify --state "$state" \
  --receipt "$TMP_ROOT/final-evidence-receipt.md"

# Regression: an unregistered check cannot be validated.
repo=$(make_repo unregistered)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
)
expect_failure 'unregistered check' "$GATE" validate --state "$state" \
  --name missing-check -- true

# Regression: a validation command that mutates candidate content is rejected.
repo=$(make_repo mutation)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name mutation --requirement required >/dev/null
)
expect_failure 'changed candidate source content' "$GATE" validate --state "$state" \
  --name mutation -- sh -c 'printf mutation >>README.md'

# Receipt verification remains read-only and compares repository identity.
repo=$(make_repo receipt-identity)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name check --requirement required --final-required false >/dev/null
  printf change >>README.md
  "$GATE" validate --state "$state" --name check -- sh -c 'test -f README.md' >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
  "$GATE" commit-slice --state "$state" --checkpoint 1 --message change --authorized-by PR >/dev/null
  "$GATE" plan-check --state "$state" --name final --requirement required >/dev/null
  "$GATE" validate --state "$state" --name final --final -- sh -c 'test -f README.md' >/dev/null
  "$GATE" review --state "$state" --result PASS --source fresh >/dev/null
  "$GATE" receipt --state "$state" --execution SOLO --delivery GUIDED --output "$TMP_ROOT/identity-receipt.md" >/dev/null
)
sed 's/^Repository:.*/Repository: forged/' "$TMP_ROOT/identity-receipt.md" >"$TMP_ROOT/tampered-receipt.md"
expect_failure 'receipt repository identity does not match' "$GATE" receipt-verify \
  --state "$state" --receipt "$TMP_ROOT/tampered-receipt.md"

# Regression: missing, unavailable, and unjustified conditional evidence block.
repo=$(make_repo missing-check)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name required-check --requirement required >/dev/null
  printf change >>README.md
)
expect_failure 'planned validation is not passing' "$GATE" checkpoint \
  --state "$state" --scope README.md

repo=$(make_repo unavailable-check)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name required-check --requirement required >/dev/null
  "$GATE" record-check-status --state "$state" --name required-check \
    --status unavailable --reason 'fixture unavailable' >/dev/null
  printf change >>README.md
)
expect_failure 'planned validation is not passing' "$GATE" checkpoint \
  --state "$state" --scope README.md

repo=$(make_repo conditional-check)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name conditional-check \
    --requirement conditional --condition 'only when enabled' >/dev/null
)
expect_failure 'not-applicable check status requires --reason' \
  "$GATE" record-check-status --state "$state" --name conditional-check \
  --status not-applicable

# Regression: same-path edits, untracked-content edits, and replacements are
# rejected even when the changed path set remains unchanged.
repo=$(make_repo same-path)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name check --requirement required >/dev/null
  printf one >>README.md
  "$GATE" validate --state "$state" --name check -- sh -c 'test -f README.md' >/dev/null
  printf two >>README.md
)
expect_failure 'planned validation is not passing' "$GATE" checkpoint \
  --state "$state" --scope README.md

repo=$(make_repo after-checkpoint)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name check --requirement required >/dev/null
  printf one >>README.md
  "$GATE" validate --state "$state" --name check -- sh -c 'test -f README.md' >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
  printf two >>README.md
)
expect_failure 'candidate fingerprint differs' "$GATE" commit-slice \
  --state "$state" --checkpoint 1 --message 'Reject stale content' --authorized-by PR

repo=$(make_repo untracked-content)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name check --requirement required >/dev/null
  printf one >new.txt
  "$GATE" validate --state "$state" --name check -- sh -c 'test -f new.txt' >/dev/null
  printf two >new.txt
)
expect_failure 'planned validation is not passing' "$GATE" checkpoint \
  --state "$state" --scope new.txt

repo=$(make_repo replacement)
state=$(clean_feature_state "$repo")
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$GATE" plan-check --state "$state" --name check --requirement required >/dev/null
  printf one >README.md
  "$GATE" validate --state "$state" --name check -- sh -c 'test -f README.md' >/dev/null
  "$GATE" checkpoint --state "$state" --scope README.md >/dev/null
  rm README.md
  printf replacement >README.md
)
expect_failure 'candidate fingerprint differs' "$GATE" commit-slice \
  --state "$state" --checkpoint 1 --message 'Reject replacement' --authorized-by PR

# Schema-v1 state is rejected rather than guessed into a new shape.
v1=$TMP_ROOT/schema-v1.yaml
cat >"$v1" <<'EOF_V1'
workflow: swe-forge
version: 1
checkout:
  path: /tmp/legacy
EOF_V1
expect_failure 'schema-v1 state is not resumable' "$ROOT/scripts/swe-forge-state" \
  validate --state "$v1"

printf '%s\n' 'PASS: executable gate tests'
