#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
GATE=$ROOT/scripts/swe-forge-gate
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-gate-test.XXXXXX")
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'test failure: %s\n' "$*" >&2
  exit 1
}

expect_failure() {
  expected=$1
  shift
  if output=$("$@" 2>&1); then fail "expected command to fail: $*"; fi
  case "$output" in *"$expected"*) ;; *) fail "failure did not contain '$expected': $output" ;; esac
}

make_repo() {
  name=$1
  repo=$TMP_ROOT/$name
  mkdir -p "$repo"
  git -C "$repo" init -q
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name 'SWE Forge Test'
  printf 'base\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -qm 'Initial commit'
  git -C "$repo" branch -M main
  git -C "$repo" checkout -qb feature
  printf '%s\n' "$repo"
}

repo=$(make_repo clean)
state=$TMP_ROOT/clean.state
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  grep -F 'schema_version: 4' "$state/run-state.yaml" >/dev/null
  grep -F '  preferred: SOLO' "$state/run-state.yaml" >/dev/null
  grep -F '  current: SOLO' "$state/run-state.yaml" >/dev/null
  test ! -e "$state/run-state.yaml.tmp" || fail 'state initializer left a temporary file'
  if grep -Eq 'runtime_profile:|context_value:|  (initial|selected|revisions):' "$state/run-state.yaml"; then
    fail 'state initializer emitted removed routing representation'
  fi
  "$ROOT/scripts/swe-forge-state" validate --state "$state/run-state.yaml" >/dev/null
  grep -F '  retry_ceiling: 2' "$state/run-state.yaml" >/dev/null
  grep -F '  status: unregistered' "$state/run-state.yaml" >/dev/null
  "$GATE" commit-plan --state "$state" --step S1 >/dev/null
  "$GATE" plan-check --state "$state" --name smoke --requirement required --final-required false >/dev/null
  printf 'changed\n' >>README.md
  "$GATE" validate --state "$state" --name smoke -- sh -c 'grep -q changed README.md' >/dev/null
  "$GATE" checkpoint --scope README.md --state "$state" --plan-step S1 >/dev/null
  "$GATE" commit-slice --state "$state" --checkpoint 1 --plan-step S1 --message 'Record gate evidence' --authorized-by PR >/dev/null
  "$GATE" plan-check --state "$state" --name final-smoke --requirement required >/dev/null
  "$GATE" validate --state "$state" --name final-smoke --final -- sh -c 'grep -q changed README.md' >/dev/null
  "$GATE" review --state "$state" --result PASS --source fresh-context --findings 1 --repaired 1 >/dev/null
  "$GATE" deliver-pr --state "$state" >/dev/null
  "$GATE" receipt --state "$state" --execution SOLO --delivery PR \
    --pr-url https://github.com/example/repo/pull/1 \
    --forge-version 0.1.0-alpha.1 --harness Pi --harness-version 0.84.1 \
    --requested-mode AUTO --selected-mode SOLO --model-provider openai-codex \
    --routing-reason 'tightly coupled test fixture' --model test-model \
    --output "$TMP_ROOT/receipt.md" >/dev/null
  "$GATE" receipt --state "$state" --execution SOLO --delivery PR \
    --pr-url https://github.com/example/repo/pull/1 >/dev/null
  test -f "$state/receipt.md"
  grep -F -- '- smoke: passed' "$state/receipt.md" >/dev/null
  grep -F -- '- final-smoke: passed' "$state/receipt.md" >/dev/null
  grep -F 'Review attempts: 1/2' "$state/receipt.md" >/dev/null
  grep -F 'Remote CI: not awaited after PR creation' "$state/receipt.md" >/dev/null
  "$GATE" receipt --verify --state "$state" >/dev/null
  "$GATE" receipt-verify --state "$state" >/dev/null
)
grep -F 'Final status: ACCEPTED' "$TMP_ROOT/receipt.md" >/dev/null || fail 'accepted receipt is missing final status'
if grep -F 'Context:' "$TMP_ROOT/receipt.md" >/dev/null; then fail 'receipt retains host context metadata'; fi
grep -F 'Fresh review: PASS — 1 findings, 1 repaired' "$TMP_ROOT/receipt.md" >/dev/null || fail 'receipt is missing review summary'
grep -F -- '- Harness: Pi 0.84.1' "$TMP_ROOT/receipt.md" >/dev/null || fail 'receipt is missing harness metadata'
grep -F -- '- Routing: AUTO -> SOLO' "$TMP_ROOT/receipt.md" >/dev/null || fail 'receipt is missing routing metadata'
grep -F -- '- Model provider: openai-codex' "$TMP_ROOT/receipt.md" >/dev/null || fail 'receipt is missing model metadata'
if grep -F 'Merge performed: no' "$TMP_ROOT/receipt.md" >/dev/null; then fail 'receipt exposes stale merge status'; fi
receipt_ref=$(awk -F': ' '$1 == "receipt_ref" { print $2; exit }' "$state/run-state.yaml")
[ "$receipt_ref" != none ] || fail 'run state does not retain receipt reference'
[ -f "$receipt_ref" ] || fail 'receipt reference does not point to a file'
review_repo=$(make_repo review-ceiling)
review_state=$TMP_ROOT/review-ceiling.state
(
  cd "$review_repo"
  "$GATE" preflight --state "$review_state" >/dev/null
  "$GATE" review --state "$review_state" --result CHANGES_REQUIRED \
    --source independent-review --findings 2 --blocked-by R1 --blocked-by R2 >/dev/null || true
  "$GATE" review --state "$review_state" --result CHANGES_REQUIRED \
    --source focused-re-review --findings 1 --repaired 1 --blocked-by R2 >/dev/null || true
  expect_failure 'review ceiling exhausted' "$GATE" review --state "$review_state" \
    --result CHANGES_REQUIRED --source investigation --findings 1 --blocked-by R2
  grep -F '  attempts: 2' "$review_state/run-state.yaml" >/dev/null
  grep -F '  status: changes-required' "$review_state/run-state.yaml" >/dev/null
  grep -F 'source=focused-re-review' "$review_state/review.env" >/dev/null
  if grep -F 'source=investigation' "$review_state/review.env" >/dev/null; then
    fail 'rejected reviewer-like activity replaced the latest evidence'
  fi
)

second_review_repo=$(make_repo second-review)
second_review_state=$TMP_ROOT/second-review.state
(
  cd "$second_review_repo"
  "$GATE" preflight --state "$second_review_state" >/dev/null
  "$GATE" review --state "$second_review_state" --result CHANGES_REQUIRED \
    --source independent-review --findings 1 --blocked-by R1 >/dev/null || true
  "$GATE" review --state "$second_review_state" --result PASS \
    --source focused-re-review --findings 0 --repaired 1 >/dev/null
  grep -F '  attempts: 2' "$second_review_state/run-state.yaml" >/dev/null
  grep -F '  status: pass' "$second_review_state/run-state.yaml" >/dev/null
)


multi_repo=$(make_repo multi-step)
multi_state=$TMP_ROOT/multi-step.state
(
  cd "$multi_repo"
  "$GATE" preflight --state "$multi_state" >/dev/null
  "$GATE" commit-plan --state "$multi_state" --step S1 --step S2 >/dev/null
  "$GATE" plan-check --state "$multi_state" --name slice-smoke \
    --requirement required --final-required false >/dev/null
  "$GATE" plan-check --state "$multi_state" --name final-smoke \
    --requirement required >/dev/null
  printf 'one\n' >one.txt
  "$GATE" validate --state "$multi_state" --name slice-smoke -- sh -c 'test -f one.txt' >/dev/null
  "$GATE" checkpoint --state "$multi_state" --scope one.txt --plan-step S1 >/dev/null
  "$GATE" commit-slice --state "$multi_state" --checkpoint 1 --plan-step S1 \
    --message 'Add first planned step' --authorized-by PR >/dev/null
  printf 'two\n' >two.txt
  "$GATE" validate --state "$multi_state" --name slice-smoke -- sh -c 'test -f two.txt' >/dev/null
  "$GATE" checkpoint --state "$multi_state" --scope two.txt --plan-step S2 >/dev/null
  "$GATE" commit-slice --state "$multi_state" --checkpoint 2 --plan-step S2 \
    --message 'Add second planned step' --authorized-by PR >/dev/null
  "$GATE" validate --state "$multi_state" --name final-smoke --final \
    -- sh -c 'test -f one.txt && test -f two.txt' >/dev/null
  "$GATE" plan-check --state "$multi_state" --name repair-smoke \
    --requirement required --final-required false >/dev/null
  "$GATE" review --state "$multi_state" --result PASS --source fresh-context >/dev/null
  printf 'repair\n' >repair.txt
  "$GATE" validate --state "$multi_state" --name repair-smoke -- sh -c 'test -f repair.txt' >/dev/null
  "$GATE" checkpoint --state "$multi_state" --scope repair.txt --review-repair >/dev/null
  "$GATE" commit-slice --state "$multi_state" --checkpoint 3 --review-repair \
    --message 'Repair reviewed finding' --authorized-by PR >/dev/null
  "$GATE" validate --state "$multi_state" --name final-smoke --final \
    -- sh -c 'test -f one.txt && test -f two.txt && test -f repair.txt' >/dev/null
  "$GATE" review --state "$multi_state" --result PASS \
    --source focused-re-review --repaired 1 >/dev/null
  "$GATE" deliver-pr --state "$multi_state" >/dev/null
  "$ROOT/scripts/swe-forge-state" commit-plan --state "$multi_state/run-state.yaml" |
    awk -F '\t' '$1 == "S1" && $2 == "complete" && $3 == "1" && $4 != "none" { first=1 }
      $1 == "S2" && $2 == "complete" && $3 == "2" && $4 != "none" { second=1 }
      END { exit !(first && second) }'
  test "$(awk -F '\t' '$9 == "review-repair" { count++ } END { print count + 0 }' "$multi_state/checkpoints.tsv")" = 1
)

collapsed_repo=$(make_repo collapsed)
collapsed_state=$TMP_ROOT/collapsed.state
(
  cd "$collapsed_repo"
  "$GATE" preflight --state "$collapsed_state" >/dev/null
  "$GATE" commit-plan --state "$collapsed_state" --step S1 --step S2 >/dev/null
  "$GATE" plan-check --state "$collapsed_state" --name slice-smoke \
    --requirement required --final-required false >/dev/null
  "$GATE" plan-check --state "$collapsed_state" --name final-smoke \
    --requirement required >/dev/null
  printf 'one\n' >one.txt
  printf 'two\n' >two.txt
  "$GATE" validate --state "$collapsed_state" --name slice-smoke \
    -- sh -c 'test -f one.txt && test -f two.txt' >/dev/null
  "$GATE" checkpoint --state "$collapsed_state" --scope one.txt --scope two.txt \
    --plan-step S1 >/dev/null
  "$GATE" commit-slice --state "$collapsed_state" --checkpoint 1 --plan-step S1 \
    --message 'Collapse planned steps' --authorized-by PR >/dev/null
  "$GATE" validate --state "$collapsed_state" --name final-smoke --final \
    -- sh -c 'test -f one.txt && test -f two.txt' >/dev/null
  "$GATE" review --state "$collapsed_state" --result PASS --source fresh-context >/dev/null
  expect_failure 'PR commit plan is incomplete' "$GATE" deliver-pr --state "$collapsed_state"
  "$ROOT/scripts/swe-forge-state" commit-plan --state "$collapsed_state/run-state.yaml" |
    awk -F '\t' '$1 == "S2" && $2 == "pending" && $3 == "none" && $4 == "none" { found=1 }
      END { exit !found }'
)

propagation_repo=$(make_repo propagation)
propagation_state=$TMP_ROOT/propagation.state
(
  cd "$propagation_repo"
  "$GATE" preflight --state "$propagation_state" \
    --requested-mode SUBAGENTS --requested-delivery GUIDED --delivery-mode GUIDED \
    --routing-preferred SUBAGENTS --routing-current SUBAGENTS \
    --reason 'requested propagation fixture' >/dev/null
)
grep -F 'requested_mode: SUBAGENTS' "$propagation_state/run-state.yaml" >/dev/null
grep -F 'requested_delivery: GUIDED' "$propagation_state/run-state.yaml" >/dev/null
grep -F 'delivery_mode: GUIDED' "$propagation_state/run-state.yaml" >/dev/null
grep -F '  current: SUBAGENTS' "$propagation_state/run-state.yaml" >/dev/null

state_tool=$ROOT/scripts/swe-forge-state
early_state=$TMP_ROOT/early-state
"$state_tool" init --state "$early_state" --checkout "$propagation_repo" --run-id early-state \
  --requested-mode SUBAGENTS --requested-delivery GUIDED --delivery-mode GUIDED \
  --routing-preferred SUBAGENTS --routing-current SUBAGENTS \
  --reason 'early shell fixture' >/dev/null
"$state_tool" validate --state "$early_state" >/dev/null
if grep -Eq '^continuation:' "$early_state/run-state.yaml"; then fail 'init unexpectedly created continuation data'; fi
"$state_tool" set-continuation --state "$early_state" \
  --workflow-active true --workflow ticket --phase implementation --step 1 \
  --awaiting none --next-action-kind implement --next-action-target state-tool \
  --next-action-acceptance 'schema valid' --safe-boundary true >/dev/null
grep -F '    mode: GUIDED' "$early_state/run-state.yaml" >/dev/null
updated_at=$(awk '$1 == "updated_at:" && section == "continuation" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$early_state/run-state.yaml")
case "$updated_at" in *T*Z) ;; *) fail 'set-continuation generated malformed timestamp' ;; esac
"$state_tool" set-routing --state "$early_state" \
  --preferred SUBAGENTS --current SOLO --reason 'native fallback' \
  --fallback-used 'SUBAGENTS -> SOLO: native capability unavailable' >/dev/null
grep -F '  preferred: SUBAGENTS' "$early_state/run-state.yaml" >/dev/null
grep -F '  current: SOLO' "$early_state/run-state.yaml" >/dev/null
grep -F 'fallback_used: SUBAGENTS -> SOLO: native capability unavailable' "$early_state/run-state.yaml" >/dev/null
"$state_tool" validate --state "$early_state" >/dev/null
adaptive_state=$TMP_ROOT/adaptive.state
"$state_tool" init --state "$adaptive_state" --checkout "$propagation_repo" --run-id adaptive-state \
  --requested-mode AUTO --requested-delivery GUIDED --delivery-mode GUIDED \
  --routing-preferred SOLO --routing-current SOLO --reason 'adaptive baseline' >/dev/null
"$state_tool" set-routing --state "$adaptive_state" \
  --preferred SUBAGENTS --current SUBAGENTS --reason 'independent discovery remains useful' \
  --fallback-used no >/dev/null
grep -F '  preferred: SUBAGENTS' "$adaptive_state/run-state.yaml" >/dev/null
grep -F '  current: SUBAGENTS' "$adaptive_state/run-state.yaml" >/dev/null
"$state_tool" set-routing --state "$adaptive_state" \
  --preferred SOLO --current SOLO --reason 'remaining work is coupled' \
  --fallback-used no >/dev/null
grep -F '  preferred: SOLO' "$adaptive_state/run-state.yaml" >/dev/null
grep -F '  current: SOLO' "$adaptive_state/run-state.yaml" >/dev/null

state_ops=$TMP_ROOT/state-operations.yaml
cp "$early_state/run-state.yaml" "$state_ops"
ops_sha=$(printf '%040d' 7)
"$state_tool" set-delivery-checkout --state "$state_ops" --head-sha "$ops_sha" --checkpoint-sha "$ops_sha" >/dev/null
grep -F "  head_sha: $ops_sha" "$state_ops" >/dev/null
grep -F "  checkpoint_sha: $ops_sha" "$state_ops" >/dev/null
"$state_tool" set-receipt-ref --state "$state_ops" --receipt-ref "$TMP_ROOT/private-receipt.md" >/dev/null
grep -F "receipt_ref: $TMP_ROOT/private-receipt.md" "$state_ops" >/dev/null

schema_v3=$TMP_ROOT/schema-v3.yaml
sed 's/^schema_version: 4$/schema_version: 3/' "$state_ops" >"$schema_v3"
expect_failure 'stale/unsupported run state' "$state_tool" validate --state "$schema_v3"
obsolete_route=$TMP_ROOT/obsolete-route.yaml
awk '/^routing:/{print; print "  initial: SOLO"; next} {print}' "$state_ops" >"$obsolete_route"
expect_failure 'obsolete routing or context-control fields' "$state_tool" validate --state "$obsolete_route"
obsolete_context=$TMP_ROOT/obsolete-context.yaml
awk '/^tasks:/{print "context:"; print "  status: near-limit"} {print}' "$state_ops" >"$obsolete_context"
task_context=$TMP_ROOT/task-context.yaml
awk '/^tasks: \{\}$/{print "tasks:"; print "  context:"; print "    status: pending"; next} {print}' "$state_ops" >"$task_context"
"$state_tool" validate --state "$task_context" >/dev/null
flow_acceptance=$TMP_ROOT/flow-acceptance.yaml
awk '
/^    acceptance:$/ { print "    acceptance: [\"schema, valid\", \"second check\"]"; skip=1; next }
skip && /^      - / { next }
skip { skip=0 }
{ print }
' "$state_ops" >"$flow_acceptance"
flow_projection=$("$state_tool" inspect --state "$flow_acceptance" --checkout "$propagation_repo")
case "$flow_projection" in
  *'"acceptance":["schema, valid","second check"]'*) ;;
  *) fail 'state inspection lost flow-style continuation acceptance' ;;
esac
deep_recovery=$TMP_ROOT/deep-recovery.yaml
awk '/^  delivery:/{print "    recovery:"; print "      host_signal: overflow"; print "      status: pending"} {print}' "$state_ops" >"$deep_recovery"
expect_failure 'obsolete routing or context-control fields' "$state_tool" validate --state "$deep_recovery"
expect_failure 'obsolete routing or context-control fields' "$state_tool" validate --state "$obsolete_context"
invalid_route=$TMP_ROOT/invalid-route.yaml
sed 's/^  current: SUBAGENTS$/  current: UNKNOWN/' "$propagation_state/run-state.yaml" >"$invalid_route"
expect_failure 'invalid routing.current' "$state_tool" validate --state "$invalid_route"

printf '%s\n' 'PASS: executable evidence and schema-v4 fixtures'
