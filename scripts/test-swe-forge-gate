#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
GATE=$ROOT/.swe-forge/tools/swe-forge-gate
STATE_TOOL=$ROOT/.swe-forge/tools/swe-forge-state
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-gate-test.XXXXXX")
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'test failure: %s\n' "$*" >&2
  exit 1
}

expect_failure() {
  expected=$1
  shift
  if output=$("$@" 2>&1); then fail "expected command to fail: $*"; fi
  case "$output" in *"$expected"*) ;; *) fail "failure did not contain '$expected': $output" ;; esac
}

make_repo() {
  name=$1
  repo=$TMP_ROOT/$name
  mkdir -p "$repo"
  git -C "$repo" init -q
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name 'SWE Forge Test'
  printf 'base\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -qm 'Initial commit'
  git -C "$repo" branch -M main
  git -C "$repo" checkout -qb feature
  printf '%s\n' "$repo"
}

repo=$(make_repo normal)
state=$TMP_ROOT/normal.state
(
  cd "$repo"
  "$GATE" preflight --state "$state" >/dev/null
  "$STATE_TOOL" validate --state "$state" >/dev/null
  if grep -Eq '^(reason|fallback_used|requested_mode|requested_delivery|receipt_ref):|checkpoint_sha|fingerprint|delivery_checkout|meta\.env|review\.env' "$state/run-state.yaml"; then
    fail 'run state retained a removed workflow projection'
  fi
  grep -F '  reason: single-checkout implementation' "$state/run-state.yaml" >/dev/null
  grep -F '  fallback: no' "$state/run-state.yaml" >/dev/null
  test ! -e "$state/meta.env" || fail 'run state created obsolete meta state'
  ! grep -Eq '^tasks:' "$state/run-state.yaml" || fail 'SOLO state retained delegated task state'
  legacy_state=$TMP_ROOT/legacy.state
  mkdir -p "$legacy_state"
  cp "$state/run-state.yaml" "$legacy_state/run-state.yaml"
  printf '%s\n' 'requested_mode: AUTO' >>"$legacy_state/run-state.yaml"
  expect_failure 'unknown or removed state fields' "$STATE_TOOL" validate --state "$legacy_state"
  mkdir "$state/.run-state.lock"
  expect_failure 'being mutated by another activity' "$STATE_TOOL" set-routing \
    --state "$state" --preferred SOLO --current SOLO --reason locked --fallback-used no
  rmdir "$state/.run-state.lock"
  identity_state=$TMP_ROOT/identity.state
  mkdir -p "$identity_state"
  awk '
    BEGIN { section = "" }
    /^[^[:space:]#][^:]*:/ { section = $1; sub(/:$/, "", section) }
    section == "checkout" && $0 ~ /^  branch:/ { print "  branch: another-branch"; next }
    { print }
  ' "$state/run-state.yaml" >"$identity_state/run-state.yaml"
  identity_inspection=$("$STATE_TOOL" inspect --state "$identity_state" --checkout "$repo")
  case "$identity_inspection" in
    *'"active":false'*'"reason":"checkout branch mismatch"'*) ;;
    *) fail 'state inspection accepted a mismatching checkout branch' ;;
  esac
  printf 'implemented\n' >>README.md
  git add README.md
  git commit -qm 'Implement ticket'
  head=$(git rev-parse HEAD)

  # Checks are recorded when run; no registration or implementation checkpoint
  # is needed before validating a clean committed candidate.
  "$GATE" validate --state "$state" --name smoke --requirement required \
    --final -- sh -c 'grep -q implemented README.md' >/dev/null
  awk -F '\t' -v head="$head" \
    '$2 == "smoke" && $5 == "passed" && $10 == head && $12 == "yes" { found=1 }
     END { exit !found }' "$state/validations.tsv"
  grep -F "  head_sha: $head" "$state/run-state.yaml" >/dev/null
  grep -F "  status: passed" "$state/run-state.yaml" >/dev/null
  "$GATE" review --state "$state" --result PASS --source fresh-context >/dev/null
  "$GATE" deliver-pr --state "$state" >/dev/null
  "$STATE_TOOL" set-pull-request --state "$state" \
    --url https://github.com/example/repo/pull/1 >/dev/null
  grep -F '  pull_request_ref: https://github.com/example/repo/pull/1' \
    "$state/run-state.yaml" >/dev/null
  grep -F '  status: complete' "$state/run-state.yaml" >/dev/null
  grep -F '  workflow_active: false' "$state/run-state.yaml" >/dev/null
  expect_failure 'unknown set-delivery-checkout option' "$STATE_TOOL" set-delivery-checkout \
    --state "$state" --path "$repo" --head-sha "$head"
  for obsolete_command in set-receipt-ref set-commit-plan record-commit-step commit-plan check-commit-step; do
    expect_failure "unknown command: $obsolete_command" "$STATE_TOOL" "$obsolete_command"
  done
)

# A final validation cannot silently move off the committed candidate.
mutation_repo=$(make_repo mutation)
mutation_state=$TMP_ROOT/mutation.state
(
  cd "$mutation_repo"
  "$GATE" preflight --state "$mutation_state" >/dev/null
  expect_failure 'smoke: failed' \
    "$GATE" validate --state "$mutation_state" --name smoke --final -- \
    sh -c 'printf changed >>README.md'
  git status --porcelain | grep -F 'README.md' >/dev/null
)

# Required unavailable evidence is explicit and blocks review/delivery.
unavailable_repo=$(make_repo unavailable)
unavailable_state=$TMP_ROOT/unavailable.state
(
  cd "$unavailable_repo"
  "$GATE" preflight --state "$unavailable_state" >/dev/null
  printf 'implementation\n' >implementation.txt
  git add implementation.txt
  git commit -qm 'Implement ticket'
  "$GATE" record-check-status --state "$unavailable_state" --name smoke \
    --requirement required --status unavailable --reason 'tool unavailable' --final >/dev/null
  expect_failure 'PR review requires passing final validation for the current HEAD' \
    "$GATE" review --state "$unavailable_state" --result PASS --source fresh-context
  expect_failure 'required or applicable final validation is not passing for current HEAD' \
    "$GATE" deliver-pr --state "$unavailable_state"
)

# One independent review may be followed by one localized repair, without a
# checkpoint/commit proof chain or a second review.
repair_repo=$(make_repo repair)
repair_state=$TMP_ROOT/repair.state
(
  cd "$repair_repo"
  "$GATE" preflight --state "$repair_state" >/dev/null
  printf 'implementation\n' >implementation.txt
  git add implementation.txt
  git commit -qm 'Implement ticket'
  "$GATE" validate --state "$repair_state" --name smoke --requirement required \
    --final -- sh -c 'test -f implementation.txt' >/dev/null
  reviewed_head=$(git rev-parse HEAD)
  "$GATE" review --state "$repair_state" --result CHANGES_REQUIRED \
    --source fresh-context --findings 1 --blocked-by R1 >/dev/null || true

  printf 'repair\n' >repair.txt
  git add repair.txt
  git commit -qm 'Repair reviewed finding'
  repaired_head=$(git rev-parse HEAD)
  "$STATE_TOOL" set-review-repair --state "$repair_state" --head-sha "$repaired_head" >/dev/null
  "$GATE" validate --state "$repair_state" --name smoke --requirement required \
    --final -- sh -c 'test -f implementation.txt && test -f repair.txt' >/dev/null
  "$GATE" deliver-pr --state "$repair_state" >/dev/null
  grep -F '  status: repaired' "$repair_state/run-state.yaml" >/dev/null
  test "$(awk '$1 == "reviewed_head:" { print $2; exit }' "$repair_state/run-state.yaml")" = "$reviewed_head"
  test "$reviewed_head" != "$repaired_head"
  expect_failure 'PR review can only start from pending review state' "$GATE" review \
    --state "$repair_state" --result PASS --source another-review
)

# Checkout ownership and protected-branch safeguards remain independent of
# validation evidence.
dirty_repo=$(make_repo dirty)
printf 'user change\n' >>"$dirty_repo/README.md"
expect_failure 'checkout is not clean before writable work' \
  sh -c "cd '$dirty_repo' && '$GATE' preflight --state '$TMP_ROOT/dirty.state'"

git -C "$dirty_repo" checkout -q main
expect_failure 'protected branch is not writable' \
  sh -c "cd '$dirty_repo' && '$GATE' preflight --state '$TMP_ROOT/protected.state'"

printf '%s\n' 'PASS: executable Git, validation, review, and delivery safeguards'
