#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-results.XXXXXX")
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'result contract test failure: %s\n' "$*" >&2
  exit 1
}

require_text() {
  needle=$1
  file=$2
  grep -F -- "$needle" "$file" >/dev/null 2>&1 || fail "$file is missing: $needle"
}

expect_failure() {
  label=$1
  shift
  if "$@" >"$TMP_ROOT/failure.out" 2>&1; then
    fail "$label unexpectedly passed"
  fi
}

result_tool=$ROOT/.swe-forge/tools/swe-forge-worker-result
[ -x "$result_tool" ] || fail 'worker-result schema/validator is not executable'

read_only=$TMP_ROOT/read-only.json
cat >"$read_only" <<'EOF_READ_ONLY'
{
  "RESULT_PROFILE": "READ_ONLY",
  "STATUS": "DONE",
  "TASK_ID": "researcher-result-profile",
  "FINDINGS": ["The researcher can report the profile boundary with concise evidence."],
  "EVIDENCE": [
    ".swe-forge/contracts/result.md#read-only-result",
    ".swe-forge/agents/researcher.md#output"
  ],
  "RECOMMENDED_ACTION": ["Keep Git and validation fields out of this result."]
}
EOF_READ_ONLY

read_only_schema=$TMP_ROOT/read-only.schema.json
"$result_tool" schema --profile READ_ONLY --task-id researcher-result-profile >"$read_only_schema"
require_text '"type": "object"' "$read_only_schema"
require_text '"const": "researcher-result-profile"' "$read_only_schema"
require_text '"additionalProperties": false' "$read_only_schema"
require_text '"FINDINGS"' "$read_only_schema"
for host in Pi OMP OpenCode Claude Codex Cursor Harness; do
  if grep -F -- "$host" "$read_only_schema" >/dev/null 2>&1; then
    fail "$read_only_schema contains host-specific schema text: $host"
  fi
done
writable_schema=$TMP_ROOT/writable.schema.json
"$result_tool" schema --profile WRITABLE --task-id writable-result-profile >"$writable_schema"
require_text '"pattern": "^[0-9A-Fa-f]{40}$"' "$writable_schema"
require_text '"VALIDATION"' "$writable_schema"
review_schema=$TMP_ROOT/review.schema.json
"$result_tool" schema --profile REVIEW >"$review_schema"
require_text '"status": {' "$review_schema"
require_text '"deferred_followups"' "$review_schema"
expect_failure 'review schema task binding' \
  "$result_tool" schema --profile REVIEW --task-id review-result
expect_failure 'ordinary schema without task binding' \
  "$result_tool" schema --profile READ_ONLY

"$result_tool" validate --profile READ_ONLY --task-id researcher-result-profile \
  --result "$read_only" >"$TMP_ROOT/read-only.validation"
require_text '"valid":true' "$TMP_ROOT/read-only.validation"

malformed_structured=$TMP_ROOT/malformed-structured.json
printf '%s\n' '{"RESULT_PROFILE":"READ_ONLY","STATUS":"DONE","TASK_ID":"researcher-result-profile","FINDINGS":["finding"],"EVIDENCE":[}' >"$malformed_structured"
expect_failure 'malformed JSON result' \
  "$result_tool" validate --profile READ_ONLY --task-id researcher-result-profile \
  --result "$malformed_structured"
missing_evidence=$TMP_ROOT/missing-evidence.json
printf '%s\n' '{"RESULT_PROFILE":"READ_ONLY","STATUS":"DONE","TASK_ID":"researcher-result-profile","FINDINGS":["finding"]}' >"$missing_evidence"
expect_failure 'read-only result without evidence' \
  "$result_tool" validate --profile READ_ONLY --result "$missing_evidence"
extra_writable_field=$TMP_ROOT/irrelevant-field.json
awk '/"RECOMMENDED_ACTION":/ { print "  \"BASE_SHA\": \"1111111111111111111111111111111111111111\"," } { print }' "$read_only" >"$extra_writable_field"
expect_failure 'read-only result with writable field' \
  "$result_tool" validate --profile READ_ONLY --result "$extra_writable_field"
duplicate_field=$TMP_ROOT/duplicate-field.json
awk '/"TASK_ID":/ { print "  \"TASK_ID\": \"another-task\"," } { print }' "$read_only" >"$duplicate_field"
expect_failure 'duplicate JSON result field' \
  "$result_tool" validate --profile READ_ONLY --result "$duplicate_field"

blocked=$TMP_ROOT/blocked.json
cat >"$blocked" <<'EOF_BLOCKED'
{
  "RESULT_PROFILE": "READ_ONLY",
  "STATUS": "BLOCKED",
  "TASK_ID": "blocked-worker",
  "FINDINGS": ["The bounded question cannot be answered yet."],
  "EVIDENCE": ["src/missing.ts"],
  "RISKS": ["The required source is unavailable."],
  "RECOMMENDED_ACTION": ["Provide the missing source path."]
}
EOF_BLOCKED
"$result_tool" validate --profile READ_ONLY --task-id blocked-worker --result "$blocked" >/dev/null
printf '%s\n' '{"RESULT_PROFILE":"READ_ONLY","STATUS":"BLOCKED","TASK_ID":"blocked-worker","FINDINGS":["blocked"],"EVIDENCE":["src/missing.ts"]}' >"$TMP_ROOT/blocked-without-action.json"
expect_failure 'blocked result without a next action' \
  "$result_tool" validate --profile READ_ONLY --result "$TMP_ROOT/blocked-without-action.json"

writable=$TMP_ROOT/writable.json
cat >"$writable" <<'EOF_WRITABLE'
{
  "RESULT_PROFILE": "WRITABLE",
  "STATUS": "DONE",
  "TASK_ID": "writable-result-profile",
  "BASE_SHA": "1111111111111111111111111111111111111111",
  "HEAD_SHA": "2222222222222222222222222222222222222222",
  "BRANCH": "refactor/result-profiles",
  "FILES_CHANGED": [".swe-forge/contracts/result.md"],
  "GIT_STATE": ["clean"],
  "VALIDATION": [
    {
      "command": "scripts/test-swe-forge-results",
      "requirement": "required",
      "condition": "always",
      "applies": true,
      "result": "passed",
      "evidence": "focused result contract fixture"
    }
  ],
  "FINDINGS": ["The writable result exposes the changed contract path and passing check."],
  "EVIDENCE": [".swe-forge/contracts/result.md#normal-writable-result"]
}
EOF_WRITABLE
"$result_tool" validate --profile WRITABLE --task-id writable-result-profile \
  --result "$writable" >"$TMP_ROOT/writable.validation"
require_text '"profile":"WRITABLE"' "$TMP_ROOT/writable.validation"
"$result_tool" validate --profile WRITABLE --task-id writable-result-profile \
  --result - <"$writable" >"$TMP_ROOT/writable.stdin.validation"
require_text '"valid":true' "$TMP_ROOT/writable.stdin.validation"

failed_validation=$TMP_ROOT/failed-validation.json
sed 's/"result": "passed"/"result": "failed"/' "$writable" >"$failed_validation"
expect_failure 'DONE result with failed required validation' \
  "$result_tool" validate --profile WRITABLE --result "$failed_validation"
missing_validation=$TMP_ROOT/missing-validation.json
sed '/"VALIDATION": \[/,/^  ],/d' "$writable" >"$missing_validation"
expect_failure 'writable result without validation' \
  "$result_tool" validate --profile WRITABLE --result "$missing_validation"
read_only_writable=$TMP_ROOT/read-only-writable.json
awk '/"FINDINGS":/ { print "  \"BASE_SHA\": \"1111111111111111111111111111111111111111\"," } { print }' "$read_only" >"$read_only_writable"
expect_failure 'read-only profile with implementation field' \
  "$result_tool" validate --profile READ_ONLY --result "$read_only_writable"

printf '%s\n' 'PASS: canonical worker result JSON contract'
