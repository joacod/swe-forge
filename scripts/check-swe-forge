#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)

fail() {
  printf 'check failure: %s\n' "$*" >&2
  exit 1
}

require_text() {
  needle=$1
  file=$2
  grep -F -- "$needle" "$ROOT/$file" >/dev/null 2>&1 || fail "$file does not contain required text: $needle"
}

reject_text() {
  needle=$1
  file=$2
  if grep -F -- "$needle" "$ROOT/$file" >/dev/null 2>&1; then fail "$file contains obsolete text: $needle"; fi
}

require_ordered_text() {
  first=$1
  second=$2
  file=$3
  awk -v first="$first" -v second="$second" '
    index($0, first) && first_line == 0 { first_line = NR }
    first_line > 0 && NR > first_line && index($0, second) { found = 1 }
    END { exit !(first_line > 0 && found) }
  ' "$ROOT/$file" || fail "$file does not load '$second' after '$first'"
}

REGISTRY_VALIDATOR=$ROOT/scripts/lib/registry.sh
[ -f "$REGISTRY_VALIDATOR" ] || fail 'missing adapter registry validator'
. "$REGISTRY_VALIDATOR"

validate_registry() {
  line_number=0
  while IFS='|' read -r harness kind source destination support; do
    line_number=$((line_number + 1))
    case "$harness" in ''|\#*) continue ;; esac
    swe_forge_registry_row_is_valid "$harness" "$kind" "$source" "$destination" "$support" || \
      fail "invalid adapter registry row at line $line_number"
    case "$kind" in
      file) [ -f "$ROOT/.swe-forge/adapters/$source" ] || fail "missing adapter registry file source at line $line_number" ;;
      tree) [ -d "$ROOT/.swe-forge/adapters/$source" ] || fail "missing adapter registry tree source at line $line_number" ;;
    esac
  done <"$ROOT/.swe-forge/adapters/registry.tsv"
  reject_text '|project|' .swe-forge/adapters/registry.tsv
}

sh -n \
  "$ROOT/scripts/lib/registry.sh" \
  "$ROOT/scripts/swe-forge" \
  "$ROOT/scripts/check-swe-forge" \
  "$ROOT/scripts/test-swe-forge" \
  "$ROOT/scripts/validate-swe-forge" \
  "$ROOT/scripts/test-swe-forge-gate" \
  "$ROOT/scripts/test-swe-forge-pi" \
  "$ROOT/scripts/test-swe-forge-omp" \
  "$ROOT/scripts/test-swe-forge-invocation" \
  "$ROOT/scripts/test-swe-forge-briefing" \
  "$ROOT/scripts/test-swe-forge-results" \
  "$ROOT/scripts/check-swe-forge-boundary" \
  "$ROOT/scripts/test-swe-forge-boundary" \
  "$ROOT/scripts/swe-forge-gate" \
  "$ROOT/scripts/swe-forge-state" \
  "$ROOT/scripts/swe-forge-invocation" \
  "$ROOT/scripts/check-release" \
  "$ROOT/.swe-forge/tools/swe-forge-gate" \
  "$ROOT/.swe-forge/tools/swe-forge-state" \
  "$ROOT/.swe-forge/tools/swe-forge-invocation" \
  "$ROOT/.swe-forge/tools/swe-forge-worker-brief" \
  "$ROOT/.swe-forge/tools/swe-forge-worker-result"

for executable in \
  scripts/check-swe-forge scripts/validate-swe-forge scripts/test-swe-forge \
  scripts/test-swe-forge-gate scripts/test-swe-forge-pi scripts/test-swe-forge-omp \
  scripts/test-swe-forge-invocation scripts/test-swe-forge-briefing \
  scripts/test-swe-forge-results scripts/check-swe-forge-boundary \
  scripts/test-swe-forge-boundary scripts/swe-forge-state scripts/swe-forge-gate \
  scripts/swe-forge-invocation .swe-forge/tools/swe-forge-gate \
  .swe-forge/tools/swe-forge-state .swe-forge/tools/swe-forge-invocation \
  .swe-forge/tools/swe-forge-worker-brief .swe-forge/tools/swe-forge-worker-result; do
  [ -x "$ROOT/$executable" ] || fail "not executable: $executable"
done

[ -f "$ROOT/.github/workflows/ci.yml" ] || fail 'missing GitHub Actions CI workflow'
require_text 'fetch-depth: 0' .github/workflows/ci.yml
require_text 'github.event.pull_request.base.sha' .github/workflows/ci.yml
require_text 'git diff --check "$BASE_SHA...$CURRENT_SHA"' .github/workflows/ci.yml
require_text './scripts/validate-swe-forge' .github/workflows/ci.yml
require_text 'pi-runtime:' .github/workflows/ci.yml
require_text 'omp-runtime:' .github/workflows/ci.yml
require_text 'node-version: 22.19.0' .github/workflows/ci.yml
require_text 'scripts/test-swe-forge-omp' .github/workflows/ci.yml
require_text 'scripts/test-swe-forge-briefing' .github/workflows/ci.yml
require_text 'scripts/test-swe-forge-results' .github/workflows/ci.yml
validate_registry

for role in orchestrator researcher architect implementer reviewer debugger test-engineer \
  refactor-specialist security-reviewer performance-reviewer; do
  [ -f "$ROOT/.swe-forge/agents/$role.md" ] || fail "missing specialist role: $role"
done

[ -f "$ROOT/VERSION" ] || fail 'missing release version file'
release_version=$(awk 'NR == 1 { print; exit }' "$ROOT/VERSION")
case "$release_version" in *.*) ;; *) fail "invalid VERSION: ${release_version:-<empty>}" ;; esac
[ -f "$ROOT/CHANGELOG.md" ] || fail 'missing changelog'
[ -f "$ROOT/docs/compatibility.md" ] || fail 'missing compatibility snapshot'
[ -f "$ROOT/docs/releases/v0.1.0-alpha.1.md" ] || fail 'missing alpha release notes'

for issue_template in \
  .github/ISSUE_TEMPLATE/installation-adapter.md \
  .github/ISSUE_TEMPLATE/workflow-behavior.md \
  .github/ISSUE_TEMPLATE/real-run-report.md; do
  [ -f "$ROOT/$issue_template" ] || fail "missing issue template: $issue_template"
done

for heading in '## What it does' '## Harnesses' '## Install' '## Use' '## Documentation'; do
  require_text "$heading" README.md
done
require_text 'harness-agnostic' README.md
require_text '`SOLO`' README.md
require_text '`SUBAGENTS`' README.md
require_text 'scripts/swe-forge install "$HARNESS"' README.md
require_text 'scripts/swe-forge verify "$HARNESS"' README.md
require_text 'Neither mode merges automatically' README.md
require_text 'one writable delivery checkout' README.md
require_text 'physical execution environment' SWE-FORGE.md
require_text 'materialized into the canonical delivery' docs/architecture.md
require_text 'host decides worker physical execution and scheduling' .swe-forge/adapters/README.md
reject_text 'CHECKOUT' .swe-forge/contracts/result.md
reject_text 'CHECKOUT' .swe-forge/tools/swe-forge-worker-result
reject_text 'max_workers:' .swe-forge/contracts/working-spec.md
reject_text 'worker_limit:' .swe-forge/examples/parallel-ticket.md
reject_text 'two to four active workers' .swe-forge/policies/delegation.md
require_text 'Adapters are harness integration layers' docs/architecture.md
require_text 'SWE Forge does not manage the harness context window' SWE-FORGE.md
require_text 'host lifecycle hooks' .swe-forge/adapters/pi/README.md
[ ! -e "$ROOT/.swe-forge/policies/context.md" ] || fail 'obsolete context policy remains'
require_text 'one delivery checkout' docs/architecture.md
require_text 'Writable delegated results are materialized' SWE-FORGE.md
require_text 'schema-v4' SWE-FORGE.md
require_text 'schema_version: 4' .swe-forge/contracts/run-state.md
require_text 'schema-v4' .swe-forge/tools/swe-forge-state
require_text 'worker-result/v1' .swe-forge/tools/swe-forge-worker-result
require_text 'worker-brief-input/v1' .swe-forge/tools/swe-forge-worker-brief
require_text 'dependency_digest' .swe-forge/contracts/worker-brief.md
require_text 'DELEGATED_RESEARCH' .swe-forge/policies/delegation.md
require_text 'Early discovery-shape assessment' .swe-forge/policies/execution-routing.md
require_text 'Independent Review Handoff' .swe-forge/policies/verification.md
require_text 'Acceptance handoff' .swe-forge/policies/verification.md
require_text 'Cleanup Handoff' .swe-forge/policies/failure-recovery.md
require_text 'native `task` tool' .swe-forge/adapters/omp/README.md
require_text 'schemaMode: strict' .swe-forge/adapters/omp/README.md
require_text 'workerBriefing' .swe-forge/adapters/pi/README.md
require_text 'raw arguments through unchanged' .swe-forge/adapters/pi/prompts/git-pr.md
require_text 'raw arguments through unchanged' .swe-forge/adapters/opencode/commands/git-pr.md
require_text '~/.agents/swe-forge/.swe-forge/workflows/ticket.md' .swe-forge/adapters/shared/agent-skill/swe-forge/SKILL.md
require_text 'allow_implicit_invocation: false' .swe-forge/adapters/shared/agent-skill/swe-forge/agents/openai.yaml
require_text 'worker-brief-input/v1' .swe-forge/workflows/ticket.md
require_text 'swe-forge-invocation' .swe-forge/workflows/ticket.md
require_text 'input_status' .swe-forge/workflows/ticket.md
require_text 'parse --raw-arguments TEXT' .swe-forge/tools/swe-forge-invocation
require_text 'consumed_tokens' .swe-forge/tools/swe-forge-invocation
require_text 'root/orchestrator authority' AGENTS.md
require_text 'ephemeral internal implementation state' AGENTS.md
require_text 'risk-proportional testing decision' SWE-FORGE.md
require_text 'Work summary' SWE-FORGE.md
require_text 'plain human' SWE-FORGE.md
require_text 'Run metadata:' .swe-forge/contracts/receipt.md
require_text 'Model provider:' .swe-forge/contracts/receipt.md
require_text 'Head:' .swe-forge/contracts/receipt.md
require_text 'Evidence fingerprint:' .swe-forge/contracts/receipt.md
require_text 'Generated at:' .swe-forge/contracts/receipt.md
require_text 'safe_boundary:' .swe-forge/contracts/run-state.md
require_text 'continuation:' .swe-forge/contracts/run-state.md
require_text 'delivery_checkout:' .swe-forge/contracts/run-state.md
require_text 'set-continuation' .swe-forge/tools/swe-forge-state
require_text 'set-routing' .swe-forge/tools/swe-forge-state
require_text 'set-delivery-checkout' .swe-forge/tools/swe-forge-state
require_text 'set-receipt-ref' .swe-forge/tools/swe-forge-state
require_text 'one fan-in barrier' .swe-forge/policies/delegation.md
require_text 'ordered commit plan' .swe-forge/policies/delivery.md
require_text 'remote default branch' .swe-forge/policies/delivery.md
require_text 'review-repair commit' .swe-forge/policies/delivery.md
require_text 'at most two review executions' SWE-FORGE.md
require_text 'Remote GitHub CI is external after PR creation' SWE-FORGE.md
require_text 'commit-plan' .swe-forge/tools/swe-forge-state
require_text 'record-commit-step' .swe-forge/tools/swe-forge-state
require_text 'review ceiling exhausted' .swe-forge/tools/swe-forge-state
require_text 'Review attempts:' .swe-forge/contracts/receipt.md
require_text 'PR creation completion boundary' .swe-forge/conformance/scenarios.md
require_text 'not awaited or polled' .swe-forge/policies/evidence.md
require_text 'relevant PR is actually `MERGED`' .swe-forge/conformance/scenarios.md
require_ordered_text 'Before broad discovery' 'final topology decision' .swe-forge/workflows/ticket.md
require_ordered_text 'Before specification or clarification behavior is needed' 'policies/specification.md' .swe-forge/workflows/ticket.md
require_ordered_text 'In `PR`, also load' 'contracts/working-spec.md' .swe-forge/workflows/ticket.md
require_ordered_text 'Before making the final automatic or explicit topology decision' 'policies/execution-routing.md' .swe-forge/workflows/ticket.md
require_ordered_text 'Before selecting or executing validation' 'policies/verification.md' .swe-forge/workflows/ticket.md
require_ordered_text 'Before the first writable checkout/setup operation' 'policies/delivery.md' .swe-forge/workflows/ticket.md
require_ordered_text 'When the review trigger applies' 'contracts/review.md' .swe-forge/workflows/ticket.md
require_ordered_text 'Before a `BLOCKED` or `FAILED` recovery path' 'policies/failure-recovery.md' .swe-forge/workflows/ticket.md
require_ordered_text 'The canonical Acceptance Gate' 'Compare the final integrated diff' .swe-forge/workflows/ticket.md

printf '%s\n' 'PASS: SWE Forge structural checks'
