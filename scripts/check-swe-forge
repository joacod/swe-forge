#!/bin/sh

set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)

fail() {
  printf 'check failure: %s\n' "$*" >&2
  exit 1
}

require_text() {
  needle=$1
  file=$2
  grep -F "$needle" "$ROOT/$file" >/dev/null 2>&1 || \
    fail "$file does not contain required text: $needle"
}

reject_text() {
  needle=$1
  file=$2
  if grep -F "$needle" "$ROOT/$file" >/dev/null 2>&1; then
    fail "$file contains obsolete text: $needle"
  fi
}

REGISTRY_VALIDATOR=$ROOT/scripts/lib/registry.sh
[ -f "$REGISTRY_VALIDATOR" ] || fail "missing adapter registry validator"
. "$REGISTRY_VALIDATOR"

validate_registry() {
  registry_line_number=0
  while IFS='|' read -r registry_harness registry_scope registry_kind \
    registry_source registry_destination registry_support; do
    registry_line_number=$((registry_line_number + 1))
    case "$registry_harness" in
      ''|\#*) continue ;;
    esac
    if ! swe_forge_registry_row_is_valid \
      "$registry_harness" \
      "$registry_scope" \
      "$registry_kind" \
      "$registry_source" \
      "$registry_destination" \
      "$registry_support"; then
      fail "invalid adapter registry row at line $registry_line_number"
    fi
    case "$registry_kind" in
      file)
        [ -f "$ROOT/.swe-forge/adapters/$registry_source" ] || \
          fail "missing adapter registry file source at line $registry_line_number"
        ;;
      tree)
        [ -d "$ROOT/.swe-forge/adapters/$registry_source" ] || \
          fail "missing adapter registry tree source at line $registry_line_number"
        ;;
      bridge) ;;
    esac
  done <"$ROOT/.swe-forge/adapters/registry.tsv"
}

sh -n "$ROOT/scripts/lib/registry.sh" "$ROOT/scripts/swe-forge" "$ROOT/scripts/test-swe-forge"
validate_registry

require_text 'final status: `ACCEPTED`, `BLOCKED`, or `FAILED`' SWE-FORGE.md
require_text 'pre-edit baseline' SWE-FORGE.md
require_text 'delivery_mode: GUIDED | PR' SWE-FORGE.md
require_text 'transient working spec' SWE-FORGE.md
require_text 'specialist skills optional and on demand' SWE-FORGE.md
require_text 'side effects' .swe-forge/policies/verification.md
require_text 'specialist_skills:' .swe-forge/contracts/working-spec.md
require_text 'specialist_skills:' .swe-forge/contracts/run-state.md
require_text 'Do not add external skill URLs to the adapter registry' .swe-forge/policies/specialist-skills.md
require_text 'refactor-design-patterns' docs/adding-a-skill.md
require_text 'ui-design-token-refactor' docs/adding-a-skill.md
require_text 'Ticket names an optional specialist skill' .swe-forge/evals/conformance-scenarios.md
require_text 'Brief Alignment Interview' .swe-forge/policies/specification.md
require_text 'git-sync' .swe-forge/policies/delivery.md
require_text 'one dedicated task branch' .swe-forge/policies/delivery.md
require_text 'per-slice commits' .swe-forge/policies/delivery.md
require_text 'provider state is `MERGED`' .swe-forge/policies/delivery.md
require_text '`go` to commit' SWE-FORGE.md
require_text 'working_spec_ref:' .swe-forge/contracts/run-state.md
require_text 'requirement: required' .swe-forge/contracts/task.md
require_text 'create_pull_request: {status: not-authorized' .swe-forge/contracts/task.md
require_text 'delegation.allowed' .swe-forge/contracts/task.md
require_text 'only a dependency in `done`' .swe-forge/contracts/run-state.md
require_text 'every critical finding blocks' .swe-forge/contracts/review.md
require_text 'review: skipped' .swe-forge/examples/simple-ticket.md
require_text 'checkout_baseline:' .swe-forge/examples/parallel-ticket.md
require_text 'checkout_baseline:' .swe-forge/examples/herdr-ticket.md
require_text 'branch_setup:' .swe-forge/contracts/run-state.md
require_text 'branch_setup:' .swe-forge/contracts/task.md
require_text 'branch_setup:' .swe-forge/examples/parallel-ticket.md
require_text 'branch_setup:' .swe-forge/examples/herdr-ticket.md
require_text '## Shared Workflow Behavior' .swe-forge/adapters/README.md
require_text 'one dedicated task branch for the run' .swe-forge/adapters/README.md
require_text 'pushing never creates a PR' .swe-forge/adapters/README.md
require_text 'syncing verifies `MERGED`' .swe-forge/adapters/README.md

for file in \
  .swe-forge/adapters/opencode/commands/swe-forge-global.md \
  .swe-forge/adapters/claude-code/skills/swe-forge-global/SKILL.md \
  .swe-forge/adapters/pi/prompts/swe-forge-global.md \
  .swe-forge/adapters/shared/agent-skill/global/SKILL.md; do
  require_text 'Resolve every' "$file"
  require_text 'relative reference under' "$file"
done
for file in \
  .swe-forge/adapters/opencode/commands/swe-forge-global.md \
  .swe-forge/adapters/pi/prompts/swe-forge-global.md; do
  require_text '$ARGUMENTS' "$file"
done
require_text '~/.pi/agent/swe-forge' .swe-forge/adapters/pi/prompts/swe-forge-global.md
require_text '~/.pi/agent/swe-forge/.swe-forge/policies/delivery.md' .swe-forge/adapters/pi/prompts/git-pr.md
require_text 'thin loader' .swe-forge/adapters/opencode/commands/git-push.md
require_text 'clean status' .swe-forge/adapters/herdr/runbook.md

while IFS='|' read -r file action; do
  require_text "\`$action\` action only" "$file"
  require_text 'thin loader' "$file"
done <<'EOF'
.swe-forge/adapters/opencode/commands/git-commit.md|commit
.swe-forge/adapters/opencode/commands/git-push.md|push
.swe-forge/adapters/opencode/commands/git-pr.md|create_pull_request
.swe-forge/adapters/opencode/commands/git-sync.md|sync
.swe-forge/adapters/opencode/commands/git-commit-global.md|commit
.swe-forge/adapters/opencode/commands/git-push-global.md|push
.swe-forge/adapters/opencode/commands/git-pr-global.md|create_pull_request
.swe-forge/adapters/opencode/commands/git-sync-global.md|sync
.swe-forge/adapters/pi/prompts/git-commit.md|commit
.swe-forge/adapters/pi/prompts/git-push.md|push
.swe-forge/adapters/pi/prompts/git-pr.md|create_pull_request
.swe-forge/adapters/pi/prompts/git-sync.md|sync
EOF
require_text 'ADAPTER_REGISTRY' scripts/swe-forge
require_text 'opencode|project|file|opencode/commands/git-push.md' .swe-forge/adapters/registry.tsv
require_text 'opencode|global|file|opencode/commands/git-pr-global.md' .swe-forge/adapters/registry.tsv
require_text 'pi|global|file|pi/prompts/git-sync.md' .swe-forge/adapters/registry.tsv
require_text 'codex|project|tree|shared/agent-skill/project' .swe-forge/adapters/registry.tsv
require_text 'cursor|global|tree|shared/agent-skill/global' .swe-forge/adapters/registry.tsv
require_text 'https://developers.openai.com/learn/codex' .swe-forge/adapters/shared/agent-skill/README.md
require_text 'https://cursor.com/docs' .swe-forge/adapters/shared/agent-skill/README.md
require_text 'shared adapter behavior' .swe-forge/adapters/claude-code/README.md
require_text 'shared adapter behavior' .swe-forge/adapters/opencode/README.md
require_text 'shared adapter behavior' .swe-forge/adapters/pi/README.md
require_text 'shared adapter behavior' .swe-forge/adapters/shared/agent-skill/README.md
require_text 'actually `MERGED`' .swe-forge/evals/conformance-scenarios.md
require_text 'allow_implicit_invocation: false' .swe-forge/adapters/shared/agent-skill/project/agents/openai.yaml
require_text '~/.agents/swe-forge' .swe-forge/adapters/shared/agent-skill/global/SKILL.md
require_text 'disable-model-invocation: true' .swe-forge/adapters/shared/agent-skill/project/SKILL.md
require_text 'shared/agent-skill/project' .swe-forge/adapters/registry.tsv
reject_text 'install all' README.md
reject_text 'install all' docs/installation.md
reject_text 'install all' scripts/swe-forge
reject_text 'verify all' scripts/test-swe-forge
reject_text 'commit_policy:' .swe-forge/examples/parallel-ticket.md
reject_text 'commit_policy:' .swe-forge/examples/herdr-ticket.md
reject_text 'pushing no longer asks whether' README.md

printf '%s\n' 'PASS: SWE Forge structural checks'
