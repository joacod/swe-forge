  "$ROOT/.swe-forge/tools/swe-forge-invocation" "$ROOT/.swe-forge/tools/swe-forge-worker-brief" \
  "$ROOT/.swe-forge/tools/swe-forge-worker-result" \
  "$ROOT/scripts/swe-forge-invocation" \
