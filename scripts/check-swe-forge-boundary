#!/bin/sh

# Narrow structural guard for canonical workflow semantics and the two runtime
# ports that must not duplicate canonical representations. It intentionally
# avoids general architecture linting.

set -eu

ROOT=${1:-$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)}

if [ "$#" -gt 1 ]; then
  printf 'usage: %s [repository-root]\n' "$0" >&2
  exit 2
fi

[ -d "$ROOT" ] || {
  printf 'canonical boundary check failure: repository root does not exist: %s\n' "$ROOT" >&2
  exit 1
}

scan_file() {
  file=$1
  matches=$(awk '
    {
      line = tolower($0)
      has_host = line ~ /(^|[^[:alnum:]_])(pi|omp|opencode|claude([[:space:]_-]+code)?|codex|cursor)([^[:alnum:]_]|$)/
      has_branch = line ~ /(^|[^[:alnum:]_])(if|elif|case)([^[:alnum:]_]|$)/
      if (has_host && has_branch) {
        print FNR ":" $0
      }
    }
  ' "$file")
  if [ -n "$matches" ]; then
    printf '%s\n' "$matches" | while IFS= read -r match; do
      printf 'canonical boundary check failure: %s:%s\n' "$file" "$match" >&2
    done
    printf '%s\n' 'Canonical workflow sources must branch on semantic capabilities, not harness identity; move host-specific behavior to an adapter/runtime integration.' >&2
    return 1
  fi
}

scan_adapter_runtime() {
  file=$1
  [ -f "$file" ] || return 0
  matches=$(awk '
    /parseScalarYaml|parseActiveRun|currentStateError|stateMatchesCheckout|briefContract|serializeOrdinaryResult|reviewShapeIsValid/ {
      print FNR ":" $0
    }
  ' "$file")
  if [ -n "$matches" ]; then
    printf '%s\n' "$matches" | while IFS= read -r match; do
      printf 'adapter representation-boundary check failure: %s:%s\n' "$file" "$match" >&2
    done
    printf '%s\n' 'Adapter runtimes must consume canonical semantic ports instead of parsing or reconstructing canonical representations.' >&2
    return 1
  fi
}

canonical_files=$(
  {
    printf '%s\n' "$ROOT/AGENTS.md" "$ROOT/SWE-FORGE.md"
    for directory in \
      "$ROOT/.swe-forge/agents" \
      "$ROOT/.swe-forge/contracts" \
      "$ROOT/.swe-forge/policies" \
      "$ROOT/.swe-forge/tools" \
      "$ROOT/.swe-forge/workflows"; do
      [ -d "$directory" ] || continue
      find "$directory" -type f -print
    done
  } | LC_ALL=C sort
)

while IFS= read -r file; do
  [ -n "$file" ] || continue
  [ -f "$file" ] || {
    printf 'canonical boundary check failure: missing canonical source: %s\n' "$file" >&2
    exit 1
  }
  scan_file "$file"
done <<EOF_FILES
$canonical_files
EOF_FILES

for runtime in \
  "$ROOT/.swe-forge/adapters/pi/extensions/swe-forge-runtime.ts" \
  "$ROOT/.swe-forge/adapters/omp/extensions/swe-forge-runtime.ts"; do
  scan_adapter_runtime "$runtime"
done

printf '%s\n' 'PASS: canonical capability-boundary structural check'
