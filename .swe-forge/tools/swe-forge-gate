#!/bin/sh

# Dependency-free Git/validation guard for SWE Forge runs.
# Git HEAD is the candidate identity for committed validation and review.

set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
PROGRAM=${0##*/}
STATE=
CHECKOUT=
REVIEW_LOCK=
TAB=$(printf '\t')
NEWLINE='
'

cleanup() {
  if [ -n "${REVIEW_LOCK:-}" ]; then
    rm -f "$REVIEW_LOCK/pid"
    rmdir "$REVIEW_LOCK" 2>/dev/null || true
  fi
}

trap 'status=$?; cleanup; exit "$status"' 0 HUP INT TERM

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  scripts/swe-forge-gate preflight --state DIR [--branch BRANCH] [--base REF]
    [--routing-preferred MODE] [--routing-current MODE]
    [--delivery-mode MODE]
  scripts/swe-forge-gate validate --state DIR --name NAME
    [--requirement required|conditional|informational] [--condition TEXT] [--final]
    -- COMMAND [ARGS...]
  scripts/swe-forge-gate record-check-status --state DIR --name NAME
    [--requirement required|conditional|informational] [--condition TEXT]
    --status passed|failed|unavailable|not-applicable [--reason TEXT] [--final]
  scripts/swe-forge-gate review --state DIR --result PASS|CHANGES_REQUIRED
    --source SOURCE [--findings N] [--blocked-by ID...]
  scripts/swe-forge-gate deliver-pr --state DIR

The guard records validation and review evidence against Git HEAD. It never
launches agents, controls external orchestration, pushes, creates a PR,
publishes, deploys, or merges.
EOF
}

reject_control_chars() {
  value=$1
  case "$value" in
    *"$TAB"*|*"$NEWLINE"*)
      fail "values containing tabs or newlines are not supported" ;;
  esac
}

absolute_path() {
  path=$1
  reject_control_chars "$path"
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    *) printf '%s/%s\n' "$PWD" "$path" ;;
  esac
}

state_path() {
  path=$(absolute_path "$1")
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -d "$path" ] && [ ! -L "$path" ] || fail "state path must be a real directory: $path"
    CDPATH= cd "$path" && pwd -P
    return
  fi
  parent=$(dirname "$path")
  [ -d "$parent" ] && [ ! -L "$parent" ] || fail "state parent must be a real directory: $parent"
  CDPATH= cd "$parent" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$path")"
}

git_root_from_cwd() {
  git rev-parse --show-toplevel 2>/dev/null || fail "not inside a Git checkout"
}

validate_run_state() {
  [ -f "$STATE/run-state.yaml" ] || fail "state has not been initialized: $STATE"
  [ -x "$SCRIPT_DIR/swe-forge-state" ] || fail "canonical state validator is unavailable"
  "$SCRIPT_DIR/swe-forge-state" validate --state "$STATE/run-state.yaml" >/dev/null
}

state_meta() {
  [ -n "${STATE:-}" ] || fail "--state is required"
  validate_run_state
  CHECKOUT=$(run_state_nested_value checkout path)
  [ -n "$CHECKOUT" ] || fail "state is missing checkout.path"
  [ -d "$CHECKOUT" ] || fail "recorded checkout no longer exists: $CHECKOUT"
  CHECKOUT=$(CDPATH= cd "$CHECKOUT" && pwd -P) || fail "recorded checkout is not accessible: $CHECKOUT"
}

run_state_value() {
  key=$1
  awk -v wanted="$key" '
    $1 == wanted ":" {
      sub(/^[^:]*:[[:space:]]*/, "")
      print
      exit
    }
  ' "$STATE/run-state.yaml"
}

run_state_nested_value() {
  section_wanted=$1
  key_wanted=$2
  awk -v wanted_section="$section_wanted" -v wanted_key="$key_wanted" '
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
    }
    section == wanted_section && $1 == wanted_key ":" {
      sub(/^[^:]*:[[:space:]]*/, "")
      print
      exit
    }
  ' "$STATE/run-state.yaml"
}

delivery_mode_from_state() {
  run_state_value delivery_mode
}

review_blocker_count() {
  blocked=$(run_state_nested_value review blocked_by)
  case "$blocked" in
    '[]'|'') printf '0\n' ;;
    \[*\])
      blocked=${blocked#\[}
      blocked=${blocked%\]}
      printf '%s\n' "$blocked" | awk -F',' 'NF { print NF; next } { print 0 }'
      ;;
    *) printf '0\n' ;;
  esac
}

current_branch() {
  git -C "$CHECKOUT" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

remote_default_branch() {
  remote_head=$(git -C "$CHECKOUT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  case "$remote_head" in
    */*) printf '%s\n' "${remote_head#*/}" ;;
    *) printf '%s\n' '' ;;
  esac
}

assert_not_protected() {
  branch=$1
  remote_default=$2
  [ "$branch" != main ] || fail "protected branch is not writable: $branch"
  [ "$branch" != master ] || fail "protected branch is not writable: $branch"
  [ -z "$remote_default" ] || [ "$branch" != "$remote_default" ] || \
    fail "remote default branch is not writable: $branch"
}

status_porcelain() {
  git -C "$CHECKOUT" status --porcelain=v1 --untracked-files=all
}

identity_safe() {
  actual_root=$(git -C "$CHECKOUT" rev-parse --show-toplevel 2>/dev/null || true)
  [ "$actual_root" = "$CHECKOUT" ] || return 1
  branch=$(current_branch)
  [ -n "$branch" ] || return 1
  recorded_branch=$(run_state_nested_value checkout branch)
  [ "$branch" = "$recorded_branch" ] || return 1
  remote_default=$(remote_default_branch)
  [ "$branch" != main ] || return 1
  [ "$branch" != master ] || return 1
  [ -z "$remote_default" ] || [ "$branch" != "$remote_default" ] || return 1
}

assert_identity() {
  state_meta
  identity_safe || fail "checkout identity, branch, or protection state changed"
}

ensure_safe_state_location() {
  root=$1
  case "$STATE" in
    "$root") fail "state directory must not be the checkout root" ;;
    "$root"/*)
      relative=${STATE#"$root"/}
      git -C "$root" check-ignore -q --no-index "$relative" || \
        fail "state inside checkout must already be ignored: $STATE" ;;
  esac
}

validate_validation_ledger() {
  if ! awk -F "$TAB" '
    BEGIN { valid = 1 }
    NF == 0 { next }
    NF != 12 { valid = 0; exit }
    $1 !~ /^[0-9]+$/ || $2 == "" ||
      ($3 != "required" && $3 != "conditional" && $3 != "informational") ||
      ($5 != "passed" && $5 != "failed" && $5 != "unavailable" && $5 != "not-applicable") ||
      (length($9) != 40 || $9 !~ /^[0-9A-Fa-f]+$/) ||
      (length($10) != 40 || $10 !~ /^[0-9A-Fa-f]+$/) ||
      ($12 != "yes" && $12 != "no") { valid = 0; exit }
    END { exit !valid }
  ' "$STATE/validations.tsv"; then
    fail "evidence state is stale or unsupported; validation ledger has an invalid format"
  fi
}

ensure_state() {
  state_meta
  for obsolete in meta.env review.env run-state.valid; do
    [ ! -e "$STATE/$obsolete" ] || \
      fail "state contains obsolete persisted data: $obsolete; start a fresh state directory"
  done
  [ -f "$STATE/validations.tsv" ] || : >"$STATE/validations.tsv"
  validate_validation_ledger
}

preflight() {
  expected_branch=
  baseline_ref=HEAD
  delivery_mode=PR
  routing_preferred=SOLO
  routing_current=SOLO
  state_reason='single-checkout implementation'
  fallback_used=no
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --branch)
        [ "$#" -ge 2 ] || fail "--branch requires a name"
        expected_branch=$2
        reject_control_chars "$expected_branch"
        shift 2
        ;;
      --base)
        [ "$#" -ge 2 ] || fail "--base requires a Git revision"
        baseline_ref=$2
        reject_control_chars "$baseline_ref"
        shift 2
        ;;
      --delivery-mode)
        [ "$#" -ge 2 ] || fail "--delivery-mode requires GUIDED or PR"
        delivery_mode=$2
        reject_control_chars "$delivery_mode"
        shift 2
        ;;
      --routing-preferred)
        [ "$#" -ge 2 ] || fail "--routing-preferred requires a topology"
        routing_preferred=$2
        reject_control_chars "$routing_preferred"
        shift 2
        ;;
      --routing-current)
        [ "$#" -ge 2 ] || fail "--routing-current requires a topology"
        routing_current=$2
        reject_control_chars "$routing_current"
        shift 2
        ;;
      --reason)
        [ "$#" -ge 2 ] || fail "--reason requires text"
        state_reason=$2
        reject_control_chars "$state_reason"
        shift 2
        ;;
      --fallback-used)
        [ "$#" -ge 2 ] || fail "--fallback-used requires text"
        fallback_used=$2
        reject_control_chars "$fallback_used"
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown preflight option: $1" ;;
    esac
  done

  [ -n "${STATE:-}" ] || fail "--state is required"
  CHECKOUT=$(git_root_from_cwd)
  ensure_safe_state_location "$CHECKOUT"
  [ ! -e "$STATE/run-state.yaml" ] || fail "state is already initialized: $STATE"
  for obsolete in meta.env review.env run-state.valid validations.tsv; do
    [ ! -e "$STATE/$obsolete" ] || \
      fail "state contains obsolete persisted data: $obsolete; start with a fresh state directory"
  done
  umask 077
  branch=$(current_branch)
  [ -n "$branch" ] || fail "checkout is detached"
  [ -z "$expected_branch" ] || [ "$branch" = "$expected_branch" ] || \
    fail "current branch $branch does not match expected branch $expected_branch"
  remote_default=$(remote_default_branch)
  assert_not_protected "$branch" "$remote_default"
  status=$(status_porcelain)
  [ -z "$status" ] || fail "checkout is not clean before writable work"
  head=$(git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null || fail "checkout has no commit baseline")
  base_head=$(git -C "$CHECKOUT" rev-parse "$baseline_ref" 2>/dev/null || \
    fail "base revision does not resolve: $baseline_ref")
  git -C "$CHECKOUT" merge-base --is-ancestor "$base_head" "$head" || \
    fail "base revision is not an ancestor of the current checkout: $baseline_ref"
  mkdir -p "$STATE"
  "$SCRIPT_DIR/swe-forge-state" init \
    --state "$STATE" \
    --checkout "$CHECKOUT" \
    --run-id "$(basename "$STATE")" \
    --baseline-ref "$base_head" \
    --delivery-mode "$delivery_mode" \
    --routing-preferred "$routing_preferred" \
    --routing-current "$routing_current" \
    --reason "$state_reason" \
    --fallback-used "$fallback_used" >/dev/null
  : >"$STATE/validations.tsv"
  "$SCRIPT_DIR/swe-forge-state" set-continuation \
    --state "$STATE/run-state.yaml" \
    --workflow-active true \
    --workflow ticket \
    --phase planning \
    --step 0 \
    --awaiting none \
    --next-action-kind specify \
    --next-action-target working-spec \
    --safe-boundary true >/dev/null
  validate_run_state
  printf 'PASS: preflight baseline recorded at %s\n' "$STATE"
  printf 'BASELINE_HEAD: %s\n' "$base_head"
  printf 'CHECKOUT_HEAD: %s\n' "$head"
  printf 'BRANCH: %s\n' "$branch"
}

join_command() {
  command_display=
  for command_arg do
    reject_control_chars "$command_arg"
    if [ -n "$command_display" ]; then
      command_display="$command_display $command_arg"
    else
      command_display=$command_arg
    fi
  done
  printf '%s\n' "$command_display"
}

append_validation() {
  name=$1
  requirement=$2
  condition=$3
  result=$4
  code=$5
  evidence=$6
  command_display=$7
  head_before=$8
  head_after=$9
  final_run=${10}
  reason=${11}
  id=$(awk 'END { print NR + 1 }' "$STATE/validations.tsv")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$id" "$name" "$requirement" "$condition" "$result" "$code" \
    "$(basename "$evidence")" "$command_display" "$head_before" "$head_after" \
    "$reason" "$final_run" >>"$STATE/validations.tsv"
}

latest_status() {
  name=$1
  wanted_head=$2
  final_mode=$3
  awk -F "$TAB" -v wanted="$name" -v head="$wanted_head" -v final="$final_mode" '
    $2 == wanted && $10 == head && (final != "yes" || $12 == "yes") {
      if (!found || ($1 + 0) > latest) {
        latest = $1 + 0
        status = $5
        reason = $11
        requirement = $3
        found = 1
      }
    }
    END {
      if (!found) printf "missing\t\t\n"
      else printf "%s\t%s\t%s\n", status, reason, requirement
    }
  ' "$STATE/validations.tsv"
}

validation_names_for_head() {
  wanted_head=$1
  awk -F "$TAB" -v head="$wanted_head" '$10 == head && $12 == "yes" { print $2 }' \
    "$STATE/validations.tsv" | LC_ALL=C sort -u
}

check_final_validations() {
  wanted_head=$1
  found=0
  blockers=
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    result=$(latest_status "$name" "$wanted_head" yes)
    status=${result%%"$TAB"*}
    rest=${result#*"$TAB"}
    reason=${rest%%"$TAB"*}
    requirement=${rest#*"$TAB"}
    [ "$requirement" != informational ] || continue
    found=$((found + 1))
    okay=no
    case "$requirement:$status" in
      required:passed) okay=yes ;;
      conditional:passed) okay=yes ;;
      conditional:not-applicable)
        [ -n "$reason" ] && okay=yes ;;
    esac
    if [ "$okay" != yes ]; then
      if [ -n "$blockers" ]; then
        blockers="$blockers, $name ($status)"
      else
        blockers="$name ($status)"
      fi
    fi
  done <<EOF_VALIDATIONS
$(validation_names_for_head "$wanted_head")
EOF_VALIDATIONS
  [ "$found" -gt 0 ] || {
    printf 'final validation is not passing: no required or applicable checks for HEAD %s\n' \
      "$wanted_head" >&2
    return 1
  }
  [ -n "$blockers" ] || return 0
  printf 'final validation is not passing: %s\n' "$blockers" >&2
  return 1
}

sync_delivery_head() {
  head=$1
  recorded=$(run_state_nested_value checkout head_sha)
  [ "$recorded" = "$head" ] || \
    "$SCRIPT_DIR/swe-forge-state" set-delivery-checkout \
      --state "$STATE/run-state.yaml" --head-sha "$head" >/dev/null
}

validation_summary_for_head() {
  head=$1
  final_count=$(awk -F "$TAB" -v wanted="$head" '$10 == wanted && $12 == "yes" { count++ } END { print count + 0 }' \
    "$STATE/validations.tsv")
  if [ "$final_count" -eq 0 ]; then
    printf 'pending\n'
  elif check_final_validations "$head" >/dev/null 2>&1; then
    printf 'passed\n'
  else
    printf 'failed\n'
  fi
}

sync_validation_state() {
  head=$1
  validation_status=$(validation_summary_for_head "$head")
  "$SCRIPT_DIR/swe-forge-state" set-validation \
    --state "$STATE/run-state.yaml" --head-sha "$head" \
    --status "$validation_status" --reference validations.tsv >/dev/null
}

validate_run() {
  name=
  requirement=required
  condition=always
  final_run=no
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --name)
        [ "$#" -ge 2 ] || fail "--name requires a label"
        name=$2
        shift 2
        ;;
      --requirement)
        [ "$#" -ge 2 ] || fail "--requirement requires required, conditional, or informational"
        requirement=$2
        shift 2
        ;;
      --condition)
        [ "$#" -ge 2 ] || fail "--condition requires a value"
        condition=$2
        shift 2
        ;;
      --final)
        final_run=yes
        shift
        ;;
      --)
        shift
        break
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown validate option: $1" ;;
    esac
  done
  [ -n "$name" ] || fail "--name is required"
  [ "$#" -gt 0 ] || fail "a command is required after --"
  reject_control_chars "$name"
  reject_control_chars "$condition"
  case "$requirement" in
    required|conditional|informational) ;;
    *) fail "invalid validation requirement: $requirement" ;;
  esac
  [ "$requirement" != conditional ] || [ -n "$condition" ] || \
    fail "conditional checks require a condition"
  ensure_state
  assert_identity
  before_status=$(status_porcelain)
  [ "$final_run" != yes ] || [ -z "$before_status" ] || \
    fail "final validation requires a clean committed candidate"
  command_display=$(join_command "$@")
  id=$(awk 'END { print NR + 1 }' "$STATE/validations.tsv")
  evidence_file=$STATE/validation.$(printf '%04d' "$id").log
  head_before=$(git -C "$CHECKOUT" rev-parse HEAD)
  if (CDPATH= cd "$CHECKOUT" && "$@") >"$evidence_file" 2>&1; then
    command_result=passed
    code=0
  else
    code=$?
    command_result=failed
  fi
  head_after=$(git -C "$CHECKOUT" rev-parse HEAD)
  after_status=$(status_porcelain)
  result=$command_result
  reason=
  if [ "$head_before" != "$head_after" ] || [ "$before_status" != "$after_status" ]; then
    result=failed
    if [ "$final_run" = yes ]; then
      reason='final validation changed the candidate'
    else
      reason='validation changed the candidate'
    fi
    printf '\nSWE Forge validation binding failure: command changed the candidate.\n' >>"$evidence_file"
  fi
  append_validation "$name" "$requirement" "$condition" "$result" "$code" \
    "$evidence_file" "$command_display" "$head_before" "$head_after" "$final_run" "$reason"
  sync_delivery_head "$head_after"
  sync_validation_state "$head_after"
  printf '%s: %s (%s)\n' "$name" "$result" "$evidence_file"
  [ "$result" = passed ]
}

record_check_status() {
  name=
  requirement=required
  condition=always
  status=
  reason=
  final_run=no
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --name)
        [ "$#" -ge 2 ] || fail "--name requires a label"
        name=$2
        shift 2
        ;;
      --requirement)
        [ "$#" -ge 2 ] || fail "--requirement requires required, conditional, or informational"
        requirement=$2
        shift 2
        ;;
      --condition)
        [ "$#" -ge 2 ] || fail "--condition requires a value"
        condition=$2
        shift 2
        ;;
      --status)
        [ "$#" -ge 2 ] || fail "--status requires a value"
        status=$2
        shift 2
        ;;
      --reason)
        [ "$#" -ge 2 ] || fail "--reason requires a value"
        reason=$2
        shift 2
        ;;
      --final)
        final_run=yes
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown record-check-status option: $1" ;;
    esac
  done
  ensure_state
  assert_identity
  [ -n "$name" ] || fail "--name is required"
  reject_control_chars "$name"
  reject_control_chars "$condition"
  reject_control_chars "$reason"
  case "$requirement" in
    required|conditional|informational) ;;
    *) fail "invalid validation requirement: $requirement" ;;
  esac
  [ "$requirement" != conditional ] || [ -n "$condition" ] || \
    fail "conditional checks require a condition"
  case "$status" in
    passed|failed|unavailable|not-applicable) ;;
    *) fail "invalid check status: ${status:-<missing>}" ;;
  esac
  case "$status" in
    unavailable|not-applicable)
      [ -n "$reason" ] || fail "$status check status requires --reason" ;;
  esac
  [ "$status" != not-applicable ] || [ "$requirement" = conditional ] || \
    fail "only conditional checks may be not-applicable"
  [ "$final_run" != yes ] || [ -z "$(status_porcelain)" ] || \
    fail "final validation status requires a clean committed candidate"
  head=$(git -C "$CHECKOUT" rev-parse HEAD)
  status_id=$(awk 'END { print NR + 1 }' "$STATE/validations.tsv")
  evidence=$STATE/status.$(printf '%04d' "$status_id").log
  printf 'recorded status %s for %s\n' "$status" "$name" >"$evidence"
  append_validation "$name" "$requirement" "$condition" "$status" 0 "$evidence" \
    "record-check-status $name $status" "$head" "$head" "$final_run" "$reason"
  sync_delivery_head "$head"
  sync_validation_state "$head"
  printf 'PASS: recorded %s for %s\n' "$status" "$name"
}

acquire_review_lock() {
  lock_path=$STATE/review.lock
  mkdir "$lock_path" 2>/dev/null || \
    fail "review state is locked by another review activity; retry after it finishes"
  REVIEW_LOCK=$lock_path
  printf '%s\n' "$$" >"$REVIEW_LOCK/pid"
}

review_candidate_ready() {
  candidate_head=$1
  [ "$(delivery_mode_from_state)" = PR ] || return 0
  [ -z "$(status_porcelain)" ] || \
    fail "PR review requires a clean committed candidate"
  check_final_validations "$candidate_head" >/dev/null 2>&1 || \
    fail "PR review requires passing final validation for the current HEAD"
  [ "$(run_state_nested_value review status)" = pending ] || \
    fail "PR review can only start from pending review state"
}

review_run() {
  result=
  source=
  findings=0
  blocked_values=
  blocked_args=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --result)
        [ "$#" -ge 2 ] || fail "--result requires PASS or CHANGES_REQUIRED"
        result=$2
        shift 2
        ;;
      --source)
        [ "$#" -ge 2 ] || fail "--source requires a review source"
        source=$2
        shift 2
        ;;
      --findings)
        [ "$#" -ge 2 ] || fail "--findings requires a non-negative integer"
        findings=$2
        shift 2
        ;;
      --blocked-by)
        [ "$#" -ge 2 ] || fail "--blocked-by requires a finding ID"
        blocked_id=$2
        reject_control_chars "$blocked_id"
        case "$blocked_id" in
          ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) fail "invalid blocked finding ID: $blocked_id" ;;
        esac
        if [ -n "$blocked_values" ]; then
          blocked_values="$blocked_values$NEWLINE$blocked_id"
        else
          blocked_values=$blocked_id
        fi
        blocked_args="$blocked_args --blocked-by $blocked_id"
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown review option: $1" ;;
    esac
  done
  [ "$result" = PASS ] || [ "$result" = CHANGES_REQUIRED ] || \
    fail "invalid review result: ${result:-<missing>}"
  [ -n "$source" ] || fail "--source is required"
  reject_control_chars "$source"
  case "$findings" in ''|*[!0-9]*) fail "findings must be a non-negative integer" ;; esac
  if [ "$result" = CHANGES_REQUIRED ] && [ "$findings" -eq 0 ]; then
    fail "CHANGES_REQUIRED review must report at least one finding"
  fi
  if [ "$result" = CHANGES_REQUIRED ] && [ -z "$blocked_values" ]; then
    fail "CHANGES_REQUIRED review must identify at least one blocking finding"
  fi
  acquire_review_lock
  ensure_state
  assert_identity
  head=$(git -C "$CHECKOUT" rev-parse HEAD)
  review_candidate_ready "$head"
  sync_delivery_head "$head"
  "$SCRIPT_DIR/swe-forge-state" set-review \
    --state "$STATE/run-state.yaml" --head-sha "$head" \
    --result "$result" $blocked_args >/dev/null
  printf 'REVIEW: %s (%s findings)\n' "$result" "$findings"
  [ "$result" = PASS ]
}

final_blockers=0
blocker() {
  final_blockers=$((final_blockers + 1))
  printf 'BLOCKED: %s\n' "$*" >&2
}

check_final_state() {
  final_blockers=0
  ensure_state
  if ! identity_safe; then blocker "checkout identity, branch, or protection state is not safe"; fi
  status=$(status_porcelain)
  [ -z "$status" ] || blocker "checkout is dirty"
  baseline_head=$(run_state_nested_value checkout base_sha)
  current_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  git -C "$CHECKOUT" merge-base --is-ancestor "$baseline_head" "$current_head" || \
    blocker "current HEAD is not based on the recorded baseline"
  if ! check_final_validations "$current_head" >/dev/null 2>&1; then
    blocker "required or applicable final validation is not passing for current HEAD"
  fi
  validation_head=$(run_state_nested_value validation head_sha)
  validation_status=$(run_state_nested_value validation status)
  [ "$validation_head" = "$current_head" ] || \
    blocker "validation state is not for current HEAD"
  [ "$validation_status" = passed ] || \
    blocker "validation state does not record a passing final candidate: ${validation_status:-missing}"

  review_state_status=$(run_state_nested_value review status)
  reviewed_head=$(run_state_nested_value review reviewed_head)
  repair_used=$(run_state_nested_value review repair_used)
  case "$review_state_status" in
    pass)
      [ "$repair_used" = false ] || blocker "review PASS cannot record a repair"
      [ "$reviewed_head" = "$current_head" ] || blocker "review evidence is not for current HEAD"
      ;;
    repaired)
      [ "$(delivery_mode_from_state)" = PR ] || \
        blocker "review repair is only supported for PR delivery"
      [ "$repair_used" = true ] || blocker "repaired review state lacks repair evidence"
      [ "$(review_blocker_count)" -eq 1 ] || \
        blocker "repaired review state must retain one blocking finding"
      [ "$reviewed_head" != "$current_head" ] || \
        blocker "review repair did not produce a new candidate"
      git -C "$CHECKOUT" cat-file -e "$reviewed_head^{commit}" 2>/dev/null || \
        blocker "review evidence references a missing commit"
      if ! git -C "$CHECKOUT" merge-base --is-ancestor "$reviewed_head" "$current_head" 2>/dev/null; then
        blocker "repaired candidate is not based on the reviewed HEAD"
      fi
      ;;
    changes-required) blocker "review has unresolved findings" ;;
    *) blocker "canonical review state does not permit delivery: ${review_state_status:-missing}" ;;
  esac
}

deliver_pr() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown deliver-pr option: $1" ;;
    esac
  done
  ensure_state
  [ "$(delivery_mode_from_state)" = PR ] || fail "deliver-pr is only valid in PR mode"
  check_final_state
  [ "$final_blockers" -eq 0 ] || exit 1
  printf 'PASS: PR delivery prerequisites\n'
  printf 'BRANCH: %s\n' "$(current_branch)"
  printf 'HEAD: %s\n' "$(git -C "$CHECKOUT" rev-parse HEAD)"
}

main() {
  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  command=$1
  shift
  case "$command" in
    preflight) preflight "$@" ;;
    validate) validate_run "$@" ;;
    record-check-status) record_check_status "$@" ;;
    review) review_run "$@" ;;
    deliver-pr) deliver_pr "$@" ;;
    -h|--help) usage ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"
