#!/bin/sh

# Release payloads place the compiled executable beside the .swe-forge tree.
# Source checkouts retain the direct Bun/TypeScript development path.

set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
STANDALONE=$SCRIPT_DIR/../../swe-forge
if [ -x "$STANDALONE" ]; then
  exec "$STANDALONE" internal gate "$@"
fi

ROOT=$(CDPATH= cd "$SCRIPT_DIR/../.." && pwd -P)
exec bun "$ROOT/src/core/evidence/cli.ts" "$@"
