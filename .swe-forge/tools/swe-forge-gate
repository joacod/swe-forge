#!/bin/sh

# Dependency-free Git/evidence guard for SWE Forge runs.
# The ledger is private supporting evidence, not a replacement for run state.

set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
PROGRAM=${0##*/}
STATE=
CHECKOUT=
SCOPE_TMP=
CHANGED_TMP=
LEDGER_TMP=
REVIEW_LOCK=
REVIEW_TMP=
TAB=$(printf '\t')
NEWLINE='
'

cleanup() {
  [ -z "${SCOPE_TMP:-}" ] || rm -f "$SCOPE_TMP"
  [ -z "${CHANGED_TMP:-}" ] || rm -f "$CHANGED_TMP"
  [ -z "${LEDGER_TMP:-}" ] || rm -f "$LEDGER_TMP"
  [ -z "${REVIEW_TMP:-}" ] || rm -f "$REVIEW_TMP"
  if [ -n "${REVIEW_LOCK:-}" ]; then
    rm -f "$REVIEW_LOCK/pid"
    rmdir "$REVIEW_LOCK" 2>/dev/null || true
  fi
}

trap 'status=$?; cleanup; exit "$status"' 0 HUP INT TERM

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  scripts/swe-forge-gate preflight --state DIR [--branch BRANCH] [--base REF]
    [--requested-mode MODE] [--routing-preferred MODE] [--routing-current MODE]
    [--requested-delivery DELIVERY] [--delivery-mode MODE]
  scripts/swe-forge-gate plan-check --state DIR --name NAME --requirement TYPE \
    [--condition TEXT] [--final-required true|false]
  scripts/swe-forge-gate validate --state DIR --name NAME [--final] \
    [--mutation-producing --mutation-scope PATH --mutation-reason TEXT] -- COMMAND [ARGS...]
  scripts/swe-forge-gate record-check-status --state DIR --name NAME \
    --status passed|failed|unavailable|not-applicable [--reason TEXT] [--final]
  scripts/swe-forge-gate fingerprint [--checkout PATH]
  scripts/swe-forge-gate checkpoint --state DIR --scope PATH [--scope PATH...] \
    [--review-repair]
  scripts/swe-forge-gate commit-slice --state DIR --checkpoint ID \
    --message MESSAGE --authorized-by PR|GO [--review-repair]
  scripts/swe-forge-gate review --state DIR --result PASS|CHANGES_REQUIRED \
    --source SOURCE [--findings N] [--repaired N] [--blocked-by ID...]
  scripts/swe-forge-gate deliver-pr --state DIR
  scripts/swe-forge-gate receipt --state DIR --execution MODE \
    --delivery GUIDED|PR [metadata options]
  scripts/swe-forge-gate receipt-verify --state DIR --receipt FILE

Receipt metadata options:
  --forge-version VERSION       SWE Forge release version.
  --harness NAME                Harness used for the run.
  --harness-version VERSION     Harness version when known.
  --requested-mode MODE         AUTO, SOLO, or SUBAGENTS.
  --selected-mode MODE          SOLO or SUBAGENTS.
  --model-provider PROVIDER     Public model provider label when safe.
  --routing-reason TEXT         Short routing rationale.
  --model MODEL                 Model label when safe to publish.

The guard never launches agents, controls external orchestration, pushes,
creates a PR, publishes, deploys, or merges.
EOF
}

reject_control_chars() {
  value=$1
  case "$value" in
    *"$TAB"*|*"$NEWLINE"*)
      fail "values containing tabs or newlines are not supported" ;;
  esac
}

absolute_path() {
  path=$1
  reject_control_chars "$path"
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    *) printf '%s/%s\n' "$PWD" "$path" ;;
  esac
}

state_path() {
  path=$(absolute_path "$1")
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -d "$path" ] && [ ! -L "$path" ] || fail "state path must be a real directory: $path"
    CDPATH= cd "$path" && pwd -P
    return
  fi
  parent=$(dirname "$path")
  [ -d "$parent" ] && [ ! -L "$parent" ] || fail "state parent must be a real directory: $parent"
  CDPATH= cd "$parent" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$path")"
}

git_root_from_cwd() {
  git rev-parse --show-toplevel 2>/dev/null || fail "not inside a Git checkout"
}

meta_value() {
  key=$1
  file=$2
  awk -F= -v wanted="$key" '$1 == wanted { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

state_signature() {
  cksum "$STATE/run-state.yaml" | awk '{ print $1 ":" $2 }'
}

validate_run_state() {
  [ -f "$STATE/run-state.yaml" ] || return 0
  [ -x "$SCRIPT_DIR/swe-forge-state" ] || return 0
  signature=$(state_signature)
  marker=$STATE/run-state.valid
  if [ -f "$marker" ] && [ "$(cat "$marker")" = "$signature" ]; then
    return 0
  fi
  "$SCRIPT_DIR/swe-forge-state" validate --state "$STATE/run-state.yaml" >/dev/null
  marker_tmp=$marker.tmp.$$
  printf '%s\n' "$signature" >"$marker_tmp"
  mv "$marker_tmp" "$marker"
}

state_meta() {
  [ -n "${STATE:-}" ] || fail "--state is required"
  [ -f "$STATE/meta.env" ] || fail "state has not been initialized: $STATE"
  if grep -Eq '^state_version=1([[:space:]]|$)' "$STATE/meta.env"; then
    fail "evidence state is stale or unsupported; start a fresh run"
  fi
  CHECKOUT=$(meta_value checkout_path "$STATE/meta.env")
  [ -n "$CHECKOUT" ] || fail "state is missing checkout_path"
  [ -d "$CHECKOUT" ] || fail "recorded checkout no longer exists: $CHECKOUT"
  validate_run_state
}
run_state_value() {
  key=$1
  awk -v wanted="$key" '
    $1 == wanted ":" {
      sub(/^[^:]*:[[:space:]]*/, "")
      print
      exit
    }
  ' "$STATE/run-state.yaml"
}
run_state_nested_value() {
  section_wanted=$1
  key_wanted=$2
  awk -v wanted_section="$section_wanted" -v wanted_key="$key_wanted" '
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
    }
    section == wanted_section && $1 == wanted_key ":" {
      sub(/^[^:]*:[[:space:]]*/, "")
      print
      exit
    }
  ' "$STATE/run-state.yaml"
}


delivery_mode_from_state() {
  run_state_value delivery_mode
}

validate_checkpoint_ledger() {
  if ! awk -F "$TAB" '
    BEGIN { valid = 1 }
    NF == 0 { next }
    NF != 10 { valid = 0; exit }
    $9 != "none" && $9 != "slice" && $9 != "review-repair" { valid = 0; exit }
    $10 != "none" && (length($10) != 40 || $10 !~ /^[0-9A-Fa-f]+$/) { valid = 0; exit }
    END { exit !valid }
  ' "$STATE/checkpoints.tsv"; then
    fail "evidence state is stale or unsupported; checkpoint ledger has an invalid format"
  fi
}

acquire_review_lock() {
  lock_path=$STATE/review.lock
  mkdir "$lock_path" 2>/dev/null || \
    fail "review state is locked by another review activity; retry after it finishes"
  REVIEW_LOCK=$lock_path
  printf '%s\n' "$$" >"$REVIEW_LOCK/pid"
}
review_repair_allowed() {
  review_status=$(run_state_nested_value review status)
  review_attempts=$(run_state_nested_value review attempts)
  review_ceiling=$(run_state_nested_value review retry_ceiling)
  [ "$review_status" = changes-required ] || \
    fail "review-repair activity requires an unresolved changes-required review"
  case "$review_attempts:$review_ceiling" in
    ''|*[!0-9:]*|*:*:) fail "review-repair activity has invalid review budget" ;;
  esac
  [ "$review_attempts" -lt "$review_ceiling" ] || \
    fail "review-repair activity stopped at the review ceiling: $review_attempts/$review_ceiling"
}

review_repair_commit_exists() {
  repair_current_head=$1
  repair_review_head=$(meta_value head "$STATE/review.env" 2>/dev/null || true)
  [ -n "$repair_review_head" ] || return 1
  while IFS="$TAB" read -r repair_id repair_branch repair_recorded_head repair_fp \
    repair_paths repair_scope repair_recorded repair_checks repair_kind repair_commit; do
    [ "$repair_kind" = review-repair ] || continue
    [ -n "$repair_commit" ] || continue
    [ "$repair_recorded_head" = "$repair_review_head" ] || continue
    repair_parent=$(git -C "$CHECKOUT" rev-parse "$repair_commit^" 2>/dev/null || true)
    [ "$repair_parent" = "$repair_recorded_head" ] || continue
    git -C "$CHECKOUT" merge-base --is-ancestor "$repair_commit" "$repair_current_head" 2>/dev/null || continue
    return 0
  done <"$STATE/checkpoints.tsv"
  return 1
}

review_candidate_ready() {
  candidate_attempts=$1
  candidate_head=$2
  candidate_fp=$3
  [ "$(delivery_mode_from_state)" = PR ] || return 0

  candidate_ceiling=$(run_state_nested_value review retry_ceiling)
  [ "$candidate_attempts" -lt "$candidate_ceiling" ] || \
    fail "review ceiling exhausted: $candidate_attempts/$candidate_ceiling executions already recorded; automatic reviewer-like activity is stopped"
  [ -z "$(status_porcelain)" ] || \
    fail "PR review requires a clean committed candidate"
  check_requirements "$candidate_fp" yes >/dev/null 2>&1 || \
    fail "PR review requires passing final validation for the current candidate"

  case "$candidate_attempts" in
    0)
      [ "$(run_state_nested_value review status)" = pending ] || \
        fail "PR review can only start from pending review state"
      ;;
    *)
      [ "$(run_state_nested_value review status)" = changes-required ] || \
        fail "PR focused re-review requires an unresolved changes-required review"
      review_repair_commit_exists "$candidate_head" || \
        fail "PR focused re-review requires a materialized review-repair commit"
      ;;
  esac
}


ensure_meta_state() {
  state_meta
  [ -f "$STATE/plan.tsv" ] || : >"$STATE/plan.tsv"
  [ -f "$STATE/validations.tsv" ] || : >"$STATE/validations.tsv"
  [ -f "$STATE/checkpoints.tsv" ] || : >"$STATE/checkpoints.tsv"
  validate_checkpoint_ledger
}

ensure_safe_state_location() {
  root=$1
  case "$STATE" in
    "$root") fail "state directory must not be the checkout root" ;;
    "$root"/*)
      relative=${STATE#"$root"/}
      git -C "$root" check-ignore -q --no-index "$relative" || \
        fail "state inside checkout must already be ignored: $STATE" ;;
  esac
}

current_branch() {
  git -C "$CHECKOUT" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

remote_default_branch() {
  remote_head=$(git -C "$CHECKOUT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  case "$remote_head" in
    */*) printf '%s\n' "${remote_head#*/}" ;;
    *) printf '%s\n' '' ;;
  esac
}

assert_not_protected() {
  branch=$1
  remote_default=$2
  [ "$branch" != main ] || fail "protected branch is not writable: $branch"
  [ "$branch" != master ] || fail "protected branch is not writable: $branch"
  [ -z "$remote_default" ] || [ "$branch" != "$remote_default" ] || \
    fail "remote default branch is not writable: $branch"
}

status_porcelain() {
  git -C "$CHECKOUT" status --porcelain=v1 --untracked-files=all
}

identity_safe() {
  actual_root=$(git -C "$CHECKOUT" rev-parse --show-toplevel 2>/dev/null || true)
  [ "$actual_root" = "$CHECKOUT" ] || return 1
  branch=$(current_branch)
  [ -n "$branch" ] || return 1
  baseline_branch=$(meta_value baseline_branch "$STATE/meta.env")
  [ "$branch" = "$baseline_branch" ] || return 1
  remote_default=$(meta_value remote_default "$STATE/meta.env")
  [ "$branch" != main ] || return 1
  [ "$branch" != master ] || return 1
  [ -z "$remote_default" ] || [ "$branch" != "$remote_default" ] || return 1
}

assert_identity() {
  state_meta
  identity_safe || fail "checkout identity, branch, or protection state changed"
}

write_meta() {
  baseline=$1
  branch=$2
  remote_default=$3
  head=$4
  meta_tmp=$STATE/meta.env.tmp.$$
  {
    printf 'state_version=2\n'
    printf 'checkout_path=%s\n' "$CHECKOUT"
    printf 'baseline_head=%s\n' "$baseline"
    printf 'checkout_head=%s\n' "$head"
    printf 'baseline_branch=%s\n' "$branch"
    printf 'remote_default=%s\n' "$remote_default"
    printf 'created_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$meta_tmp"
  mv "$meta_tmp" "$STATE/meta.env"
}

update_meta_checkout() {
  new_head=$1
  meta_tmp=$STATE/meta.env.tmp.$$
  awk -F= -v wanted="$new_head" '
    $1 == "checkout_head" {
      print "checkout_head=" wanted
      next
    }
    { print }
  ' "$STATE/meta.env" >"$meta_tmp"
  mv "$meta_tmp" "$STATE/meta.env"
}

preflight() {
  expected_branch=
  baseline_ref=HEAD
  requested_mode=AUTO
  requested_delivery=PR
  delivery_mode=PR
  routing_preferred=SOLO
  routing_current=SOLO
  state_reason='single-checkout implementation'
  fallback_used=no
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --branch)
        [ "$#" -ge 2 ] || fail "--branch requires a name"
        expected_branch=$2
        reject_control_chars "$expected_branch"
        shift 2
        ;;
      --base)
        [ "$#" -ge 2 ] || fail "--base requires a Git revision"
        baseline_ref=$2
        reject_control_chars "$baseline_ref"
        shift 2
        ;;
      --requested-mode)
        [ "$#" -ge 2 ] || fail "--requested-mode requires a topology"
        requested_mode=$2
        reject_control_chars "$requested_mode"
        shift 2
        ;;
      --requested-delivery)
        [ "$#" -ge 2 ] || fail "--requested-delivery requires DEFAULT, GUIDED, or PR"
        requested_delivery=$2
        reject_control_chars "$requested_delivery"
        shift 2
        ;;
      --delivery-mode)
        [ "$#" -ge 2 ] || fail "--delivery-mode requires GUIDED or PR"
        delivery_mode=$2
        reject_control_chars "$delivery_mode"
        shift 2
        ;;
      --routing-preferred)
        [ "$#" -ge 2 ] || fail "--routing-preferred requires a topology"
        routing_preferred=$2
        reject_control_chars "$routing_preferred"
        shift 2
        ;;
      --routing-current)
        [ "$#" -ge 2 ] || fail "--routing-current requires a topology"
        routing_current=$2
        reject_control_chars "$routing_current"
        shift 2
        ;;
      --reason)
        [ "$#" -ge 2 ] || fail "--reason requires text"
        state_reason=$2
        reject_control_chars "$state_reason"
        shift 2
        ;;
      --fallback-used)
        [ "$#" -ge 2 ] || fail "--fallback-used requires text"
        fallback_used=$2
        reject_control_chars "$fallback_used"
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown preflight option: $1" ;;
    esac
  done

  [ -n "${STATE:-}" ] || fail "--state is required"
  CHECKOUT=$(git_root_from_cwd)
  ensure_safe_state_location "$CHECKOUT"
  [ ! -e "$STATE/meta.env" ] || fail "state is already initialized: $STATE"
  umask 077
  branch=$(current_branch)
  [ -n "$branch" ] || fail "checkout is detached"
  [ -z "$expected_branch" ] || [ "$branch" = "$expected_branch" ] || \
    fail "current branch $branch does not match expected branch $expected_branch"
  remote_default=$(remote_default_branch)
  assert_not_protected "$branch" "$remote_default"
  status=$(status_porcelain)
  [ -z "$status" ] || fail "checkout is not clean before writable work"
  head=$(git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null || fail "checkout has no commit baseline")
  base_head=$(git -C "$CHECKOUT" rev-parse "$baseline_ref" 2>/dev/null || \
    fail "base revision does not resolve: $baseline_ref")
  git -C "$CHECKOUT" merge-base --is-ancestor "$base_head" "$head" || \
    fail "base revision is not an ancestor of the current checkout: $baseline_ref"
  mkdir -p "$STATE"
  write_meta "$base_head" "$branch" "$remote_default" "$head"
  : >"$STATE/plan.tsv"
  : >"$STATE/validations.tsv"
  : >"$STATE/checkpoints.tsv"
  "$SCRIPT_DIR/swe-forge-state" init \
    --state "$STATE" \
    --checkout "$CHECKOUT" \
    --run-id "$(basename "$STATE")" \
    --baseline-ref "$base_head" \
    --requested-mode "$requested_mode" \
    --requested-delivery "$requested_delivery" \
    --delivery-mode "$delivery_mode" \
    --routing-preferred "$routing_preferred" \
    --routing-current "$routing_current" \
    --reason "$state_reason" \
    --fallback-used "$fallback_used" \
    --delivery-status ready \
    --delivery-branch-setup reused \
    --remote-default-evidence "${remote_default:-none}" >/dev/null
  "$SCRIPT_DIR/swe-forge-state" set-continuation \
    --state "$STATE" \
    --workflow-active true \
    --workflow ticket \
    --phase planning \
    --step 0 \
    --awaiting none \
    --next-action-kind specify \
    --next-action-target working-spec \
    --safe-boundary true >/dev/null
  validate_run_state
  printf 'PASS: preflight baseline recorded at %s\n' "$STATE"
  printf 'BASELINE_HEAD: %s\n' "$base_head"
  printf 'CHECKOUT_HEAD: %s\n' "$head"
  printf 'BRANCH: %s\n' "$branch"
}

candidate_paths_for_checkout() {
  root=$1
  {
    git -C "$root" diff --name-only --find-renames HEAD --
    git -C "$root" ls-files --others --exclude-standard
  } | LC_ALL=C sort -u
}

fingerprint_for_checkout() {
  root=$1
  [ -d "$root" ] || fail "checkout does not exist: $root"
  git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1 || fail "not a Git checkout: $root"
  paths=$(candidate_paths_for_checkout "$root")
  if [ -n "$paths" ]; then
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      reject_control_chars "$path"
      case "$path" in
        /*|../*|*/../*|..)
          fail "candidate path is not repository-relative: $path" ;;
      esac
    done <<EOF_PATHS
$paths
EOF_PATHS
  fi
  {
    printf 'HEAD\t%s\n' "$(git -C "$root" rev-parse HEAD)"
    printf 'CANDIDATE_BEGIN\n'
    if [ -n "$paths" ]; then
      while IFS= read -r path; do
        [ -n "$path" ] || continue
        full_path=$root/$path
        if [ -L "$full_path" ]; then
          type=symlink
          mode=symlink
          hash=$(readlink "$full_path")
        elif [ -f "$full_path" ]; then
          type=regular
          if [ -x "$full_path" ]; then mode=executable; else mode=regular; fi
          if hash=$(CDPATH= cd "$root" && git hash-object -- "$path" 2>/dev/null); then :; else hash=unreadable; fi
        elif [ -e "$full_path" ]; then
          type=other
          mode=other
          if hash=$(CDPATH= cd "$root" && git hash-object -- "$path" 2>/dev/null); then :; else hash=unreadable; fi
        else
          type=deleted
          mode=deleted
          hash=deleted
        fi
        reject_control_chars "$hash"
        printf '%s\t%s\t%s\t%s\n' "$path" "$type" "$mode" "$hash"
      done <<EOF_CANDIDATE
$paths
EOF_CANDIDATE
    fi
    printf 'CANDIDATE_END\n'
  } | git -C "$root" hash-object --stdin
}

fingerprint_run() {
  root=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --checkout)
        [ "$#" -ge 2 ] || fail "--checkout requires a path"
        root=$(absolute_path "$2")
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown fingerprint option: $1" ;;
    esac
  done
  [ -n "$root" ] || root=$(git_root_from_cwd)
  fingerprint_for_checkout "$root"
}

changed_paths_for_checkout() {
  candidate_paths_for_checkout "$1"
}

scope_allows() {
  candidate=$1
  while IFS= read -r scope; do
    [ -n "$scope" ] || continue
    reject_control_chars "$scope"
    case "$scope" in
      */\*\*)
        prefix=${scope%/\*\*}
        case "$candidate" in
          "$prefix"|"$prefix"/*) return 0 ;;
        esac
        ;;
      *)
        [ "$candidate" = "$scope" ] && return 0 ;;
    esac
  done <"$SCOPE_TMP"
  return 1
}

plan_values() {
  name=$1
  awk -F '\t' -v wanted="$name" '$1 == wanted { print; exit }' "$STATE/plan.tsv"
}

plan_check() {
  name=
  requirement=
  condition=always
  final_required=true
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --name)
        [ "$#" -ge 2 ] || fail "--name requires a value"
        name=$2
        shift 2
        ;;
      --requirement)
        [ "$#" -ge 2 ] || fail "--requirement requires required, conditional, or informational"
        requirement=$2
        shift 2
        ;;
      --condition)
        [ "$#" -ge 2 ] || fail "--condition requires a value"
        condition=$2
        shift 2
        ;;
      --final-required)
        [ "$#" -ge 2 ] || fail "--final-required requires true or false"
        final_required=$2
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown plan-check option: $1" ;;
    esac
  done
  ensure_meta_state
  [ -n "$name" ] || fail "--name is required"
  reject_control_chars "$name"
  reject_control_chars "$condition"
  case "$requirement" in required|conditional|informational) ;; *) fail "invalid validation requirement: ${requirement:-<missing>}" ;; esac
  case "$final_required" in true|false) ;; *) fail "--final-required must be true or false" ;; esac
  [ "$requirement" != conditional ] || [ -n "$condition" ] || fail "conditional checks require a condition"
  [ -z "$(plan_values "$name")" ] || fail "planned check already exists: $name"
  printf '%s\t%s\t%s\t%s\n' "$name" "$requirement" "$condition" "$final_required" >>"$STATE/plan.tsv"
  printf 'PASS: planned check %s\n' "$name"
}

latest_status() {
  name=$1
  wanted_fp=$2
  final_mode=$3
  awk -F '\t' -v wanted="$name" -v fp="$wanted_fp" -v final="$final_mode" '
    $2 == wanted && $13 == fp && (final != "yes" || $17 == "yes") {
      status=$5
      reason=$16
    }
    END {
      if (status == "") status="missing"
      printf "%s\t%s\n", status, reason
    }
  ' "$STATE/validations.tsv"
}

checkpoint_has_check() {
  wanted=$1
  for checks_file in "$STATE"/checkpoint.*.checks; do
    [ -f "$checks_file" ] || continue
    grep -Fx "$wanted" "$checks_file" >/dev/null 2>&1 && return 0
  done
  return 1
}

check_requirements() {
  wanted_fp=$1
  final_mode=$2
  found=0
  current_evidence=0
  blockers=
  slice_checks=0
  while IFS="$TAB" read -r name requirement condition final_required; do
    [ -n "${name:-}" ] || continue
    [ "$final_required" = false ] || continue
    slice_checks=1
    break
  done <"$STATE/plan.tsv"
  while IFS="$TAB" read -r name requirement condition final_required; do
    [ -n "${name:-}" ] || continue
    if [ "$final_mode" = yes ] && [ "$final_required" != true ]; then
      continue
    fi
    if [ "$final_mode" != yes ] && [ "$final_required" = true ] && \
      [ "$slice_checks" -eq 1 ]; then
      # Final-only checks may be planned up front without forcing a full
      # repository run at every slice checkpoint.
      continue
    fi
    found=$((found + 1))
    case "$requirement" in
      informational) continue ;;
    esac
    result=$(latest_status "$name" "$wanted_fp" "$final_mode")
    status=${result%%"$TAB"*}
    reason=${result#*"$TAB"}
    if [ "$status" != missing ]; then
      current_evidence=$((current_evidence + 1))
    elif [ "$final_mode" != yes ] && [ "$final_required" = false ] && \
      checkpoint_has_check "$name"; then
      # A slice-local check already passed at an earlier committed checkpoint.
      # New slice checks still have to produce evidence for this candidate.
      continue
    fi
    okay=no
    case "$requirement:$status" in
      required:passed) okay=yes ;;
      conditional:passed) okay=yes ;;
      conditional:not_applicable)
        [ -n "$reason" ] && okay=yes ;;
    esac
    if [ "$okay" != yes ]; then
      if [ -n "$blockers" ]; then blockers="$blockers, $name ($status)"; else blockers="$name ($status)"; fi
    fi
  done <"$STATE/plan.tsv"
  [ "$found" -gt 0 ] || {
    printf 'planned validation is not passing: no planned checks\n' >&2
    return 1
  }
  if [ "$final_mode" != yes ] && [ "$current_evidence" -eq 0 ]; then
    printf 'planned validation is not passing: no current-slice evidence\n' >&2
    return 1
  fi
  if [ -n "$blockers" ]; then
    printf 'planned validation is not passing: %s\n' "$blockers" >&2
    return 1
  fi
}

append_attempt() {
  name=$1
  requirement=$2
  condition=$3
  result=$4
  code=$5
  evidence=$6
  command_display=$7
  head_before=$8
  head_after=$9
  fp_before=${10}
  fp_after=${11}
  bound_fp=${12}
  mutation=${13}
  mutation_scope=${14}
  mutation_reason=${15}
  final_run=${16}
  id=$(awk 'END { print NR + 1 }' "$STATE/validations.tsv")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$id" "$name" "$requirement" "$condition" "$result" "$code" \
    "$(basename "$evidence")" "$command_display" "$head_before" "$head_after" \
    "$fp_before" "$fp_after" "$bound_fp" "$mutation" "$mutation_scope" \
    "$mutation_reason" "$final_run" >>"$STATE/validations.tsv"
}

join_command() {
  command_display=
  for command_arg do
    reject_control_chars "$command_arg"
    if [ -n "$command_display" ]; then
      command_display="$command_display $command_arg"
    else
      command_display=$command_arg
    fi
  done
  printf '%s\n' "$command_display"
}

validate_run() {
  name=
  final_run=no
  mutation=no
  mutation_scope=
  mutation_reason=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --name)
        [ "$#" -ge 2 ] || fail "--name requires a label"
        name=$2
        shift 2
        ;;
      --requirement)
        [ "$#" -ge 2 ] || fail "--requirement is derived from the plan; do not provide it"
        fail "validate must refer to a registered check; requirement is stored by plan-check" ;;
      --final)
        final_run=yes
        shift
        ;;
      --mutation-producing|--allow-mutation)
        mutation=yes
        shift
        ;;
      --mutation-scope|--mutation-path)
        [ "$#" -ge 2 ] || fail "--mutation-scope requires a path"
        mutation_scope=$2
        shift 2
        ;;
      --mutation-reason)
        [ "$#" -ge 2 ] || fail "--mutation-reason requires a reason"
        mutation_reason=$2
        shift 2
        ;;
      --)
        shift
        break
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown validate option: $1" ;;
    esac
  done
  [ -n "$name" ] || fail "--name is required"
  [ "$#" -gt 0 ] || fail "a command is required after --"
  ensure_meta_state
  assert_identity
  plan=$(plan_values "$name")
  [ -n "$plan" ] || fail "validate refers to unregistered check: $name"
  IFS="$TAB" read -r planned_name requirement condition planned_final <<EOF_PLAN
$plan
EOF_PLAN
  reject_control_chars "$mutation_scope"
  reject_control_chars "$mutation_reason"
  if [ "$mutation" = yes ]; then
    [ -n "$mutation_scope" ] || fail "mutation-producing checks require --mutation-scope"
    [ -n "$mutation_reason" ] || fail "mutation-producing checks require --mutation-reason"
  else
    [ -z "$mutation_scope" ] || fail "--mutation-scope requires --mutation-producing"
    [ -z "$mutation_reason" ] || fail "--mutation-reason requires --mutation-producing"
  fi
  command_display=$(join_command "$@")
  id=$(awk 'END { print NR + 1 }' "$STATE/validations.tsv")
  evidence_file=$STATE/validation.$(printf '%04d' "$id").log
  head_before=$(git -C "$CHECKOUT" rev-parse HEAD)
  fp_before=$(fingerprint_for_checkout "$CHECKOUT")
  if (CDPATH= cd "$CHECKOUT" && "$@") >"$evidence_file" 2>&1; then
    command_result=passed
    code=0
  else
    code=$?
    command_result=failed
  fi
  head_after=$(git -C "$CHECKOUT" rev-parse HEAD)
  fp_after=$(fingerprint_for_checkout "$CHECKOUT")
  bound_fp=$fp_after
  result=$command_result
  if [ "$fp_before" != "$fp_after" ] && [ "$mutation" != yes ]; then
    result=failed
    printf '\nSWE Forge evidence binding failure: command changed candidate source content.\n' >>"$evidence_file"
    mutation_reason_record='un-declared candidate mutation'
  else
    mutation_reason_record=$mutation_reason
  fi
  append_attempt "$name" "$requirement" "$condition" "$result" "$code" \
    "$evidence_file" "$command_display" "$head_before" "$head_after" \
    "$fp_before" "$fp_after" "$bound_fp" "$mutation" "$mutation_scope" \
    "$mutation_reason_record" "$final_run"
  if [ "$fp_before" != "$fp_after" ] && [ "$mutation" != yes ]; then
    printf 'FAIL: validation changed candidate source content (%s)\n' "$evidence_file" >&2
  fi
  printf '%s: %s (%s)\n' "$name" "$result" "$evidence_file"
  [ "$result" = passed ]
}

record_check_status() {
  name=
  status=
  reason=
  final_run=no
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --name)
        [ "$#" -ge 2 ] || fail "--name requires a label"
        name=$2
        shift 2
        ;;
      --status)
        [ "$#" -ge 2 ] || fail "--status requires a value"
        status=$2
        shift 2
        ;;
      --reason)
        [ "$#" -ge 2 ] || fail "--reason requires a value"
        reason=$2
        shift 2
        ;;
      --final)
        final_run=yes
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown record-check-status option: $1" ;;
    esac
  done
  ensure_meta_state
  assert_identity
  [ -n "$name" ] || fail "--name is required"
  reject_control_chars "$name"
  reject_control_chars "$reason"
  plan=$(plan_values "$name")
  [ -n "$plan" ] || fail "record-check-status refers to unregistered check: $name"
  IFS="$TAB" read -r planned_name requirement condition planned_final <<EOF_PLAN
$plan
EOF_PLAN
  case "$status" in passed|failed|unavailable|not-applicable) ;; *) fail "invalid check status: ${status:-<missing>}" ;; esac
  case "$status" in unavailable|not-applicable)
    [ -n "$reason" ] || fail "$status check status requires --reason" ;;
  esac
  [ "$status" != not-applicable ] || [ "$requirement" = conditional ] || \
    fail "only conditional checks may be not-applicable"
  head=$(git -C "$CHECKOUT" rev-parse HEAD)
  fp=$(fingerprint_for_checkout "$CHECKOUT")
  status_id=$(awk 'END { print NR + 1 }' "$STATE/validations.tsv")
  evidence=$STATE/status.$(printf '%04d' "$status_id").log
  printf 'recorded status %s for %s\n' "$status" "$name" >"$evidence"
  append_attempt "$name" "$requirement" "$condition" "$status" 0 "$evidence" \
    "record-check-status $name $status" "$head" "$head" "$fp" "$fp" "$fp" \
    no '' "$reason" "$final_run"
  printf 'PASS: recorded %s for %s\n' "$status" "$name"
}

checkpoint_field() {
  id=$1
  field=$2
  awk -F '\t' -v wanted="$id" -v number="$field" '$1 == wanted { print $number; exit }' "$STATE/checkpoints.tsv"
}
record_checkpoint_commit() {
  checkpoint_id=$1
  commit_sha=$2
  LEDGER_TMP=$STATE/checkpoints.tsv.tmp.$$
  awk -F "$TAB" -v OFS="$TAB" -v wanted="$checkpoint_id" -v commit="$commit_sha" '
    $1 == wanted {
      $10 = commit
      count++
    }
    { print }
    END { if (count != 1) exit 1 }
  ' "$STATE/checkpoints.tsv" >"$LEDGER_TMP" || \
    fail "checkpoint commit evidence could not be recorded: $checkpoint_id"
  mv "$LEDGER_TMP" "$STATE/checkpoints.tsv"
  LEDGER_TMP=
}


same_path_sets() {
  first=$1
  second=$2
  first_tmp=$STATE/.set-a.$$
  second_tmp=$STATE/.set-b.$$
  LC_ALL=C sort -u "$first" >"$first_tmp"
  LC_ALL=C sort -u "$second" >"$second_tmp"
  if cmp -s "$first_tmp" "$second_tmp"; then result=0; else result=1; fi
  rm -f "$first_tmp" "$second_tmp"
  return "$result"
}

checkpoint_run() {
  scope_count=0
  SCOPE_VALUES=
  review_repair=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --scope)
        [ "$#" -ge 2 ] || fail "--scope requires a path or path/**"
        [ -n "$2" ] || fail "--scope requires a non-empty path"
        reject_control_chars "$2"
        case "$2" in /*|../*|*/../*|.. ) fail "checkpoint scope must be repository-relative: $2" ;; esac
        if [ -n "$SCOPE_VALUES" ]; then SCOPE_VALUES="$SCOPE_VALUES$NEWLINE$2"; else SCOPE_VALUES=$2; fi
        scope_count=$((scope_count + 1))
        shift 2
        ;;
      --review-repair)
        [ "$review_repair" = false ] || fail "--review-repair may be provided only once"
        review_repair=true
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown checkpoint option: $1" ;;
    esac
  done
  [ "$scope_count" -gt 0 ] || fail "at least one --scope is required"
  delivery_mode=$(delivery_mode_from_state)
  if [ "$delivery_mode" = PR ]; then
    if [ "$review_repair" = true ]; then
      review_repair_allowed
      checkpoint_kind=review-repair
    else
      [ "$(run_state_nested_value review status)" != changes-required ] || \
        fail "PR checkpoint after a review finding requires --review-repair"
      checkpoint_kind=slice
    fi
  else
    [ "$review_repair" = false ] || fail "--review-repair is only valid in PR mode"
    checkpoint_kind=none
  fi
  SCOPE_TMP=$STATE/scope.$$
  printf '%s\n' "$SCOPE_VALUES" >"$SCOPE_TMP"
  assert_identity
  CHANGED_TMP=$STATE/changed.$$
  committed_tmp=$STATE/committed.$$
  changed_paths_for_checkout "$CHECKOUT" >"$CHANGED_TMP"
  baseline_head=$(meta_value baseline_head "$STATE/meta.env")
  last_known_head=$(meta_value checkout_head "$STATE/meta.env")
  current_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  [ -n "$last_known_head" ] || fail "state is missing checkout_head"
  if [ "$last_known_head" != "$current_head" ]; then
    fail "checkout HEAD changed outside SWE Forge slice delivery; start a new preflight"
  fi
  git -C "$CHECKOUT" diff --name-only --find-renames "$baseline_head..$current_head" | LC_ALL=C sort -u >"$committed_tmp"
  if [ ! -s "$CHANGED_TMP" ] && [ "$baseline_head" != "$current_head" ]; then
    cp "$committed_tmp" "$CHANGED_TMP"
  fi
  changed_count=0
  out_of_scope=
  while IFS= read -r changed; do
    [ -n "$changed" ] || continue
    reject_control_chars "$changed"
    changed_count=$((changed_count + 1))
    if ! scope_allows "$changed"; then
      if [ -n "$out_of_scope" ]; then out_of_scope="$out_of_scope, $changed"; else out_of_scope=$changed; fi
    fi
  done <"$CHANGED_TMP"
  [ "$changed_count" -gt 0 ] || fail "checkpoint has no changed files"
  [ -z "$out_of_scope" ] || fail "changed files outside checkpoint scope: $out_of_scope"
  candidate_fp=$(fingerprint_for_checkout "$CHECKOUT")
  check_requirements "$candidate_fp" no
  id=$(awk 'END { print NR + 1 }' "$STATE/checkpoints.tsv")
  paths_file=$STATE/checkpoint.$(printf '%04d' "$id").paths
  scope_file=$STATE/checkpoint.$(printf '%04d' "$id").scope
  checks_file=$STATE/checkpoint.$(printf '%04d' "$id").checks
  cp "$CHANGED_TMP" "$paths_file"
  cp "$SCOPE_TMP" "$scope_file"
  : >"$checks_file"
  while IFS="$TAB" read -r name requirement condition final_required; do
    [ -n "${name:-}" ] || continue
    case "$requirement" in informational) continue ;; esac
    result=$(latest_status "$name" "$candidate_fp" no)
    status=${result%%"$TAB"*}
    reason=${result#*"$TAB"}
    case "$requirement:$status" in
      required:passed|conditional:passed) printf '%s\n' "$name" >>"$checks_file" ;;
      conditional:not_applicable)
        [ -n "$reason" ] && printf '%s\n' "$name" >>"$checks_file" ;;
    esac
  done <"$STATE/plan.tsv"
  branch=$(current_branch)
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tnone\n' "$id" "$branch" "$current_head" \
    "$candidate_fp" "$(basename "$paths_file")" "$(basename "$scope_file")" \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$(basename "$checks_file")" \
    "$checkpoint_kind" >>"$STATE/checkpoints.tsv"
  printf 'PASS: checkpoint %s recorded (%s changed files, %s)\n' "$id" "$changed_count" "$checkpoint_kind"
  printf 'CHECKPOINT_ID: %s\n' "$id"
  rm -f "$committed_tmp"
}

commit_slice() {
  checkpoint_id=
  message=
  authorized_by=
  review_repair=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --checkpoint)
        [ "$#" -ge 2 ] || fail "--checkpoint requires an ID"
        checkpoint_id=$2
        shift 2
        ;;
      --message)
        [ "$#" -ge 2 ] || fail "--message requires a subject"
        message=$2
        shift 2
        ;;
      --authorized-by)
        [ "$#" -ge 2 ] || fail "--authorized-by requires PR or GO"
        authorized_by=$2
        shift 2
        ;;
      --review-repair)
        [ "$review_repair" = false ] || fail "--review-repair may be provided only once"
        review_repair=true
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown commit-slice option: $1" ;;
    esac
  done
  [ "$authorized_by" = PR ] || [ "$authorized_by" = GO ] || fail "commit-slice requires explicit PR or GO authorization"
  [ -n "$message" ] || fail "--message is required"
  reject_control_chars "$message"
  message_length=$(printf '%s' "$message" | awk '{ print length }')
  [ "$message_length" -le 72 ] || fail "commit subject exceeds 72 characters"
  ensure_meta_state
  delivery_mode=$(delivery_mode_from_state)
  if [ "$delivery_mode" = PR ]; then
    if [ "$review_repair" = true ]; then
      review_repair_allowed
      commit_kind=review-repair
    else
      [ "$(run_state_nested_value review status)" != changes-required ] || \
        fail "PR commit after a review finding requires --review-repair"
      commit_kind=slice
    fi
  else
    [ "$review_repair" = false ] || fail "--review-repair is only valid in PR mode"
    commit_kind=none
  fi
  assert_identity
  case "$checkpoint_id" in ''|*[!0-9]*) fail "checkpoint must be a numeric ID" ;; esac
  checkpoint_path=$(checkpoint_field "$checkpoint_id" 5)
  checkpoint_fp=$(checkpoint_field "$checkpoint_id" 4)
  checkpoint_head=$(checkpoint_field "$checkpoint_id" 3)
  checkpoint_kind=$(checkpoint_field "$checkpoint_id" 9)
  checkpoint_commit=$(checkpoint_field "$checkpoint_id" 10)
  [ -n "$checkpoint_path" ] || fail "unknown checkpoint: $checkpoint_id"
  [ -f "$STATE/$checkpoint_path" ] || fail "checkpoint paths are missing: $checkpoint_path"
  [ "$checkpoint_kind" = "$commit_kind" ] || fail "checkpoint $checkpoint_id is not a $commit_kind checkpoint"
  [ "$checkpoint_commit" = none ] || fail "checkpoint $checkpoint_id already has a materializing commit"
  current_fp=$(fingerprint_for_checkout "$CHECKOUT")
  [ "$current_fp" = "$checkpoint_fp" ] || fail "candidate fingerprint differs from checkpoint $checkpoint_id"
  current_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  [ "$current_head" = "$checkpoint_head" ] || fail "current HEAD differs from checkpoint $checkpoint_id"
  current_paths=$STATE/commit-changed.$$
  changed_paths_for_checkout "$CHECKOUT" >"$current_paths"
  same_path_sets "$STATE/$checkpoint_path" "$current_paths" || fail "current changed paths differ from checkpoint $checkpoint_id"
  staged_before=$STATE/staged-before.$$
  git -C "$CHECKOUT" diff --cached --name-only -M HEAD | LC_ALL=C sort -u >"$staged_before"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    grep -Fx "$path" "$STATE/$checkpoint_path" >/dev/null 2>&1 || \
      fail "staged path is outside checkpoint $checkpoint_id: $path"
  done <"$staged_before"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    git -C "$CHECKOUT" add -- "$path"
  done <"$STATE/$checkpoint_path"
  staged_tmp=$STATE/staged.$$
  git -C "$CHECKOUT" diff --cached --name-only -M HEAD | LC_ALL=C sort -u >"$staged_tmp"
  same_path_sets "$STATE/$checkpoint_path" "$staged_tmp" || fail "staged paths differ from checkpoint $checkpoint_id"
  unstaged_tmp=$STATE/unstaged.$$
  git -C "$CHECKOUT" diff --name-only --find-renames | LC_ALL=C sort -u >"$unstaged_tmp"
  [ ! -s "$unstaged_tmp" ] || fail "staged tree does not represent checkpointed content exactly"
  staged_fp=$(fingerprint_for_checkout "$CHECKOUT")
  [ "$staged_fp" = "$checkpoint_fp" ] || fail "staged tree fingerprint differs from checkpoint $checkpoint_id"
  git -C "$CHECKOUT" commit -m "$message"
  new_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  record_checkpoint_commit "$checkpoint_id" "$new_head"
  "$SCRIPT_DIR/swe-forge-state" set-delivery-checkout \
    --state "$STATE/run-state.yaml" \
    --head-sha "$new_head" \
    --checkpoint-sha "$new_head" >/dev/null
  update_meta_checkout "$new_head"
  rm -f "$current_paths" "$staged_before" "$staged_tmp" "$unstaged_tmp"
  printf 'PASS: committed checkpoint %s (%s)\n' "$checkpoint_id" "$commit_kind"
  printf 'COMMIT: %s\n' "$new_head"
}

review_run() {
  result=
  source=
  findings=0
  repaired=0
  blocked_values=
  blocked_args=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --result)
        [ "$#" -ge 2 ] || fail "--result requires PASS or CHANGES_REQUIRED"
        result=$2
        shift 2
        ;;
      --source)
        [ "$#" -ge 2 ] || fail "--source requires a review source"
        source=$2
        shift 2
        ;;
      --findings)
        [ "$#" -ge 2 ] || fail "--findings requires a non-negative integer"
        findings=$2
        shift 2
        ;;
      --repaired)
        [ "$#" -ge 2 ] || fail "--repaired requires a non-negative integer"
        repaired=$2
        shift 2
        ;;
      --blocked-by)
        [ "$#" -ge 2 ] || fail "--blocked-by requires a finding ID"
        blocked_id=$2
        reject_control_chars "$blocked_id"
        case "$blocked_id" in
          ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) fail "invalid blocked finding ID: $blocked_id" ;;
        esac
        if [ -n "$blocked_values" ]; then blocked_values="$blocked_values$NEWLINE$blocked_id"; else blocked_values=$blocked_id; fi
        blocked_args="$blocked_args --blocked-by $blocked_id"
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown review option: $1" ;;
    esac
  done
  [ "$result" = PASS ] || [ "$result" = CHANGES_REQUIRED ] || fail "invalid review result: ${result:-<missing>}"
  [ -n "$source" ] || fail "--source is required"
  reject_control_chars "$source"
  case "$findings" in ''|*[!0-9]*) fail "findings must be a non-negative integer" ;; esac
  case "$repaired" in ''|*[!0-9]*) fail "repaired must be a non-negative integer" ;; esac
  blocked_display=none
  if [ -n "$blocked_values" ]; then
    blocked_display=
    blocked_first=true
    while IFS= read -r blocked_id; do
      [ -n "$blocked_id" ] || continue
      if [ "$blocked_first" = true ]; then
        blocked_first=false
      else
        blocked_display="$blocked_display,"
      fi
      blocked_display="$blocked_display$blocked_id"
    done <<EOF_BLOCKED
$blocked_values
EOF_BLOCKED
  fi
  acquire_review_lock
  ensure_meta_state
  assert_identity
  head=$(git -C "$CHECKOUT" rev-parse HEAD)
  fp=$(fingerprint_for_checkout "$CHECKOUT")
  current_attempts=$(run_state_nested_value review attempts)
  review_requested_result=$result
  review_candidate_ready "$current_attempts" "$head" "$fp"
  result=$review_requested_result
  SWE_FORGE_REVIEW_LOCK_HELD=true "$SCRIPT_DIR/swe-forge-state" set-review \
    --state "$STATE/run-state.yaml" --result "$result" $blocked_args >/dev/null
  attempt=$(run_state_nested_value review attempts)
  ceiling=$(run_state_nested_value review retry_ceiling)
  REVIEW_TMP=$STATE/review.env.tmp.$$
  {
    printf 'result=%s\n' "$result"
    printf 'source=%s\n' "$source"
    printf 'findings=%s\n' "$findings"
    printf 'repaired=%s\n' "$repaired"
    printf 'blocked_by=%s\n' "$blocked_display"
    printf 'attempt=%s\n' "$attempt"
    printf 'retry_ceiling=%s\n' "$ceiling"
    printf 'head=%s\n' "$head"
    printf 'fingerprint=%s\n' "$fp"
    printf 'recorded_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$REVIEW_TMP"
  mv "$REVIEW_TMP" "$STATE/review.env"
  REVIEW_TMP=
  printf 'REVIEW: %s attempt %s/%s (%s findings, %s repaired)\n' \
    "$result" "$attempt" "$ceiling" "$findings" "$repaired"
  [ "$result" = PASS ]
}

final_blockers=0
blocker() {
  final_blockers=$((final_blockers + 1))
  printf 'BLOCKED: %s\n' "$*" >&2
}

repository_identity() {
  identity=$(git -C "$CHECKOUT" remote get-url origin 2>/dev/null || true)
  if [ -n "$identity" ]; then
    printf '%s\n' "$identity"
  else
    root=$(git -C "$CHECKOUT" rev-parse --show-toplevel)
    printf 'local:%s\n' "$(printf '%s' "$root" | git -C "$CHECKOUT" hash-object --stdin)"
  fi
}

check_checkpoint_completion() {
  [ "$(delivery_mode_from_state)" = PR ] || return 0
  current_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  while IFS="$TAB" read -r checkpoint_id _branch recorded_head _fp paths_file _scope _recorded _checks checkpoint_kind checkpoint_commit; do
    [ -n "$checkpoint_id" ] || continue
    case "$checkpoint_kind" in
      slice|review-repair) ;;
      *)
        blocker "checkpoint $checkpoint_id has no PR delivery kind"
        continue
        ;;
    esac
    [ "$checkpoint_commit" != none ] || {
      blocker "checkpoint $checkpoint_id has no materializing commit"
      continue
    }
    git -C "$CHECKOUT" cat-file -e "$checkpoint_commit^{commit}" 2>/dev/null || {
      blocker "checkpoint $checkpoint_id references a missing commit"
      continue
    }
    git -C "$CHECKOUT" merge-base --is-ancestor "$checkpoint_commit" "$current_head" || {
      blocker "checkpoint $checkpoint_id commit is not in the delivered history"
      continue
    }
    commit_parent=$(git -C "$CHECKOUT" rev-parse "$checkpoint_commit^" 2>/dev/null || true)
    [ "$commit_parent" = "$recorded_head" ] || {
      blocker "checkpoint $checkpoint_id commit does not materialize its checkpoint"
      continue
    }
    [ -f "$STATE/$paths_file" ] || {
      blocker "checkpoint paths are missing: $checkpoint_id"
      continue
    }
    commit_paths=$STATE/checkpoint-commit-paths.$$
    git -C "$CHECKOUT" diff-tree --root --no-commit-id --name-only --find-renames -r \
      "$checkpoint_commit" >"$commit_paths"
    if ! same_path_sets "$STATE/$paths_file" "$commit_paths"; then
      blocker "checkpoint $checkpoint_id commit paths differ from its checkpoint"
    fi
    rm -f "$commit_paths"
  done <"$STATE/checkpoints.tsv"
}

check_final_state() {
  require_pr_url=$1
  final_blockers=0
  ensure_meta_state
  if ! identity_safe; then blocker "checkout identity, branch, or protection state is not safe"; fi
  status=$(status_porcelain)
  [ -z "$status" ] || blocker "checkout is dirty"
  baseline_head=$(meta_value baseline_head "$STATE/meta.env")
  current_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  git -C "$CHECKOUT" merge-base --is-ancestor "$baseline_head" "$current_head" || blocker "current HEAD is not based on the recorded baseline"
  checkpoint_count=$(awk 'NF { count++ } END { print count + 0 }' "$STATE/checkpoints.tsv")
  [ "$checkpoint_count" -gt 0 ] || blocker "no checkpoint evidence was recorded"
  if [ "$(delivery_mode_from_state)" = PR ]; then
    check_checkpoint_completion
  fi
  fp=$(fingerprint_for_checkout "$CHECKOUT")
  if ! check_requirements "$fp" yes >/dev/null 2>&1; then blocker "required or applicable final validation is not passing for current candidate"; fi
  review_state_status=$(run_state_nested_value review status)
  review_state_attempts=$(run_state_nested_value review attempts)
  review_state_ceiling=$(run_state_nested_value review retry_ceiling)
  if [ "$(delivery_mode_from_state)" = PR ]; then
    [ "$review_state_status" = pass ] || blocker "canonical review state is not PASS: ${review_state_status:-missing}"
    case "$review_state_attempts" in ''|*[!0-9]*|0) blocker "canonical review attempt evidence is missing" ;; esac
    [ -n "$review_state_ceiling" ] || blocker "canonical review ceiling is missing"
  fi
  if [ -f "$STATE/review.env" ]; then
    review_result=$(meta_value result "$STATE/review.env")
    review_head=$(meta_value head "$STATE/review.env")
    review_fp=$(meta_value fingerprint "$STATE/review.env")
    review_attempt=$(meta_value attempt "$STATE/review.env")
    review_ceiling=$(meta_value retry_ceiling "$STATE/review.env")
    [ "$review_result" = PASS ] || blocker "fresh review is not PASS: ${review_result:-missing}"
    [ "$review_head" = "$current_head" ] || blocker "review evidence is not for current HEAD"
    [ "$review_fp" = "$fp" ] || blocker "review evidence is not for current candidate fingerprint"
    if [ "$(delivery_mode_from_state)" = PR ]; then
      [ "$review_attempt" = "$review_state_attempts" ] || \
        blocker "review evidence attempt does not match canonical run state"
      [ "$review_ceiling" = "$review_state_ceiling" ] || \
        blocker "review evidence ceiling does not match canonical run state"
    fi
  else
    blocker "review evidence is missing"
  fi
  if [ "$require_pr_url" = yes ]; then
    [ -n "${PR_URL:-}" ] || blocker "PR URL is required for a final PR receipt"
  fi
}

deliver_pr() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown deliver-pr option: $1" ;;
    esac
  done
  check_final_state no
  [ "$final_blockers" -eq 0 ] || exit 1
  printf 'PASS: PR delivery prerequisites\n'
  printf 'BRANCH: %s\n' "$(current_branch)"
  printf 'HEAD: %s\n' "$(git -C "$CHECKOUT" rev-parse HEAD)"
}

receipt_status_display() {
  name=$1
  fp=$2
  final_required=$3
  if [ "$final_required" = true ]; then
    final_mode=yes
  else
    final_mode=no
  fi
  result=$(latest_status "$name" "$fp" "$final_mode")
  status=${result%%"$TAB"*}
  if [ "$status" = missing ] && [ "$final_required" = false ] && \
    checkpoint_has_check "$name"; then
    status=passed
  fi
  case "$status" in
    passed) printf 'passed\n' ;;
    failed) printf 'failed\n' ;;
    unavailable) printf 'unavailable\n' ;;
    not-applicable) printf 'not-applicable\n' ;;
    *) printf 'missing\n' ;;
  esac
}

receipt_text() {
  execution=$1
  delivery=$2
  pr_url=$3
  baseline_head=$(meta_value baseline_head "$STATE/meta.env")
  current_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  current_fp=$(fingerprint_for_checkout "$CHECKOUT")
  branch=$(current_branch)
  short_base=$(git -C "$CHECKOUT" rev-parse --short "$baseline_head")
  short_head=$(git -C "$CHECKOUT" rev-parse --short "$current_head")
  short_fp=$(printf '%s' "$current_fp" | cut -c 1-12)
  commit_count=$(git -C "$CHECKOUT" rev-list --count "$baseline_head..$current_head")
  checkpoint_count=$(awk 'NF { count++ } END { print count + 0 }' "$STATE/checkpoints.tsv")
  slice_checkpoint_count=$(awk -F "$TAB" '$9 == "slice" { count++ } END { print count + 0 }' "$STATE/checkpoints.tsv")
  repair_checkpoint_count=$(awk -F "$TAB" '$9 == "review-repair" { count++ } END { print count + 0 }' "$STATE/checkpoints.tsv")
  printf '## SWE Forge receipt\n\n'
  printf 'Execution: %s\n' "$execution"
  printf 'Delivery: %s\n' "$delivery"
  if [ -n "${receipt_forge_version:-}" ] || [ -n "${receipt_harness:-}" ] || \
    [ -n "${receipt_harness_version:-}" ] || [ -n "${receipt_requested_mode:-}" ] || \
    [ -n "${receipt_selected_mode:-}" ] || [ -n "${receipt_model_provider:-}" ] || \
    [ -n "${receipt_routing_reason:-}" ] || [ -n "${receipt_model:-}" ]; then
    printf 'Run metadata:\n'
    [ -z "${receipt_forge_version:-}" ] || printf -- '- SWE Forge: %s\n' "$receipt_forge_version"
    if [ -n "${receipt_harness:-}" ] || [ -n "${receipt_harness_version:-}" ]; then
      if [ -n "${receipt_harness_version:-}" ]; then printf -- '- Harness: %s %s\n' "$receipt_harness" "$receipt_harness_version"; else printf -- '- Harness: %s\n' "$receipt_harness"; fi
    fi
    if [ -n "${receipt_requested_mode:-}" ] || [ -n "${receipt_selected_mode:-}" ]; then printf -- '- Routing: %s -> %s\n' "${receipt_requested_mode:-unknown}" "${receipt_selected_mode:-unknown}"; fi
    [ -z "${receipt_model_provider:-}" ] || printf -- '- Model provider: %s\n' "$receipt_model_provider"
    [ -z "${receipt_model:-}" ] || printf -- '- Model: %s\n' "$receipt_model"
    [ -z "${receipt_routing_reason:-}" ] || printf -- '- Routing reason: %s\n' "$receipt_routing_reason"
  fi
  printf 'Repository: %s\n' "$(repository_identity)"
  printf 'Base: %s\n' "$short_base"
  printf 'Branch: %s\n' "$branch"
  printf 'Head: %s\n' "$short_head"
  printf 'Evidence fingerprint: %s\n' "$short_fp"
  printf 'Generated at: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if [ "$delivery" = PR ]; then
    printf 'Commits: %s (%s validated slices, %s review repairs)\n' \
      "$commit_count" "$slice_checkpoint_count" "$repair_checkpoint_count"
  elif [ "$checkpoint_count" -eq 1 ]; then
    printf 'Commits: %s (1 validated slice)\n' "$commit_count"
  else
    printf 'Commits: %s (%s validated slices)\n' "$commit_count" "$checkpoint_count"
  fi
  printf 'Verification:\n'
  while IFS="$TAB" read -r name requirement condition final_required; do
    [ -n "${name:-}" ] || continue
    printf -- '- %s: %s\n' "$name" "$(receipt_status_display "$name" "$current_fp" "$final_required")"
  done <"$STATE/plan.tsv"
  if [ -f "$STATE/review.env" ]; then
    review_result=$(meta_value result "$STATE/review.env")
    review_findings=$(meta_value findings "$STATE/review.env")
    review_repaired=$(meta_value repaired "$STATE/review.env")
    review_attempt=$(meta_value attempt "$STATE/review.env")
    review_ceiling=$(meta_value retry_ceiling "$STATE/review.env")
    [ -n "$review_attempt" ] || review_attempt=$(run_state_nested_value review attempts)
    [ -n "$review_ceiling" ] || review_ceiling=$(run_state_nested_value review retry_ceiling)
    printf 'Fresh review: %s — %s findings, %s repaired\n' "$review_result" "$review_findings" "$review_repaired"
    printf 'Review attempts: %s/%s\n' "$review_attempt" "$review_ceiling"
  else
    printf 'Fresh review: NOT RUN\n'
  fi
  if [ "$delivery" = PR ]; then
    printf 'Remote CI: not awaited after PR creation\n'
  fi
  if [ -n "$pr_url" ]; then printf 'Pull request: %s\n' "$pr_url"; else printf 'Pull request: not-created\n'; fi
  if [ "$final_blockers" -eq 0 ]; then printf 'Final status: ACCEPTED\n'; else printf 'Final status: BLOCKED\n'; fi
}

receipt_run() {
  execution=
  delivery=
  PR_URL=
  output=
  verify_mode=no
  receipt_forge_version=
  receipt_harness=
  receipt_harness_version=
  receipt_requested_mode=
  receipt_selected_mode=
  receipt_model_provider=
  receipt_routing_reason=
  receipt_model=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --verify)
        verify_mode=yes
        shift
        ;;
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --execution)
        [ "$#" -ge 2 ] || fail "--execution requires SOLO or SUBAGENTS"
        execution=$2
        shift 2
        ;;
      --delivery)
        [ "$#" -ge 2 ] || fail "--delivery requires GUIDED or PR"
        delivery=$2
        shift 2
        ;;
      --pr-url)
        [ "$#" -ge 2 ] || fail "--pr-url requires a URL"
        PR_URL=$2
        shift 2
        ;;
      --receipt|--file)
        [ "$#" -ge 2 ] || fail "--receipt requires a file"
        output=$2
        shift 2
        ;;
      --output)
        [ "$#" -ge 2 ] || fail "--output requires a file"
        output=$2
        shift 2
        ;;
      --forge-version)
        [ "$#" -ge 2 ] || fail "--forge-version requires a value"
        receipt_forge_version=$2
        shift 2
        ;;
      --harness)
        [ "$#" -ge 2 ] || fail "--harness requires a value"
        receipt_harness=$2
        shift 2
        ;;
      --harness-version)
        [ "$#" -ge 2 ] || fail "--harness-version requires a value"
        receipt_harness_version=$2
        shift 2
        ;;
      --requested-mode)
        [ "$#" -ge 2 ] || fail "--requested-mode requires a value"
        receipt_requested_mode=$2
        shift 2
        ;;
      --selected-mode)
        [ "$#" -ge 2 ] || fail "--selected-mode requires a value"
        receipt_selected_mode=$2
        shift 2
        ;;
      --model-provider)
        [ "$#" -ge 2 ] || fail "--model-provider requires a value"
        receipt_model_provider=$2
        shift 2
        ;;
      --routing-reason)
        [ "$#" -ge 2 ] || fail "--routing-reason requires a value"
        receipt_routing_reason=$2
        shift 2
        ;;
      --model)
        [ "$#" -ge 2 ] || fail "--model requires a value"
        receipt_model=$2
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown receipt option: $1" ;;
    esac
  done
  if [ "$verify_mode" = yes ]; then
    [ -n "${STATE:-}" ] || fail "--state is required"
    [ -n "$output" ] || output=$STATE/receipt.md
    receipt_verify --state "$STATE" --receipt "$output"
    return
  fi
  case "$execution" in SOLO|SUBAGENTS) ;; *) fail "invalid execution topology: ${execution:-<missing>}" ;; esac
  case "$delivery" in GUIDED|PR) ;; *) fail "invalid delivery mode: ${delivery:-<missing>}" ;; esac
  [ "$delivery" != GUIDED ] || [ -z "$PR_URL" ] || \
    fail "a pull-request URL is only valid for PR receipt delivery"
  case "$receipt_requested_mode" in ''|AUTO|SOLO|SUBAGENTS) ;; *) fail "invalid requested topology metadata" ;; esac
  case "$receipt_selected_mode" in ''|SOLO|SUBAGENTS) ;; *) fail "invalid selected topology metadata" ;; esac
  for receipt_value in "$receipt_forge_version" "$receipt_harness" "$receipt_harness_version" \
    "$receipt_requested_mode" "$receipt_selected_mode" "$receipt_model_provider" \
    "$receipt_routing_reason" "$receipt_model"; do
    reject_control_chars "$receipt_value"
  done
  if [ -n "$PR_URL" ]; then
    case "$PR_URL" in http://*|https://*) ;; *) fail "PR URL must use http:// or https://" ;; esac
  fi
  ensure_meta_state
  state_delivery_mode=$(delivery_mode_from_state)
  [ "$delivery" = "$state_delivery_mode" ] || \
    fail "receipt delivery mode $delivery does not match run state $state_delivery_mode"
  if [ -n "$output" ]; then
    reject_control_chars "$output"
    output=$(absolute_path "$output")
  else
    output=$STATE/receipt.md
  fi
  output_tmp=$output.tmp.$$
  if [ "$delivery" = PR ]; then check_final_state yes; else check_final_state no; fi
  receipt_text "$execution" "$delivery" "$PR_URL" >"$output_tmp"
  mv "$output_tmp" "$output"
  "$SCRIPT_DIR/swe-forge-state" set-receipt-ref \
    --state "$STATE/run-state.yaml" \
    --receipt-ref "$output" >/dev/null
  if [ "$delivery" = PR ] && [ -n "$PR_URL" ] && [ "$final_blockers" -eq 0 ]; then
    "$SCRIPT_DIR/swe-forge-state" set-pull-request \
      --state "$STATE/run-state.yaml" --url "$PR_URL" >/dev/null
  fi
  cat "$output"
  [ "$final_blockers" -eq 0 ]
}

receipt_verify() {
  receipt_file=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail "--state requires a directory"
        STATE=$(state_path "$2")
        shift 2
        ;;
      --receipt|--file)
        [ "$#" -ge 2 ] || fail "--receipt requires a file"
        receipt_file=$2
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown receipt-verify option: $1" ;;
    esac
  done
  [ -n "${STATE:-}" ] || fail "--state is required"
  [ -n "$receipt_file" ] || receipt_file=$STATE/receipt.md
  [ -f "$receipt_file" ] || fail "receipt does not exist: $receipt_file"
  ensure_meta_state
  assert_identity
  receipt_head=$(awk -F': ' '$1 == "Head" { print $2; exit }' "$receipt_file")
  receipt_fp=$(awk -F': ' '$1 == "Evidence fingerprint" { print $2; exit }' "$receipt_file")
  receipt_branch=$(awk -F': ' '$1 == "Branch" { print $2; exit }' "$receipt_file")
  receipt_repo=$(awk -F': ' '$1 == "Repository" { print $2; exit }' "$receipt_file")
  receipt_status=$(awk -F': ' '$1 == "Final status" { print $2; exit }' "$receipt_file")
  receipt_delivery=$(awk -F': ' '$1 == "Delivery" { print $2; exit }' "$receipt_file")
  receipt_pr_url=$(awk -F': ' '$1 == "Pull request" { print $2; exit }' "$receipt_file")
  receipt_review_attempts=$(awk -F': ' '$1 == "Review attempts" { print $2; exit }' "$receipt_file")
  canonical_delivery=$(delivery_mode_from_state)
  [ "$receipt_delivery" = "$canonical_delivery" ] || \
    fail "receipt delivery mode $receipt_delivery does not match run state $canonical_delivery"
  review_state_attempts=$(run_state_nested_value review attempts)
  review_state_ceiling=$(run_state_nested_value review retry_ceiling)
  if [ "$canonical_delivery" = PR ]; then
    recorded_pr_url=$(run_state_nested_value delivery pull_request_ref)
    [ -n "$recorded_pr_url" ] && [ "$recorded_pr_url" != none ] || \
      fail "run state is missing the recorded pull-request URL"
    [ "$receipt_pr_url" = "$recorded_pr_url" ] || \
      fail "receipt pull-request URL does not match run state"
    [ "$receipt_review_attempts" = "$review_state_attempts/$review_state_ceiling" ] || \
      fail "receipt review attempts do not match canonical run state"
  else
    [ -z "$receipt_pr_url" ] || [ "$receipt_pr_url" = not-created ] || \
      fail "guided receipt cannot contain a pull-request URL"
  fi
  current_head=$(git -C "$CHECKOUT" rev-parse HEAD)
  current_short_head=$(git -C "$CHECKOUT" rev-parse --short "$current_head")
  [ "$current_short_head" = "$receipt_head" ] || fail "receipt is stale: Head does not match current HEAD"
  current_fp=$(fingerprint_for_checkout "$CHECKOUT")
  current_short_fp=$(printf '%s' "$current_fp" | cut -c 1-12)
  [ "$current_short_fp" = "$receipt_fp" ] || fail "receipt is stale: evidence fingerprint does not match current candidate"
  [ "$receipt_branch" = "$(current_branch)" ] || fail "receipt branch does not match current branch"
  [ "$receipt_repo" = "$(repository_identity)" ] || fail "receipt repository identity does not match current repository"
  [ "$receipt_status" = ACCEPTED ] || fail "receipt does not report ACCEPTED"
  delivery=$receipt_delivery
  if [ "$delivery" = PR ]; then PR_URL=$receipt_pr_url; check_final_state yes; else check_final_state no; fi
  [ "$final_blockers" -eq 0 ] || exit 1
  printf 'PASS: receipt is current and evidence-bound\n'
}

main() {
  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  command=$1
  shift
  case "$command" in
    preflight) preflight "$@" ;;
    plan-check) plan_check "$@" ;;
    validate) validate_run "$@" ;;
    record-check-status) record_check_status "$@" ;;
    fingerprint) fingerprint_run "$@" ;;
    checkpoint) checkpoint_run "$@" ;;
    commit-slice) commit_slice "$@" ;;
    review) review_run "$@" ;;
    deliver-pr) deliver_pr "$@" ;;
    receipt) receipt_run "$@" ;;
    receipt-verify|verify-receipt) receipt_verify "$@" ;;
    -h|--help) usage ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"
