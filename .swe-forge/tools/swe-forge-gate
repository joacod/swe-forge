#!/bin/sh

# Compatibility entrypoint for the typed evidence gate.
# Keep this established executable path stable for adapters and installations.

set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
ROOT=$(CDPATH= cd "$SCRIPT_DIR/../.." && pwd -P)
exec bun "$ROOT/src/core/evidence/cli.ts" "$@"
