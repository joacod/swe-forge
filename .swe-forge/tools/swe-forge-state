#!/bin/sh

# Dependency-free validator and bounded mutation owner for the current SWE Forge
# run-state schema. Obsolete and unknown schemas are stale; this helper never
# migrates them.

set -eu

PROGRAM=${0##*/}
TAB=$(printf '\t')
NEWLINE='
'

MAX_PROJECTION_LENGTH=160
MAX_ACCEPTANCE_ITEMS=8

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  swe-forge-state validate --state FILE|DIRECTORY
  swe-forge-state inspect --state FILE|DIRECTORY --checkout PATH
  swe-forge-state resolve-active --checkout PATH \
    [--candidate FILE|DIRECTORY ...] [--all]
  swe-forge-state init --state DIRECTORY [--checkout PATH] [options]
  swe-forge-state set-routing --state FILE|DIRECTORY \
    --preferred TOPOLOGY --current TOPOLOGY --reason TEXT \
    --fallback-used TEXT
  swe-forge-state set-continuation --state FILE|DIRECTORY [options]
  swe-forge-state set-delivery-checkout --state FILE|DIRECTORY --head-sha SHA
  swe-forge-state set-validation --state FILE|DIRECTORY \
    --head-sha SHA --status pending|passed|failed --reference REF
  swe-forge-state set-review --state FILE|DIRECTORY \
    --head-sha SHA --result PASS|CHANGES_REQUIRED [--blocked-by ID...]
  swe-forge-state set-review-repair --state FILE|DIRECTORY --head-sha SHA
  swe-forge-state set-pull-request --state FILE|DIRECTORY --url URL

`inspect` and `resolve-active` expose the validated semantic run-state
projection as deterministic JSON. Candidate discovery remains the caller's
responsibility; this helper owns validation, eligibility, and ordering.
`init` creates the current schema-v5 state from actual checkout facts and
semantic routing and delivery input. `set-continuation` owns its timestamp.
`set-delivery-checkout`, `set-validation`, `set-review`,
`set-review-repair`, and `set-pull-request` own purpose-specific updates. All
write operations are serialized per state, validated before atomic replacement,
and never migrate stale state.
EOF
}

control_chars() {
  case "$1" in
    *"$TAB"*|*"$NEWLINE"*)
      fail 'state values may not contain tabs or newlines' ;;
  esac
}

state_file() {
  value=$1
  control_chars "$value"
  if [ -d "$value" ] && [ ! -L "$value" ]; then
    value=$value/run-state.yaml
  fi
  [ -f "$value" ] || fail "run-state file does not exist: $value"
  printf '%s\n' "$value"
}

canonical_path() {
  value=$1
  control_chars "$value"
  case "$value" in
    /*) candidate=$value ;;
    *) candidate=$PWD/$value ;;
  esac
  if [ -d "$candidate" ]; then
    CDPATH= cd -P "$candidate" && pwd -P
    return
  fi
  if [ -f "$candidate" ]; then
    directory=$(dirname "$candidate")
    base=$(basename "$candidate")
    CDPATH= cd -P "$directory" && printf '%s/%s\n' "$(pwd -P)" "$base"
    return
  fi
  printf '%s\n' "$candidate"
}

file_mtime_seconds() {
  file=$1
  if value=$(stat -f '%m' "$file" 2>/dev/null); then
    printf '%s\n' "$value"
    return
  fi
  if value=$(stat -c '%Y' "$file" 2>/dev/null); then
    printf '%s\n' "$value"
    return
  fi
  return 1
}

timestamp_epoch() {
  value=$1
  if parsed=$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$value" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  if parsed=$(date -u -j -f '%Y-%m-%dT%H:%M:%S%z' "$value" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  normalized=$(printf '%s\n' "$value" | sed -E 's/\.[0-9]+([Z+-])/\1/; s/([+-][0-9][0-9]):([0-9][0-9])$/\1\2/')
  if parsed=$(date -u -j -f '%Y-%m-%dT%H:%M:%S%z' "$normalized" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  if parsed=$(date -u -d "$value" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  return 1
}

json_quote() {
  awk -v value="$1" '
    BEGIN {
      quote = sprintf("%c", 34)
      backslash = sprintf("%c", 92)
      tab = sprintf("%c", 9)
      newline = sprintf("%c", 10)
      carriage_return = sprintf("%c", 13)
      form_feed = sprintf("%c", 12)
      backspace = sprintf("%c", 8)
      printf "%s", quote
      for (i = 1; i <= length(value); i++) {
        c = substr(value, i, 1)
        if (c == quote) printf "%s", backslash quote
        else if (c == backslash) printf "%s", backslash backslash
        else if (c == tab) printf "%s", backslash "t"
        else if (c == newline) printf "%s", backslash "n"
        else if (c == carriage_return) printf "%s", backslash "r"
        else if (c == form_feed) printf "%s", backslash "f"
        else if (c == backspace) printf "%s", backslash "b"
        else printf "%s", c
      }
      printf "%s\n", quote
    }
  '
}

top_level() {
  key=$1
  file=$2
  awk -v wanted="$key" '
    $0 ~ "^" wanted ":([[:space:]]|$)" { count++ }
    END { if (count == 1) exit 0; exit 1 }
  ' "$file"
}

value_for() {
  key=$1
  file=$2
  awk -v wanted="$key" '$1 == wanted ":" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$file"
}

scalar_value() {
  path=$1
  file=$2
  awk -v wanted="$path" '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ || /^[[:space:]]*-/ { next }
    {
      leading=$0
      sub(/[^ ]+.*/, "", leading)
      indent=length(leading)
      line=$0
      sub(/^[ ]*/, "", line)
      if (line !~ /^[A-Za-z0-9_-]+:/) next
      key=line
      sub(/:.*/, "", key)
      raw=line
      sub(/^[^:]*:[[:space:]]*/, "", raw)
      sub(/[[:space:]]+#.*$/, "", raw)
      sub(/[[:space:]]+$/, "", raw)
      while (depth > 0 && indents[depth] >= indent) depth--
      depth++
      keys[depth]=key
      indents[depth]=indent
      current=keys[1]
      for (i=2; i<=depth; i++) current=current "." keys[i]
      if (current == wanted) {
        print raw
        found=1
        exit
      }
      if (raw != "") depth--
    }
    END { if (found) exit 0; exit 1 }
  ' "$file"
}

nested_key() {
  scalar_value "$1.$2" "$3" >/dev/null
}

required_scalar() {
  field=$1
  file=$2
  value=$(scalar_value "$field" "$file") || fail "current schema is missing $field"
  [ -n "$value" ] || fail "current schema has an empty $field"
  printf '%s\n' "$value"
}

validate_enum() {
  field=$1
  file=$2
  shift 2
  value=$(required_scalar "$field" "$file")
  for allowed do
    [ "$value" = "$allowed" ] && return 0
  done
  fail "invalid $field"
}

require_enum_arg() {
  field=$1
  candidate=$2
  shift 2
  for allowed do
    [ "$candidate" = "$allowed" ] && return 0
  done
  fail "invalid $field"
}

require_bool_arg() {
  field=$1
  candidate=$2
  case "$candidate" in
    true|false) ;;
    *) fail "invalid $field" ;;
  esac
}

require_scalar_arg() {
  field=$1
  candidate=$2
  [ -n "$candidate" ] || fail "$field is required"
  control_chars "$candidate"
}

validate_sha_field() {
  field=$1
  value=$2
  case "$value" in
    ''|*[!0123456789abcdefABCDEF]*) fail "$field is not a hexadecimal SHA" ;;
  esac
  [ "${#value}" -eq 40 ] || fail "$field must contain a full 40-character SHA"
}

validate_sha_or_none() {
  field=$1
  value=$2
  case "$value" in
    none|NONE|null) ;;
    *) validate_sha_field "$field" "$value" ;;
  esac
}

validate_url_or_none() {
  field=$1
  value=$2
  case "$value" in
    none) ;;
    http://*|https://*) control_chars "$value" ;;
    *) fail "invalid $field" ;;
  esac
}

identifier_valid() {
  value=$1
  case "$value" in
    ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

reject_unknown_fields() {
  file=$1
  if awk '
    function indentation(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      return length(value) - length(stripped)
    }
    function key_name(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      sub(/:.*/, "", stripped)
      return stripped
    }
    function allowed_top(key) {
      return key == "workflow" || key == "workflow_version" ||
        key == "schema_version" || key == "run_id" || key == "status" ||
        key == "delivery_mode" || key == "routing" || key == "checkout" ||
        key == "continuation" || key == "validation" || key == "review" ||
        key == "delivery" || key == "tasks"
    }
    function allowed_task(key) {
      return key == "status" || key == "dependencies" || key == "accepted_result_ref"
    }
    function allowed_child(parent, key) {
      if (parent == "routing") return key == "preferred" || key == "current" || key == "reason" || key == "fallback"
      if (parent == "checkout") return key == "path" || key == "branch" || key == "base_sha" || key == "head_sha"
      if (parent == "delivery") return key == "status" || key == "pull_request_ref" || key == "pr_number" || key == "pr_state"
      if (parent == "validation") return key == "head_sha" || key == "status" || key == "reference"
      if (parent == "review") return key == "status" || key == "reviewed_head" || key == "repair_used" || key == "blocked_by"
      if (parent == "continuation") return key == "workflow_active" || key == "workflow" || key == "phase" ||
        key == "step" || key == "awaiting" || key == "next_action" || key == "safe_boundary" || key == "updated_at"
      if (parent == "next_action") return key == "kind" || key == "target" || key == "acceptance"
      return parent == "tasks"
    }
    {
      if ($0 ~ /^[[:space:]]*(#|$|-)/) next
      current_indent = indentation($0)
      current_key = key_name($0)
      while (depth > 0 && indents[depth] >= current_indent) depth--
      depth++
      indents[depth] = current_indent
      keys[depth] = current_key
      if (current_indent == 0) {
        if (!allowed_top(current_key)) found=1
        next
      }
      parent = keys[depth - 1]
      if (keys[1] == "tasks") {
        if (current_indent == 2) next
        if (current_indent == 4 && !allowed_task(current_key)) found=1
        if (current_indent >= 6 && keys[depth - 1] != "dependencies") found=1
        next
      }
      if (current_indent == 2 && !allowed_child(parent, current_key)) found=1
      if (current_indent == 4 && parent == "next_action" && !allowed_child(parent, current_key)) found=1
      if (current_indent >= 6) {
        if (keys[2] != "next_action" && keys[3] != "acceptance") found=1
      }
    }
    END { if (found) exit 0; exit 1 }
  ' "$file"; then
    fail 'stale/unsupported run state: unknown or removed state fields; start a fresh run'
  fi
}

validate_routing() {
  preferred=$1
  current=$2
  case "$preferred" in
    SOLO|SUBAGENTS) ;;
    *) fail "invalid routing.preferred: $preferred" ;;
  esac
  case "$current" in
    SOLO|SUBAGENTS) ;;
    *) fail "invalid routing.current: $current" ;;
  esac
}

validate_review() {
  file=$1
  for field in status reviewed_head repair_used blocked_by; do
    nested_key review "$field" "$file" || fail "review is missing $field"
  done
  validate_enum review.status "$file" pending pass changes-required repaired skipped
  validate_enum review.repair_used "$file" true false
  reviewed_head=$(required_scalar review.reviewed_head "$file")
  validate_sha_or_none review.reviewed_head "$reviewed_head"
  blocked_by=$(required_scalar review.blocked_by "$file")
  case "$blocked_by" in
    \[*\]) ;;
    *) fail 'review.blocked_by must be a list' ;;
  esac
  review_status=$(required_scalar review.status "$file")
  case "$review_status" in
    pending|skipped)
      [ "$reviewed_head" = none ] || fail "review.$review_status must not have a reviewed candidate"
      [ "$blocked_by" = '[]' ] || fail "review.$review_status may not retain blocking findings"
      [ "$(required_scalar review.repair_used "$file")" = false ] || fail "review.$review_status may not be repaired" ;;
    pass)
      [ "$reviewed_head" != none ] || fail 'review.pass requires a reviewed candidate'
      [ "$blocked_by" = '[]' ] || fail 'review.pass may not retain blocking findings'
      [ "$(required_scalar review.repair_used "$file")" = false ] || fail 'review.pass may not be repaired' ;;
    changes-required)
      [ "$reviewed_head" != none ] || fail 'review.changes-required requires a reviewed candidate'
      [ "$blocked_by" != '[]' ] || fail 'review.changes-required requires a blocking finding'
      [ "$(required_scalar review.repair_used "$file")" = false ] || fail 'review.changes-required may not be repaired' ;;
    repaired)
      [ "$reviewed_head" != none ] || fail 'review.repaired requires a reviewed candidate'
      [ "$blocked_by" != '[]' ] || fail 'review.repaired requires a blocking finding'
      [ "$(required_scalar review.repair_used "$file")" = true ] || fail 'review.repaired requires repair_used: true' ;;
  esac
}

validate_delivery() {
  file=$1
  for field in status pull_request_ref pr_number pr_state; do
    nested_key delivery "$field" "$file" || fail "delivery is missing $field"
  done
  validate_enum delivery.status "$file" not-applicable pending complete blocked
  validate_url_or_none delivery.pull_request_ref "$(required_scalar delivery.pull_request_ref "$file")"
  pr_number=$(required_scalar delivery.pr_number "$file")
  case "$pr_number" in
    none|''|*[!0-9]*) [ "$pr_number" = none ] || fail 'invalid delivery.pr_number' ;;
  esac
  validate_enum delivery.pr_state "$file" DRAFT OPEN MERGED CLOSED none
  delivery_mode=$(required_scalar delivery_mode "$file")
  delivery_status=$(required_scalar delivery.status "$file")
  pull_request_ref=$(required_scalar delivery.pull_request_ref "$file")
  if [ "$delivery_mode" = GUIDED ]; then
    [ "$delivery_status" = not-applicable ] || [ "$delivery_status" = complete ] || \
      fail 'GUIDED delivery must be not-applicable or complete'
    [ "$pull_request_ref" = none ] || fail 'GUIDED delivery may not record a pull request'
  else
    [ "$delivery_status" != not-applicable ] || fail 'PR delivery must have a delivery status'
  fi
  if [ "$delivery_status" = complete ]; then
    [ "$pull_request_ref" != none ] || [ "$delivery_mode" = GUIDED ] || \
      fail 'complete PR delivery requires a pull-request reference'
  fi
}

validate_validation() {
  file=$1
  for field in head_sha status reference; do
    nested_key validation "$field" "$file" || fail "validation is missing $field"
  done
  head=$(required_scalar validation.head_sha "$file")
  validate_sha_or_none validation.head_sha "$head"
  validate_enum validation.status "$file" pending passed failed
  reference=$(required_scalar validation.reference "$file")
  status=$(required_scalar validation.status "$file")
  if [ "$status" != pending ]; then
    [ "$reference" != none ] || fail "validation.$status requires a result reference"
    [ "$head" != none ] || fail "validation.$status requires a candidate"
  fi
}

assert_recorded_checkout() {
  state_file_arg=$1
  recorded_checkout=$(required_scalar checkout.path "$state_file_arg")
  actual_root=$(git -C "$recorded_checkout" rev-parse --show-toplevel 2>/dev/null) || \
    fail "recorded checkout is not a Git checkout: $recorded_checkout"
  [ "$actual_root" = "$recorded_checkout" ] || \
    fail 'recorded checkout root does not match the canonical checkout'
  recorded_branch=$(required_scalar checkout.branch "$state_file_arg")
  actual_branch=$(git -C "$recorded_checkout" symbolic-ref --quiet --short HEAD 2>/dev/null) || \
    fail 'recorded checkout is detached'
  [ "$actual_branch" = "$recorded_branch" ] || \
    fail 'recorded checkout branch does not match run state'
}

assert_recorded_head() {
  expected=$1
  state_file_arg=$2
  assert_recorded_checkout "$state_file_arg"
  recorded_checkout=$(required_scalar checkout.path "$state_file_arg")
  actual_head=$(git -C "$recorded_checkout" rev-parse HEAD 2>/dev/null) || \
    fail "recorded checkout is not a Git checkout: $recorded_checkout"
  [ "$actual_head" = "$expected" ] || \
    fail "candidate HEAD does not match the recorded checkout: $expected"
}

validate_continuation() {
  file=$1
  for key in workflow_active workflow phase step awaiting next_action safe_boundary updated_at; do
    nested_key continuation "$key" "$file" || fail "continuation is missing $key"
  done
  validate_enum continuation.workflow_active "$file" true false
  validate_enum continuation.workflow "$file" ticket delivery other
  validate_enum continuation.phase "$file" planning discovery implementation review delivery awaiting_merge recovery complete
  step=$(required_scalar continuation.step "$file")
  case "$step" in
    none|*[!0-9]*) [ "$step" = none ] || fail 'invalid continuation.step' ;;
  esac
  validate_enum continuation.awaiting "$file" none user_merge user_decision recovery
  validate_enum continuation.safe_boundary "$file" true false
  required_scalar continuation.updated_at "$file" >/dev/null
  for key in kind target acceptance; do
    nested_key continuation.next_action "$key" "$file" || fail "continuation.next_action is missing $key"
  done
  validate_enum continuation.next_action.kind "$file" specify discover implement validate review verify_and_sync_merge recover none
  required_scalar continuation.next_action.target "$file" >/dev/null
  acceptance=$(required_scalar continuation.next_action.acceptance "$file")
  case "$acceptance" in \[*\]) ;; *) fail 'continuation.next_action.acceptance must be a list' ;; esac
}

validate_state() {
  file=$(state_file "$1")
  schema=$(value_for schema_version "$file" || true)
  [ "$schema" = 5 ] || \
    fail 'stale/unsupported run state: only schema_version: 5 is supported; start a fresh run'
  reject_unknown_fields "$file"

  for key in workflow workflow_version schema_version run_id status delivery_mode \
    routing checkout continuation validation review delivery; do
    top_level "$key" "$file" || fail "stale/unsupported run state: schema-v5 state is missing current key: $key; start a fresh run"
  done

  [ "$(value_for workflow "$file")" = swe-forge ] || fail 'workflow must be swe-forge'
  [ "$(value_for workflow_version "$file")" = 1 ] || fail 'workflow_version must be 1'
  required_scalar run_id "$file" >/dev/null
  validate_enum status "$file" planning running blocked reviewing repairing accepted failed
  validate_enum delivery_mode "$file" GUIDED PR

  for field in preferred current reason fallback; do
    nested_key routing "$field" "$file" || fail "routing is missing $field"
  done
  validate_routing \
    "$(required_scalar routing.preferred "$file")" \
    "$(required_scalar routing.current "$file")"
  required_scalar routing.reason "$file" >/dev/null
  required_scalar routing.fallback "$file" >/dev/null

  for field in path branch base_sha head_sha; do
    nested_key checkout "$field" "$file" || fail "checkout is missing $field"
  done
  checkout_path=$(required_scalar checkout.path "$file")
  case "$checkout_path" in /*) ;; *) fail 'checkout.path must be absolute' ;; esac
  required_scalar checkout.branch "$file" >/dev/null
  validate_sha_or_none checkout.base_sha "$(required_scalar checkout.base_sha "$file")"
  validate_sha_or_none checkout.head_sha "$(required_scalar checkout.head_sha "$file")"

  validate_delivery "$file"
  validate_validation "$file"
  validate_review "$file"
  validate_continuation "$file"
  if [ "$(required_scalar delivery.status "$file")" = complete ] && \
    [ "$(required_scalar continuation.workflow_active "$file")" = true ]; then
    fail 'complete delivery must have inactive continuation'
  fi

  if top_level tasks "$file" 2>/dev/null; then
    preferred=$(required_scalar routing.preferred "$file")
    current=$(required_scalar routing.current "$file")
    [ "$preferred" = SUBAGENTS ] || [ "$current" = SUBAGENTS ] || \
      fail 'delegated task state is only valid when SUBAGENTS routing is selected'
  fi

  printf 'PASS: schema-v5 run state is structurally valid: %s\n' "$file"
}

