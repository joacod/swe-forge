set_validation() {
  state_arg=
  head_arg=
  validation_status=
  reference_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --head-sha) [ "$#" -ge 2 ] || fail '--head-sha requires a SHA'; head_arg=$2; shift 2 ;;
      --status) [ "$#" -ge 2 ] || fail '--status requires pending, passed, or failed'; validation_status=$2; shift 2 ;;
      --reference|--ref) [ "$#" -ge 2 ] || fail '--reference requires a value'; reference_arg=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-validation option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$head_arg" ] || fail '--head-sha is required'
  [ -n "$validation_status" ] || fail '--status is required'
  [ -n "$reference_arg" ] || fail '--reference is required'
  state_path=$(state_file "$state_arg")
  acquire_state_lock
  validate_state "$state_path" >/dev/null
  require_enum_arg validation.status "$validation_status" pending passed failed
  validate_sha_or_none validation.head_sha "$head_arg"
  [ "$head_arg" = none ] || assert_recorded_head "$head_arg" "$state_path"
  if [ "$validation_status" != pending ] && [ "$head_arg" = none ]; then
    fail 'validation status and candidate identity do not match'
  fi
  require_scalar_arg validation.reference "$reference_arg"

  state_tmp=$state_path.tmp.$$
  awk -v head_value="$head_arg" -v status_value="$validation_status" -v ref_value="$reference_arg" '
    BEGIN { section="" }
    /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }
    section == "validation" && $0 ~ /^  head_sha:/ { print "  head_sha: " head_value; head_count++; next }
    section == "validation" && $0 ~ /^  status:/ { print "  status: " status_value; status_count++; next }
    section == "validation" && $0 ~ /^  reference:/ { print "  reference: " ref_value; ref_count++; next }
    { print }
    END { if (head_count != 1 || status_count != 1 || ref_count != 1) exit 1 }
  ' "$state_path" >"$state_tmp" || fail 'validation update could not locate current validation fields'
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: validation updated: %s\n' "$state_path"
}

set_review() {
  state_arg=
  review_result=
  head_arg=
  blocked_values=
  blocked_seen=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --head-sha) [ "$#" -ge 2 ] || fail '--head-sha requires a SHA'; head_arg=$2; shift 2 ;;
      --result) [ "$#" -ge 2 ] || fail '--result requires PASS or CHANGES_REQUIRED'; review_result=$2; shift 2 ;;
      --blocked-by)
        [ "$#" -ge 2 ] || fail '--blocked-by requires an ID'
        blocked_id=$2
        identifier_valid "$blocked_id" || fail "invalid blocked finding id: $blocked_id"
        case "$blocked_seen" in *"|$blocked_id|"*) fail "duplicate blocked finding id: $blocked_id" ;; esac
        blocked_seen="$blocked_seen|$blocked_id|"
        if [ -n "$blocked_values" ]; then blocked_values="$blocked_values$NEWLINE$blocked_id"; else blocked_values=$blocked_id; fi
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-review option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$head_arg" ] || fail '--head-sha is required'
  case "$review_result" in PASS|CHANGES_REQUIRED) ;; *) fail "invalid review result: ${review_result:-<missing>}" ;; esac
  [ "$review_result" != CHANGES_REQUIRED ] || [ -n "$blocked_values" ] || fail 'CHANGES_REQUIRED review must identify at least one blocking finding'
  [ "$review_result" != PASS ] || [ -z "$blocked_values" ] || fail 'PASS review may not identify blocking findings'
  validate_sha_field review.reviewed_head "$head_arg"
  state_path=$(state_file "$state_arg")
  acquire_state_lock
  validate_state "$state_path" >/dev/null
  assert_recorded_head "$head_arg" "$state_path"
  current_review_status=$(required_scalar review.status "$state_path")
  [ "$current_review_status" = pending ] || fail "review has already been recorded: $current_review_status"

  review_status=pass
  [ "$review_result" = CHANGES_REQUIRED ] && review_status=changes-required
  blocked_yaml=[]
  if [ -n "$blocked_values" ]; then
    blocked_yaml="["
    blocked_first=true
    while IFS= read -r blocked_id; do
      [ -n "$blocked_id" ] || continue
      if [ "$blocked_first" = true ]; then blocked_first=false; else blocked_yaml="$blocked_yaml, "; fi
      blocked_yaml="$blocked_yaml$blocked_id"
    done <<EOF_BLOCKED
$blocked_values
EOF_BLOCKED
    blocked_yaml="$blocked_yaml]"
  fi

  top_status=$(required_scalar status "$state_path")
  [ "$review_result" != CHANGES_REQUIRED ] || top_status=repairing
  state_tmp=$state_path.tmp.$$$$
  awk -v top_status="$top_status" '
    BEGIN { section=""; skip=0; status_count=0 }
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
      if (section == "review") { skip=1; next }
      skip=0
    }
    skip { next }
    /^[^ ]*status:/ {
      print "status: " top_status
      status_count++
      next
    }
    { print }
    END { if (status_count != 1) exit 1 }
  ' "$state_path" >"$state_tmp" || fail 'review update could not locate the current state status'
  {
    printf 'review:\n'
    printf '  status: %s\n' "$review_status"
    printf '  reviewed_head: %s\n' "$head_arg"
    printf '  repair_used: false\n'
    printf '  blocked_by: %s\n' "$blocked_yaml"
  } >>"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: review recorded: %s\n' "$review_result"
}

set_review_repair() {
  state_arg=
  head_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --head-sha) [ "$#" -ge 2 ] || fail '--head-sha requires a SHA'; head_arg=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-review-repair option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$head_arg" ] || fail '--head-sha is required'
  validate_sha_field review.reviewed_head "$head_arg"
  state_path=$(state_file "$state_arg")
  acquire_state_lock
  validate_state "$state_path" >/dev/null
  assert_recorded_head "$head_arg" "$state_path"
  current_review_status=$(required_scalar review.status "$state_path")
  [ "$current_review_status" = changes-required ] || fail "review repair requires an unresolved changes-required review: $current_review_status"
  [ "$(required_scalar review.repair_used "$state_path")" = false ] || fail 'review repair has already been used'
  blocked_yaml=$(required_scalar review.blocked_by "$state_path")
  case "$blocked_yaml" in \[*\]) ;; *) fail 'review repair requires a valid blocking-finding list' ;; esac
  blocked_values=${blocked_yaml#\[}
  blocked_values=${blocked_values%\]}
  blocked_count=$(printf '%s\n' "$blocked_values" | awk -F',' 'NF { count++ } END { print count + 0 }')
  [ "$blocked_count" -eq 1 ] || fail 'review repair requires exactly one blocking finding'
  reviewed_head=$(required_scalar review.reviewed_head "$state_path")
  [ "$reviewed_head" != "$head_arg" ] || fail 'review repair must produce a new candidate'

  state_tmp=$state_path.tmp.$$$$
  awk '
    BEGIN { section=""; skip=0; status_count=0 }
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
      if (section == "review") { skip=1; next }
      skip=0
    }
    skip { next }
    /^[^ ]*status:/ { print "status: running"; status_count++; next }
    { print }
    END { if (status_count != 1) exit 1 }
  ' "$state_path" >"$state_tmp" || fail 'review repair update could not locate the current state status'
  {
    printf 'review:\n'
    printf '  status: repaired\n'
    printf '  reviewed_head: %s\n' "$reviewed_head"
    printf '  repair_used: true\n'
    printf '  blocked_by: %s\n' "$blocked_yaml"
  } >>"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: review repair recorded: %s\n' "$state_path"
}

set_pull_request() {
  state_arg=
  url_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --url) [ "$#" -ge 2 ] || fail '--url requires a URL'; url_arg=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-pull-request option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$url_arg" ] || fail '--url is required'
  case "$url_arg" in http://*|https://*) ;; *) fail 'pull-request URL must use http:// or https://' ;; esac
  control_chars "$url_arg"
  state_path=$(state_file "$state_arg")
  acquire_state_lock
  validate_state "$state_path" >/dev/null
  [ "$(required_scalar delivery_mode "$state_path")" = PR ] || fail 'pull-request completion is only valid in PR mode'
  existing_ref=$(required_scalar delivery.pull_request_ref "$state_path")
  [ "$existing_ref" = none ] || [ "$existing_ref" = "$url_arg" ] || fail 'pull-request completion URL does not match the recorded PR'
  current_delivery_status=$(required_scalar delivery.status "$state_path")
  [ "$current_delivery_status" = complete ] || [ "$current_delivery_status" = pending ] || [ "$current_delivery_status" = blocked ] || \
    fail "pull-request completion is not valid from delivery status: $current_delivery_status"

  state_tmp=$state_path.tmp.$$$$
  awk '
    BEGIN { section=""; skip_delivery=0; active_count=0 }
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
      if (section == "delivery") { skip_delivery=1; next }
      skip_delivery=0
    }
    skip_delivery { next }
    section == "continuation" && $0 ~ /^  workflow_active:/ { print "  workflow_active: false"; active_count++; next }
    { print }
    END { if (active_count != 1) exit 1 }
  ' "$state_path" >"$state_tmp" || fail 'pull-request completion could not update continuation state'
  {
    printf 'delivery:\n'
    printf '  status: complete\n'
    printf '  pull_request_ref: %s\n' "$url_arg"
    printf '  pr_number: %s\n' "$(required_scalar delivery.pr_number "$state_path")"
    printf '  pr_state: %s\n' "$(required_scalar delivery.pr_state "$state_path")"
  } >>"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: pull-request completion recorded: %s\n' "$state_path"
}

main() {
  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  command=$1
  shift
  case "$command" in
    validate)
      state=
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state=$2; shift 2 ;;
          -h|--help) usage; exit 0 ;;
          *) fail "unknown validate option: $1" ;;
        esac
      done
      [ -n "$state" ] || fail '--state is required'
      validate_state "$state"
      ;;
    inspect) inspect_command "$@" ;;
    resolve-active) resolve_active_command "$@" ;;
    init) init_state "$@" ;;
    set-routing) set_routing "$@" ;;
    set-continuation) set_continuation "$@" ;;
    set-delivery-checkout) set_delivery_checkout "$@" ;;
    set-validation) set_validation "$@" ;;
    set-review) set_review "$@" ;;
    set-review-repair) set_review_repair "$@" ;;
    set-pull-request) set_pull_request "$@" ;;
    -h|--help) usage ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"
