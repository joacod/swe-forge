#!/bin/sh

# Dependency-free structural validator for the current SWE Forge run-state schema.
# Obsolete and unknown schemas are stale; this helper never migrates them.

set -eu

PROGRAM=${0##*/}
TAB=$(printf '\t')
NEWLINE='
'

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  swe-forge-state validate --state FILE|DIRECTORY

The validator accepts only workflow_version 1 / schema_version 3 state.
Obsolete or unknown state must be replaced by starting a fresh run.
EOF
}

control_chars() {
  case "$1" in
    *"$TAB"*|*"$NEWLINE"*)
      fail "state contains unsupported tab or newline data" ;;
  esac
}

state_file() {
  value=$1
  control_chars "$value"
  if [ -d "$value" ] && [ ! -L "$value" ]; then
    value=$value/run-state.yaml
  fi
  [ -f "$value" ] || fail "run-state file does not exist: $value"
  printf '%s\n' "$value"
}

top_level() {
  key=$1
  file=$2
  awk -v wanted="$key" '
    $0 ~ "^" wanted ":([[:space:]]|$)" { found=1; count++ }
    END { if (count == 1) exit 0; exit 1 }
  ' "$file"
}

nested_key() {
  section=$1
  key=$2
  file=$3
  awk -v section="$section" -v wanted="$key" '
    /^[^[:space:]#][^:]*:/ { current=$1; sub(/:$/, "", current); next }
    current == section && $0 ~ "^  " wanted ":([[:space:]]|$)" { found=1; count++ }
    END { if (count == 1) exit 0; exit 1 }
  ' "$file"
}

lifecycle_key() {
  key=$1
  file=$2
  awk -v wanted="$key" '
    /^[^[:space:]#][^:]*:/ { current=$1; sub(/:$/, "", current); next }
    current == "provider_capabilities" && $0 ~ "^    " wanted ":([[:space:]]|$)" { found=1; count++ }
    END { if (count == 1) exit 0; exit 1 }
  ' "$file"
}

value_for() {
  key=$1
  file=$2
  awk -v wanted="$key" '$1 == wanted ":" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$file"
}

# Read one scalar from the deliberately simple state YAML without introducing
# a general parser. The path is optional for stage-dependent current-schema
# sections that are not semantically available yet.
scalar_value() {
  path=$1
  file=$2
  awk -v wanted="$path" '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ || /^[[:space:]]*-/ { next }
    {
      leading=$0
      sub(/[^ ]+.*/, "", leading)
      indent=length(leading)
      line=$0
      sub(/^[ ]*/, "", line)
      if (line !~ /^[A-Za-z0-9_-]+:/) next
      key=line
      sub(/:.*/, "", key)
      raw=line
      sub(/^[^:]*:[[:space:]]*/, "", raw)
      sub(/[[:space:]]+#.*$/, "", raw)
      sub(/[[:space:]]+$/, "", raw)
      while (depth > 0 && indents[depth] >= indent) depth--
      depth++
      keys[depth]=key
      indents[depth]=indent
      current=keys[1]
      for (i=2; i<=depth; i++) current=current "." keys[i]
      if (current == wanted) {
        print raw
        found=1
        exit
      }
      if (raw != "") depth--
    }
    END { if (found) exit 0; exit 1 }
  ' "$file"
}

required_scalar() {
  field=$1
  file=$2
  scalar_value "$field" "$file" || fail "current schema is missing $field"
}

validate_enum() {
  field=$1
  file=$2
  shift 2
  value=$(required_scalar "$field" "$file")
  for allowed do
    [ "$value" = "$allowed" ] && return 0
  done
  fail "invalid $field"
}

validate_delivery_projection() {
  file=$1
  projection=$(required_scalar continuation.delivery.mode "$file")
  canonical=$(required_scalar delivery_mode "$file")
  [ "$projection" = "$canonical" ] || \
    fail "continuation.delivery.mode must match delivery_mode"
}

validate_sha_field() {
  field=$1
  value=$2
  case "$value" in
    ''|*[!0123456789abcdefABCDEF]*) fail "$field is not a hexadecimal SHA" ;;
  esac
  [ "${#value}" -eq 40 ] || fail "$field must contain a full 40-character SHA"
}

validate_state() {
  file=$(state_file "$1")

  schema=$(value_for schema_version "$file" || true)
  [ "$schema" = 3 ] || \
    fail "stale/unsupported run state: only schema_version: 3 is supported; start a fresh run"
  if grep -Eq '^(preferred_mode|execution_mode):' "$file"; then
    fail "schema-v3 state contains removed routing field; start a fresh run"
  fi

  for key in workflow workflow_version schema_version run_id status requested_mode \
    requested_provider execution_provider delegation_backend write_isolation \
    provider_reason parallel_strategy integration_strategy requested_delivery \
    delivery_mode reason fallback_used routing invocation_checkout \
    delivery_checkout isolated_eligibility parallel_value provider_capabilities \
    delivery integration workers; do
    top_level "$key" "$file" || fail "schema-v3 state is missing top-level key: $key"
  done

  [ "$(value_for workflow "$file")" = swe-forge ] || fail "workflow must be swe-forge"
  [ "$(value_for workflow_version "$file")" = 1 ] || fail "workflow_version must be 1"
  [ "$(value_for schema_version "$file")" = 3 ] || fail "schema_version must be 3"
  validate_enum status "$file" planning running blocked reviewing repairing accepted failed
  validate_enum requested_mode "$file" AUTO SOLO SUBAGENTS ISOLATED
  validate_enum requested_provider "$file" AUTO NATIVE HERDR NONE
  validate_enum execution_provider "$file" NATIVE HERDR NONE
  validate_enum delegation_backend "$file" NONE NATIVE HERDR OTHER
  validate_enum write_isolation "$file" SHARED WORKTREE
  validate_enum parallel_strategy "$file" NONE COMPOSE
  validate_enum integration_strategy "$file" NONE CHERRY_PICK
  validate_enum requested_delivery "$file" DEFAULT GUIDED PR
  validate_enum delivery_mode "$file" GUIDED PR

  for field in initial preferred selected current; do
    nested_key routing "$field" "$file" || \
      fail "routing is missing $field"
    validate_enum "routing.$field" "$file" SOLO SUBAGENTS ISOLATED
  done

  for key in path branch head_sha classification mutation_allowed baseline_ref; do
    nested_key invocation_checkout "$key" "$file" || \
      fail "invocation_checkout is missing $key"
  done
  for key in path branch kind base_sha head_sha checkpoint_sha status branch_setup \
    remote_default_evidence; do
    nested_key delivery_checkout "$key" "$file" || \
      fail "delivery_checkout is missing $key"
  done
  for key in status evidence_ref blockers; do
    nested_key isolated_eligibility "$key" "$file" || \
      fail "isolated_eligibility is missing $key"
  done
  for key in status rationale overridden_by_user; do
    nested_key parallel_value "$key" "$file" || \
      fail "parallel_value is missing $key"
  done
  for key in concurrent_writable_workers dedicated_worktrees exact_base_sha \
    integration_checkout_protection structured_results central_integration; do
    nested_key provider_capabilities "$key" "$file" || \
      fail "provider_capabilities is missing $key"
  done
  for key in wait inspect cancel cleanup; do
    lifecycle_key "$key" "$file" || \
      fail "provider_capabilities.lifecycle is missing $key"
  done

  # Continuation is stage-dependent. Once a current-schema producer writes it,
  # its durable control fields and self-contained delivery projection are
  # required; a pre-continuation state may omit the whole section.
  if top_level continuation "$file" 2>/dev/null; then
    for key in workflow_active workflow phase step awaiting safe_boundary updated_at; do
      nested_key continuation "$key" "$file" || \
        fail "continuation is missing $key"
    done
    validate_enum continuation.workflow_active "$file" true false
    validate_enum continuation.safe_boundary "$file" true false
    required_scalar continuation.delivery.mode "$file" >/dev/null
    validate_enum continuation.delivery.mode "$file" GUIDED PR
    validate_delivery_projection "$file"
  fi

  for field in invocation_checkout_head_sha delivery_checkout_base_sha \
    delivery_checkout_head_sha delivery_checkout_checkpoint_sha; do
    case "$field" in
      invocation_checkout_head_sha) value=$(awk '$1 == "head_sha:" && section == "invocation_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$file") ;;
      delivery_checkout_base_sha) value=$(awk '$1 == "base_sha:" && section == "delivery_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$file") ;;
      delivery_checkout_head_sha) value=$(awk '$1 == "head_sha:" && section == "delivery_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$file") ;;
      delivery_checkout_checkpoint_sha) value=$(awk '$1 == "checkpoint_sha:" && section == "delivery_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$file") ;;
    esac
    case "$value" in
      ''|null|none|NONE) ;;
      *) validate_sha_field "$field" "$value" ;;
    esac
  done

  kind=$(awk '$1 == "kind:" && section == "delivery_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$file")
  case "$kind" in task|integration) ;; *) fail "delivery_checkout.kind must be task or integration" ;; esac
  classification=$(awk '$1 == "classification:" && section == "invocation_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$file")
  case "$classification" in writable|protected|detached|unclassifiable) ;; *) fail "invalid invocation checkout classification" ;; esac
  mutation_allowed=$(awk '$1 == "mutation_allowed:" && section == "invocation_checkout" { print $2; exit } /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }' "$file")
  case "$mutation_allowed" in true|false) ;; *) fail "invocation_checkout.mutation_allowed must be true or false" ;; esac

  printf 'PASS: schema-v3 run state is structurally valid: %s\n' "$file"
}

main() {
  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  command=$1
  shift
  case "$command" in
    validate)
      state=
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --state)
            [ "$#" -ge 2 ] || fail "--state requires a file or directory"
            state=$2
            shift 2
            ;;
          -h|--help) usage; exit 0 ;;
          *) fail "unknown validate option: $1" ;;
        esac
      done
      [ -n "$state" ] || fail "--state is required"
      validate_state "$state"
      ;;
    -h|--help) usage ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"
