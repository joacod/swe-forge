#!/bin/sh

# Dependency-free validator and bounded mutation owner for the current SWE Forge
# run-state schema. Obsolete and unknown schemas are stale; this helper never
# migrates them.

set -eu

PROGRAM=${0##*/}
TAB=$(printf '\t')
NEWLINE='
'

MAX_PROJECTION_LENGTH=160
MAX_ACCEPTANCE_ITEMS=8

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  swe-forge-state validate --state FILE|DIRECTORY
  swe-forge-state inspect --state FILE|DIRECTORY --checkout PATH
  swe-forge-state resolve-active --checkout PATH \
    [--candidate FILE|DIRECTORY ...] [--all]
  swe-forge-state init --state DIRECTORY [--checkout PATH] [options]
  swe-forge-state set-routing --state FILE|DIRECTORY \
    --preferred TOPOLOGY --current TOPOLOGY --reason TEXT \
    --fallback-used TEXT
  swe-forge-state set-continuation --state FILE|DIRECTORY [options]
  swe-forge-state set-delivery-checkout --state FILE|DIRECTORY \
    --head-sha SHA
  swe-forge-state set-delivery-checkout --state FILE|DIRECTORY \
    --path PATH --branch BRANCH --base-sha SHA --head-sha SHA
  swe-forge-state set-review --state FILE|DIRECTORY \
    --result PASS|CHANGES_REQUIRED [--blocked-by ID...]
  swe-forge-state set-review-repair --state FILE|DIRECTORY
  swe-forge-state set-pull-request --state FILE|DIRECTORY --url URL

`inspect` and `resolve-active` expose the validated semantic run-state
projection as deterministic JSON. Candidate discovery remains the caller's
responsibility; this helper owns validation, eligibility, and ordering.
`init` creates the current schema-v4 structural shell from the selected
internal routing, delivery, checkout, and normalized invocation facts. Pass the
parser's `delivery_mode` unchanged; it defaults to `PR`, while an explicit
`guided` modifier selects `GUIDED`.
`set-routing` owns deliberate preferred/effective topology changes and their
current rationale. `set-continuation` accepts only the bounded continuation
surface; it generates updated_at and derives the delivery projection.
`set-delivery-checkout`, `set-review`, `set-review-repair`, and
`set-pull-request` own their purpose-specific updates. All write operations
validate a temporary result before atomic replacement. Obsolete or unknown
state must be replaced by starting a fresh run.
EOF
}

control_chars() {
  case "$1" in
    *"$TAB"*|*"$NEWLINE"*)
      fail 'state values may not contain tabs or newlines' ;;
  esac
}

state_file() {
  value=$1
  control_chars "$value"
  if [ -d "$value" ] && [ ! -L "$value" ]; then
    value=$value/run-state.yaml
  fi
  [ -f "$value" ] || fail "run-state file does not exist: $value"
  printf '%s\n' "$value"
}

canonical_path() {
  value=$1
  control_chars "$value"
  case "$value" in
    /*) candidate=$value ;;
    *) candidate=$PWD/$value ;;
  esac
  if [ -d "$candidate" ]; then
    CDPATH= cd -P "$candidate" && pwd -P
    return
  fi
  if [ -f "$candidate" ]; then
    directory=$(dirname "$candidate")
    base=$(basename "$candidate")
    CDPATH= cd -P "$directory" && printf '%s/%s\n' "$(pwd -P)" "$base"
    return
  fi
  printf '%s\n' "$candidate"
}

file_mtime_seconds() {
  file=$1
  if value=$(stat -f '%m' "$file" 2>/dev/null); then
    printf '%s\n' "$value"
    return
  fi
  if value=$(stat -c '%Y' "$file" 2>/dev/null); then
    printf '%s\n' "$value"
    return
  fi
  return 1
}

timestamp_epoch() {
  value=$1
  if parsed=$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$value" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  if parsed=$(date -u -j -f '%Y-%m-%dT%H:%M:%S%z' "$value" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  normalized=$(printf '%s\n' "$value" | sed -E 's/\.[0-9]+([Z+-])/\1/; s/([+-][0-9][0-9]):([0-9][0-9])$/\1\2/')
  if parsed=$(date -u -j -f '%Y-%m-%dT%H:%M:%S%z' "$normalized" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  if parsed=$(date -u -d "$value" '+%s' 2>/dev/null); then
    printf '%s\n' "$parsed"
    return
  fi
  return 1
}

json_quote() {
  awk -v value="$1" '
    BEGIN {
      quote = sprintf("%c", 34)
      backslash = sprintf("%c", 92)
      tab = sprintf("%c", 9)
      newline = sprintf("%c", 10)
      carriage_return = sprintf("%c", 13)
      form_feed = sprintf("%c", 12)
      backspace = sprintf("%c", 8)
      printf "%s", quote
      for (i = 1; i <= length(value); i++) {
        c = substr(value, i, 1)
        if (c == quote) printf "%s", backslash quote
        else if (c == backslash) printf "%s", backslash backslash
        else if (c == tab) printf "%s", backslash "t"
        else if (c == newline) printf "%s", backslash "n"
        else if (c == carriage_return) printf "%s", backslash "r"
        else if (c == form_feed) printf "%s", backslash "f"
        else if (c == backspace) printf "%s", backslash "b"
        else printf "%s", c
      }
      printf "%s\n", quote
    }
  '
}

top_level() {
  key=$1
  file=$2
  awk -v wanted="$key" '
    $0 ~ "^" wanted ":([[:space:]]|$)" { count++ }
    END { if (count == 1) exit 0; exit 1 }
  ' "$file"
}

nested_key() {
  section=$1
  key=$2
  file=$3
  scalar_value "$section.$key" "$file" >/dev/null
}

value_for() {
  key=$1
  file=$2
  awk -v wanted="$key" '$1 == wanted ":" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$file"
}

scalar_value() {
  path=$1
  file=$2
  awk -v wanted="$path" '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ || /^[[:space:]]*-/ { next }
    {
      leading=$0
      sub(/[^ ]+.*/, "", leading)
      indent=length(leading)
      line=$0
      sub(/^[ ]*/, "", line)
      if (line !~ /^[A-Za-z0-9_-]+:/) next
      key=line
      sub(/:.*/, "", key)
      raw=line
      sub(/^[^:]*:[[:space:]]*/, "", raw)
      sub(/[[:space:]]+#.*$/, "", raw)
      sub(/[[:space:]]+$/, "", raw)
      while (depth > 0 && indents[depth] >= indent) depth--
      depth++
      keys[depth]=key
      indents[depth]=indent
      current=keys[1]
      for (i=2; i<=depth; i++) current=current "." keys[i]
      if (current == wanted) {
        print raw
        found=1
        exit
      }
      if (raw != "") depth--
    }
    END { if (found) exit 0; exit 1 }
  ' "$file"
}

required_scalar() {
  field=$1
  file=$2
  scalar_value "$field" "$file" || fail "current schema is missing $field"
}

validate_enum() {
  field=$1
  file=$2
  shift 2
  value=$(required_scalar "$field" "$file")
  for allowed do
    [ "$value" = "$allowed" ] && return 0
  done
  fail "invalid $field"
}

require_enum_arg() {
  field=$1
  candidate=$2
  shift 2
  for allowed do
    [ "$candidate" = "$allowed" ] && return 0
  done
  fail "invalid $field"
}

require_bool_arg() {
  field=$1
  candidate=$2
  case "$candidate" in
    true|false) ;;
    *) fail "invalid $field" ;;
  esac
}

require_scalar_arg() {
  field=$1
  candidate=$2
  [ -n "$candidate" ] || fail "$field is required"
  control_chars "$candidate"
}

absolute_path() {
  candidate=$1
  control_chars "$candidate"
  case "$candidate" in
    /*) printf '%s\n' "$candidate" ;;
    *) printf '%s/%s\n' "$PWD" "$candidate" ;;
  esac
}

validate_sha_field() {
  field=$1
  value=$2
  case "$value" in
    ''|*[!0123456789abcdefABCDEF]*) fail "$field is not a hexadecimal SHA" ;;
  esac
  [ "${#value}" -eq 40 ] || fail "$field must contain a full 40-character SHA"
}

validate_delivery_projection() {
  file=$1
  projection=$(required_scalar continuation.delivery.mode "$file")
  canonical=$(required_scalar delivery_mode "$file")
  [ "$projection" = "$canonical" ] || fail 'continuation.delivery.mode must match delivery_mode'
}
identifier_valid() {
  value=$1
  case "$value" in
    ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

validate_review() {
  file=$1
  for field in status blocked_by contract_ref; do
    nested_key review "$field" "$file" || fail "review is missing $field"
  done
  validate_enum review.status "$file" pending pass changes-required repaired skipped
  blocked_by=$(required_scalar review.blocked_by "$file")
  review_status=$(required_scalar review.status "$file")
  case "$review_status" in
    changes-required|repaired)
      [ "$blocked_by" != '[]' ] || fail "review.$review_status requires a blocking finding" ;;
    pass|pending|skipped)
      [ "$review_status" != pass ] || [ "$blocked_by" = '[]' ] || \
        fail 'review.pass may not retain blocking findings' ;;
  esac
  required_scalar review.contract_ref "$file" >/dev/null
}
reject_obsolete_fields() {
  file=$1
  if awk '
    function indentation(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      return length(value) - length(stripped)
    }
    function key_name(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      sub(/:.*/, "", stripped)
      return stripped
    }
    {
      if ($0 ~ /^[[:space:]]*(#|$)/) next
      current_indent = indentation($0)
      while (depth > 0 && indents[depth] >= current_indent) depth--
      current_key = key_name($0)
      depth++
      indents[depth] = current_indent
      keys[depth] = current_key
      under_continuation = 0
      under_next_action = 0
      under_routing = 0
      under_review = 0
      under_delivery_checkout = 0
      for (i = 1; i < depth; i++) {
        if (keys[i] == "continuation") under_continuation = 1
        if (keys[i] == "next_action") under_next_action = 1
        if (keys[i] == "routing") under_routing = 1
        if (keys[i] == "review") under_review = 1
        if (keys[i] == "delivery_checkout") under_delivery_checkout = 1
      }
      if (current_indent == 0 &&
          current_key != "workflow" && current_key != "workflow_version" &&
          current_key != "schema_version" && current_key != "run_id" &&
          current_key != "status" && current_key != "delivery_mode" &&
          current_key != "reason" && current_key != "fallback_used" &&
          current_key != "routing" && current_key != "delivery_checkout" &&
          current_key != "delivery" && current_key != "review" &&
          current_key != "tasks" && current_key != "ticket_ref" &&
          current_key != "parsed_ticket_ref" && current_key != "specialist_skills" &&
          current_key != "working_spec_ref" && current_key != "acceptance_ref" &&
          current_key != "current_phase" && current_key != "continuation" &&
          current_key != "validation_ref" && current_key != "cleanup" &&
          current_key != "retries") found=1
      if (under_routing &&
          (current_key == "initial" || current_key == "selected" ||
           current_key == "revisions" || current_key == "context_value" ||
           current_key == "runtime_profile_ref")) found=1
      if (under_continuation && current_key == "recovery") found=1
      if (under_next_action && current_key == "expected_context_tokens") found=1
      if (under_delivery_checkout && current_key == "checkpoint_sha") found=1
      if (under_review &&
          (current_key == "attempts" || current_key == "retry_ceiling" ||
           current_key == "ceiling_provenance")) found=1
    }
    END { if (found) exit 0; exit 1 }
  ' "$file"; then
    fail 'stale/unsupported run state: obsolete routing, delivery, or context-control fields; start a fresh run'
  fi
}


validate_routing() {
  preferred=$1
  current=$2

  case "$preferred" in
    SOLO|SUBAGENTS) ;;
    *) fail "invalid routing.preferred: $preferred" ;;
  esac
  case "$current" in
    SOLO|SUBAGENTS) ;;
    *) fail "invalid routing.current: $current" ;;
  esac
}


validate_state() {
  file=$(state_file "$1")
  schema=$(value_for schema_version "$file" || true)
  [ "$schema" = 4 ] || \
    fail 'stale/unsupported run state: only schema_version: 4 is supported; start a fresh run'
  reject_obsolete_fields "$file"

  for key in workflow workflow_version schema_version run_id status delivery_mode \
    reason fallback_used routing delivery_checkout delivery review tasks; do
    top_level "$key" "$file" || fail "stale/unsupported run state: schema-v4 state is missing current key: $key; start a fresh run"
  done

  [ "$(value_for workflow "$file")" = swe-forge ] || fail 'workflow must be swe-forge'
  [ "$(value_for workflow_version "$file")" = 1 ] || fail 'workflow_version must be 1'
  validate_enum status "$file" planning running blocked reviewing repairing accepted failed
  validate_enum delivery_mode "$file" GUIDED PR

  for field in preferred current; do
    nested_key routing "$field" "$file" || fail "routing is missing $field"
    validate_enum "routing.$field" "$file" SOLO SUBAGENTS
  done

  validate_routing \
    "$(required_scalar routing.preferred "$file")" \
    "$(required_scalar routing.current "$file")"

  for field in path branch base_sha head_sha status branch_setup \
    remote_default_evidence; do
    nested_key delivery_checkout "$field" "$file" || \
      fail "delivery_checkout is missing $field"
  done
  for field in commit push create_pull_request sync pull_request_ref; do
    nested_key delivery "$field" "$file" || fail "delivery is missing $field"
  done
  for action in commit push create_pull_request publish deploy merge; do
    scalar_value "delivery.authorization.$action" "$file" >/dev/null || \
      fail "delivery.authorization is missing $action"
  done
  validate_enum delivery.authorization.commit "$file" not-authorized go PR
  validate_enum delivery.authorization.push "$file" not-authorized PR
  validate_enum delivery.authorization.create_pull_request "$file" not-authorized PR
  validate_enum delivery.authorization.publish "$file" not-authorized
  validate_enum delivery.authorization.deploy "$file" not-authorized
  validate_enum delivery.authorization.merge "$file" not-authorized
  validate_enum delivery.commit "$file" not-authorized pending complete blocked
  validate_enum delivery.push "$file" not-authorized pending complete blocked
  validate_enum delivery.create_pull_request "$file" not-authorized pending complete blocked
  validate_enum delivery.sync "$file" not-authorized pending complete blocked
  validate_review "$file"

  classification=$(required_scalar delivery_checkout.status "$file")
  case "$classification" in ready|running|blocked|dirty|complete) ;;
    *) fail 'invalid delivery_checkout.status' ;;
  esac
  validate_enum delivery_checkout.branch_setup "$file" auto-created reused user-provided provided blocked
  for field in delivery_checkout.base_sha delivery_checkout.head_sha; do
    value=$(required_scalar "$field" "$file")
    case "$value" in
      none|NONE|null) ;;
      *) validate_sha_field "$field" "$value" ;;
    esac
  done

  if top_level continuation "$file" 2>/dev/null; then
    for key in workflow_active workflow phase step awaiting safe_boundary updated_at; do
      nested_key continuation "$key" "$file" || fail "continuation is missing $key"
    done
    validate_enum continuation.workflow_active "$file" true false
    validate_enum continuation.workflow "$file" ticket delivery other
    validate_enum continuation.phase "$file" planning discovery implementation review delivery awaiting_merge recovery complete
    validate_enum continuation.awaiting "$file" none user_merge user_decision recovery
    validate_enum continuation.safe_boundary "$file" true false
    required_scalar continuation.updated_at "$file" >/dev/null
    required_scalar continuation.delivery.mode "$file" >/dev/null
    validate_enum continuation.delivery.mode "$file" GUIDED PR
    validate_delivery_projection "$file"
  fi

  printf 'PASS: schema-v4 run state is structurally valid: %s\n' "$file"
}

inspection_valid=false
inspection_active=false
inspection_delegation_authorized=false
inspection_reason=
inspection_state_file=
inspection_checkout=
inspection_recorded_checkout=
inspection_run_id=
inspection_status=
inspection_workflow_active_json=false
inspection_updated_at=
inspection_updated_epoch=
inspection_updated_at_ms=0
inspection_modified_epoch=
inspection_modified_at_ms=0
inspection_preferred=
inspection_current=
inspection_delivery_mode=
inspection_phase=
inspection_step=
inspection_awaiting=
inspection_next_kind=
inspection_next_target=
inspection_acceptance_json=[]
inspection_safe_boundary_json=false
inspection_pr_number=
inspection_pr_state=
inspection_review_status=

inspection_scalar() {
  scalar_value "$1" "$2" 2>/dev/null || true
}

inspection_defaults() {
  inspection_valid=false
  inspection_active=false
  inspection_delegation_authorized=false
  inspection_reason='invalid or unsupported run state'
  inspection_state_file=
  inspection_checkout=
  inspection_recorded_checkout=
  inspection_run_id=
  inspection_status=
  inspection_workflow_active_json=false
  inspection_updated_at=
  inspection_updated_epoch=
  inspection_updated_at_ms=0
  inspection_modified_epoch=
  inspection_modified_at_ms=0
  inspection_preferred=
  inspection_current=
  inspection_delivery_mode=
  inspection_phase=none
  inspection_step=none
  inspection_awaiting=none
  inspection_next_kind=none
  inspection_next_target=none
  inspection_acceptance_json=[]
  inspection_safe_boundary_json=false
  inspection_pr_number=none
  inspection_pr_state=none
  inspection_review_status=none
}

inspect_state_data() {
  state_arg=$1
  checkout_arg=$2
  inspection_defaults
  inspection_state_file=$(state_file "$state_arg")
  inspection_state_file=$(canonical_path "$inspection_state_file")
  inspection_checkout=$(canonical_path "$checkout_arg")

  if ! "$0" validate --state "$inspection_state_file" >/dev/null 2>/dev/null; then
    return 0
  fi

  inspection_valid=true
  inspection_run_id=$(required_scalar run_id "$inspection_state_file")
  inspection_status=$(required_scalar status "$inspection_state_file")
  inspection_recorded_checkout=$(canonical_path "$(required_scalar delivery_checkout.path "$inspection_state_file")")
  inspection_preferred=$(required_scalar routing.preferred "$inspection_state_file")
  inspection_current=$(required_scalar routing.current "$inspection_state_file")
  inspection_delivery_mode=$(required_scalar delivery_mode "$inspection_state_file")
  inspection_workflow_active=$(inspection_scalar continuation.workflow_active "$inspection_state_file")
  inspection_updated_at=$(inspection_scalar continuation.updated_at "$inspection_state_file")
  inspection_phase=$(inspection_scalar continuation.phase "$inspection_state_file")
  inspection_step=$(inspection_scalar continuation.step "$inspection_state_file")
  inspection_awaiting=$(inspection_scalar continuation.awaiting "$inspection_state_file")
  inspection_next_kind=$(inspection_scalar continuation.next_action.kind "$inspection_state_file")
  inspection_review_status=$(inspection_scalar review.status "$inspection_state_file")
  [ -n "$inspection_review_status" ] || inspection_review_status=none
  inspection_next_target=$(inspection_scalar continuation.next_action.target "$inspection_state_file")
  inspection_acceptance_json=$(inspection_acceptance "$inspection_state_file")
  inspection_safe_boundary=$(inspection_scalar continuation.safe_boundary "$inspection_state_file")
  inspection_pr_number=$(inspection_scalar continuation.delivery.pr_number "$inspection_state_file")
  inspection_pr_state=$(inspection_scalar continuation.delivery.pr_state "$inspection_state_file")

  [ -n "$inspection_phase" ] || inspection_phase=none
  [ -n "$inspection_step" ] || inspection_step=none
  [ -n "$inspection_awaiting" ] || inspection_awaiting=none
  [ -n "$inspection_next_kind" ] || inspection_next_kind=none
  [ -n "$inspection_next_target" ] || inspection_next_target=none
  [ -n "$inspection_pr_number" ] || inspection_pr_number=none
  [ -n "$inspection_pr_state" ] || inspection_pr_state=none
  inspection_phase=$(projection_value "$inspection_phase")
  inspection_step=$(projection_value "$inspection_step")
  inspection_awaiting=$(projection_value "$inspection_awaiting")
  inspection_next_kind=$(projection_value "$inspection_next_kind")
  inspection_next_target=$(projection_value "$inspection_next_target")
  inspection_pr_number=$(projection_value "$inspection_pr_number")
  inspection_pr_state=$(projection_value "$inspection_pr_state")

  case "$inspection_workflow_active" in
    true) inspection_workflow_active_json=true ;;
    false|'') inspection_workflow_active_json=false ;;
    *) inspection_reason='invalid continuation activity marker'; return 0 ;;
  esac
  case "$inspection_safe_boundary" in
    true) inspection_safe_boundary_json=true ;;
    false|'') inspection_safe_boundary_json=false ;;
    *) inspection_reason='invalid continuation boundary marker'; return 0 ;;
  esac
  if [ "$inspection_workflow_active_json" != true ]; then
    inspection_reason='inactive workflow continuation'
    return 0
  fi

  if [ "$inspection_recorded_checkout" != "$inspection_checkout" ]; then
    inspection_reason='checkout mismatch'
    return 0
  fi
  if ! inspection_updated_epoch=$(timestamp_epoch "$inspection_updated_at" 2>/dev/null); then
    inspection_reason='stale or malformed continuation timestamp'
    return 0
  fi
  inspection_updated_at_ms=$((inspection_updated_epoch * 1000))
  if ! inspection_modified_epoch=$(file_mtime_seconds "$inspection_state_file" 2>/dev/null); then
    inspection_reason='state file modification time is unavailable'
    return 0
  fi
  inspection_modified_at_ms=$((inspection_modified_epoch * 1000))

  case "$inspection_status" in
    planning|running|blocked|reviewing|repairing)
      inspection_active=true
      ;;
    accepted|failed)
      inspection_reason='terminal or inactive run state'
      return 0
      ;;
    *)
      inspection_reason='unsupported run-state status'
      return 0
      ;;
  esac
  case "$inspection_status" in
    planning|running|reviewing|repairing) inspection_delegation_authorized=true ;;
    blocked) inspection_delegation_authorized=false ;;
  esac
  if [ "$inspection_delegation_authorized" = true ]; then
    inspection_reason=eligible
  else
    inspection_reason='active continuation without delegation authorization'
  fi
}

emit_state_json() {
  printf '{"schema":"swe-forge-state/v1","valid":%s,"active":%s,"delegation_authorized":%s,"reason":%s' \
    "$inspection_valid" "$inspection_active" "$inspection_delegation_authorized" \
    "$(json_quote "$inspection_reason")"
  printf ',"state_file":%s,"run_id":%s,"status":%s,"checkout":%s' \
    "$(json_quote "$inspection_state_file")" "$(json_quote "$inspection_run_id")" \
    "$(json_quote "$inspection_status")" "$(json_quote "$inspection_recorded_checkout")"
  printf ',"updated_at":%s,"updated_at_ms":%s,"modified_at_ms":%s' \
    "$(json_quote "$inspection_updated_at")" \
    "$inspection_updated_at_ms" "$inspection_modified_at_ms"
  printf ',"routing":{"preferred":%s,"current":%s},"delivery_mode":%s' \
    "$(json_quote "$inspection_preferred")" "$(json_quote "$inspection_current")" \
    "$(json_quote "$inspection_delivery_mode")"
  printf ',"review":{"status":%s}' \
    "$(json_quote "$inspection_review_status")"
  printf ',"continuation":{"workflow_active":%s,"phase":%s,"step":%s,"awaiting":%s' \
    "$inspection_workflow_active_json" "$(json_quote "$inspection_phase")" \
    "$(json_quote "$inspection_step")" "$(json_quote "$inspection_awaiting")"
  printf ',"next_action":{"kind":%s,"target":%s,"acceptance":%s},"safe_boundary":%s' \
    "$(json_quote "$inspection_next_kind")" "$(json_quote "$inspection_next_target")" \
    "$inspection_acceptance_json" "$inspection_safe_boundary_json"
  printf ',"delivery":{"mode":%s,"pr_number":%s,"pr_state":%s}}}' \
    "$(json_quote "$inspection_delivery_mode")" "$(json_quote "$inspection_pr_number")" \
    "$(json_quote "$inspection_pr_state")"
}
inspection_acceptance() {
  file=$1
  awk -v maximum="$MAX_PROJECTION_LENGTH" -v maximum_items="$MAX_ACCEPTANCE_ITEMS" '
    function indentation(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      return length(value) - length(stripped)
    }
    function key_name(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      sub(/:.*/, "", stripped)
      return stripped
    }
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    function json_quote(value,    i, c, quote, backslash, tab, newline, carriage_return, form_feed, backspace, vertical_tab) {
      quote = sprintf("%c", 34)
      backslash = sprintf("%c", 92)
      tab = sprintf("%c", 9)
      newline = sprintf("%c", 10)
      carriage_return = sprintf("%c", 13)
      form_feed = sprintf("%c", 12)
      backspace = sprintf("%c", 8)
      vertical_tab = sprintf("%c", 11)
      result = quote
      for (i = 1; i <= length(value); i++) {
        c = substr(value, i, 1)
        if (c == quote) result = result backslash quote
        else if (c == backslash) result = result backslash backslash
        else if (c == tab) result = result backslash "t"
        else if (c == newline) result = result backslash "n"
        else if (c == carriage_return) result = result backslash "r"
        else if (c == form_feed) result = result backslash "f"
        else if (c == backspace) result = result backslash "b"
        else if (c == vertical_tab) result = result backslash "u000b"
        else result = result c
      }
      return result quote
    }
    function append_value(value) {
      value = trim(value)
      if (value == "" || count >= maximum_items) return
      if (value ~ /^".*"$/) {
        sub(/^"/, "", value)
        sub(/"$/, "", value)
      }
      value = substr(value, 1, maximum)
      if (count > 0) printf ","
      printf "%s", json_quote(value)
      count++
    }
    function append_flow(value,    i, c, quote, escaped, item, backslash, double_quote, single_quote) {
      sub(/^\[/, "", value)
      sub(/\][[:space:]]*$/, "", value)
      if (value == "") return
      backslash = sprintf("%c", 92)
      double_quote = sprintf("%c", 34)
      single_quote = sprintf("%c", 39)
      quote = ""
      escaped = 0
      item = ""
      for (i = 1; i <= length(value); i++) {
        c = substr(value, i, 1)
        if (escaped) {
          item = item c
          escaped = 0
          continue
        }
        if (quote != "" && c == backslash) {
          escaped = 1
          continue
        }
        if (quote == "" && (c == double_quote || c == single_quote)) {
          quote = c
          continue
        }
        if (quote != "" && c == quote) {
          quote = ""
          continue
        }
        if (quote == "" && c == ",") {
          append_value(item)
          item = ""
          continue
        }
        item = item c
      }
      append_value(item)
    }
    BEGIN {
      in_continuation = 0
      in_next_action = 0
      in_acceptance = 0
      count = 0
      printf "["
    }
    {
      if ($0 ~ /^[[:space:]]*(#|$)/) next
      current_indent = indentation($0)
      current_key = key_name($0)
      if (current_indent == 0) {
        in_continuation = current_key == "continuation"
        in_next_action = 0
        in_acceptance = 0
      } else if (in_continuation && current_indent == 2) {
        in_next_action = current_key == "next_action"
        in_acceptance = 0
      } else if (in_continuation && in_next_action && current_indent == 4) {
        in_acceptance = current_key == "acceptance"
        value = $0
        sub(/^[ ]*acceptance:[[:space:]]*/, "", value)
        if (in_acceptance && value ~ /^\[/) {
          append_flow(value)
          in_acceptance = 0
        }
      } else if (in_continuation && in_next_action && in_acceptance &&
          current_indent >= 6 && $0 ~ /^      - /) {
        value = $0
        sub(/^      - /, "", value)
        append_value(value)
      }
    }
    END { print "]" }
  ' "$file"
}

projection_value() {
  awk -v value="$1" -v maximum="$MAX_PROJECTION_LENGTH" '
    BEGIN {
      print substr(value, 1, maximum)
    }
  '
}

inspect_command() {
  inspect_state_arg=
  inspect_checkout_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; inspect_state_arg=$2; shift 2 ;;
      --checkout) [ "$#" -ge 2 ] || fail '--checkout requires a path'; inspect_checkout_arg=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown inspect option: $1" ;;
    esac
  done
  [ -n "$inspect_state_arg" ] || fail 'inspect requires --state'
  [ -n "$inspect_checkout_arg" ] || fail 'inspect requires --checkout'
  inspect_state_data "$inspect_state_arg" "$inspect_checkout_arg"
  emit_state_json
}

resolve_active_command() {
  resolve_checkout_arg=
  resolve_all=false
  resolve_candidates=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --checkout) [ "$#" -ge 2 ] || fail '--checkout requires a path'; resolve_checkout_arg=$2; shift 2 ;;
      --candidate)
        [ "$#" -ge 2 ] || fail '--candidate requires a file or directory'
        control_chars "$2"
        if [ -z "$resolve_candidates" ]; then resolve_candidates=$2; else resolve_candidates="$resolve_candidates$NEWLINE$2"; fi
        shift 2
        ;;
      --all) resolve_all=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown resolve-active option: $1" ;;
    esac
  done
  [ -n "$resolve_checkout_arg" ] || fail 'resolve-active requires --checkout'
  resolve_checkout=$(canonical_path "$resolve_checkout_arg")
  inspect_tmp=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-state.XXXXXX")
  candidate_file=$inspect_tmp/candidates
  records_file=$inspect_tmp/records
  seen_file=$inspect_tmp/seen
  sorted_file=$inspect_tmp/sorted
  : >"$candidate_file"
  : >"$records_file"
  : >"$seen_file"
  if [ -n "$resolve_candidates" ]; then printf '%s\n' "$resolve_candidates" >"$candidate_file"; fi

  index=0
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    [ -e "$candidate" ] || continue
    inspect_state_data "$candidate" "$resolve_checkout"
    [ "$inspection_active" = true ] || continue
    if awk -v value="$inspection_state_file" '$0 == value { found = 1 } END { exit(found ? 0 : 1) }' "$seen_file"; then
      continue
    fi
    printf '%s\n' "$inspection_state_file" >>"$seen_file"
    index=$((index + 1))
    json_file=$inspect_tmp/state.$index.json
    emit_state_json >"$json_file"
    printf '%s\t%s\t%s\t%s\n' "$inspection_state_file" "$inspection_updated_epoch" \
      "$inspection_modified_epoch" "$json_file" >>"$records_file"
  done <"$candidate_file"

  LC_ALL=C sort -t "$TAB" -k2,2nr -k3,3nr -k1,1 "$records_file" >"$sorted_file"
  printf '{"schema":"swe-forge-state/v1","checkout":%s,"states":[' "$(json_quote "$resolve_checkout")"
  selected=0
  while IFS="$TAB" read -r _state _updated _modified json_file; do
    [ -n "$json_file" ] || continue
    if [ "$resolve_all" != true ] && [ "$selected" -gt 0 ]; then break; fi
    [ "$selected" -eq 0 ] || printf ','
    cat "$json_file"
    selected=$((selected + 1))
  done <"$sorted_file"
  printf ']}\n'
}

checkout_root_for_init() {
  candidate=$1
  [ -d "$candidate" ] || fail "checkout does not exist: $candidate"
  root=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || \
    fail "not a Git checkout: $candidate"
  CDPATH= cd "$root" && pwd -P
}

git_branch_for_init() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null || printf '%s\n' none
}

state_directory_for_init() {
  candidate=$(absolute_path "$1")
  if [ -e "$candidate" ] || [ -L "$candidate" ]; then
    [ -d "$candidate" ] && [ ! -L "$candidate" ] || \
      fail "state path must be a real directory: $candidate"
    CDPATH= cd "$candidate" && pwd -P
    return
  fi
  parent=$(dirname "$candidate")
  [ -d "$parent" ] && [ ! -L "$parent" ] || \
    fail "state parent is not a real directory: $parent"
  CDPATH= cd "$parent" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$candidate")"
}

state_tmp=
inspect_tmp=
review_lock=
cleanup_state_tmp() {
  [ -z "${state_tmp:-}" ] || rm -f "$state_tmp"
}
cleanup_inspect_tmp() {
  [ -z "${inspect_tmp:-}" ] || rm -rf "$inspect_tmp"
}
cleanup_review_lock() {
  if [ -n "${review_lock:-}" ]; then
    rm -f "$review_lock/pid"
    rmdir "$review_lock" 2>/dev/null || true
  fi
}
acquire_review_lock() {
  lock_path=$(dirname "$state_path")/review.lock
  if [ "${SWE_FORGE_REVIEW_LOCK_HELD:-false}" = true ]; then
    owner_pid=$(cat "$lock_path/pid" 2>/dev/null || true)
    [ "$owner_pid" = "${PPID:-}" ] || \
      fail 'review lock is not owned by the invoking gate'
    return 0
  fi
  mkdir "$lock_path" 2>/dev/null || \
    fail 'review state is locked by another review activity; retry after it finishes'
  review_lock=$lock_path
  printf '%s\n' "$$" >"$review_lock/pid"
}

trap 'status=$?; cleanup_state_tmp; cleanup_inspect_tmp; cleanup_review_lock; exit "$status"' 0 HUP INT TERM

init_state() {
  init_state_arg=
  init_checkout_arg=.
  init_run_id=
  init_baseline_ref=HEAD
  init_status=running
  init_delivery_mode=PR
  init_reason='initial schema-v4 state'
  init_fallback_used=no
  init_routing_preferred=
  init_routing_current=
  init_delivery_status=ready
  init_delivery_branch_setup=reused
  init_remote_default_evidence=none

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail '--state requires a directory'
        init_state_arg=$2
        shift 2
        ;;
      --checkout)
        [ "$#" -ge 2 ] || fail '--checkout requires a path'
        init_checkout_arg=$2
        shift 2
        ;;
      --run-id)
        [ "$#" -ge 2 ] || fail '--run-id requires an ID'
        init_run_id=$2
        shift 2
        ;;
      --baseline-ref|--base|--base-sha)
        [ "$#" -ge 2 ] || fail "$1 requires a Git revision"
        init_baseline_ref=$2
        shift 2
        ;;
      --status)
        [ "$#" -ge 2 ] || fail '--status requires a lifecycle status'
        init_status=$2
        shift 2
        ;;
      --delivery-mode)
        [ "$#" -ge 2 ] || fail '--delivery-mode requires GUIDED or PR'
        init_delivery_mode=$2
        shift 2
        ;;
      --reason)
        [ "$#" -ge 2 ] || fail '--reason requires text'
        init_reason=$2
        shift 2
        ;;
      --fallback-used)
        [ "$#" -ge 2 ] || fail '--fallback-used requires text'
        init_fallback_used=$2
        shift 2
        ;;
      --routing-preferred)
        [ "$#" -ge 2 ] || fail '--routing-preferred requires a topology'
        init_routing_preferred=$2
        shift 2
        ;;
      --routing-current)
        [ "$#" -ge 2 ] || fail '--routing-current requires a topology'
        init_routing_current=$2
        shift 2
        ;;
      --delivery-status)
        [ "$#" -ge 2 ] || fail '--delivery-status requires a checkout status'
        init_delivery_status=$2
        shift 2
        ;;
      --delivery-branch-setup)
        [ "$#" -ge 2 ] || fail '--delivery-branch-setup requires a setup status'
        init_delivery_branch_setup=$2
        shift 2
        ;;
      --remote-default-evidence)
        [ "$#" -ge 2 ] || fail '--remote-default-evidence requires text'
        init_remote_default_evidence=$2
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *) fail "unknown init option: $1" ;;
    esac
  done

  [ -n "$init_state_arg" ] || fail '--state is required'
  init_state_dir=$(state_directory_for_init "$init_state_arg")
  init_state_file=$init_state_dir/run-state.yaml
  [ ! -e "$init_state_file" ] || fail "run state is already initialized: $init_state_file"
  mkdir -p "$init_state_dir"

  init_checkout_root=$(checkout_root_for_init "$init_checkout_arg")
  init_branch=$(CDPATH= cd "$init_checkout_root" && git_branch_for_init)
  init_head=$(git -C "$init_checkout_root" rev-parse HEAD 2>/dev/null) || \
    fail 'checkout has no commit baseline'
  init_base_sha=$(git -C "$init_checkout_root" rev-parse "$init_baseline_ref" 2>/dev/null) || \
    fail "baseline revision does not resolve: $init_baseline_ref"
  git -C "$init_checkout_root" merge-base --is-ancestor "$init_base_sha" "$init_head" || \
    fail "baseline revision is not an ancestor of the checkout: $init_baseline_ref"

  [ -n "$init_run_id" ] || init_run_id=$(basename "$init_state_dir")
  require_scalar_arg run_id "$init_run_id"
  require_enum_arg status "$init_status" planning running blocked reviewing repairing accepted failed
  require_enum_arg delivery_mode "$init_delivery_mode" GUIDED PR
  [ -n "$init_routing_preferred" ] || init_routing_preferred=SOLO
  [ -n "$init_routing_current" ] || init_routing_current=$init_routing_preferred
  require_enum_arg routing.preferred "$init_routing_preferred" SOLO SUBAGENTS
  require_enum_arg routing.current "$init_routing_current" SOLO SUBAGENTS
  require_scalar_arg reason "$init_reason"
  require_scalar_arg fallback_used "$init_fallback_used"
  require_enum_arg delivery_checkout.status "$init_delivery_status" ready running blocked dirty complete
  require_enum_arg delivery_checkout.branch_setup "$init_delivery_branch_setup" auto-created reused user-provided provided blocked
  control_chars "$init_remote_default_evidence"
  validate_routing "$init_routing_preferred" "$init_routing_current"

  if [ "$init_delivery_mode" = PR ]; then
    delivery_authorization=PR
    delivery_status_value=pending
  else
    delivery_authorization=not-authorized
    delivery_status_value=not-authorized
  fi

  state_tmp=$init_state_dir/run-state.yaml.tmp.$$
  umask 077
  {
    printf 'workflow: swe-forge\n'
    printf 'workflow_version: 1\n'
    printf 'schema_version: 4\n'
    printf 'run_id: %s\n' "$init_run_id"
    printf 'status: %s\n' "$init_status"
    printf 'delivery_mode: %s\n' "$init_delivery_mode"
    printf 'reason: %s\n' "$init_reason"
    printf 'fallback_used: %s\n' "$init_fallback_used"
    printf 'routing:\n'
    printf '  preferred: %s\n' "$init_routing_preferred"
    printf '  current: %s\n' "$init_routing_current"
    printf 'delivery_checkout:\n'
    printf '  path: %s\n' "$init_checkout_root"
    printf '  branch: %s\n' "$init_branch"
    printf '  base_sha: %s\n' "$init_base_sha"
    printf '  head_sha: %s\n' "$init_head"
    printf '  status: %s\n' "$init_delivery_status"
    printf '  branch_setup: %s\n' "$init_delivery_branch_setup"
    printf '  remote_default_evidence: %s\n' "$init_remote_default_evidence"
    printf 'delivery:\n'
    printf '  authorization:\n'
    printf '    commit: %s\n' "$delivery_authorization"
    printf '    push: %s\n' "$delivery_authorization"
    printf '    create_pull_request: %s\n' "$delivery_authorization"
    printf '    publish: not-authorized\n'
    printf '    deploy: not-authorized\n'
    printf '    merge: not-authorized\n'
    printf '  commit: %s\n' "$delivery_status_value"
    printf '  push: %s\n' "$delivery_status_value"
    printf '  create_pull_request: %s\n' "$delivery_status_value"
    printf '  sync: not-authorized\n'
    printf '  pull_request_ref: none\n'
    printf 'review:\n'
    printf '  status: pending\n'
    printf '  blocked_by: []\n'
    printf '  contract_ref: .swe-forge/contracts/review.md\n'
    printf 'tasks: {}\n'
  } >"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$init_state_file"
  state_tmp=
  printf 'PASS: schema-v4 run state initialized: %s\n' "$init_state_file"
}
set_review() {
  state_arg=
  review_result=
  blocked_values=
  blocked_seen=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --result) [ "$#" -ge 2 ] || fail '--result requires PASS or CHANGES_REQUIRED'; review_result=$2; shift 2 ;;
      --blocked-by)
        [ "$#" -ge 2 ] || fail '--blocked-by requires an ID'
        blocked_id=$2
        identifier_valid "$blocked_id" || fail "invalid blocked finding id: $blocked_id"
        case "$blocked_seen" in *"|$blocked_id|"*) fail "duplicate blocked finding id: $blocked_id" ;; esac
        blocked_seen="$blocked_seen|$blocked_id|"
        if [ -n "$blocked_values" ]; then blocked_values="$blocked_values$NEWLINE$blocked_id"; else blocked_values=$blocked_id; fi
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-review option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  case "$review_result" in PASS|CHANGES_REQUIRED) ;; *) fail "invalid review result: ${review_result:-<missing>}" ;; esac
  if [ "$review_result" = CHANGES_REQUIRED ] && [ -z "$blocked_values" ]; then
    fail 'CHANGES_REQUIRED review must identify at least one blocking finding'
  fi
  if [ "$review_result" = PASS ] && [ -n "$blocked_values" ]; then
    fail 'PASS review may not identify blocking findings'
  fi
  state_path=$(state_file "$state_arg")
  acquire_review_lock
  validate_state "$state_path" >/dev/null
  current_review_status=$(required_scalar review.status "$state_path")
  [ "$current_review_status" = pending ] || \
    fail "review has already been recorded: $current_review_status"
  contract_ref=$(required_scalar review.contract_ref "$state_path")
  case "$review_result" in
    PASS) review_status=pass ;;
    CHANGES_REQUIRED) review_status=changes-required ;;
  esac
  top_status=$(required_scalar status "$state_path")
  [ "$review_result" != CHANGES_REQUIRED ] || top_status=repairing
  blocked_yaml=[]
  if [ -n "$blocked_values" ]; then
    blocked_yaml="["
    blocked_first=true
    while IFS= read -r blocked_id; do
      [ -n "$blocked_id" ] || continue
      if [ "$blocked_first" = true ]; then blocked_first=false; else blocked_yaml="$blocked_yaml, "; fi
      blocked_yaml="$blocked_yaml$blocked_id"
    done <<EOF_BLOCKED
$blocked_values
EOF_BLOCKED
    blocked_yaml="$blocked_yaml]"
  fi

  state_tmp=$state_path.tmp.$$
  awk -v top_status="$top_status" '
    BEGIN { section=""; skip=0; status_count=0 }
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
      if (section == "review") { skip=1; next }
      skip=0
    }
    skip { next }
    /^status:/ {
      print "status: " top_status
      status_count++
      next
    }
    { print }
    END { if (status_count != 1) exit 1 }
  ' "$state_path" >"$state_tmp" || fail 'review update could not locate the current state status'
  {
    printf 'review:\n'
    printf '  status: %s\n' "$review_status"
    printf '  blocked_by: %s\n' "$blocked_yaml"
    printf '  contract_ref: %s\n' "$contract_ref"
  } >>"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: review recorded: %s\n' "$review_result"
}
set_review_repair() {
  state_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-review-repair option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  state_path=$(state_file "$state_arg")
  acquire_review_lock
  validate_state "$state_path" >/dev/null
  current_review_status=$(required_scalar review.status "$state_path")
  [ "$current_review_status" = changes-required ] || \
    fail "review repair requires an unresolved changes-required review: $current_review_status"
  contract_ref=$(required_scalar review.contract_ref "$state_path")
  blocked_yaml=$(required_scalar review.blocked_by "$state_path")
  case "$blocked_yaml" in
    \[*\]) ;;
    *) fail 'review repair requires a valid blocking-finding list' ;;
  esac
  blocked_values=${blocked_yaml#\[}
  blocked_values=${blocked_values%\]}
  blocked_count=$(printf '%s\n' "$blocked_values" | awk -F',' 'NF { count++ } END { print count + 0 }')
  [ "$blocked_count" -eq 1 ] || \
    fail 'review repair requires exactly one blocking finding'
  state_tmp=$state_path.tmp.$$
  awk '
    BEGIN { section=""; skip=0; status_count=0 }
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
      if (section == "review") { skip=1; next }
      skip=0
    }
    skip { next }
    /^status:/ {
      print "status: running"
      status_count++
      next
    }
    { print }
    END { if (status_count != 1) exit 1 }
  ' "$state_path" >"$state_tmp" || fail 'review repair update could not locate the current state status'
  {
    printf 'review:\n'
    printf '  status: repaired\n'
    printf '  blocked_by: %s\n' "$blocked_yaml"
    printf '  contract_ref: %s\n' "$contract_ref"
  } >>"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: review repair recorded: %s\n' "$state_path"
}

