inspection_acceptance() {
  file=$1
  awk -v maximum="$MAX_PROJECTION_LENGTH" -v maximum_items="$MAX_ACCEPTANCE_ITEMS" '
    function indentation(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      return length(value) - length(stripped)
    }
    function key_name(value, stripped) {
      stripped = value
      sub(/^[ ]*/, "", stripped)
      sub(/:.*/, "", stripped)
      return stripped
    }
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    function json_quote(value,    i, c, quote, backslash, tab, newline, carriage_return, form_feed, backspace, vertical_tab) {
      quote = sprintf("%c", 34)
      backslash = sprintf("%c", 92)
      tab = sprintf("%c", 9)
      newline = sprintf("%c", 10)
      carriage_return = sprintf("%c", 13)
      form_feed = sprintf("%c", 12)
      backspace = sprintf("%c", 8)
      vertical_tab = sprintf("%c", 11)
      result = quote
      for (i = 1; i <= length(value); i++) {
        c = substr(value, i, 1)
        if (c == quote) result = result backslash quote
        else if (c == backslash) result = result backslash backslash
        else if (c == tab) result = result backslash "t"
        else if (c == newline) result = result backslash "n"
        else if (c == carriage_return) result = result backslash "r"
        else if (c == form_feed) result = result backslash "f"
        else if (c == backspace) result = result backslash "b"
        else if (c == vertical_tab) result = result backslash "u000b"
        else result = result c
      }
      return result quote
    }
    function append_value(value) {
      value = trim(value)
      if (value == "" || count >= maximum_items) return
      if (value ~ /^".*"$/) {
        sub(/^"/, "", value)
        sub(/"$/, "", value)
      }
      value = substr(value, 1, maximum)
      if (count > 0) printf ","
      printf "%s", json_quote(value)
      count++
    }
    function append_flow(value,    i, c, quote, escaped, item, backslash, double_quote, single_quote) {
      sub(/^\[/, "", value)
      sub(/\][[:space:]]*$/, "", value)
      if (value == "") return
      backslash = sprintf("%c", 92)
      double_quote = sprintf("%c", 34)
      single_quote = sprintf("%c", 39)
      quote = ""
      escaped = 0
      item = ""
      for (i = 1; i <= length(value); i++) {
        c = substr(value, i, 1)
        if (escaped) {
          item = item c
          escaped = 0
          continue
        }
        if (quote != "" && c == backslash) {
          escaped = 1
          continue
        }
        if (quote == "" && (c == double_quote || c == single_quote)) {
          quote = c
          continue
        }
        if (quote != "" && c == quote) {
          quote = ""
          continue
        }
        if (quote == "" && c == ",") {
          append_value(item)
          item = ""
          continue
        }
        item = item c
      }
      append_value(item)
    }
    BEGIN {
      in_continuation = 0
      in_next_action = 0
      in_acceptance = 0
      count = 0
      printf "["
    }
    {
      if ($0 ~ /^[[:space:]]*(#|$)/) next
      current_indent = indentation($0)
      current_key = key_name($0)
      if (current_indent == 0) {
        in_continuation = current_key == "continuation"
        in_next_action = 0
        in_acceptance = 0
      } else if (in_continuation && current_indent == 2) {
        in_next_action = current_key == "next_action"
        in_acceptance = 0
      } else if (in_continuation && in_next_action && current_indent == 4) {
        in_acceptance = current_key == "acceptance"
        value = $0
        sub(/^[ ]*acceptance:[[:space:]]*/, "", value)
        if (in_acceptance && value ~ /^\[/) {
          append_flow(value)
          in_acceptance = 0
        }
      } else if (in_continuation && in_next_action && in_acceptance &&
          current_indent >= 6 && $0 ~ /^      - /) {
        value = $0
        sub(/^      - /, "", value)
        append_value(value)
      }
    }
    END { print "]" }
  ' "$file"
}

projection_value() {
  awk -v value="$1" -v maximum="$MAX_PROJECTION_LENGTH" 'BEGIN { print substr(value, 1, maximum) }'
}

inspect_checkout_identity() {
  if [ ! -d "$inspection_checkout" ]; then
    inspection_reason='checkout unavailable'
    return 1
  fi
  inspection_actual_root=$(git -C "$inspection_checkout" rev-parse --show-toplevel 2>/dev/null || true)
  [ -n "$inspection_actual_root" ] || return 0
  if [ "$inspection_actual_root" != "$inspection_checkout" ]; then
    inspection_reason='checkout root mismatch'
    return 1
  fi
  inspection_actual_branch=$(git -C "$inspection_checkout" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  if [ -z "$inspection_actual_branch" ]; then
    inspection_reason='checkout is detached'
    return 1
  fi
  if [ "$inspection_actual_branch" != "$inspection_checkout_branch" ]; then
    inspection_reason='checkout branch mismatch'
    return 1
  fi
  inspection_actual_head=$(git -C "$inspection_checkout" rev-parse HEAD 2>/dev/null || true)
  case "$inspection_checkout_head" in
    none|NONE|null) ;;
    *)
      if [ -n "$inspection_actual_head" ] && [ "$inspection_actual_head" != "$inspection_checkout_head" ]; then
        inspection_reason='checkout HEAD mismatch'
        return 1
      fi
      ;;
  esac
  case "$inspection_checkout_base" in
    none|NONE|null) ;;
    *)
      if ! git -C "$inspection_checkout" merge-base --is-ancestor "$inspection_checkout_base" HEAD 2>/dev/null; then
        inspection_reason='checkout baseline mismatch'
        return 1
      fi
      ;;
  esac
  return 0
}

inspect_state_data() {
  state_arg=$1
  checkout_arg=$2
  inspection_defaults
  inspection_state_file=$(state_file "$state_arg")
  inspection_state_file=$(canonical_path "$inspection_state_file")
  inspection_checkout=$(canonical_path "$checkout_arg")

  if ! "$0" validate --state "$inspection_state_file" >/dev/null 2>/dev/null; then
    return 0
  fi

  inspection_valid=true
  inspection_run_id=$(required_scalar run_id "$inspection_state_file")
  inspection_status=$(required_scalar status "$inspection_state_file")
  inspection_recorded_checkout=$(canonical_path "$(required_scalar checkout.path "$inspection_state_file")")
  inspection_preferred=$(required_scalar routing.preferred "$inspection_state_file")
  inspection_current=$(required_scalar routing.current "$inspection_state_file")
  inspection_route_reason=$(required_scalar routing.reason "$inspection_state_file")
  inspection_route_fallback=$(required_scalar routing.fallback "$inspection_state_file")
  inspection_delivery_mode=$(required_scalar delivery_mode "$inspection_state_file")
  inspection_checkout_branch=$(required_scalar checkout.branch "$inspection_state_file")
  inspection_checkout_base=$(required_scalar checkout.base_sha "$inspection_state_file")
  inspection_checkout_head=$(required_scalar checkout.head_sha "$inspection_state_file")
  inspection_workflow_active=$(required_scalar continuation.workflow_active "$inspection_state_file")
  inspection_updated_at=$(required_scalar continuation.updated_at "$inspection_state_file")
  inspection_phase=$(required_scalar continuation.phase "$inspection_state_file")
  inspection_step=$(required_scalar continuation.step "$inspection_state_file")
  inspection_awaiting=$(required_scalar continuation.awaiting "$inspection_state_file")
  inspection_next_kind=$(required_scalar continuation.next_action.kind "$inspection_state_file")
  inspection_next_target=$(required_scalar continuation.next_action.target "$inspection_state_file")
  inspection_acceptance_json=$(inspection_acceptance "$inspection_state_file")
  inspection_safe_boundary=$(required_scalar continuation.safe_boundary "$inspection_state_file")
  inspection_validation_head=$(required_scalar validation.head_sha "$inspection_state_file")
  inspection_validation_status=$(required_scalar validation.status "$inspection_state_file")
  inspection_validation_reference=$(required_scalar validation.reference "$inspection_state_file")
  inspection_review_status=$(required_scalar review.status "$inspection_state_file")
  inspection_reviewed_head=$(required_scalar review.reviewed_head "$inspection_state_file")
  inspection_review_repair_used=$(required_scalar review.repair_used "$inspection_state_file")
  inspection_delivery_status=$(required_scalar delivery.status "$inspection_state_file")
  inspection_pull_request_ref=$(required_scalar delivery.pull_request_ref "$inspection_state_file")
  inspection_pr_number=$(required_scalar delivery.pr_number "$inspection_state_file")
  inspection_pr_state=$(required_scalar delivery.pr_state "$inspection_state_file")

  if ! inspect_checkout_identity; then return 0; fi

  inspection_phase=$(projection_value "$inspection_phase")
  inspection_step=$(projection_value "$inspection_step")
  inspection_awaiting=$(projection_value "$inspection_awaiting")
  inspection_next_kind=$(projection_value "$inspection_next_kind")
  inspection_next_target=$(projection_value "$inspection_next_target")
  inspection_validation_reference=$(projection_value "$inspection_validation_reference")
  inspection_reviewed_head=$(projection_value "$inspection_reviewed_head")
  inspection_pull_request_ref=$(projection_value "$inspection_pull_request_ref")
  inspection_pr_number=$(projection_value "$inspection_pr_number")
  inspection_pr_state=$(projection_value "$inspection_pr_state")

  case "$inspection_workflow_active" in
    true) inspection_workflow_active_json=true ;;
    false) inspection_workflow_active_json=false ;;
    *) inspection_reason='invalid continuation activity marker'; return 0 ;;
  esac
  case "$inspection_safe_boundary" in
    true) inspection_safe_boundary_json=true ;;
    false) inspection_safe_boundary_json=false ;;
    *) inspection_reason='invalid continuation boundary marker'; return 0 ;;
  esac
  if [ "$inspection_workflow_active_json" != true ]; then
    inspection_reason='inactive workflow continuation'
    return 0
  fi
  if [ "$inspection_recorded_checkout" != "$inspection_checkout" ]; then
    inspection_reason='checkout mismatch'
    return 0
  fi
  if ! inspection_updated_epoch=$(timestamp_epoch "$inspection_updated_at" 2>/dev/null); then
    inspection_reason='stale or malformed continuation timestamp'
    return 0
  fi
  inspection_updated_at_ms=$((inspection_updated_epoch * 1000))
  if ! inspection_modified_epoch=$(file_mtime_seconds "$inspection_state_file" 2>/dev/null); then
    inspection_reason='state file modification time is unavailable'
    return 0
  fi
  inspection_modified_at_ms=$((inspection_modified_epoch * 1000))

  case "$inspection_status" in
    planning|running|blocked|reviewing|repairing)
      inspection_active=true ;;
    accepted|failed)
      inspection_reason='terminal or inactive run state'
      return 0 ;;
    *)
      inspection_reason='unsupported run-state status'
      return 0 ;;
  esac
  case "$inspection_status" in
    planning|running|reviewing|repairing) inspection_delegation_authorized=true ;;
    blocked) inspection_delegation_authorized=false ;;
  esac
  if [ "$inspection_delegation_authorized" = true ]; then
    inspection_reason=eligible
  else
    inspection_reason='active continuation without delegation authorization'
  fi
}

emit_state_json() {
  printf '{"schema":"swe-forge-state/v1","valid":%s,"active":%s,"delegation_authorized":%s,"reason":%s' \
    "$inspection_valid" "$inspection_active" "$inspection_delegation_authorized" \
    "$(json_quote "$inspection_reason")"
  printf ',"state_file":%s,"run_id":%s,"status":%s,"checkout":%s' \
    "$(json_quote "$inspection_state_file")" "$(json_quote "$inspection_run_id")" \
    "$(json_quote "$inspection_status")" "$(json_quote "$inspection_recorded_checkout")"
  printf ',"updated_at":%s,"updated_at_ms":%s,"modified_at_ms":%s' \
    "$(json_quote "$inspection_updated_at")" \
    "$inspection_updated_at_ms" "$inspection_modified_at_ms"
  printf ',"routing":{"preferred":%s,"current":%s,"reason":%s,"fallback":%s},"delivery_mode":%s' \
    "$(json_quote "$inspection_preferred")" "$(json_quote "$inspection_current")" \
    "$(json_quote "$inspection_route_reason")" "$(json_quote "$inspection_route_fallback")" \
    "$(json_quote "$inspection_delivery_mode")"
  printf ',"checkout_state":{"branch":%s,"base_sha":%s,"head_sha":%s}' \
    "$(json_quote "$inspection_checkout_branch")" "$(json_quote "$inspection_checkout_base")" \
    "$(json_quote "$inspection_checkout_head")"
  printf ',"validation":{"head_sha":%s,"status":%s,"reference":%s}' \
    "$(json_quote "$inspection_validation_head")" "$(json_quote "$inspection_validation_status")" \
    "$(json_quote "$inspection_validation_reference")"
  printf ',"review":{"status":%s,"reviewed_head":%s,"repair_used":%s}' \
    "$(json_quote "$inspection_review_status")" "$(json_quote "$inspection_reviewed_head")" \
    "$([ "$inspection_review_repair_used" = true ] && printf true || printf false)"
  printf ',"continuation":{"workflow_active":%s,"phase":%s,"step":%s,"awaiting":%s' \
    "$inspection_workflow_active_json" "$(json_quote "$inspection_phase")" \
    "$(json_quote "$inspection_step")" "$(json_quote "$inspection_awaiting")"
  printf ',"next_action":{"kind":%s,"target":%s,"acceptance":%s},"safe_boundary":%s}' \
    "$(json_quote "$inspection_next_kind")" "$(json_quote "$inspection_next_target")" \
    "$inspection_acceptance_json" "$inspection_safe_boundary_json"
  printf ',"delivery":{"status":%s,"pull_request_ref":%s,"pr_number":%s,"pr_state":%s}}\n' \
    "$(json_quote "$inspection_delivery_status")" "$(json_quote "$inspection_pull_request_ref")" \
    "$(json_quote "$inspection_pr_number")" "$(json_quote "$inspection_pr_state")"
}

inspect_command() {
  inspect_state_arg=
  inspect_checkout_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; inspect_state_arg=$2; shift 2 ;;
      --checkout) [ "$#" -ge 2 ] || fail '--checkout requires a path'; inspect_checkout_arg=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown inspect option: $1" ;;
    esac
  done
  [ -n "$inspect_state_arg" ] || fail 'inspect requires --state'
  [ -n "$inspect_checkout_arg" ] || fail 'inspect requires --checkout'
  inspect_state_data "$inspect_state_arg" "$inspect_checkout_arg"
  emit_state_json
}

resolve_active_command() {
  resolve_checkout_arg=
  resolve_all=false
  resolve_candidates=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --checkout) [ "$#" -ge 2 ] || fail '--checkout requires a path'; resolve_checkout_arg=$2; shift 2 ;;
      --candidate)
        [ "$#" -ge 2 ] || fail '--candidate requires a file or directory'
        control_chars "$2"
        if [ -z "$resolve_candidates" ]; then resolve_candidates=$2; else resolve_candidates="$resolve_candidates$NEWLINE$2"; fi
        shift 2
        ;;
      --all) resolve_all=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown resolve-active option: $1" ;;
    esac
  done
  [ -n "$resolve_checkout_arg" ] || fail 'resolve-active requires --checkout'
  resolve_checkout=$(canonical_path "$resolve_checkout_arg")
  inspect_tmp=$(mktemp -d "${TMPDIR:-/tmp}/swe-forge-state.XXXXXX")
  candidate_file=$inspect_tmp/candidates
  records_file=$inspect_tmp/records
  seen_file=$inspect_tmp/seen
  duplicate_ids=$inspect_tmp/duplicate-ids
  sorted_file=$inspect_tmp/sorted
  : >"$candidate_file"
  : >"$records_file"
  : >"$seen_file"
  : >"$duplicate_ids"
  if [ -n "$resolve_candidates" ]; then printf '%s\n' "$resolve_candidates" >"$candidate_file"; fi

  index=0
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    [ -e "$candidate" ] || continue
    inspect_state_data "$candidate" "$resolve_checkout"
    [ "$inspection_active" = true ] || continue
    if awk -v value="$inspection_state_file" '$0 == value { found = 1 } END { exit(found ? 0 : 1) }' "$seen_file"; then
      continue
    fi
    printf '%s\n' "$inspection_state_file" >>"$seen_file"
    index=$((index + 1))
    json_file=$inspect_tmp/state.$index.json
    emit_state_json >"$json_file"
    printf '%s\t%s\t%s\t%s\t%s\n' "$inspection_state_file" "$inspection_updated_epoch" \
      "$inspection_modified_epoch" "$inspection_run_id" "$json_file" >>"$records_file"
  done <"$candidate_file"

  LC_ALL=C sort -t "$TAB" -k2,2nr -k3,3nr -k1,1 "$records_file" >"$sorted_file"
  awk -F "$TAB" '{ count[$4]++ } END { for (id in count) if (count[id] > 1) print id }' \
    "$records_file" | LC_ALL=C sort -u >"$duplicate_ids"
  printf '{"schema":"swe-forge-state/v1","checkout":%s,"states":[' "$(json_quote "$resolve_checkout")"
  selected=0
  while IFS="$TAB" read -r _state _updated _modified run_id json_file; do
    [ -n "$json_file" ] || continue
    if awk -v id="$run_id" '$0 == id { found = 1 } END { exit(found ? 0 : 1) }' "$duplicate_ids"; then
      continue
    fi
    if [ "$resolve_all" != true ] && [ "$selected" -gt 0 ]; then break; fi
    [ "$selected" -eq 0 ] || printf ','
    cat "$json_file"
    selected=$((selected + 1))
  done <"$sorted_file"
  printf ']}\n'
}

checkout_root_for_init() {
  candidate=$1
  [ -d "$candidate" ] || fail "checkout does not exist: $candidate"
  root=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || \
    fail "not a Git checkout: $candidate"
  CDPATH= cd "$root" && pwd -P
}

git_branch_for_init() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null || printf '%s\n' none
}

state_directory_for_init() {
  candidate=$(absolute_path "$1")
  if [ -e "$candidate" ] || [ -L "$candidate" ]; then
    [ -d "$candidate" ] && [ ! -L "$candidate" ] || \
      fail "state path must be a real directory: $candidate"
    CDPATH= cd "$candidate" && pwd -P
    return
  fi
  parent=$(dirname "$candidate")
  [ -d "$parent" ] && [ ! -L "$parent" ] || \
    fail "state parent is not a real directory: $parent"
  CDPATH= cd "$parent" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$candidate")"
}

absolute_path() {
  value=$1
  control_chars "$value"
  case "$value" in
    /*) printf '%s\n' "$value" ;;
    *) printf '%s/%s\n' "$PWD" "$value" ;;
  esac
}

state_tmp=
inspect_tmp=
state_lock=
cleanup_state_tmp() {
  [ -z "${state_tmp:-}" ] || rm -f "$state_tmp"
}
cleanup_inspect_tmp() {
  [ -z "${inspect_tmp:-}" ] || rm -rf "$inspect_tmp"
}
cleanup_state_lock() {
  if [ -n "${state_lock:-}" ]; then
    rm -f "$state_lock/pid"
    rmdir "$state_lock" 2>/dev/null || true
  fi
}
acquire_state_lock() {
  lock_path=$(dirname "$state_path")/.run-state.lock
  mkdir "$lock_path" 2>/dev/null || \
    fail 'run state is being mutated by another activity; retry after it finishes'
  state_lock=$lock_path
  printf '%s\n' "$$" >"$state_lock/pid"
}

trap 'status=$?; cleanup_state_tmp; cleanup_inspect_tmp; cleanup_state_lock; exit "$status"' 0 HUP INT TERM

init_state() {
  init_state_arg=
  init_checkout_arg=.
  init_run_id=
  init_baseline_ref=HEAD
  init_status=running
  init_delivery_mode=PR
  init_reason='initial routing decision'
  init_fallback=no
  init_routing_preferred=
  init_routing_current=

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a directory'; init_state_arg=$2; shift 2 ;;
      --checkout) [ "$#" -ge 2 ] || fail '--checkout requires a path'; init_checkout_arg=$2; shift 2 ;;
      --run-id) [ "$#" -ge 2 ] || fail '--run-id requires an ID'; init_run_id=$2; shift 2 ;;
      --baseline-ref|--base|--base-sha) [ "$#" -ge 2 ] || fail "$1 requires a Git revision"; init_baseline_ref=$2; shift 2 ;;
      --status) [ "$#" -ge 2 ] || fail '--status requires a lifecycle status'; init_status=$2; shift 2 ;;
      --delivery-mode) [ "$#" -ge 2 ] || fail '--delivery-mode requires GUIDED or PR'; init_delivery_mode=$2; shift 2 ;;
      --reason) [ "$#" -ge 2 ] || fail '--reason requires text'; init_reason=$2; shift 2 ;;
      --fallback-used) [ "$#" -ge 2 ] || fail '--fallback-used requires text'; init_fallback=$2; shift 2 ;;
      --routing-preferred) [ "$#" -ge 2 ] || fail '--routing-preferred requires a topology'; init_routing_preferred=$2; shift 2 ;;
      --routing-current) [ "$#" -ge 2 ] || fail '--routing-current requires a topology'; init_routing_current=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown init option: $1" ;;
    esac
  done

  [ -n "$init_state_arg" ] || fail '--state is required'
  init_state_dir=$(state_directory_for_init "$init_state_arg")
  mkdir -p "$init_state_dir"
  state_path=$init_state_dir/run-state.yaml
  acquire_state_lock
  [ ! -e "$state_path" ] || fail "run state is already initialized: $state_path"
  for obsolete in meta.env review.env run-state.valid validations.tsv; do
    [ ! -e "$init_state_dir/$obsolete" ] || \
      fail "state contains obsolete persisted data: $obsolete; start with a fresh state directory"
  done

  init_checkout_root=$(checkout_root_for_init "$init_checkout_arg")
  init_branch=$(CDPATH= cd "$init_checkout_root" && git_branch_for_init)
  [ "$init_branch" != none ] || fail 'checkout is detached'
  init_head=$(git -C "$init_checkout_root" rev-parse HEAD 2>/dev/null) || \
    fail 'checkout has no commit baseline'
  init_base_sha=$(git -C "$init_checkout_root" rev-parse "$init_baseline_ref" 2>/dev/null) || \
    fail "baseline revision does not resolve: $init_baseline_ref"
  git -C "$init_checkout_root" merge-base --is-ancestor "$init_base_sha" "$init_head" || \
    fail "baseline revision is not an ancestor of the checkout: $init_baseline_ref"

  [ -n "$init_run_id" ] || init_run_id=$(basename "$init_state_dir")
  require_scalar_arg run_id "$init_run_id"
  require_enum_arg status "$init_status" planning running blocked reviewing repairing accepted failed
  require_enum_arg delivery_mode "$init_delivery_mode" GUIDED PR
  [ -n "$init_routing_preferred" ] || init_routing_preferred=SOLO
  [ -n "$init_routing_current" ] || init_routing_current=$init_routing_preferred
  require_enum_arg routing.preferred "$init_routing_preferred" SOLO SUBAGENTS
  require_enum_arg routing.current "$init_routing_current" SOLO SUBAGENTS
  require_scalar_arg routing.reason "$init_reason"
  require_scalar_arg routing.fallback "$init_fallback"
  validate_routing "$init_routing_preferred" "$init_routing_current"

  if [ "$init_delivery_mode" = PR ]; then
    delivery_status=pending
  else
    delivery_status=not-applicable
  fi
  if [ "$init_routing_current" = SUBAGENTS ]; then
    include_tasks=true
  else
    include_tasks=false
  fi

  state_tmp=$state_path.tmp.$$
  umask 077
  {
    printf 'workflow: swe-forge\n'
    printf 'workflow_version: 1\n'
    printf 'schema_version: 5\n'
    printf 'run_id: %s\n' "$init_run_id"
    printf 'status: %s\n' "$init_status"
    printf 'delivery_mode: %s\n' "$init_delivery_mode"
    printf 'routing:\n'
    printf '  preferred: %s\n' "$init_routing_preferred"
    printf '  current: %s\n' "$init_routing_current"
    printf '  reason: %s\n' "$init_reason"
    printf '  fallback: %s\n' "$init_fallback"
    printf 'checkout:\n'
    printf '  path: %s\n' "$init_checkout_root"
    printf '  branch: %s\n' "$init_branch"
    printf '  base_sha: %s\n' "$init_base_sha"
    printf '  head_sha: %s\n' "$init_head"
    printf 'continuation:\n'
    printf '  workflow_active: true\n'
    printf '  workflow: ticket\n'
    printf '  phase: planning\n'
    printf '  step: 0\n'
    printf '  awaiting: none\n'
    printf '  next_action:\n'
    printf '    kind: specify\n'
    printf '    target: working-spec\n'
    printf '    acceptance: []\n'
    printf '  safe_boundary: true\n'
    printf '  updated_at: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'validation:\n'
    printf '  head_sha: none\n'
    printf '  status: pending\n'
    printf '  reference: validations.tsv\n'
    printf 'review:\n'
    printf '  status: pending\n'
    printf '  reviewed_head: none\n'
    printf '  repair_used: false\n'
    printf '  blocked_by: []\n'
    printf 'delivery:\n'
    printf '  status: %s\n' "$delivery_status"
    printf '  pull_request_ref: none\n'
    printf '  pr_number: none\n'
    printf '  pr_state: none\n'
    if [ "$include_tasks" = true ]; then printf 'tasks: {}\n'; fi
  } >"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: schema-v5 run state initialized: %s\n' "$state_path"
}

set_routing() {
  state_arg=
  preferred_arg=
  current_arg=
  reason_arg=
  fallback_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --preferred) [ "$#" -ge 2 ] || fail '--preferred requires a topology'; preferred_arg=$2; shift 2 ;;
      --current) [ "$#" -ge 2 ] || fail '--current requires a topology'; current_arg=$2; shift 2 ;;
      --reason) [ "$#" -ge 2 ] || fail '--reason requires text'; reason_arg=$2; shift 2 ;;
      --fallback-used) [ "$#" -ge 2 ] || fail '--fallback-used requires text'; fallback_arg=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-routing option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$preferred_arg" ] || fail '--preferred is required'
  [ -n "$current_arg" ] || fail '--current is required'
  [ -n "$reason_arg" ] || fail '--reason is required'
  [ -n "$fallback_arg" ] || fail '--fallback-used is required'
  state_path=$(state_file "$state_arg")
  acquire_state_lock
  validate_state "$state_path" >/dev/null
  require_enum_arg routing.preferred "$preferred_arg" SOLO SUBAGENTS
  require_enum_arg routing.current "$current_arg" SOLO SUBAGENTS
  require_scalar_arg routing.reason "$reason_arg"
  require_scalar_arg routing.fallback "$fallback_arg"

  state_tmp=$state_path.tmp.$$
  awk -v preferred="$preferred_arg" -v current="$current_arg" \
    -v reason="$reason_arg" -v fallback="$fallback_arg" '
    BEGIN { section="" }
    /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }
    section == "routing" && $0 ~ /^  preferred:/ { print "  preferred: " preferred; preferred_count++; next }
    section == "routing" && $0 ~ /^  current:/ { print "  current: " current; current_count++; next }
    section == "routing" && $0 ~ /^  reason:/ { print "  reason: " reason; reason_count++; next }
    section == "routing" && $0 ~ /^  fallback:/ { print "  fallback: " fallback; fallback_count++; next }
    { print }
    END {
      if (preferred_count != 1 || current_count != 1 || reason_count != 1 || fallback_count != 1) exit 1
    }
  ' "$state_path" >"$state_tmp" || fail 'routing update could not locate the current state fields'
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: routing updated: %s\n' "$state_path"
}

set_continuation() {
  state_arg=
  workflow_active=
  workflow=
  phase=
  step=
  awaiting=
  next_kind=
  next_target=
  acceptance=
  safe_boundary=
  pr_number_supplied=false
  pr_state_supplied=false
  pr_number=
  pr_state=

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --workflow-active) [ "$#" -ge 2 ] || fail '--workflow-active requires true or false'; workflow_active=$2; shift 2 ;;
      --workflow) [ "$#" -ge 2 ] || fail '--workflow requires a workflow name'; workflow=$2; shift 2 ;;
      --phase) [ "$#" -ge 2 ] || fail '--phase requires a phase'; phase=$2; shift 2 ;;
      --step) [ "$#" -ge 2 ] || fail '--step requires a step'; step=$2; shift 2 ;;
      --awaiting) [ "$#" -ge 2 ] || fail '--awaiting requires a value'; awaiting=$2; shift 2 ;;
      --next-action-kind) [ "$#" -ge 2 ] || fail '--next-action-kind requires a kind'; next_kind=$2; shift 2 ;;
      --next-action-target) [ "$#" -ge 2 ] || fail '--next-action-target requires a target'; next_target=$2; shift 2 ;;
      --next-action-acceptance|--acceptance)
        [ "$#" -ge 2 ] || fail "$1 requires a check"
        control_chars "$2"
        if [ -n "$acceptance" ]; then acceptance="$acceptance$NEWLINE$2"; else acceptance=$2; fi
        shift 2
        ;;
      --safe-boundary) [ "$#" -ge 2 ] || fail '--safe-boundary requires true or false'; safe_boundary=$2; shift 2 ;;
      --pr-number) [ "$#" -ge 2 ] || fail '--pr-number requires a number or none'; pr_number=$2; pr_number_supplied=true; shift 2 ;;
      --pr-state) [ "$#" -ge 2 ] || fail '--pr-state requires a state or none'; pr_state=$2; pr_state_supplied=true; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-continuation option: $1" ;;
    esac
  done

  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$workflow_active" ] || fail '--workflow-active is required'
  [ -n "$workflow" ] || fail '--workflow is required'
  [ -n "$phase" ] || fail '--phase is required'
  [ -n "$step" ] || fail '--step is required'
  [ -n "$awaiting" ] || fail '--awaiting is required'
  [ -n "$next_kind" ] || fail '--next-action-kind is required'
  [ -n "$next_target" ] || fail '--next-action-target is required'
  [ -n "$safe_boundary" ] || fail '--safe-boundary is required'
  for value in "$workflow" "$phase" "$step" "$awaiting" "$next_kind" "$next_target"; do control_chars "$value"; done
  state_path=$(state_file "$state_arg")
  acquire_state_lock
  validate_state "$state_path" >/dev/null
  require_bool_arg continuation.workflow_active "$workflow_active"
  require_enum_arg continuation.workflow "$workflow" ticket delivery other
  require_enum_arg continuation.phase "$phase" planning discovery implementation review delivery awaiting_merge recovery complete
  case "$step" in none|*[!0-9]*) [ "$step" = none ] || fail 'invalid continuation.step' ;; esac
  require_enum_arg continuation.awaiting "$awaiting" none user_merge user_decision recovery
  require_enum_arg continuation.next_action.kind "$next_kind" specify discover implement validate review verify_and_sync_merge recover none
  require_bool_arg continuation.safe_boundary "$safe_boundary"
  [ "$pr_number_supplied" = true ] || pr_number=$(required_scalar delivery.pr_number "$state_path")
  [ "$pr_state_supplied" = true ] || pr_state=$(required_scalar delivery.pr_state "$state_path")
  case "$pr_number" in none|*[!0-9]*) [ "$pr_number" = none ] || fail 'invalid delivery.pr_number' ;; esac
  require_enum_arg delivery.pr_state "$pr_state" DRAFT OPEN MERGED CLOSED none

  state_tmp=$state_path.tmp.$$
  awk '
    BEGIN { skip=0 }
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
      if (section == "continuation") { skip=1; next }
      skip=0
    }
    skip { next }
    { print }
  ' "$state_path" >"$state_tmp"
  {
    printf 'continuation:\n'
    printf '  workflow_active: %s\n' "$workflow_active"
    printf '  workflow: %s\n' "$workflow"
    printf '  phase: %s\n' "$phase"
    printf '  step: %s\n' "$step"
    printf '  awaiting: %s\n' "$awaiting"
    printf '  next_action:\n'
    printf '    kind: %s\n' "$next_kind"
    printf '    target: %s\n' "$next_target"
    if [ -n "$acceptance" ]; then
      printf '    acceptance:\n'
      printf '%s\n' "$acceptance" | while IFS= read -r check; do [ -n "$check" ] || continue; printf '      - %s\n' "$check"; done
    else
      printf '    acceptance: []\n'
    fi
    printf '  safe_boundary: %s\n' "$safe_boundary"
    printf '  updated_at: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >>"$state_tmp"
  # Continuation owns the PR's compact external-state projection when callers
  # provide it; keep it in delivery rather than duplicating delivery_mode.
  if [ "$pr_number_supplied" = true ] || [ "$pr_state_supplied" = true ]; then
    delivery_tmp=$state_path.delivery.$$
    awk -v pr_number="$pr_number" -v pr_state="$pr_state" '
      BEGIN { section="" }
      /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }
      section == "delivery" && $0 ~ /^  pr_number:/ { print "  pr_number: " pr_number; number_count++; next }
      section == "delivery" && $0 ~ /^  pr_state:/ { print "  pr_state: " pr_state; state_count++; next }
      { print }
      END { if (number_count != 1 || state_count != 1) exit 1 }
    ' "$state_tmp" >"$delivery_tmp" || { rm -f "$delivery_tmp"; fail 'continuation update could not locate delivery PR state'; }
    mv "$delivery_tmp" "$state_tmp"
  fi
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: continuation updated: %s\n' "$state_path"
}

