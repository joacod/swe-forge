#!/bin/sh

# Dependency-free validator and bounded mutation owner for the current SWE Forge
# run-state schema. Obsolete and unknown schemas are stale; this helper never
# migrates them.

set -eu

PROGRAM=${0##*/}
TAB=$(printf '\t')
NEWLINE='
'

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  swe-forge-state validate --state FILE|DIRECTORY
  swe-forge-state init --state DIRECTORY [--checkout PATH] [options]
  swe-forge-state set-continuation --state FILE|DIRECTORY [options]
  swe-forge-state set-delivery-checkout --state FILE|DIRECTORY \
    --head-sha SHA --checkpoint-sha SHA
  swe-forge-state set-delivery-checkout --state FILE|DIRECTORY \
    --path PATH --branch BRANCH --base-sha SHA \
    --head-sha SHA --checkpoint-sha SHA
  swe-forge-state set-receipt-ref --state FILE|DIRECTORY --receipt-ref REF

`init` creates the current schema-v4 structural shell from explicit routing,
delivery, checkout, and normalized invocation facts. Pass the parser's
requested_mode, requested_delivery, and delivery_mode values unchanged.
`set-continuation` accepts only the bounded continuation surface; it generates
updated_at and derives the delivery projection. `set-delivery-checkout` and
`set-receipt-ref` own their purpose-specific updates. All write operations
validate a temporary result before atomic replacement. Obsolete or unknown
state must be replaced by starting a fresh run.
EOF
}

control_chars() {
  case "$1" in
    *"$TAB"*|*"$NEWLINE"*)
      fail 'state values may not contain tabs or newlines' ;;
  esac
}

state_file() {
  value=$1
  control_chars "$value"
  if [ -d "$value" ] && [ ! -L "$value" ]; then
    value=$value/run-state.yaml
  fi
  [ -f "$value" ] || fail "run-state file does not exist: $value"
  printf '%s\n' "$value"
}

top_level() {
  key=$1
  file=$2
  awk -v wanted="$key" '
    $0 ~ "^" wanted ":([[:space:]]|$)" { count++ }
    END { if (count == 1) exit 0; exit 1 }
  ' "$file"
}

nested_key() {
  section=$1
  key=$2
  file=$3
  scalar_value "$section.$key" "$file" >/dev/null
}

value_for() {
  key=$1
  file=$2
  awk -v wanted="$key" '$1 == wanted ":" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$file"
}

scalar_value() {
  path=$1
  file=$2
  awk -v wanted="$path" '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ || /^[[:space:]]*-/ { next }
    {
      leading=$0
      sub(/[^ ]+.*/, "", leading)
      indent=length(leading)
      line=$0
      sub(/^[ ]*/, "", line)
      if (line !~ /^[A-Za-z0-9_-]+:/) next
      key=line
      sub(/:.*/, "", key)
      raw=line
      sub(/^[^:]*:[[:space:]]*/, "", raw)
      sub(/[[:space:]]+#.*$/, "", raw)
      sub(/[[:space:]]+$/, "", raw)
      while (depth > 0 && indents[depth] >= indent) depth--
      depth++
      keys[depth]=key
      indents[depth]=indent
      current=keys[1]
      for (i=2; i<=depth; i++) current=current "." keys[i]
      if (current == wanted) {
        print raw
        found=1
        exit
      }
      if (raw != "") depth--
    }
    END { if (found) exit 0; exit 1 }
  ' "$file"
}

required_scalar() {
  field=$1
  file=$2
  scalar_value "$field" "$file" || fail "current schema is missing $field"
}

validate_enum() {
  field=$1
  file=$2
  shift 2
  value=$(required_scalar "$field" "$file")
  for allowed do
    [ "$value" = "$allowed" ] && return 0
  done
  fail "invalid $field"
}

require_enum_arg() {
  field=$1
  candidate=$2
  shift 2
  for allowed do
    [ "$candidate" = "$allowed" ] && return 0
  done
  fail "invalid $field"
}

require_bool_arg() {
  field=$1
  candidate=$2
  case "$candidate" in
    true|false) ;;
    *) fail "invalid $field" ;;
  esac
}

require_scalar_arg() {
  field=$1
  candidate=$2
  [ -n "$candidate" ] || fail "$field is required"
  control_chars "$candidate"
}

absolute_path() {
  candidate=$1
  control_chars "$candidate"
  case "$candidate" in
    /*) printf '%s\n' "$candidate" ;;
    *) printf '%s/%s\n' "$PWD" "$candidate" ;;
  esac
}

validate_sha_field() {
  field=$1
  value=$2
  case "$value" in
    ''|*[!0123456789abcdefABCDEF]*) fail "$field is not a hexadecimal SHA" ;;
  esac
  [ "${#value}" -eq 40 ] || fail "$field must contain a full 40-character SHA"
}

validate_delivery_projection() {
  file=$1
  projection=$(required_scalar continuation.delivery.mode "$file")
  canonical=$(required_scalar delivery_mode "$file")
  [ "$projection" = "$canonical" ] || fail 'continuation.delivery.mode must match delivery_mode'
}

validate_routing() {
  requested=$1
  initial=$2
  current=$3
  requested_delivery=$4
  delivery_mode=$5

  if [ "$requested" != AUTO ] && [ "$initial" != "$requested" ]; then
    fail "routing.initial must match explicit requested_mode: $requested"
  fi
  case "$requested_delivery" in
    DEFAULT|GUIDED) expected_delivery=GUIDED ;;
    PR) expected_delivery=PR ;;
    *) fail 'invalid requested_delivery' ;;
  esac
  [ "$delivery_mode" = "$expected_delivery" ] || \
    fail "delivery_mode must match requested_delivery: $requested_delivery requires $expected_delivery"
  case "$current" in
    SOLO|SUBAGENTS) ;;
    *) fail "invalid routing.current: $current" ;;
  esac
}

validate_state() {
  file=$(state_file "$1")
  schema=$(value_for schema_version "$file" || true)
  [ "$schema" = 4 ] || \
    fail 'stale/unsupported run state: only schema_version: 4 is supported; start a fresh run'

  for key in workflow workflow_version schema_version run_id status requested_mode \
    requested_delivery delivery_mode reason fallback_used routing delivery_checkout \
    runtime_profile delivery receipt_ref tasks; do
    top_level "$key" "$file" || fail "schema-v4 state is missing top-level key: $key"
  done

  [ "$(value_for workflow "$file")" = swe-forge ] || fail 'workflow must be swe-forge'
  [ "$(value_for workflow_version "$file")" = 1 ] || fail 'workflow_version must be 1'
  validate_enum status "$file" planning running blocked reviewing repairing accepted failed
  validate_enum requested_mode "$file" AUTO SOLO SUBAGENTS
  validate_enum requested_delivery "$file" DEFAULT GUIDED PR
  validate_enum delivery_mode "$file" GUIDED PR

  for field in initial preferred selected current; do
    nested_key routing "$field" "$file" || fail "routing is missing $field"
    validate_enum "routing.$field" "$file" SOLO SUBAGENTS
  done
  for field in projected_pressure context_reducibility delegatable_context \
    root_context_requirement continuity_risk; do
    nested_key routing.context_value "$field" "$file" || \
      fail "routing.context_value is missing $field"
    validate_enum "routing.context_value.$field" "$file" low medium high unknown
  done
  required_scalar routing.context_value.rationale "$file" >/dev/null
  required_scalar routing.runtime_profile_ref "$file" >/dev/null

  validate_routing \
    "$(required_scalar requested_mode "$file")" \
    "$(required_scalar routing.initial "$file")" \
    "$(required_scalar routing.current "$file")" \
    "$(required_scalar requested_delivery "$file")" \
    "$(required_scalar delivery_mode "$file")"

  for field in harness context_usage context_window proactive_compaction \
    compaction_hooks state_reinjection capability_precedence; do
    nested_key runtime_profile "$field" "$file" || \
      fail "runtime_profile is missing $field"
  done
  validate_enum runtime_profile.context_usage "$file" available estimated unavailable unknown
  validate_enum runtime_profile.context_window "$file" reported configured unknown
  validate_enum runtime_profile.proactive_compaction "$file" available unavailable unknown
  validate_enum runtime_profile.compaction_hooks "$file" available unavailable unknown
  validate_enum runtime_profile.state_reinjection "$file" available unavailable unknown
  validate_enum runtime_profile.subagents.native "$file" available unavailable unknown

  for field in path branch base_sha head_sha checkpoint_sha status branch_setup \
    remote_default_evidence; do
    nested_key delivery_checkout "$field" "$file" || \
      fail "delivery_checkout is missing $field"
  done
  for field in commit push create_pull_request sync pull_request_ref; do
    nested_key delivery "$field" "$file" || fail "delivery is missing $field"
  done
  for action in commit push create_pull_request publish deploy merge; do
    scalar_value "delivery.authorization.$action" "$file" >/dev/null || \
      fail "delivery.authorization is missing $action"
  done
  validate_enum delivery.authorization.commit "$file" not-authorized go PR
  validate_enum delivery.authorization.push "$file" not-authorized PR
  validate_enum delivery.authorization.create_pull_request "$file" not-authorized PR
  validate_enum delivery.authorization.publish "$file" not-authorized
  validate_enum delivery.authorization.deploy "$file" not-authorized
  validate_enum delivery.authorization.merge "$file" not-authorized
  validate_enum delivery.commit "$file" not-authorized pending complete blocked
  validate_enum delivery.push "$file" not-authorized pending complete blocked
  validate_enum delivery.create_pull_request "$file" not-authorized pending complete blocked
  validate_enum delivery.sync "$file" not-authorized pending complete blocked

  classification=$(required_scalar delivery_checkout.status "$file")
  case "$classification" in ready|running|blocked|dirty|complete) ;;
    *) fail 'invalid delivery_checkout.status' ;;
  esac
  validate_enum delivery_checkout.branch_setup "$file" auto-created reused user-provided provided blocked
  for field in delivery_checkout.base_sha delivery_checkout.head_sha delivery_checkout.checkpoint_sha; do
    value=$(required_scalar "$field" "$file")
    case "$value" in
      none|NONE|null) ;;
      *) validate_sha_field "$field" "$value" ;;
    esac
  done

  if top_level continuation "$file" 2>/dev/null; then
    for key in workflow_active workflow phase step awaiting safe_boundary updated_at; do
      nested_key continuation "$key" "$file" || fail "continuation is missing $key"
    done
    validate_enum continuation.workflow_active "$file" true false
    validate_enum continuation.workflow "$file" ticket delivery other
    validate_enum continuation.phase "$file" planning discovery implementation review delivery awaiting_merge recovery complete
    validate_enum continuation.awaiting "$file" none user_merge user_decision recovery
    validate_enum continuation.safe_boundary "$file" true false
    required_scalar continuation.updated_at "$file" >/dev/null
    required_scalar continuation.delivery.mode "$file" >/dev/null
    validate_enum continuation.delivery.mode "$file" GUIDED PR
    validate_delivery_projection "$file"
  fi

  printf 'PASS: schema-v4 run state is structurally valid: %s\n' "$file"
}

checkout_root_for_init() {
  candidate=$1
  [ -d "$candidate" ] || fail "checkout does not exist: $candidate"
  root=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || \
    fail "not a Git checkout: $candidate"
  CDPATH= cd "$root" && pwd -P
}

git_branch_for_init() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null || printf '%s\n' none
}

state_directory_for_init() {
  candidate=$(absolute_path "$1")
  if [ -e "$candidate" ] || [ -L "$candidate" ]; then
    [ -d "$candidate" ] && [ ! -L "$candidate" ] || \
      fail "state path must be a real directory: $candidate"
    CDPATH= cd "$candidate" && pwd -P
    return
  fi
  parent=$(dirname "$candidate")
  [ -d "$parent" ] && [ ! -L "$parent" ] || \
    fail "state parent is not a real directory: $parent"
  CDPATH= cd "$parent" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$candidate")"
}

state_tmp=
cleanup_state_tmp() {
  [ -z "${state_tmp:-}" ] || rm -f "$state_tmp"
}
trap 'status=$?; cleanup_state_tmp; exit "$status"' 0 HUP INT TERM

init_state() {
  init_state_arg=
  init_checkout_arg=.
  init_run_id=
  init_baseline_ref=HEAD
  init_status=running
  init_requested_mode=AUTO
  init_requested_delivery=DEFAULT
  init_delivery_mode=
  init_reason='initial schema-v4 state'
  init_fallback_used=no
  init_routing_initial=
  init_routing_preferred=
  init_routing_selected=
  init_routing_current=
  init_delivery_status=ready
  init_delivery_branch_setup=reused
  init_remote_default_evidence=none
  init_runtime_harness=unknown
  init_runtime_context_usage=unknown
  init_runtime_context_window=unknown
  init_runtime_proactive_compaction=unknown
  init_runtime_compaction_hooks=unknown
  init_runtime_state_reinjection=unknown
  init_runtime_subagents=unknown

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail '--state requires a directory'
        init_state_arg=$2
        shift 2
        ;;
      --checkout)
        [ "$#" -ge 2 ] || fail '--checkout requires a path'
        init_checkout_arg=$2
        shift 2
        ;;
      --run-id)
        [ "$#" -ge 2 ] || fail '--run-id requires an ID'
        init_run_id=$2
        shift 2
        ;;
      --baseline-ref|--base|--base-sha)
        [ "$#" -ge 2 ] || fail "$1 requires a Git revision"
        init_baseline_ref=$2
        shift 2
        ;;
      --status)
        [ "$#" -ge 2 ] || fail '--status requires a lifecycle status'
        init_status=$2
        shift 2
        ;;
      --requested-mode)
        [ "$#" -ge 2 ] || fail '--requested-mode requires a topology'
        init_requested_mode=$2
        shift 2
        ;;
      --requested-delivery)
        [ "$#" -ge 2 ] || fail '--requested-delivery requires DEFAULT, GUIDED, or PR'
        init_requested_delivery=$2
        shift 2
        ;;
      --delivery-mode)
        [ "$#" -ge 2 ] || fail '--delivery-mode requires GUIDED or PR'
        init_delivery_mode=$2
        shift 2
        ;;
      --reason)
        [ "$#" -ge 2 ] || fail '--reason requires text'
        init_reason=$2
        shift 2
        ;;
      --fallback-used)
        [ "$#" -ge 2 ] || fail '--fallback-used requires text'
        init_fallback_used=$2
        shift 2
        ;;
      --routing-initial)
        [ "$#" -ge 2 ] || fail '--routing-initial requires a topology'
        init_routing_initial=$2
        shift 2
        ;;
      --routing-preferred)
        [ "$#" -ge 2 ] || fail '--routing-preferred requires a topology'
        init_routing_preferred=$2
        shift 2
        ;;
      --routing-selected)
        [ "$#" -ge 2 ] || fail '--routing-selected requires a topology'
        init_routing_selected=$2
        shift 2
        ;;
      --routing-current)
        [ "$#" -ge 2 ] || fail '--routing-current requires a topology'
        init_routing_current=$2
        shift 2
        ;;
      --delivery-status)
        [ "$#" -ge 2 ] || fail '--delivery-status requires a checkout status'
        init_delivery_status=$2
        shift 2
        ;;
      --delivery-branch-setup)
        [ "$#" -ge 2 ] || fail '--delivery-branch-setup requires a setup status'
        init_delivery_branch_setup=$2
        shift 2
        ;;
      --remote-default-evidence)
        [ "$#" -ge 2 ] || fail '--remote-default-evidence requires text'
        init_remote_default_evidence=$2
        shift 2
        ;;
      --runtime-harness)
        [ "$#" -ge 2 ] || fail '--runtime-harness requires a value'
        init_runtime_harness=$2
        shift 2
        ;;
      --context-usage)
        [ "$#" -ge 2 ] || fail '--context-usage requires a value'
        init_runtime_context_usage=$2
        shift 2
        ;;
      --context-window)
        [ "$#" -ge 2 ] || fail '--context-window requires a value'
        init_runtime_context_window=$2
        shift 2
        ;;
      --proactive-compaction)
        [ "$#" -ge 2 ] || fail '--proactive-compaction requires a value'
        init_runtime_proactive_compaction=$2
        shift 2
        ;;
      --compaction-hooks)
        [ "$#" -ge 2 ] || fail '--compaction-hooks requires a value'
        init_runtime_compaction_hooks=$2
        shift 2
        ;;
      --state-reinjection)
        [ "$#" -ge 2 ] || fail '--state-reinjection requires a value'
        init_runtime_state_reinjection=$2
        shift 2
        ;;
      --native-subagents)
        [ "$#" -ge 2 ] || fail '--native-subagents requires a value'
        init_runtime_subagents=$2
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *) fail "unknown init option: $1" ;;
    esac
  done

  [ -n "$init_state_arg" ] || fail '--state is required'
  init_state_dir=$(state_directory_for_init "$init_state_arg")
  init_state_file=$init_state_dir/run-state.yaml
  [ ! -e "$init_state_file" ] || fail "run state is already initialized: $init_state_file"
  mkdir -p "$init_state_dir"

  init_checkout_root=$(checkout_root_for_init "$init_checkout_arg")
  init_branch=$(CDPATH= cd "$init_checkout_root" && git_branch_for_init)
  init_head=$(git -C "$init_checkout_root" rev-parse HEAD 2>/dev/null) || \
    fail 'checkout has no commit baseline'
  init_base_sha=$(git -C "$init_checkout_root" rev-parse "$init_baseline_ref" 2>/dev/null) || \
    fail "baseline revision does not resolve: $init_baseline_ref"
  git -C "$init_checkout_root" merge-base --is-ancestor "$init_base_sha" "$init_head" || \
    fail "baseline revision is not an ancestor of the checkout: $init_baseline_ref"

  [ -n "$init_run_id" ] || init_run_id=$(basename "$init_state_dir")
  require_scalar_arg run_id "$init_run_id"
  require_enum_arg status "$init_status" planning running blocked reviewing repairing accepted failed
  require_enum_arg requested_mode "$init_requested_mode" AUTO SOLO SUBAGENTS
  require_enum_arg requested_delivery "$init_requested_delivery" DEFAULT GUIDED PR
  if [ -z "$init_delivery_mode" ]; then
    case "$init_requested_delivery" in
      PR) init_delivery_mode=PR ;;
      DEFAULT|GUIDED) init_delivery_mode=GUIDED ;;
    esac
  fi
  require_enum_arg delivery_mode "$init_delivery_mode" GUIDED PR
  [ -n "$init_routing_initial" ] || {
    case "$init_requested_mode" in
      AUTO) init_routing_initial=SOLO ;;
      *) init_routing_initial=$init_requested_mode ;;
    esac
  }
  [ -n "$init_routing_preferred" ] || init_routing_preferred=$init_routing_initial
  [ -n "$init_routing_selected" ] || init_routing_selected=$init_routing_preferred
  [ -n "$init_routing_current" ] || init_routing_current=$init_routing_selected
  for init_route in "$init_routing_initial" "$init_routing_preferred" \
    "$init_routing_selected" "$init_routing_current"; do
    require_enum_arg routing "$init_route" SOLO SUBAGENTS
  done
  require_scalar_arg reason "$init_reason"
  require_scalar_arg fallback_used "$init_fallback_used"
  require_enum_arg delivery_checkout.status "$init_delivery_status" ready running blocked dirty complete
  require_enum_arg delivery_checkout.branch_setup "$init_delivery_branch_setup" auto-created reused user-provided provided blocked
  require_enum_arg runtime_profile.context_usage "$init_runtime_context_usage" available estimated unavailable unknown
  require_enum_arg runtime_profile.context_window "$init_runtime_context_window" reported configured unknown
  require_enum_arg runtime_profile.proactive_compaction "$init_runtime_proactive_compaction" available unavailable unknown
  require_enum_arg runtime_profile.compaction_hooks "$init_runtime_compaction_hooks" available unavailable unknown
  require_enum_arg runtime_profile.state_reinjection "$init_runtime_state_reinjection" available unavailable unknown
  require_enum_arg runtime_profile.subagents.native "$init_runtime_subagents" available unavailable unknown
  control_chars "$init_runtime_harness"
  control_chars "$init_remote_default_evidence"
  validate_routing "$init_requested_mode" "$init_routing_initial" "$init_routing_current" \
    "$init_requested_delivery" "$init_delivery_mode"

  if [ "$init_delivery_mode" = PR ]; then
    delivery_authorization=PR
    delivery_status_value=pending
  else
    delivery_authorization=not-authorized
    delivery_status_value=not-authorized
  fi

  state_tmp=$init_state_dir/run-state.yaml.tmp.$$
  umask 077
  {
    printf 'workflow: swe-forge\n'
    printf 'workflow_version: 1\n'
    printf 'schema_version: 4\n'
    printf 'run_id: %s\n' "$init_run_id"
    printf 'status: %s\n' "$init_status"
    printf 'requested_mode: %s\n' "$init_requested_mode"
    printf 'requested_delivery: %s\n' "$init_requested_delivery"
    printf 'delivery_mode: %s\n' "$init_delivery_mode"
    printf 'reason: %s\n' "$init_reason"
    printf 'fallback_used: %s\n' "$init_fallback_used"
    printf 'routing:\n'
    printf '  initial: %s\n' "$init_routing_initial"
    printf '  preferred: %s\n' "$init_routing_preferred"
    printf '  selected: %s\n' "$init_routing_selected"
    printf '  current: %s\n' "$init_routing_current"
    printf '  revisions: []\n'
    printf '  context_value:\n'
    printf '    projected_pressure: unknown\n'
    printf '    context_reducibility: unknown\n'
    printf '    delegatable_context: low\n'
    printf '    root_context_requirement: high\n'
    printf '    continuity_risk: unknown\n'
    printf '    rationale: initialization facts only\n'
    printf '  runtime_profile_ref: none\n'
    printf 'runtime_profile:\n'
    printf '  harness: %s\n' "$init_runtime_harness"
    printf '  context_usage: %s\n' "$init_runtime_context_usage"
    printf '  context_window: %s\n' "$init_runtime_context_window"
    printf '  proactive_compaction: %s\n' "$init_runtime_proactive_compaction"
    printf '  compaction_hooks: %s\n' "$init_runtime_compaction_hooks"
    printf '  state_reinjection: %s\n' "$init_runtime_state_reinjection"
    printf '  subagents:\n'
    printf '    native: %s\n' "$init_runtime_subagents"
    printf '  capability_precedence: observed > adapter_declared > static_default > unknown\n'
    printf 'receipt_ref: none\n'
    printf 'delivery_checkout:\n'
    printf '  path: %s\n' "$init_checkout_root"
    printf '  branch: %s\n' "$init_branch"
    printf '  base_sha: %s\n' "$init_base_sha"
    printf '  head_sha: %s\n' "$init_head"
    printf '  checkpoint_sha: %s\n' "$init_head"
    printf '  status: %s\n' "$init_delivery_status"
    printf '  branch_setup: %s\n' "$init_delivery_branch_setup"
    printf '  remote_default_evidence: %s\n' "$init_remote_default_evidence"
    printf 'delivery:\n'
    printf '  authorization:\n'
    printf '    commit: %s\n' "$delivery_authorization"
    printf '    push: %s\n' "$delivery_authorization"
    printf '    create_pull_request: %s\n' "$delivery_authorization"
    printf '    publish: not-authorized\n'
    printf '    deploy: not-authorized\n'
    printf '    merge: not-authorized\n'
    printf '  commit: %s\n' "$delivery_status_value"
    printf '  push: %s\n' "$delivery_status_value"
    printf '  create_pull_request: %s\n' "$delivery_status_value"
    printf '  sync: not-authorized\n'
    printf '  pull_request_ref: none\n'
    printf 'tasks: {}\n'
  } >"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$init_state_file"
  state_tmp=
  printf 'PASS: schema-v4 run state initialized: %s\n' "$init_state_file"
}

set_delivery_checkout() {
  state_arg=
  path_arg=
  branch_arg=
  base_arg=
  head_arg=
  checkpoint_arg=
  path_supplied=false
  branch_supplied=false
  base_supplied=false
  head_supplied=false
  checkpoint_supplied=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail '--state requires a file or directory'
        state_arg=$2
        shift 2
        ;;
      --path|--checkout)
        [ "$#" -ge 2 ] || fail "$1 requires a path"
        path_arg=$2
        path_supplied=true
        shift 2
        ;;
      --branch)
        [ "$#" -ge 2 ] || fail '--branch requires a name'
        branch_arg=$2
        branch_supplied=true
        shift 2
        ;;
      --base-sha|--base)
        [ "$#" -ge 2 ] || fail "$1 requires a SHA"
        base_arg=$2
        base_supplied=true
        shift 2
        ;;
      --head-sha|--head)
        [ "$#" -ge 2 ] || fail "$1 requires a SHA"
        head_arg=$2
        head_supplied=true
        shift 2
        ;;
      --checkpoint-sha|--checkpoint)
        [ "$#" -ge 2 ] || fail "$1 requires a SHA"
        checkpoint_arg=$2
        checkpoint_supplied=true
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *) fail "unknown set-delivery-checkout option: $1" ;;
    esac
  done

  [ -n "$state_arg" ] || fail '--state is required'
  state_path=$(state_file "$state_arg")
  validate_state "$state_path" >/dev/null
  identity_update=false
  for supplied in "$path_supplied" "$branch_supplied" "$base_supplied"; do
    [ "$supplied" = true ] && identity_update=true
  done
  if [ "$identity_update" = true ]; then
    [ "$path_supplied" = true ] || fail 'checkout identity update requires --path'
    [ "$branch_supplied" = true ] || fail 'checkout identity update requires --branch'
    [ "$base_supplied" = true ] || fail 'checkout identity update requires --base-sha'
    case "$path_arg" in /*) ;; *) fail 'delivery_checkout.path must be absolute' ;; esac
    require_scalar_arg delivery_checkout.branch "$branch_arg"
    validate_sha_field delivery_checkout.base_sha "$base_arg"
  else
    [ "$head_supplied" = true ] || fail 'checkpoint update requires --head-sha'
    [ "$checkpoint_supplied" = true ] || fail 'checkpoint update requires --checkpoint-sha'
  fi
  require_scalar_arg delivery_checkout.head_sha "$head_arg"
  require_scalar_arg delivery_checkout.checkpoint_sha "$checkpoint_arg"
  validate_sha_field delivery_checkout.head_sha "$head_arg"
  validate_sha_field delivery_checkout.checkpoint_sha "$checkpoint_arg"

  state_tmp=$state_path.tmp.$$
  awk \
    -v update_path="$path_supplied" -v update_branch="$branch_supplied" \
    -v update_base="$base_supplied" -v update_head="$head_supplied" \
    -v update_checkpoint="$checkpoint_supplied" -v path_value="$path_arg" \
    -v branch_value="$branch_arg" -v base_value="$base_arg" \
    -v head_value="$head_arg" -v checkpoint_value="$checkpoint_arg" '
    BEGIN { section="" }
    /^[^[:space:]#][^:]*:/ { section=$1; sub(/:$/, "", section) }
    section == "delivery_checkout" && update_path == "true" && $0 ~ /^  path:/ { print "  path: " path_value; path_count++; next }
    section == "delivery_checkout" && update_branch == "true" && $0 ~ /^  branch:/ { print "  branch: " branch_value; branch_count++; next }
    section == "delivery_checkout" && update_base == "true" && $0 ~ /^  base_sha:/ { print "  base_sha: " base_value; base_count++; next }
    section == "delivery_checkout" && update_head == "true" && $0 ~ /^  head_sha:/ { print "  head_sha: " head_value; head_count++; next }
    section == "delivery_checkout" && update_checkpoint == "true" && $0 ~ /^  checkpoint_sha:/ { print "  checkpoint_sha: " checkpoint_value; checkpoint_count++; next }
    { print }
    END {
      if (update_path == "true" && path_count != 1) exit 1
      if (update_branch == "true" && branch_count != 1) exit 1
      if (update_base == "true" && base_count != 1) exit 1
      if (update_head == "true" && head_count != 1) exit 1
      if (update_checkpoint == "true" && checkpoint_count != 1) exit 1
    }
  ' "$state_path" >"$state_tmp" || fail 'delivery checkout update could not locate the current state fields'
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: delivery checkout updated: %s\n' "$state_path"
}

set_receipt_ref() {
  state_arg=
  receipt_arg=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state)
        [ "$#" -ge 2 ] || fail '--state requires a file or directory'
        state_arg=$2
        shift 2
        ;;
      --receipt-ref)
        [ "$#" -ge 2 ] || fail '--receipt-ref requires a reference'
        receipt_arg=$2
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *) fail "unknown set-receipt-ref option: $1" ;;
    esac
  done
  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$receipt_arg" ] || fail '--receipt-ref is required'
  state_path=$(state_file "$state_arg")
  validate_state "$state_path" >/dev/null
  require_scalar_arg receipt_ref "$receipt_arg"
  state_tmp=$state_path.tmp.$$
  awk -v wanted="$receipt_arg" '
    /^receipt_ref:/ {
      count++
      if (count == 1) { print "receipt_ref: " wanted; next }
    }
    { print }
    END { if (count != 1) exit 1 }
  ' "$state_path" >"$state_tmp" || fail 'current state contains an invalid receipt reference'
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: receipt reference updated: %s\n' "$state_path"
}

set_continuation() {
  state_arg=
  workflow_active=
  workflow=
  phase=
  step=
  awaiting=
  next_kind=
  next_target=
  acceptance=
  expected_context_tokens=unknown
  safe_boundary=
  pr_number=none
  pr_state=none
  recovery_signal=none
  recovery_status=none

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state_arg=$2; shift 2 ;;
      --workflow-active) [ "$#" -ge 2 ] || fail '--workflow-active requires true or false'; workflow_active=$2; shift 2 ;;
      --workflow) [ "$#" -ge 2 ] || fail '--workflow requires a workflow name'; workflow=$2; shift 2 ;;
      --phase) [ "$#" -ge 2 ] || fail '--phase requires a phase'; phase=$2; shift 2 ;;
      --step) [ "$#" -ge 2 ] || fail '--step requires a step'; step=$2; shift 2 ;;
      --awaiting) [ "$#" -ge 2 ] || fail '--awaiting requires a value'; awaiting=$2; shift 2 ;;
      --next-action-kind) [ "$#" -ge 2 ] || fail '--next-action-kind requires a kind'; next_kind=$2; shift 2 ;;
      --next-action-target) [ "$#" -ge 2 ] || fail '--next-action-target requires a target'; next_target=$2; shift 2 ;;
      --next-action-acceptance|--acceptance)
        [ "$#" -ge 2 ] || fail "$1 requires a check"
        control_chars "$2"
        if [ -n "$acceptance" ]; then acceptance="$acceptance$NEWLINE$2"; else acceptance=$2; fi
        shift 2
        ;;
      --expected-context-tokens) [ "$#" -ge 2 ] || fail '--expected-context-tokens requires a value'; expected_context_tokens=$2; shift 2 ;;
      --safe-boundary) [ "$#" -ge 2 ] || fail '--safe-boundary requires true or false'; safe_boundary=$2; shift 2 ;;
      --pr-number) [ "$#" -ge 2 ] || fail '--pr-number requires a number or none'; pr_number=$2; shift 2 ;;
      --pr-state) [ "$#" -ge 2 ] || fail '--pr-state requires a state or none'; pr_state=$2; shift 2 ;;
      --recovery-host-signal) [ "$#" -ge 2 ] || fail '--recovery-host-signal requires a signal'; recovery_signal=$2; shift 2 ;;
      --recovery-status) [ "$#" -ge 2 ] || fail '--recovery-status requires a status'; recovery_status=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown set-continuation option: $1" ;;
    esac
  done

  [ -n "$state_arg" ] || fail '--state is required'
  [ -n "$workflow_active" ] || fail '--workflow-active is required'
  [ -n "$workflow" ] || fail '--workflow is required'
  [ -n "$phase" ] || fail '--phase is required'
  [ -n "$step" ] || fail '--step is required'
  [ -n "$awaiting" ] || fail '--awaiting is required'
  [ -n "$next_kind" ] || fail '--next-action-kind is required'
  [ -n "$next_target" ] || fail '--next-action-target is required'
  [ -n "$safe_boundary" ] || fail '--safe-boundary is required'
  for value in "$workflow" "$phase" "$step" "$awaiting" "$next_kind" "$next_target" \
    "$expected_context_tokens" "$pr_number" "$pr_state" "$recovery_signal" "$recovery_status"; do
    control_chars "$value"
  done
  state_path=$(state_file "$state_arg")
  validate_state "$state_path" >/dev/null
  require_bool_arg continuation.workflow_active "$workflow_active"
  require_enum_arg continuation.workflow "$workflow" ticket delivery other
  require_enum_arg continuation.phase "$phase" planning discovery implementation review delivery awaiting_merge recovery complete
  case "$step" in none|*[!0-9]*) [ "$step" = none ] || fail 'invalid continuation.step' ;; esac
  require_enum_arg continuation.awaiting "$awaiting" none user_merge user_decision recovery
  require_enum_arg continuation.next_action.kind "$next_kind" specify discover implement validate review verify_and_sync_merge recover none
  require_bool_arg continuation.safe_boundary "$safe_boundary"
  case "$expected_context_tokens" in unknown|none) ;; ''|*[!0-9]*) fail 'invalid continuation.next_action.expected_context_tokens' ;; esac
  case "$pr_number" in none|''|*[!0-9]*) [ "$pr_number" = none ] || fail 'invalid continuation.delivery.pr_number' ;; esac
  require_enum_arg continuation.delivery.pr_state "$pr_state" DRAFT OPEN MERGED CLOSED none
  require_enum_arg continuation.recovery.host_signal "$recovery_signal" none near-limit overflow compaction
  require_enum_arg continuation.recovery.status "$recovery_status" none pending recovered blocked

  delivery_mode=$(required_scalar delivery_mode "$state_path")
  state_tmp=$state_path.tmp.$$
  awk '
    BEGIN { skip=0 }
    /^[^[:space:]#][^:]*:/ {
      section=$1
      sub(/:$/, "", section)
      if (section == "continuation") { skip=1; next }
      skip=0
    }
    skip { next }
    { print }
  ' "$state_path" >"$state_tmp"
  {
    printf 'continuation:\n'
    printf '  workflow_active: %s\n' "$workflow_active"
    printf '  workflow: %s\n' "$workflow"
    printf '  phase: %s\n' "$phase"
    printf '  step: %s\n' "$step"
    printf '  awaiting: %s\n' "$awaiting"
    printf '  next_action:\n'
    printf '    kind: %s\n' "$next_kind"
    printf '    target: %s\n' "$next_target"
    if [ -n "$acceptance" ]; then
      printf '    acceptance:\n'
      printf '%s\n' "$acceptance" | while IFS= read -r check; do
        [ -n "$check" ] || continue
        printf '      - %s\n' "$check"
      done
    else
      printf '    acceptance: []\n'
    fi
    printf '    expected_context_tokens: %s\n' "$expected_context_tokens"
    printf '  safe_boundary: %s\n' "$safe_boundary"
    printf '  updated_at: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '  delivery:\n'
    printf '    mode: %s\n' "$delivery_mode"
    printf '    pr_number: %s\n' "$pr_number"
    printf '    pr_state: %s\n' "$pr_state"
    printf '  recovery:\n'
    printf '    host_signal: %s\n' "$recovery_signal"
    printf '    status: %s\n' "$recovery_status"
  } >>"$state_tmp"
  validate_state "$state_tmp" >/dev/null
  mv "$state_tmp" "$state_path"
  state_tmp=
  printf 'PASS: continuation updated: %s\n' "$state_path"
}

main() {
  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  command=$1
  shift
  case "$command" in
    validate)
      state=
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --state) [ "$#" -ge 2 ] || fail '--state requires a file or directory'; state=$2; shift 2 ;;
          -h|--help) usage; exit 0 ;;
          *) fail "unknown validate option: $1" ;;
        esac
      done
      [ -n "$state" ] || fail '--state is required'
      validate_state "$state"
      ;;
    init) init_state "$@" ;;
    set-continuation) set_continuation "$@" ;;
    set-delivery-checkout) set_delivery_checkout "$@" ;;
    set-receipt-ref) set_receipt_ref "$@" ;;
    -h|--help) usage ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"
