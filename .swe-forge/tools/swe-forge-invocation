#!/bin/sh

# Dependency-free, portable parser for the reserved SWE-Forge invocation prefix.
# It owns command grammar only; topology selection and provider semantics remain
# agentic decisions after the normalized invocation facts are available.

set -eu

usage() {
  cat <<'EOF'
Usage:
  swe-forge-invocation parse --raw-arguments TEXT
  swe-forge-invocation parse --stdin

`--raw-arguments` accepts the complete, unmodified argument string as one
value. `--stdin` reads that same value without changing whitespace. The parser
writes one deterministic JSON object with the normalized invocation facts
(`input_status` is `COMPLETE`, `EMPTY`, `INCOMPLETE`, or
`MIGRATION_REQUIRED`) and never chooses automatic topology or a provider.
For `MIGRATION_REQUIRED`, use: "The `herdr` topology token was removed. Use
`isolated` and request Herdr as an execution-provider preference if it is
wanted."
EOF
}

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

# Keep the raw value in one awk record. The previous character-at-a-time shell
# implementation repeatedly copied the remaining string and became unusably
# slow for real ticket-sized invocations. NUL is not a shell argument value;
# using it as the record separator preserves all supported whitespace exactly.
parse_stream() {
  awk '
    BEGIN {
      RS = "\0"
      space = " "
      tab = sprintf("%c", 9)
      newline = sprintf("%c", 10)
      carriage_return = sprintf("%c", 13)
      form_feed = sprintf("%c", 12)
      vertical_tab = sprintf("%c", 11)
      backspace = sprintf("%c", 8)
      quote = sprintf("%c", 34)
      backslash = sprintf("%c", 92)
      raw = ""
    }

    function is_whitespace(c) {
      return c == space || c == tab || c == newline || \
        c == carriage_return || c == form_feed || c == vertical_tab
    }

    function trim_leading(s, i, c) {
      i = 1
      while (i <= length(s)) {
        c = substr(s, i, 1)
        if (!is_whitespace(c)) break
        i++
      }
      return substr(s, i)
    }

    function trim_trailing(s, i, c) {
      i = length(s)
      while (i > 0) {
        c = substr(s, i, 1)
        if (!is_whitespace(c)) break
        i--
      }
      return substr(s, 1, i)
    }

    function take_token(s, i, c) {
      i = 1
      while (i <= length(s)) {
        c = substr(s, i, 1)
        if (is_whitespace(c)) break
        i++
      }
      token = substr(s, 1, i - 1)
      token_remainder = substr(s, i)
    }

    function json_string(s, i, c) {
      printf "\""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == quote) printf "%s", "\\\""
        else if (c == backslash) printf "%s", "\\\\"
        else if (c == tab) printf "%s", "\\t"
        else if (c == newline) printf "%s", "\\n"
        else if (c == carriage_return) printf "%s", "\\r"
        else if (c == form_feed) printf "%s", "\\f"
        else if (c == backspace) printf "%s", "\\b"
        else if (c == vertical_tab) printf "%s", "\\u000b"
        else printf "%s", c
      }
      printf "\""
    }

    {
      raw = raw $0
    }

    END {
      # The caller appends a sentinel so an input-ending newline is not
      # discarded by awk record handling.
      raw = substr(raw, 1, length(raw) - 1)
      requested_mode = "AUTO"
      requested_delivery = "DEFAULT"
      delivery_mode = "GUIDED"
      input_status = "COMPLETE"
      parsed_ticket = ""
      consumed_count = 0

      parse_remainder = trim_leading(raw)
      if (parse_remainder == "") {
        input_status = "EMPTY"
      } else {
        take_token(parse_remainder)
        first_token = token
        parse_remainder = token_remainder

        if (first_token == "herdr") {
          consumed[++consumed_count] = first_token
          input_status = "MIGRATION_REQUIRED"
        } else if (first_token == "solo" || first_token == "subagents" || first_token == "isolated") {
          if (first_token == "solo") requested_mode = "SOLO"
          else if (first_token == "subagents") requested_mode = "SUBAGENTS"
          else requested_mode = "ISOLATED"
          consumed[++consumed_count] = first_token
          parse_remainder = trim_leading(parse_remainder)
          if (parse_remainder != "") {
            take_token(parse_remainder)
            if (token == "guided" || token == "pr") {
              if (token == "guided") requested_delivery = "GUIDED"
              else requested_delivery = "PR"
              delivery_mode = requested_delivery
              consumed[++consumed_count] = token
              parse_remainder = token_remainder
            }
          }
          parsed_ticket = trim_trailing(trim_leading(parse_remainder))
          if (parsed_ticket == "") input_status = "INCOMPLETE"
        } else if (first_token == "guided" || first_token == "pr") {
          if (first_token == "guided") requested_delivery = "GUIDED"
          else requested_delivery = "PR"
          delivery_mode = requested_delivery
          consumed[++consumed_count] = first_token
          parse_remainder = trim_leading(parse_remainder)
          if (parse_remainder != "") {
            take_token(parse_remainder)
            if (token == "solo" || token == "subagents" || token == "isolated") {
              if (token == "solo") requested_mode = "SOLO"
              else if (token == "subagents") requested_mode = "SUBAGENTS"
              else requested_mode = "ISOLATED"
              consumed[++consumed_count] = token
              parse_remainder = token_remainder
            }
          }
          parsed_ticket = trim_trailing(trim_leading(parse_remainder))
          if (parsed_ticket == "") input_status = "INCOMPLETE"
        } else {
          parsed_ticket = trim_trailing(trim_leading(raw))
        }
      }

      printf "{\"raw_arguments\":"
      json_string(raw)
      printf ",\"parsed_ticket\":"
      json_string(parsed_ticket)
      printf ",\"requested_mode\":\"%s\",\"requested_delivery\":\"%s\",\"delivery_mode\":\"%s\",\"input_status\":\"%s\",\"consumed_tokens\":[", requested_mode, requested_delivery, delivery_mode, input_status
      for (i = 1; i <= consumed_count; i++) {
        if (i > 1) printf ","
        json_string(consumed[i])
      }
      printf "]}\n"
    }
  '
}

parse_raw_arguments() {
  printf '%s\001' "$1" | parse_stream
}

parse() {
  [ "$#" -gt 0 ] || fail 'parse requires --raw-arguments or --stdin'
  case "$1" in
    --raw-arguments|--raw)
      [ "$#" -eq 2 ] || fail "$1 requires exactly one value"
      parse_raw_arguments "$2"
      ;;
    --stdin)
      [ "$#" -eq 1 ] || fail '--stdin does not accept additional arguments'
      { cat; printf '\001'; } | parse_stream
      ;;
    -h|--help)
      usage
      ;;
    *) fail "unknown parse option: $1" ;;
  esac
}

main() {
  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  case "$1" in
    parse)
      shift
      parse "$@"
      ;;
    -h|--help)
      usage
      ;;
    *) fail "unknown command: $1" ;;
  esac
}

main "$@"
