#!/bin/sh
set -eu

# Keep the workflow shell-based; use the standard JSON parser only for this
# boundary, where shell/awk cannot safely reject duplicate or escaped values.
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'FAIL: swe-forge-worker-brief requires python3' >&2
  exit 1
fi

exec 3<&0
exec python3 - "$@" <<'PY'
import json
import os
import re
import sys
from pathlib import Path

MAX_BYTES = 256 * 1024
TASK_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
DIGEST_CATEGORIES = {
    "accepted_decisions",
    "relevant_facts",
    "changed_interfaces",
    "paths_symbols",
    "authoritative_assumptions",
    "validation_facts",
    "unresolved_risks",
    "source_refs",
}
FORBIDDEN_ACTIONS = [
    "delivery",
    "recursive delegation",
    "peer communication",
    "scope expansion",
    "topology decisions",
]


def usage() -> None:
    print(
        """Usage:
  swe-forge-worker-brief validate --brief FILE|-
  swe-forge-worker-brief inspect --brief FILE|-

The brief is one canonical worker_briefing/v1 JSON object. Validate it before
launch and pass the same JSON text to the worker. inspect validates the brief
and emits the small task/profile/write-access port used by host adapters.
""",
    )


def fail(message: str) -> None:
    print(f"FAIL: {message}", file=sys.stderr)
    raise SystemExit(1)


def duplicate_free_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate object key: {key}")
        result[key] = value
    return result


def reject_constant(value):
    raise ValueError(f"invalid JSON constant: {value}")


def load_json(source: str):
    try:
        raw = os.fdopen(3, "rb").read() if source == "-" else Path(source).read_bytes()
    except OSError as error:
        fail(f"brief file could not be read: {error}")
    if len(raw) > MAX_BYTES:
        fail("worker briefing exceeds the canonical size limit")
    try:
        text = raw.decode("utf-8")
        return json.loads(
            text,
            object_pairs_hook=duplicate_free_object,
            parse_constant=reject_constant,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        fail(f"brief is not valid unambiguous JSON: {error}")


def object_with_keys(value, label: str, required, optional=()):
    if not isinstance(value, dict):
        fail(f"{label} must be an object")
    allowed = set(required) | set(optional)
    unknown = sorted(set(value) - allowed)
    if unknown:
        fail(f"{label} contains unknown field: {unknown[0]}")
    missing = [key for key in required if key not in value]
    if missing:
        fail(f"{label} is missing {missing[0]}")
    return value


def safe_string(value, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        fail(f"{label} must be a non-empty string")
    if any(ord(character) < 32 or ord(character) == 127 for character in value):
        fail(f"{label} contains a control character")
    return value


def string_list(value, label: str, minimum=0):
    if not isinstance(value, list):
        fail(f"{label} must be an array")
    if len(value) < minimum:
        fail(f"{label} must contain at least one item")
    return [safe_string(item, f"{label} item") for item in value]


def action_set(value, expected, label: str) -> None:
    if len(value) != len(set(value)) or set(value) != set(expected):
        fail(f"{label} do not match the canonical worker boundary")


def validate_dependencies(value) -> None:
    dependencies = object_with_keys(value, "dependencies", (), ("completed", "pending"))
    if not dependencies:
        fail("dependencies must contain completed or pending entries")
    seen = set()
    completed = dependencies.get("completed", [])
    if not isinstance(completed, list):
        fail("dependencies.completed must be an array")
    for index, item in enumerate(completed, 1):
        entry = object_with_keys(
            item,
            f"dependencies.completed[{index}]",
            ("task_id", "dependency_digest"),
        )
        task_id = safe_string(entry["task_id"], f"dependencies.completed[{index}].task_id")
        if not TASK_ID.fullmatch(task_id):
            fail(f"dependency task ID contains unsupported characters: {task_id}")
        if task_id in seen:
            fail(f"duplicate dependency task: {task_id}")
        seen.add(task_id)
        digest = object_with_keys(
            entry["dependency_digest"],
            f"dependencies.completed[{index}].dependency_digest",
            (),
            DIGEST_CATEGORIES,
        )
        if not digest:
            fail(f"dependencies.completed[{index}] has an empty dependency digest")
        if "source_refs" not in digest:
            fail(f"dependencies.completed[{index}] must include source_refs")
        for category, facts in digest.items():
            string_list(facts, f"dependency digest {category}", 1)

    pending = dependencies.get("pending", [])
    if not isinstance(pending, list):
        fail("dependencies.pending must be an array")
    for index, item in enumerate(pending, 1):
        task_id = safe_string(item, f"dependencies.pending[{index}]")
        if not TASK_ID.fullmatch(task_id):
            fail(f"dependency task ID contains unsupported characters: {task_id}")
        if task_id in seen:
            fail(f"dependency appears more than once: {task_id}")
        seen.add(task_id)
    if not seen:
        fail("dependencies must contain a completed or pending dependency")


def validate_brief(document):
    outer = object_with_keys(document, "brief", ("worker_briefing",))
    brief = object_with_keys(
        outer["worker_briefing"],
        "worker_briefing",
        (
            "schema",
            "task_id",
            "worker",
            "objective",
            "acceptance",
            "repository",
            "architecture_decisions",
            "validation",
            "permissions",
            "return",
        ),
        ("dependencies",),
    )
    if brief["schema"] != "worker-brief/v1":
        fail("schema must be worker-brief/v1")

    task_id = safe_string(brief["task_id"], "task_id")
    if not TASK_ID.fullmatch(task_id):
        fail("task_id contains unsupported characters")

    worker = object_with_keys(
        brief["worker"],
        "worker",
        ("role", "mode", "depth", "recursive_delegation"),
    )
    role = safe_string(worker["role"], "worker.role")
    if worker["mode"] != "delegated_worker":
        fail("worker.mode must be delegated_worker")
    if not isinstance(worker["depth"], int) or isinstance(worker["depth"], bool) or worker["depth"] < 1:
        fail("worker.depth must be a positive integer")
    if worker["recursive_delegation"] is not False:
        fail("worker.recursive_delegation must be false")

    safe_string(brief["objective"], "objective")
    string_list(brief["acceptance"], "acceptance", 1)

    repository = object_with_keys(
        brief["repository"],
        "repository",
        ("instructions", "allowed_reads", "allowed_writes"),
    )
    string_list(repository["instructions"], "repository.instructions")
    string_list(repository["allowed_reads"], "repository.allowed_reads", 1)
    writes = string_list(repository["allowed_writes"], "repository.allowed_writes", 1)

    decisions = string_list(brief["architecture_decisions"], "architecture_decisions")
    del decisions  # The validation above is intentional; the values remain root-selected.

    validation = brief["validation"]
    if not isinstance(validation, list) or not validation:
        fail("validation must contain at least one check")
    for index, item in enumerate(validation, 1):
        check = object_with_keys(
            item,
            f"validation[{index}]",
            ("command", "requirement", "condition", "side_effects"),
        )
        safe_string(check["command"], f"validation[{index}].command")
        if not isinstance(check["requirement"], str) or check["requirement"] not in {"required", "conditional", "informational"}:
            fail(f"invalid validation requirement: {check['requirement']}")
        safe_string(check["condition"], f"validation[{index}].condition")
        if not isinstance(check["side_effects"], str) or check["side_effects"] not in {"local-only", "external-read", "external-write", "destructive"}:
            fail(f"invalid validation side effect: {check['side_effects']}")

    permissions = object_with_keys(
        brief["permissions"],
        "permissions",
        ("write_access", "topology", "allowed_actions", "forbidden_actions"),
    )
    write_access = permissions["write_access"]
    if not isinstance(write_access, str) or write_access not in {"read-only", "read-write"}:
        fail("permissions.write_access must be read-only or read-write")
    if permissions["topology"] != "SUBAGENTS":
        fail("permissions.topology must be SUBAGENTS")
    allowed_actions = string_list(permissions["allowed_actions"], "permissions.allowed_actions", 1)
    forbidden_actions = string_list(permissions["forbidden_actions"], "permissions.forbidden_actions", 1)
    action_set(forbidden_actions, FORBIDDEN_ACTIONS, "permissions.forbidden_actions")

    if write_access == "read-only":
        if writes != ["none"]:
            fail("read-only workers must have allowed_writes [none]")
    else:
        if "none" in writes:
            fail("read-write workers may not have an allowed write named none")
        if not writes:
            fail("read-write workers must declare an allowed write")

    result = object_with_keys(brief["return"], "return", ("profile", "contract", "expected_output"))
    profile = result["profile"]
    if not isinstance(profile, str) or profile not in {"READ_ONLY", "WRITABLE", "REVIEW"}:
        fail(f"invalid return.profile: {profile}")
    string_list(result["expected_output"], "return.expected_output", 1)

    if role == "reviewer":
        if write_access != "read-only" or profile != "REVIEW":
            fail("review workers must be read-only and use the REVIEW profile")
        if result["contract"] != ".swe-forge/contracts/review.md":
            fail("REVIEW workers must use contracts/review.md")
        action_set(allowed_actions, ["read"], "review workers' allowed actions")
    elif write_access == "read-only":
        if profile != "READ_ONLY":
            fail("read-only workers must use the READ_ONLY profile")
        if result["contract"] != ".swe-forge/contracts/result.md":
            fail("ordinary workers must use contracts/result.md")
        action_set(allowed_actions, ["read", "validation"], "read-only ordinary workers' allowed actions")
    else:
        if profile != "WRITABLE":
            fail("read-write workers must use the WRITABLE profile")
        if result["contract"] != ".swe-forge/contracts/result.md":
            fail("ordinary workers must use contracts/result.md")
        action_set(allowed_actions, ["read", "edit", "validation"], "read-write workers' allowed actions")

    if "dependencies" in brief:
        validate_dependencies(brief["dependencies"])
    return brief, task_id, profile, write_access


def brief_path(arguments):
    if len(arguments) == 1 and arguments[0] in {"-h", "--help"}:
        usage()
        raise SystemExit(0)
    if len(arguments) != 2 or arguments[0] != "--brief":
        fail("use --brief FILE|-")
    return arguments[1]


def main():
    arguments = sys.argv[1:]
    if not arguments:
        usage()
        raise SystemExit(2)
    if arguments[0] in {"-h", "--help"}:
        usage()
        return
    command = arguments[0]
    if command not in {"validate", "inspect"}:
        fail(f"unknown operation: {command}")
    source = brief_path(arguments[1:])
    brief, task_id, profile, write_access = validate_brief(load_json(source))
    if command == "validate":
        print("PASS: worker briefing validated")
        return
    print(
        json.dumps(
            {
                "schema": "worker-brief/v1",
                "valid": True,
                "task_id": task_id,
                "profile": profile,
                "write_access": write_access,
            },
            separators=(",", ":"),
        )
    )


if __name__ == "__main__":
    main()
PY
