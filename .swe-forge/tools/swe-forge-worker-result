#!/bin/sh
set -eu

# Keep the workflow shell-based; use the standard JSON parser only for this
# boundary, where shell/awk cannot safely reject duplicate or escaped values.
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'FAIL: swe-forge-worker-result requires python3' >&2
  exit 1
fi

exec 3<&0
exec python3 - "$@" <<'PY'
import json
import os
import re
import sys
from pathlib import Path
from typing import Optional

MAX_BYTES = 256 * 1024
TASK_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
SHA = re.compile(r"^[0-9A-Fa-f]{40}$")
COMMON = {"RESULT_PROFILE", "STATUS", "TASK_ID", "FINDINGS", "EVIDENCE", "RISKS", "RECOMMENDED_ACTION"}
WRITABLE = {
    *COMMON,
    "BASE_SHA",
    "HEAD_SHA",
    "BRANCH",
    "FILES_CHANGED",
    "GIT_STATE",
    "DELIVERABLE_COMMITS",
    "VALIDATION",
    "SCOPE_EXCEPTIONS",
}
VALIDATION_FIELDS = {"command", "requirement", "condition", "applies", "result", "evidence"}


def usage() -> None:
    print(
        """Usage:
  swe-forge-worker-result schema --profile PROFILE [--task-id ID]
  swe-forge-worker-result validate --profile READ_ONLY|WRITABLE \\
    [--task-id ID] --result FILE|-

schema emits the direct JSON Schema for one canonical result profile.
validate accepts that same JSON object from a file or stdin. JSON is also the
text fallback for hosts without native structured-output support; no second
encoding is used.
""",
    )


def fail(message: str) -> None:
    print(f"FAIL: {message}", file=sys.stderr)
    raise SystemExit(1)


def duplicate_free_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate object key: {key}")
        result[key] = value
    return result


def reject_constant(value):
    raise ValueError(f"invalid JSON constant: {value}")


def load_json(source: str):
    try:
        raw = os.fdopen(3, "rb").read() if source == "-" else Path(source).read_bytes()
    except OSError as error:
        fail(f"result file could not be read: {error}")
    if len(raw) > MAX_BYTES:
        fail("worker result exceeds the canonical size limit")
    try:
        return json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=duplicate_free_object,
            parse_constant=reject_constant,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        fail(f"result is not valid unambiguous JSON: {error}")


def object_with_keys(value, label: str, required, optional=()):
    if not isinstance(value, dict):
        fail(f"{label} must be an object")
    allowed = set(required) | set(optional)
    unknown = sorted(set(value) - allowed)
    if unknown:
        fail(f"{label} contains unknown field: {unknown[0]}")
    missing = [key for key in required if key not in value]
    if missing:
        fail(f"{label} is missing {missing[0]}")
    return value


def safe_string(value, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        fail(f"{label} must be a non-empty string")
    if any(ord(character) < 32 or ord(character) == 127 for character in value):
        fail(f"{label} contains a control character")
    return value


def enum(value, choices, label: str) -> str:
    if not isinstance(value, str) or value not in choices:
        fail(f"invalid {label}: {value}")
    return value


def required_string_array(value, label: str):
    if not isinstance(value, list) or not value:
        fail(f"{label} must contain at least one item")
    return [safe_string(item, f"{label} item") for item in value]


def optional_string_array(value, label: str) -> None:
    if value is None:
        return
    required_string_array(value, label)


def validate_validation(records, status: str):
    if not isinstance(records, list) or not records:
        fail("VALIDATION must contain at least one record")
    for index, value in enumerate(records, 1):
        record = object_with_keys(value, f"VALIDATION[{index}]", VALIDATION_FIELDS)
        safe_string(record["command"], f"VALIDATION[{index}].command")
        enum(record["requirement"], {"required", "conditional", "informational"}, f"VALIDATION[{index}].requirement")
        safe_string(record["condition"], f"VALIDATION[{index}].condition")
        if not isinstance(record["applies"], bool):
            fail(f"VALIDATION[{index}].applies must be boolean")
        result = enum(
            record["result"],
            {"passed", "failed", "unavailable", "not-applicable"},
            f"VALIDATION[{index}].result",
        )
        safe_string(record["evidence"], f"VALIDATION[{index}].evidence")
        requirement = record["requirement"]
        applies = record["applies"]
        if requirement == "required" and not applies:
            fail("required validation must apply")
        if requirement == "conditional" and not applies and result != "not-applicable":
            fail("non-applicable conditional validation must be not-applicable")
        if status == "DONE" and requirement == "required" and result != "passed":
            fail(f"DONE result has a non-passing required validation: {record['command']}")
        if status == "DONE" and requirement == "conditional" and applies and result != "passed":
            fail(f"DONE result has a non-passing applicable validation: {record['command']}")
        yield requirement, applies, result, record["command"]


def validate_result(document, expected_profile: str, expected_task: Optional[str]):
    if not isinstance(document, dict):
        fail("result must be a JSON object")
    allowed = COMMON if expected_profile == "READ_ONLY" else WRITABLE
    unknown = sorted(set(document) - allowed)
    if unknown:
        fail(f"result contains unknown or profile-incompatible field: {unknown[0]}")
    for name in ("RESULT_PROFILE", "STATUS", "TASK_ID", "FINDINGS", "EVIDENCE"):
        if name not in document:
            fail(f"result is missing {name}")
    if document["RESULT_PROFILE"] != expected_profile:
        fail("result profile does not match expected profile")
    task_id = safe_string(document["TASK_ID"], "TASK_ID")
    if not TASK_ID.fullmatch(task_id):
        fail("TASK_ID contains unsupported characters")
    if expected_task is not None and task_id != expected_task:
        fail("TASK_ID does not match the requested task")
    status = enum(document["STATUS"], {"DONE", "BLOCKED", "FAILED"}, "STATUS")
    required_string_array(document["FINDINGS"], "FINDINGS")
    required_string_array(document["EVIDENCE"], "EVIDENCE")
    if "RISKS" in document:
        optional_string_array(document["RISKS"], "RISKS")
    if "RECOMMENDED_ACTION" in document:
        optional_string_array(document["RECOMMENDED_ACTION"], "RECOMMENDED_ACTION")
    if status in {"BLOCKED", "FAILED"}:
        if "RECOMMENDED_ACTION" not in document or not isinstance(document["RECOMMENDED_ACTION"], list) or not document["RECOMMENDED_ACTION"]:
            fail(f"{status} result must include RECOMMENDED_ACTION")

    if expected_profile == "READ_ONLY":
        return task_id, status

    for name in ("BASE_SHA", "HEAD_SHA", "BRANCH", "FILES_CHANGED", "GIT_STATE", "VALIDATION"):
        if name not in document:
            fail(f"result is missing {name}")
    base_sha = safe_string(document["BASE_SHA"], "BASE_SHA")
    head_sha = safe_string(document["HEAD_SHA"], "HEAD_SHA")
    safe_string(document["BRANCH"], "BRANCH")
    if not SHA.fullmatch(base_sha):
        fail("BASE_SHA must be a full 40-character SHA")
    if head_sha != "none" and not SHA.fullmatch(head_sha):
        fail("HEAD_SHA must be a full 40-character SHA or none")
    changed = required_string_array(document["FILES_CHANGED"], "FILES_CHANGED")
    required_string_array(document["GIT_STATE"], "GIT_STATE")
    list(validate_validation(document["VALIDATION"], status))
    for path in changed:
        if path == "none" and status == "DONE":
            fail("DONE WRITABLE result cannot report no changed files")
        if path != "none" and path.startswith("/"):
            fail("FILES_CHANGED paths must be repository-relative")
        if path != "none" and (path == ".." or path.startswith("../") or "/../" in path):
            fail("FILES_CHANGED paths may not escape the repository")
    for name in ("DELIVERABLE_COMMITS", "SCOPE_EXCEPTIONS"):
        if name in document:
            optional_string_array(document[name], name)
    return task_id, status


def string_array_schema(minimum=1):
    schema = {"type": "array", "items": {"type": "string", "minLength": 1}}
    if minimum is not None:
        schema["minItems"] = minimum
    return schema


def nullable_array_schema():
    return {"anyOf": [string_array_schema(1), {"type": "null"}]}


def result_schema(profile: str, task_id: Optional[str]):
    common_properties = {
        "RESULT_PROFILE": {"type": "string", "enum": [profile]},
        "STATUS": {"type": "string", "enum": ["DONE", "BLOCKED", "FAILED"]},
        "TASK_ID": {"type": "string", "const": task_id} if task_id is not None else {"type": "string"},
        "FINDINGS": string_array_schema(1),
        "EVIDENCE": string_array_schema(1),
        "RISKS": nullable_array_schema(),
        "RECOMMENDED_ACTION": nullable_array_schema(),
    }
    required = ["RESULT_PROFILE", "STATUS", "TASK_ID", "FINDINGS", "EVIDENCE"]
    schema = {
        "type": "object",
        "properties": common_properties,
        "required": required,
        "additionalProperties": False,
    }
    if profile == "WRITABLE":
        validation_item = {
            "type": "object",
            "properties": {
                "command": {"type": "string", "minLength": 1},
                "requirement": {"type": "string", "enum": ["required", "conditional", "informational"]},
                "condition": {"type": "string", "minLength": 1},
                "applies": {"type": "boolean"},
                "result": {"type": "string", "enum": ["passed", "failed", "unavailable", "not-applicable"]},
                "evidence": {"type": "string", "minLength": 1},
            },
            "required": ["command", "requirement", "condition", "applies", "result", "evidence"],
            "additionalProperties": False,
        }
        schema["properties"].update(
            {
                "BASE_SHA": {"type": "string", "pattern": SHA.pattern},
                "HEAD_SHA": {"anyOf": [{"type": "string", "pattern": SHA.pattern}, {"type": "string", "const": "none"}]},
                "BRANCH": {"type": "string", "minLength": 1},
                "FILES_CHANGED": string_array_schema(1),
                "GIT_STATE": string_array_schema(1),
                "DELIVERABLE_COMMITS": nullable_array_schema(),
                "VALIDATION": {"type": "array", "items": validation_item, "minItems": 1},
                "SCOPE_EXCEPTIONS": nullable_array_schema(),
            }
        )
        schema["required"] += ["BASE_SHA", "HEAD_SHA", "BRANCH", "FILES_CHANGED", "GIT_STATE", "VALIDATION"]
    elif profile == "REVIEW":
        schema = {
            "type": "object",
            "properties": {
                "status": {"type": "string", "enum": ["PASS", "CHANGES_REQUIRED"]},
                "scope": {"type": "object", "additionalProperties": True},
                "review_focus": {"type": "object", "additionalProperties": True},
                "findings": {"type": "array", "items": {"type": "object", "additionalProperties": True}},
                "deferred_followups": {"type": "array", "items": {"type": "object", "additionalProperties": True}},
            },
            "required": ["status", "scope", "review_focus", "findings", "deferred_followups"],
            "additionalProperties": False,
        }
    elif profile != "READ_ONLY":
        fail(f"unknown result profile: {profile}")
    return schema


def parse_options(arguments, command: str):
    profile = None
    task_id = None
    result = None
    index = 0
    while index < len(arguments):
        option = arguments[index]
        if option in {"--profile", "--task-id", "--task", "--result"}:
            if index + 1 >= len(arguments):
                fail(f"{option} requires a value")
            value = arguments[index + 1]
            if option == "--profile":
                profile = value
            elif option in {"--task-id", "--task"}:
                task_id = value
            else:
                if result is not None:
                    fail("result input was specified more than once")
                result = value
            index += 2
            continue
        if command == "validate" and not option.startswith("-"):
            if result is not None:
                fail("result input was specified more than once")
            result = option
            index += 1
            continue
        if option in {"-h", "--help"}:
            usage()
            raise SystemExit(0)
        fail(f"unknown {command} option: {option}")
    return profile, task_id, result


def main():
    arguments = sys.argv[1:]
    if not arguments:
        usage()
        raise SystemExit(2)
    if arguments[0] in {"-h", "--help"}:
        usage()
        return
    command = arguments[0]
    if command not in {"schema", "validate"}:
        fail(f"unknown operation: {command}")
    profile, task_id, result = parse_options(arguments[1:], command)
    if not isinstance(profile, str) or profile not in {"READ_ONLY", "WRITABLE", "REVIEW"}:
        fail("a valid --profile is required")
    if task_id is not None and not TASK_ID.fullmatch(task_id):
        fail("task ID contains unsupported characters")
    if command == "schema":
        if profile == "REVIEW" and task_id is not None:
            fail("REVIEW schema does not accept --task-id")
        if profile != "REVIEW" and task_id is None:
            fail("ordinary schema requires --task-id")
        print(json.dumps(result_schema(profile, task_id), indent=2))
        return
    if profile == "REVIEW":
        fail("REVIEW results use contracts/review.md; validate its dedicated contract")
    if result is None:
        fail("validate requires --result FILE|-")
    document = load_json(result)
    task_id_value, status = validate_result(document, profile, task_id)
    print(
        json.dumps(
            {
                "schema": "worker-result/v1",
                "valid": True,
                "profile": profile,
                "status": status,
                "task_id": task_id_value,
            },
            separators=(",", ":"),
        )
    )


if __name__ == "__main__":
    main()
PY
